+Definition armv8a_VSRI_instr : instr_desc_t :=
+  mk_v1d_imm_instr VSRI (CAimmC_armv8a_vshr esize) (armv8a_VSRI_semi esize).
+
+(* [C7.2.302 SLI] ARM DDI 0487 M.d, p. C7-3677
+   Syntax: SLI <Vd>.<T>, <Vn>.<T>, #<shift>
