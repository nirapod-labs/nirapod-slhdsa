diff --git a/compiler/tests/fail/asmgen/armv8a/vmovi_nonzero.jazz b/compiler/tests/fail/asmgen/armv8a/vmovi_nonzero.jazz
new file mode 100644
index 00000000..800ab395
--- /dev/null
+++ b/compiler/tests/fail/asmgen/armv8a/vmovi_nonzero.jazz
@@ -0,0 +1,7 @@
+/* MOVI is accepted with the immediate 0 only. */
+export
+fn vmovi_nonzero(reg u64 p) {
+    reg u128 a;
+    a = #VMOVI(1);
+    [:u128 p] = a;
+}
diff --git a/compiler/tests/fail/asmgen/armv8a/vshl_amount_range.jazz b/compiler/tests/fail/asmgen/armv8a/vshl_amount_range.jazz
