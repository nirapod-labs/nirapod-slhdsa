+Lemma lower_vec_Papp1P op e : Plower_vec_pexpr (Papp1 op e).
+Proof.
+  move=> s ws' aop es w h hws hfve hsem.
+  move: h; rewrite /lower_vec_pexpr.
+  case: op hsem hfve => [ ws0 | ? ? | ? ? | ? ? || ws0 | ? | ? ? ] // hsem hfve.
+
+  (* The zero constant, set by MOVI. *)
