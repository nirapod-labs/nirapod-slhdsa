 Proof.
   case: e => [||| gx | al aa ws0 x e || al ws0 x e | op e | op e0 e1 ||].
   all: try by move=> > /=.
   - exact: (lower_vec_moveP (Pvar _)).
   - exact: (lower_vec_moveP (Pget _ _ _ _ _)).
-  exact: (lower_vec_moveP (Pload _ _ _)).
+  - exact: (lower_vec_moveP (Pload _ _ _)).
+  - exact: lower_vec_Papp1P.
+  exact: lower_vec_Papp2P.
 Qed.
 
