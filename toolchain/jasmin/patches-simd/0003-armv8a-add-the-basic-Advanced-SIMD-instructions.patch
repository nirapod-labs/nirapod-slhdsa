@@ -0,0 +1,8 @@
+/* SHL shifts by at most the element size minus one. */
+export
+fn vshl_amount_range(reg u64 p) {
+    reg u128 a;
+    a = [:u128 p];
+    a = #VSHL_4u32(a, 32);
+    [:u128 p] = a;
+}
