+    assert (hn' := is_wconstP true (p_globs p) s hn).
+    move: hn'; rewrite hsem /= (truncate_word_le _ hws) => /ok_inj hw.
+    split; last done.
+    rewrite /=; eexists; first reflexivity.
+    rewrite /exec_sopn /= truncate_word_u /= hw.
+    (* Both 64-bit elements are 0. *)
