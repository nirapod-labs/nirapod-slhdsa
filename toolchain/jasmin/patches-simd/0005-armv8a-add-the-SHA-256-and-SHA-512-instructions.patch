diff --git a/compiler/tests/success/armv8a/simd_exec.jazz b/compiler/tests/success/armv8a/simd_exec.jazz
new file mode 100644
index 00000000..6c570ffd
--- /dev/null
+++ b/compiler/tests/success/armv8a/simd_exec.jazz
@@ -0,0 +1,141 @@
+/*
+ * Fixed-input checks of the Advanced SIMD permutations and element moves,
+ * evaluated by tests/exec/exec_armv8a.ml. Byte i of the first input vector
+ * is i and byte i of the second is 16 + i, so that every element of a
+ * result names the element it comes from.
+ */
+
+u128[2] PERM_IN = {
+  0x0f0e0d0c0b0a09080706050403020100,
+  0x1f1e1d1c1b1a19181716151413121110
+};
+
+u32[1] MOVE_W = { 0xa3a2a1a0 };
+
+u64[1] MOVE_X = { 0xb7b6b5b4b3b2b1b0 };
+
+export
+fn perm_ext() -> reg u128, reg u128, reg u128, reg u128 {
+  reg u128 a b r0 r1 r2 r3;
+  a = PERM_IN[0];
+  b = PERM_IN[1];
+  r0 = #VEXT(a, b, 0);
+  r1 = #VEXT(a, b, 3);
+  r2 = #VEXT(a, b, 8);
+  r3 = #VEXT(a, b, 15);
+  return r0, r1, r2, r3;
+}
+
+export
+fn perm_rev() -> reg u128, reg u128, reg u128, reg u128 {
+  reg u128 a r0 r1 r2 r3;
+  a = PERM_IN[0];
+  r0 = #VREV32_16u8(a);
+  r1 = #VREV32_8u16(a);
+  r2 = #VREV64_16u8(a);
+  r3 = #VREV64_8u16(a);
+  return r0, r1, r2, r3;
+}
+
+export
+fn perm_rev64_4s() -> reg u128 {
+  reg u128 a r;
+  a = PERM_IN[0];
+  r = #VREV64_4u32(a);
+  return r;
+}
+
+export
+fn perm_trn() -> reg u128, reg u128, reg u128, reg u128 {
+  reg u128 a b r0 r1 r2 r3;
+  a = PERM_IN[0];
+  b = PERM_IN[1];
+  r0 = #VTRN1_16u8(a, b);
+  r1 = #VTRN1_4u32(a, b);
+  r2 = #VTRN2_8u16(a, b);
+  r3 = #VTRN2_2u64(a, b);
+  return r0, r1, r2, r3;
+}
+
+export
+fn perm_zip() -> reg u128, reg u128, reg u128, reg u128 {
+  reg u128 a b r0 r1 r2 r3;
+  a = PERM_IN[0];
+  b = PERM_IN[1];
+  r0 = #VZIP1_16u8(a, b);
+  r1 = #VZIP1_4u32(a, b);
+  r2 = #VZIP2_8u16(a, b);
+  r3 = #VZIP2_2u64(a, b);
+  return r0, r1, r2, r3;
+}
+
+export
+fn perm_uzp() -> reg u128, reg u128, reg u128, reg u128 {
+  reg u128 a b r0 r1 r2 r3;
+  a = PERM_IN[0];
+  b = PERM_IN[1];
+  r0 = #VUZP1_16u8(a, b);
+  r1 = #VUZP1_4u32(a, b);
+  r2 = #VUZP2_8u16(a, b);
+  r3 = #VUZP2_2u64(a, b);
+  return r0, r1, r2, r3;
+}
+
+export
+fn move_dup() -> reg u128, reg u128, reg u128, reg u128 {
+  reg u128 a b r0 r1 r2 r3;
+  reg u32 w;
+  reg u64 x;
+  a = PERM_IN[0];
+  b = PERM_IN[1];
+  w = MOVE_W[0];
+  x = MOVE_X[0];
+  r0 = #VDUP_16u8(w);
+  r1 = #VDUP_2u64(x);
+  r2 = #VDUPE_8u16(a, 5);
+  r3 = #VDUPE_4u32(b, 2);
+  return r0, r1, r2, r3;
+}
+
+/* Vd is also an input of INS: each result starts from a fresh copy. */
+export
+fn move_ins() -> reg u128, reg u128, reg u128, reg u128 {
+  reg u128 b r0 r1 r2 r3;
+  reg u32 w;
+  reg u64 x;
+  b = PERM_IN[1];
+  w = MOVE_W[0];
+  x = MOVE_X[0];
+  r0 = PERM_IN[0];
+  r0 = #VINS_4u32(r0, w, 1);
+  r1 = PERM_IN[0];
+  r1 = #VINS_2u64(r1, x, 0);
+  r2 = PERM_IN[0];
+  r2 = #VINSE_16u8(r2, b, 2, 13);
+  r3 = PERM_IN[0];
+  r3 = #VINSE_4u32(r3, b, 1, 3);
+  return r0, r1, r2, r3;
+}
+
+export
+fn move_umov_bh() -> reg u32, reg u32 {
+  reg u128 a b;
+  reg u32 r0 r1;
+  a = PERM_IN[0];
+  b = PERM_IN[1];
+  r0 = #VUMOV_16u8(a, 13);
+  r1 = #VUMOV_8u16(b, 6);
+  return r0, r1;
+}
+
+export
+fn move_umov_sd() -> reg u32, reg u64 {
+  reg u128 a b;
+  reg u32 r0;
+  reg u64 r1;
+  a = PERM_IN[0];
+  b = PERM_IN[1];
+  r0 = #VUMOV_4u32(a, 2);
+  r1 = #VUMOV_2u64(b, 1);
+  return r0, r1;
+}
diff --git a/compiler/tests/success/armv8a/simd_sha2_kat.jazz b/compiler/tests/success/armv8a/simd_sha2_kat.jazz
new file mode 100644
index 00000000..728cc912
--- /dev/null
+++ b/compiler/tests/success/armv8a/simd_sha2_kat.jazz
@@ -0,0 +1,211 @@
+/*
+ * Known-answer test of the SHA-256 and SHA-512 instructions: the SHA-256
+ * and SHA-512 digests of "abc", computed with SHA256H/H2/SU0/SU1 and
+ * SHA512H/H2/SU0/SU1 (tests/exec/exec_armv8a.ml). The message is stored
+ * already padded (FIPS 180-4 5.1), as the bytes of each block in memory
+ * order.
+ */
+
+/* FIPS 180-4 4.2.2, four constants per vector, K[4i] in element 0. */
+u128[16] SHA256_K = {
+  0xe9b5dba5b5c0fbcf71374491428a2f98,
+  0xab1c5ed5923f82a459f111f13956c25b,
+  0x550c7dc3243185be12835b01d807aa98,
+  0xc19bf1749bdc06a780deb1fe72be5d74,
+  0x240ca1cc0fc19dc6efbe4786e49b69c1,
+  0x76f988da5cb0a9dc4a7484aa2de92c6f,
+  0xbf597fc7b00327c8a831c66d983e5152,
+  0x1429296706ca6351d5a79147c6e00bf3,
+  0x53380d134d2c6dfc2e1b213827b70a85,
+  0x92722c8581c2c92e766a0abb650a7354,
+  0xc76c51a3c24b8b70a81a664ba2bfe8a1,
+  0x106aa070f40e3585d6990624d192e819,
+  0x34b0bcb52748774c1e376c0819a4c116,
+  0x682e6ff35b9cca4f4ed8aa4a391c0cb3,
+  0x8cc7020884c8781478a5636f748f82ee,
+  0xc67178f2bef9a3f7a4506ceb90befffa
+};
+
+/* FIPS 180-4 5.3.3: H0..H3 in elements 0..3, then H4..H7. */
+u128[2] SHA256_IV = {
+  0xa54ff53a3c6ef372bb67ae856a09e667,
+  0x5be0cd191f83d9ab9b05688c510e527f
+};
+
+/* FIPS 180-4 4.2.3, two constants per vector, K[2i] in element 0. */
+u128[40] SHA512_K = {
+  0x7137449123ef65cd428a2f98d728ae22,
+  0xe9b5dba58189dbbcb5c0fbcfec4d3b2f,
+  0x59f111f1b605d0193956c25bf348b538,
