 proofs/compiler/armv8a_simd_lemmas.v          | 355 ++++++++++++++++++
 13 files changed, 1253 insertions(+), 83 deletions(-)
 create mode 100644 compiler/tests/exec/exec_armv8a.expected
 create mode 100644 compiler/tests/exec/exec_armv8a.ml
 create mode 100644 compiler/tests/success/armv8a/simd_exec.jazz
 create mode 100644 compiler/tests/success/armv8a/simd_sha2_kat.jazz
 create mode 100644 proofs/compiler/armv8a_simd_lemmas.v

diff --git a/compiler/scripts/check b/compiler/scripts/check
index d2cdf058..89dddfbf 100755
--- a/compiler/scripts/check
+++ b/compiler/scripts/check
@@ -46,6 +46,13 @@ else
     ASARGS="--triple=x86_64"
 fi
 
+# On every armv8a triple: +sha2 enables the SHA-256 instructions and +sha3
+# the SHA-512 ones, both optional (LLVM puts SHA-512 under sha3)
+if [ $ARCH = "armv8a" ]
+then
+    ASARGS="$ASARGS -mattr=+sha2,+sha3"
+fi
+
 llvm-mc $ASARGS --filetype=obj -o ${OBJ} ${ASM}
 
