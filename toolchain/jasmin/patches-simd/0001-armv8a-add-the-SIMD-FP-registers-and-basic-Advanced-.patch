+Let ak_vv := [:: [:: [:: CAxmm ]; [:: CAxmm ] ] ].
+Let ak_vvv := [:: [:: [:: CAxmm ]; [:: CAxmm ]; [:: CAxmm ] ] ].
+Let ak_vv_imm (c : armv8a_caimm_cond) :=
+  [:: [:: [:: CAxmm ]; [:: CAxmm ]; [:: CAimm (Some c) U8 ] ] ].
