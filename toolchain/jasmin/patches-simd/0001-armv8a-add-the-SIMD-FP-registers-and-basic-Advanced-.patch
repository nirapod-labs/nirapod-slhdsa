diff --git a/compiler/tests/success/armv8a/simd_moves.jazz b/compiler/tests/success/armv8a/simd_moves.jazz
new file mode 100644
index 000000000..337829e6d
--- /dev/null
+++ b/compiler/tests/success/armv8a/simd_moves.jazz
@@ -0,0 +1,90 @@
+/* Loads and stores at the encodable address forms. */
+export fn ldst(reg u64 src dst) {
+  reg u128 a b c d;
+  a = [:u128 src + 0];
+  b = [:u128 src + 16];
+  c = [:u128 src + 3];
+  d = [:u128 src - 7];
+  a = a ^ b;
+  [:u128 dst + 0] = a;
+  [:u128 dst + 33] = c;
+  [:u128 dst + 4080] = b;
+  [:u128 dst - 16] = d;
+}
+
+/* Register offset. */
+export fn ldst_reg(reg u64 src dst i) {
+  reg u128 a;
+  a = [:u128 src + i];
+  [:u128 dst + i] = a;
+}
+
+/* Vector arguments and result (V0-V7 in, V0 out). */
+export fn vargs(reg u128 a b c d e f g h) -> reg u128 {
+  reg u128 r;
+  r = a +4u32 b;
+  r = r ^ c;
+  r = r -2u64 d;
+  r = r | e;
+  r = r & !f;
+  r = r +16u8 g;
+  r = r ^ h;
+  return r;
+}
+
+/* Internal call with vector arguments and results. */
+fn inner(reg u128 x y) -> reg u128, reg u128 {
+  reg u128 s t;
+  s = x +2u64 y;
+  t = x ^ y;
+  return s, t;
+}
+
+export fn call_inner(reg u64 p) {
+  reg u128 a b s t;
+  a = [:u128 p + 0];
+  b = [:u128 p + 16];
+  s, t = inner(a, b);
+  [:u128 p + 32] = s;
+  [:u128 p + 48] = t;
+}
+
+/* 30 live vectors: forces the allocator to use V8-V15 (callee-saved). */
+export fn pressure(reg u64 p) {
+  inline int i;
+  reg u128[30] v;
+  reg u128 acc;
+  for i = 0 to 30 { v[i] = [:u128 p + 16 * i]; }
+  for i = 0 to 30 { v[i] = v[i] +4u32 v[(i + 1) % 30]; }
+  acc = v[0];
+  for i = 1 to 30 { acc = acc ^ v[i]; }
+  [:u128 p + 480] = acc;
+  for i = 0 to 30 { [:u128 p + 496 + 16 * i] = v[i]; }
+}
+
+/* Stack-resident vectors and a vector stack array. */
+export fn stackvec(reg u64 p) {
+  inline int i;
+  stack u128[4] s;
+  stack u128 t;
+  reg u128 a b;
+  for i = 0 to 4 { a = [:u128 p + 16 * i]; s[i] = a; }
+  b = s[3];
+  t = b;
+  a = s[0];
+  b = t;
+  a = a +8u16 b;
+  s[1] = a;
+  for i = 0 to 4 { a = s[i]; [:u128 p + 64 + 16 * i] = a; }
+}
+
+/* Explicit spill and reload. */
+export fn spill(reg u64 p) {
+  reg u128 a b;
+  a = [:u128 p + 0];
+  () = #spill(a);
+  b = [:u128 p + 16];
+  () = #unspill(a);
+  a = a ^ b;
+  [:u128 p + 32] = a;
+}
diff --git a/compiler/tests/success/armv8a/simd_ops.jazz b/compiler/tests/success/armv8a/simd_ops.jazz
new file mode 100644
index 000000000..2a569f85b
--- /dev/null
+++ b/compiler/tests/success/armv8a/simd_ops.jazz
@@ -0,0 +1,40 @@
+/* Advanced SIMD operations: lowered source operators and intrinsics. */
+export
+fn simd_ops(reg u64 p) {
+    reg u128 a b c d;
+    a = [:u128 p];
+    b = [:u128 p + 16];
+
+    c = a ^ b;
+    c = c & b;
+    c = c | a;
+    c = c & !b;
+    c = !c;
+    c = c +16u8 a;
+    c = c +8u16 a;
+    c = c +4u32 a;
+    c = c +2u64 a;
+    c = c -16u8 b;
+    c = c -8u16 b;
+    c = c -4u32 b;
+    c = c -2u64 b;
+    c = c <<16u8 7;
+    c = c <<8u16 1;
+    c = c <<4u32 0;
+    c = c >>2u64 64;
+    c = c >>4u32 1;
+
+    d = #VMOV(a);
+    d = #VEOR(d, c);
+    d = #VAND(d, b);
+    d = #VORR(d, b);
+    d = #VBIC(d, a);
+    d = #VNOT(d);
+    d = #VADD_16u8(d, a);
+    d = #VSUB_2u64(d, b);
+    d = #VSHL_8u16(d, 15);
+    d = #VUSHR_16u8(d, 8);
+    d = #VSRI_4u32(d, a, 32);
+    d = #VSLI_2u64(d, b, 63);
+    [:u128 p + 32] = d;
+}
diff --git a/eclib/JModel_armv8a.ec b/eclib/JModel_armv8a.ec
index 37656be9c..a45606c35 100644
--- a/eclib/JModel_armv8a.ec
+++ b/eclib/JModel_armv8a.ec
@@ -299,3 +299,103 @@ op LDP_32 (x: W64.t) : W32.t * W32.t = (x \bits32 0, x \bits32 1).
 op STP_64 (x y: W64.t) : W128.t = W2u64.pack2 [x; y].
 
 op STP_32 (x y: W32.t) : W64.t = W2u32.pack2 [x; y].
+
+(* -------------------------------------------------------------------- *)
+(* Source-level operators on 128-bit vectors (the semantics of the Jasmin
+   operators +NuS, -NuS, *NuS, <<NuS, >>NuS and >>sNuS at u128; the shift
+   amount is a 128-bit word, and a shift by the element size or more gives
+   0, or the sign fill for the arithmetic shift). *)
