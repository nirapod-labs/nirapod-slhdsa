+  move: hw => [?]; subst wres.
+  split; last done.
+  rewrite /sem_pexprs /=.
+  rewrite hseme {hseme} /=.
+  rewrite truncate_word_le // {hws1} /=.
+  rewrite hread {hread} /=.
+  eexists; first reflexivity.
+  by rewrite /exec_sopn /= truncate_word_le.
+Qed.
