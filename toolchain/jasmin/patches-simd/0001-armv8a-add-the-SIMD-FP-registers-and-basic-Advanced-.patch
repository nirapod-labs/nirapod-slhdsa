+   assembly printer. *)
+Definition pp_armv8a_vop
+  (mn : armv8a_mnemonic) (szs : seq wsize) (args : seq asm_arg) : pp_asm_op :=
+  {|
+    pp_aop_name := vasm_name mn;
+    pp_aop_ext := PP_name;
+    pp_aop_args := zip szs args;
+  |}.
