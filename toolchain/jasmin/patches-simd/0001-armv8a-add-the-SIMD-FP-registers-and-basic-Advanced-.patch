+Lemma disj_fvars_read_e_Papp1 op e :
+  disj_fvars (read_e (Papp1 op e)) -> disj_fvars (read_e e).
+Proof. done. Qed.
+
+Lemma is_lnot128P e e' : is_lnot128 e = Some e' -> e = Papp1 (Olnot U128) e'.
+Proof. by case: e => // -[] // -[] // ? [->]. Qed.
+
+(* The shift amount of a vector shift by a constant, given to the
+   instruction as an 8-bit immediate. *)
+Lemma vshift_amount (n : word U128) (ve : velem) :
+  (wunsigned n <=? wsize_bits ve)%Z ->
+  wunsigned (wrepr U8 (wunsigned n)) = wunsigned n.
+Proof.
+  move=> /ZleP h; apply: wunsigned_repr_small.
+  have [h0 _] := wunsigned_range n.
+  by case: ve h => /= h; split => //; apply: (Z.le_lt_trans _ _ _ h).
+Qed.
+
+Lemma lower_vec_PvarP gx : Plower_vec_pexpr (Pvar gx).
+Proof.
+  move=> s ws' aop es w h hws hfvx /= hget.
+  move: h; rewrite /lower_vec_pexpr /lower_vec_Pvar.
+  case: is_var_in_memory => -[? ?]; subst aop es.
+  all: split; last done.
+  all: rewrite /= hget /=; eexists; first reflexivity.
+  all: by rewrite /exec_sopn /= truncate_word_le.
+Qed.
+
+Lemma lower_vec_loadP e :
+  match e with Pload _ _ _ | Pget _ _ _ _ _ => Plower_vec_pexpr e
+  | _ => True end.
+Proof.
