+| XAR.                           (* Exclusive-OR and rotate *)
 
 #[ export ]
 Instance eqTC_armv8a_mnemonic : eqTypeC armv8a_mnemonic :=
@@ -248,6 +254,7 @@ Definition armv8a_mnemonics : seq armv8a_mnemonic :=
     ; VDUP; VDUPE; VINS; VINSE; VUMOV
     ; SHA256H; SHA256H2; SHA256SU0; SHA256SU1
     ; SHA512H; SHA512H2; SHA512SU0; SHA512SU1
+    ; EOR3; BCAX; RAX1; XAR
   ].
 
 Lemma armv8a_mnemonic_fin_axiom : Finite.axiom armv8a_mnemonics.
@@ -449,6 +456,10 @@ Definition string_of_armv8a_mnemonic (mn : armv8a_mnemonic) : string :=
   | SHA512H2 => "SHA512H2"
   | SHA512SU0 => "SHA512SU0"
   | SHA512SU1 => "SHA512SU1"
+  | EOR3 => "EOR3"
