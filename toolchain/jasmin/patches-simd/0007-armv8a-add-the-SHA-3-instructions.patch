 # On every armv8a triple: +sha2 enables the SHA-256 instructions and +sha3
-# the SHA-512 ones, both optional (LLVM puts SHA-512 under sha3)
+# the SHA-512 and SHA-3 ones, all optional (LLVM puts SHA-512 under sha3)
 if [ $ARCH = "armv8a" ]
 then
     ASARGS="$ASARGS -mattr=+sha2,+sha3"
