diff --git a/compiler/tests/success/armv8a/simd_exec.jazz b/compiler/tests/success/armv8a/simd_exec.jazz
index 6c570ffd..93ccfc94 100644
--- a/compiler/tests/success/armv8a/simd_exec.jazz
+++ b/compiler/tests/success/armv8a/simd_exec.jazz
@@ -1,8 +1,9 @@
 /*
- * Fixed-input checks of the Advanced SIMD permutations and element moves,
- * evaluated by tests/exec/exec_armv8a.ml. Byte i of the first input vector
- * is i and byte i of the second is 16 + i, so that every element of a
- * result names the element it comes from.
+ * Fixed-input checks of the Advanced SIMD permutations and element moves
+ * and of the SHA-3 instructions, evaluated by tests/exec/exec_armv8a.ml.
+ * Byte i of the first permutation input is i and byte i of the second is
+ * 16 + i, so that every element of a result names the element it comes
+ * from.
  */
 
 u128[2] PERM_IN = {
@@ -139,3 +140,37 @@ fn move_umov_sd() -> reg u32, reg u64 {
   r1 = #VUMOV_2u64(b, 1);
   return r0, r1;
 }
+
+/* SHA-3 instructions on three unrelated vectors. */
+u128[3] SHA3_IN = {
+  0x0123456789abcdeffedcba9876543210,
+  0x9e3779b97f4a7c15f39cc0605cedc834,
+  0xb7e151628aed2a6abf7158809cf4f3c7
+};
+
+export
+fn sha3_ops() -> reg u128, reg u128, reg u128, reg u128 {
+  reg u128 a b c r0 r1 r2 r3;
+  a = SHA3_IN[0];
+  b = SHA3_IN[1];
+  c = SHA3_IN[2];
+  r0 = #EOR3(a, b, c);
+  r1 = #BCAX(a, b, c);
+  r2 = #RAX1(a, b);
+  r3 = #RAX1(b, a);
+  return r0, r1, r2, r3;
+}
+
+/* XAR rotates right; a rotation by 32 is also one by 32 to the left, so
+   the others tell the direction. */
+export
+fn sha3_xar() -> reg u128, reg u128, reg u128, reg u128 {
+  reg u128 a b r0 r1 r2 r3;
+  a = SHA3_IN[0];
+  b = SHA3_IN[1];
+  r0 = #XAR(a, b, 1);
+  r1 = #XAR(a, b, 7);
+  r2 = #XAR(a, b, 32);
+  r3 = #XAR(a, b, 63);
+  return r0, r1, r2, r3;
+}
diff --git a/compiler/tests/success/armv8a/simd_sha3.jazz b/compiler/tests/success/armv8a/simd_sha3.jazz
new file mode 100644
index 00000000..9ffc12f8
--- /dev/null
+++ b/compiler/tests/success/armv8a/simd_sha3.jazz
@@ -0,0 +1,14 @@
+/* The SHA-3 cryptographic-extension instructions; XAR at both ends of its range. */
+export
+fn simd_sha3(reg u64 p) {
+    reg u128 a b c d e;
+    a = [:u128 p];
+    b = [:u128 p + 16];
+    c = [:u128 p + 32];
+    d = #EOR3(a, b, c);
+    e = #RAX1(d, a);
+    e = #XAR(e, b, 63);
+    e = #XAR(e, c, 0);
+    e = #BCAX(e, a, b);
+    [:u128 p + 48] = e;
+}
diff --git a/eclib/JModel_armv8a.ec b/eclib/JModel_armv8a.ec
index d3487ca4..9aad20a6 100644
--- a/eclib/JModel_armv8a.ec
+++ b/eclib/JModel_armv8a.ec
@@ -669,3 +669,15 @@ op SHA512SU0 (d n: W128.t) : W128.t =
 op SHA512SU1 (d n m: W128.t) : W128.t =
   W2u64.pack2 [(d \bits64 0) + sha512sigma1 (n \bits64 0) + (m \bits64 0);
                (d \bits64 1) + sha512sigma1 (n \bits64 1) + (m \bits64 1)].
+
+(* -------------------------------------------------------------------- *)
+(* SHA-3 (FEAT_SHA3). *)
+
+op EOR3 (n m a: W128.t) : W128.t = n +^ m +^ a.
+
+op BCAX (n m a: W128.t) : W128.t = n +^ (m `&` invw a).
+
+op RAX1 (n m: W128.t) : W128.t = n +^ W2u64.map (fun (e: W64.t) => e `|<<<|` 1) m.
+
+op XAR (n m: W128.t) (imm: W8.t) : W128.t =
+  W2u64.map (fun (e: W64.t) => e `|>>>|` to_uint imm) (n +^ m).
diff --git a/proofs/compiler/armv8a_decl.v b/proofs/compiler/armv8a_decl.v
index 67624fec..12d049c3 100644
