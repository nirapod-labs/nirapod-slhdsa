+Definition vuzp (ve : wsize) (part : nat) (a b : u128) : u128 :=
+  let zipped := split_vec ve a ++ split_vec ve b in
+  make_vec U128
+    [seq nth (wrepr ve 0) zipped (2 * e + part) | e <- iota 0 (velems ve) ].
