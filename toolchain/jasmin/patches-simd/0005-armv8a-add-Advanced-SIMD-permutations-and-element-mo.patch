--- /dev/null
+++ b/compiler/tests/fail/asmgen/armv8a/vins_index_range.jazz
@@ -0,0 +1,10 @@
+/* A 4S vector has elements 0 to 3. */
+export
+fn vins_index_range(reg u64 p) {
+    reg u128 a;
+    reg u32 w;
+    a = [:u128 p];
+    w = [:u32 p + 16];
+    a = #VINS_4u32(a, w, 4);
+    [:u128 p] = a;
+}
diff --git a/compiler/tests/fail/asmgen/armv8a/vinse_index_range.jazz b/compiler/tests/fail/asmgen/armv8a/vinse_index_range.jazz
new file mode 100644
index 00000000..410b8ca0
--- /dev/null
+++ b/compiler/tests/fail/asmgen/armv8a/vinse_index_range.jazz
@@ -0,0 +1,10 @@
+/* Both indices of a 16B vector are in [0, 15]: here the second one, the
+   source element, is not. */
+export
+fn vinse_index_range(reg u64 p) {
+    reg u128 a b;
+    a = [:u128 p];
+    b = [:u128 p + 16];
+    a = #VINSE_16u8(a, b, 0, 16);
+    [:u128 p] = a;
+}
diff --git a/compiler/tests/fail/asmgen/armv8a/vumov_index_range.jazz b/compiler/tests/fail/asmgen/armv8a/vumov_index_range.jazz
