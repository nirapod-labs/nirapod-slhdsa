+Definition vtrn (ve : wsize) (part : nat) (a b : u128) : u128 :=
+  let pairs := (velems ve %/ 2)%nat in
+  make_vec U128
+    (flatten [seq [:: velem_at ve a (2 * p + part); velem_at ve b (2 * p + part) ]
+             | p <- iota 0 pairs ]).
