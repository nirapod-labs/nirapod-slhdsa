+Definition vzip (ve : wsize) (part : nat) (a b : u128) : u128 :=
+  let pairs := (velems ve %/ 2)%nat in
+  let base := (part * pairs)%nat in
+  make_vec U128
+    (flatten [seq [:: velem_at ve a (base + p); velem_at ve b (base + p) ]
+             | p <- iota 0 pairs ]).
