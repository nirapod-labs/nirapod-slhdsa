diff --git a/compiler/tests/success/armv8a/simd_sha3.jazz b/compiler/tests/success/armv8a/simd_sha3.jazz
new file mode 100644
index 000000000..295210318
--- /dev/null
+++ b/compiler/tests/success/armv8a/simd_sha3.jazz
@@ -0,0 +1,14 @@
+/* SHA-3 cryptographic-extension instructions on two Keccak lanes per register. */
+export
+fn simd_sha3(reg u64 p) {
+    reg u128 a b c d e;
+    a = [:u128 p];
+    b = [:u128 p + 16];
+    c = [:u128 p + 32];
+    d = #EOR3(a, b, c);
+    e = #RAX1(d, a);
+    e = #XAR(e, b, 63);
+    e = #XAR(e, c, 0);
+    e = #BCAX(e, a, b);
+    [:u128 p + 48] = e;
+}
diff --git a/eclib/JModel_armv8a.ec b/eclib/JModel_armv8a.ec
index fc4d802c6..9863eaca7 100644
--- a/eclib/JModel_armv8a.ec
+++ b/eclib/JModel_armv8a.ec
@@ -488,3 +488,15 @@ op SHA512SU0 (d n: W128.t) : W128.t =
 op SHA512SU1 (d n m: W128.t) : W128.t =
   W2u64.pack2 [(d \bits64 0) + sha512sigma1 (n \bits64 0) + (m \bits64 0);
                (d \bits64 1) + sha512sigma1 (n \bits64 1) + (m \bits64 1)].
+
+(* -------------------------------------------------------------------- *)
+(* SHA-3 (FEAT_SHA3). *)
+
+op EOR3 (n m a: W128.t) : W128.t = n +^ m +^ a.
+
+op BCAX (n m a: W128.t) : W128.t = n +^ (m `&` invw a).
+
+op RAX1 (n m: W128.t) : W128.t = n +^ W2u64.map (fun (e: W64.t) => e `|<<<|` 1) m.
+
+op XAR (n m: W128.t) (imm: W8.t) : W128.t =
+  W2u64.map (fun (e: W64.t) => e `|>>>|` to_uint imm) (n +^ m).
diff --git a/proofs/compiler/armv8a_decl.v b/proofs/compiler/armv8a_decl.v
index 915895a55..7fdf44617 100644
--- a/proofs/compiler/armv8a_decl.v
+++ b/proofs/compiler/armv8a_decl.v
@@ -338,7 +338,8 @@ Notation xregister := vregister.
    The Advanced SIMD conditions carry the element size [esize] of the
    arrangement:
    - [CAimmC_armv8a_vshl esize]: a left shift amount (SHL, SLI) in
-     [0, esize - 1] (SHL (vector), operand description).
+     [0, esize - 1] (SHL (vector), operand description); with [esize = 64],
+     also the rotation of XAR, encoded in the 6-bit field imm6.
    - [CAimmC_armv8a_vshr esize]: a right shift amount (USHR, SRI) in
      [1, esize] (USHR (vector), operand description). *)
 #[only(eqbOK)] derive
diff --git a/proofs/compiler/armv8a_instr_decl.v b/proofs/compiler/armv8a_instr_decl.v
index 41c5bdfe5..4a3c7d327 100644
--- a/proofs/compiler/armv8a_instr_decl.v
+++ b/proofs/compiler/armv8a_instr_decl.v
@@ -198,7 +198,13 @@ Variant armv8a_mnemonic : Type :=
 | SHA512H                        (* SHA-512 hash update, part 1 *)
 | SHA512H2                       (* SHA-512 hash update, part 2 *)
 | SHA512SU0                      (* SHA-512 schedule update 0 *)
-| SHA512SU1.                     (* SHA-512 schedule update 1 *)
+| SHA512SU1                      (* SHA-512 schedule update 1 *)
+
+(* Cryptographic extension: SHA-3 (FEAT_SHA3). *)
+| EOR3                           (* Three-way exclusive-OR *)
+| BCAX                           (* Bit clear and exclusive-OR *)
+| RAX1                           (* Rotate and exclusive-OR *)
+| XAR.                           (* Exclusive-OR and rotate *)
 
 #[ export ]
 Instance eqTC_armv8a_mnemonic : eqTypeC armv8a_mnemonic :=
@@ -226,6 +232,7 @@ Definition armv8a_mnemonics : seq armv8a_mnemonic :=
     ; VSHL; VUSHR; VSRI; VSLI
     ; SHA256H; SHA256H2; SHA256SU0; SHA256SU1
     ; SHA512H; SHA512H2; SHA512SU0; SHA512SU1
+    ; EOR3; BCAX; RAX1; XAR
   ].
 
 Lemma armv8a_mnemonic_fin_axiom : Finite.axiom armv8a_mnemonics.
@@ -411,6 +418,10 @@ Definition string_of_armv8a_mnemonic (mn : armv8a_mnemonic) : string :=
   | SHA512H2 => "SHA512H2"
   | SHA512SU0 => "SHA512SU0"
   | SHA512SU1 => "SHA512SU1"
+  | EOR3 => "EOR3"
+  | BCAX => "BCAX"
+  | RAX1 => "RAX1"
+  | XAR => "XAR"
   end%string.
 
 (* Assembly mnemonic of the Advanced SIMD instructions. *)
@@ -444,6 +455,8 @@ Definition vector_esizes (mn : armv8a_mnemonic) : seq wsize :=
   | VADD | VSUB | VSHL | VUSHR | VSRI | VSLI => [:: U8; U16; U32; U64 ]
   | SHA256H | SHA256H2 | SHA256SU0 | SHA256SU1 => [:: U32 ]
   | SHA512H | SHA512H2 | SHA512SU0 | SHA512SU1 => [:: U64 ]
+  | EOR3 | BCAX => [:: U8 ]
+  | RAX1 | XAR => [:: U64 ]
   | _ => [::]
   end.
 
@@ -3524,6 +3537,100 @@ Definition armv8a_SHA512SU1_semi (wd wn wm : word U128) : ty_v :=
 Definition armv8a_SHA512SU1_instr : instr_desc_t :=
   mk_v3d_instr SHA512SU1 [:: U64; U64; U64 ] armv8a_SHA512SU1_semi.
 
+
+(* -------------------------------------------------------------------- *)
+(* SHA-3. EOR3 and BCAX use the 16B arrangement, RAX1 and XAR the 2D one. *)
+
+Let ak_vvvv := [:: [:: [:: CAxmm ]; [:: CAxmm ]; [:: CAxmm ]; [:: CAxmm ] ] ].
+Let ak_vvv_imm (c : armv8a_caimm_cond) :=
+  [:: [:: [:: CAxmm ]; [:: CAxmm ]; [:: CAxmm ]; [:: CAimm (Some c) U8 ] ] ].
+
+(* Three vector sources. *)
+Definition mk_v3_instr mn (semi : word U128 -> word U128 -> word U128 -> ty_v) : instr_desc_t :=
+  let tin := [:: lvec; lvec; lvec ] in
+  {|
+    id_msb_flag := MSB_CLEAR;
+    id_tin := tin;
+    id_in := [:: Ea 1; Ea 2; Ea 3 ];
+    id_tout := [:: lvec ];
+    id_out := [:: Ea 0 ];
+    id_semi_total := semi;
+    id_nargs := 4;
+    id_args_kinds := ak_vvvv;
+    id_eq_size := refl_equal;
+    id_check_dest := refl_equal;
+    id_str_jas := armv8a_mn_str mn;
+    id_safe := [::];
+    id_err := ErrSemUndef;
+    id_init := [:: IBool true ];
+    id_doit := DOIT;
+    id_pp_asm := pp_armv8a_vop mn [:: esize; esize; esize; esize ];
+    id_valid := vvalid mn;
+    id_safe_wf := refl_equal;
+    id_wf := refl_equal;
+  |}.
+
+(* Two vector sources and an immediate. *)
+Definition mk_v2_imm_instr mn (c : armv8a_caimm_cond)
+  (semi : word U128 -> word U128 -> word U8 -> ty_v) : instr_desc_t :=
+  let tin := [:: lvec; lvec; lword U8 ] in
+  {|
+    id_msb_flag := MSB_CLEAR;
+    id_tin := tin;
+    id_in := [:: Ea 1; Ea 2; Ea 3 ];
+    id_tout := [:: lvec ];
+    id_out := [:: Ea 0 ];
+    id_semi_total := semi;
+    id_nargs := 4;
+    id_args_kinds := ak_vvv_imm c;
+    id_eq_size := refl_equal;
+    id_check_dest := refl_equal;
+    id_str_jas := armv8a_mn_str mn;
+    id_safe := [::];
+    id_err := ErrSemUndef;
+    id_init := [:: IBool true ];
+    id_doit := DOIT;
+    id_pp_asm := pp_armv8a_vop mn [:: esize; esize; esize; U8 ];
+    id_valid := vvalid mn;
+    id_safe_wf := refl_equal;
+    id_wf := refl_equal;
+  |}.
+
+(* [EOR3] ARM DDI 0602 2026-03
+   Syntax: EOR3 <Vd>.16B, <Vn>.16B, <Vm>.16B, <Va>.16B
+   Semantics: bitwise Vn XOR Vm XOR Va. *)
+Definition armv8a_EOR3_semi (wn wm wa : word U128) : ty_v :=
+  wxor (wxor wn wm) wa.
+
+Definition armv8a_EOR3_instr : instr_desc_t := mk_v3_instr EOR3 armv8a_EOR3_semi.
+
+(* [BCAX] ARM DDI 0602 2026-03
+   Syntax: BCAX <Vd>.16B, <Vn>.16B, <Vm>.16B, <Va>.16B
+   Semantics: bitwise Vn XOR (Vm AND NOT Va). *)
+Definition armv8a_BCAX_semi (wn wm wa : word U128) : ty_v :=
+  wxor wn (wand wm (wnot wa)).
+
+Definition armv8a_BCAX_instr : instr_desc_t := mk_v3_instr BCAX armv8a_BCAX_semi.
+
+(* [RAX1] ARM DDI 0602 2026-03
+   Syntax: RAX1 <Vd>.2D, <Vn>.2D, <Vm>.2D
+   Semantics: Vn XOR Vm with each 64-bit element of Vm first rotated left
+   by one. *)
+Definition armv8a_RAX1_semi (wn wm : word U128) : ty_v := rax1 wn wm.
+
+Definition armv8a_RAX1_instr : instr_desc_t := mk_v2_instr RAX1 armv8a_RAX1_semi.
+
+(* [XAR] ARM DDI 0602 2026-03
+   Syntax: XAR <Vd>.2D, <Vn>.2D, <Vm>.2D, #<imm6>
+   The immediate is a right rotation in [0, 63].
+   Semantics: each 64-bit element of Vn XOR Vm rotated right by the
+   immediate. *)
+Definition armv8a_XAR_semi (wn wm : word U128) (imm : word U8) : ty_v :=
+  xar wn wm (wunsigned imm).
+
+Definition armv8a_XAR_instr : instr_desc_t :=
+  mk_v2_imm_instr XAR (CAimmC_armv8a_vshl U64) armv8a_XAR_semi.
+
 (* -------------------------------------------------------------------- *)
 (* Description of instructions. *)
 
@@ -3625,6 +3732,10 @@ Definition mn_desc (mn : armv8a_mnemonic) : instr_desc_t :=
   | SHA512H2 => armv8a_SHA512H2_instr
   | SHA512SU0 => armv8a_SHA512SU0_instr
   | SHA512SU1 => armv8a_SHA512SU1_instr
+  | EOR3 => armv8a_EOR3_instr
+  | BCAX => armv8a_BCAX_instr
+  | RAX1 => armv8a_RAX1_instr
+  | XAR => armv8a_XAR_instr
   end.
 
 End ARMV8A_INSTR.
diff --git a/proofs/compiler/armv8a_simd.v b/proofs/compiler/armv8a_simd.v
index 1378ff6e3..7ce466967 100644
--- a/proofs/compiler/armv8a_simd.v
+++ b/proofs/compiler/armv8a_simd.v
@@ -173,3 +173,15 @@ Definition sha512su1 (w x y : u128) : u128 :=
   let y0 := velem_at U64 y 0 in let y1 := velem_at U64 y 1 in
   let w0 := velem_at U64 w 0 in let w1 := velem_at U64 w 1 in
   make_vec U128 [:: w0 + sha512_sigma1 x0 + y0; w1 + sha512_sigma1 x1 + y1 ].
+
+(* -------------------------------------------------------------------- *)
+(* SHA-3 (FEAT_SHA3). *)
+
+(* RAX1: [n] XOR [m], each 64-bit element of [m] first rotated left by
+   one. *)
+Definition rax1 (n m : u128) : u128 :=
+  wxor n (lift1_vec U64 (fun x => wrol x 1) U128 m).
+
+(* XAR: each 64-bit element of [n] XOR [m] rotated right by [imm]. *)
+Definition xar (n m : u128) (imm : Z) : u128 :=
+  lift1_vec U64 (fun x => wror x imm) U128 (wxor n m).
diff --git a/proofs/compiler/armv8a_simd_facts.v b/proofs/compiler/armv8a_simd_facts.v
index 1e9d9079e..94850565a 100644
--- a/proofs/compiler/armv8a_simd_facts.v
+++ b/proofs/compiler/armv8a_simd_facts.v
@@ -15,6 +15,7 @@
      SHA512SU1 compute two message-schedule words;
    - the [*_instr_*] lemmas: the same statements about the [id_semi] of the
      instruction descriptions, which fix the role of each operand;
+   - [xar_rolE]: XAR by 64 - r is a left rotation by r of the XOR.
    These are statements about the semantics as transcribed; they do not
    validate the transcription against the hardware (the differential and
    known-answer tests do that). *)
@@ -368,3 +369,20 @@ Proof.
 Qed.
 
 End INSTR.
+
+(* -------------------------------------------------------------------- *)
+(* SHA-3: the Keccak-f[1600] steps of FIPS 202, 3.2, on two lanes per
+   register. With C[x] the column parities of θ and A the state:
+     θ:   D[x] = C[x - 1] XOR ROT(C[x + 1], 1)   = RAX1(C[x - 1], C[x + 1])
+     θ+ρ: ROT(A[x, y] XOR D[x], r)              = XAR(A[x, y], D[x], 64 - r)
+     χ:   A[x] XOR (NOT A[x + 1] AND A[x + 2])  = BCAX(A[x], A[x + 2], A[x + 1])
+   and the parities are folded with EOR3. The rotation of ρ is a left
+   rotation; XAR rotates right, by 64 - r. This correspondence is informal:
+   only the rotation identity below is proved here. *)
+
+Lemma xar_rolE (n m : u128) (r : Z) :
+  xar n m (64 - r) = lift1_vec U64 (fun x => wrol x r) U128 (wxor n m).
+Proof.
+  rewrite /xar /lift1_vec /lift1_vec'; congr make_vec.
+  by apply: eq_map => x; exact: (wror_opp x r).
+Qed.
