+- armv8a: add the SHA-3 instructions EOR3, BCAX, RAX1 and XAR.
diff --git a/compiler/tests/fail/asmgen/armv8a/xar_rotation_range.jazz b/compiler/tests/fail/asmgen/armv8a/xar_rotation_range.jazz
new file mode 100644
index 000000000..28431179c
--- /dev/null
+++ b/compiler/tests/fail/asmgen/armv8a/xar_rotation_range.jazz
@@ -0,0 +1,9 @@
+/* XAR rotates by at most 63. */
+export
+fn xar_rotation_range(reg u64 p) {
+    reg u128 a b;
+    a = [:u128 p];
+    b = [:u128 p + 16];
+    a = #XAR(a, b, 64);
+    [:u128 p] = a;
+}
