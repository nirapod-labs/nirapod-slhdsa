new file mode 100644
index 000000000..429365e32
--- /dev/null
+++ b/compiler/tests/success/armv8a/simd_sha2.jazz
@@ -0,0 +1,49 @@
+/* SHA-256 and SHA-512 cryptographic-extension instructions. */
+export
+fn simd_sha256(reg u64 p) {
+    reg u128 abcd efgh wk w0 w1 w2 w3 t;
+    abcd = [:u128 p];
+    efgh = [:u128 p + 16];
+    w0 = [:u128 p + 32];
+    w1 = [:u128 p + 48];
+    w2 = [:u128 p + 64];
+    w3 = [:u128 p + 80];
+    wk = w0 +4u32 w1;
+    t = abcd;
+    abcd = #SHA256H(abcd, efgh, wk);
+    efgh = #SHA256H2(efgh, t, wk);
+    w0 = #SHA256SU0(w0, w1);
+    w0 = #SHA256SU1(w0, w2, w3);
+    [:u128 p] = abcd;
+    [:u128 p + 16] = efgh;
+    [:u128 p + 32] = w0;
+}
+
+/* Two SHA-512 rounds and two schedule words, in the operand layout of
+   SHA512H_H2_rounds: (a, b), (c, d), (e, f), (g, h) with the first element
+   in element 0; wk holds (K_t + W_t, K_t+1 + W_t+1). */
+export
+fn simd_sha512(reg u64 p) {
+    reg u128 ab cd ef gh wk fg de ef2 w0 w1 w9 w14;
+    ab = [:u128 p];
+    cd = [:u128 p + 16];
+    ef = [:u128 p + 32];
+    gh = [:u128 p + 48];
+    wk = [:u128 p + 64];
+    w0 = [:u128 p + 80];
+    w1 = [:u128 p + 96];
+    w9 = [:u128 p + 112];
+    w14 = [:u128 p + 128];
+    fg = #VEXT(ef, gh, 8);
+    wk = #VEXT(wk, wk, 8);
+    de = #VEXT(cd, ef, 8);
+    gh = gh +2u64 wk;
+    gh = #SHA512H(gh, fg, de);
+    ef2 = cd +2u64 gh;
+    gh = #SHA512H2(gh, cd, ab);
+    w0 = #SHA512SU0(w0, w1);
+    w0 = #SHA512SU1(w0, w14, w9);
+    [:u128 p] = gh;
+    [:u128 p + 16] = ef2;
+    [:u128 p + 32] = w0;
+}
