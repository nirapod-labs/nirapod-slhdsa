+
+/*
+ * One SHA-256 block. abcd holds (A, B, C, D) in lanes 0..3 and efgh holds
+ * (E, F, G, H). Each iteration performs four rounds: SHA256H updates
+ * (A..D) and SHA256H2 updates (E..H) from the same W+K vector, and
+ * SHA256SU0/SU1 compute the next four schedule words in place.
+ */
+inline
+fn sha256_block(reg u128 abcd efgh, reg u128 m0 m1 m2 m3) -> reg u128, reg u128 {
+  reg u128 abcd0 efgh0 wk t;
+  inline int i;
+  abcd0 = abcd;
+  efgh0 = efgh;
+  m0 = #VREV32_16u8(m0);
+  m1 = #VREV32_16u8(m1);
+  m2 = #VREV32_16u8(m2);
+  m3 = #VREV32_16u8(m3);
+  for i = 0 to 16 {
+    wk = SHA256_K[i];
+    wk = wk +4u32 m0;
+    t = abcd;
+    abcd = #SHA256H(abcd, efgh, wk);
+    efgh = #SHA256H2(efgh, t, wk);
+    if (i < 12) {
+      m0 = #SHA256SU0(m0, m1);
+      m0 = #SHA256SU1(m0, m2, m3);
+    }
+    t = m0; m0 = m1; m1 = m2; m2 = m3; m3 = t;
+  }
+  abcd = abcd +4u32 abcd0;
+  efgh = efgh +4u32 efgh0;
+  return abcd, efgh;
+}
+
+/*
+ * One SHA-512 block, two rounds per iteration. ab, cd, ef, gh hold
+ * (A, B), (C, D), (E, F), (G, H), first element in lane 0. SHA512H takes
+ * the W+K pair added to (G, H) with its lanes swapped, (F, G) and (D, E);
+ * its result plus (C, D) is the next (E, F)-register, and SHA512H2 then
+ * forms the next (A, B)-register from it, (C, D) and (A, B).
+ */
+inline
+fn sha512_block(reg u128 ab cd ef gh, reg u128 m0 m1 m2 m3 m4 m5 m6 m7)
+  -> reg u128, reg u128, reg u128, reg u128 {
+  reg u128 ab0 cd0 ef0 gh0 wk fg de s t;
+  inline int i;
+  ab0 = ab; cd0 = cd; ef0 = ef; gh0 = gh;
+  m0 = #VREV64_16u8(m0); m1 = #VREV64_16u8(m1);
+  m2 = #VREV64_16u8(m2); m3 = #VREV64_16u8(m3);
+  m4 = #VREV64_16u8(m4); m5 = #VREV64_16u8(m5);
+  m6 = #VREV64_16u8(m6); m7 = #VREV64_16u8(m7);
+  for i = 0 to 40 {
+    wk = SHA512_K[i];
+    wk = wk +2u64 m0;
+    fg = #VEXT(ef, gh, 8);
+    wk = #VEXT(wk, wk, 8);
+    de = #VEXT(cd, ef, 8);
+    gh = gh +2u64 wk;
+    if (i < 32) {
+      s = #VEXT(m4, m5, 8);
+      m0 = #SHA512SU0(m0, m1);
+      m0 = #SHA512SU1(m0, m7, s);
+    }
+    gh = #SHA512H(gh, fg, de);
+    t = cd +2u64 gh;
+    gh = #SHA512H2(gh, cd, ab);
+    /* (A..H) rotate by two: gh is the new (A, B), t the new (E, F). */
+    s = ab; ab = gh; gh = ef; ef = t; cd = s;
+    s = m0; m0 = m1; m1 = m2; m2 = m3; m3 = m4; m4 = m5; m5 = m6; m6 = m7; m7 = s;
+  }
+  ab = ab +2u64 ab0; cd = cd +2u64 cd0;
+  ef = ef +2u64 ef0; gh = gh +2u64 gh0;
+  return ab, cd, ef, gh;
+}
+
+export
+fn sha256_empty() -> reg u128, reg u128 {
+  reg u128 abcd efgh m0 m1 m2 m3;
+  abcd = SHA256_IV[0];
+  efgh = SHA256_IV[1];
+  m0 = SHA256_MSG_EMPTY[0];
+  m1 = SHA256_MSG_EMPTY[1];
+  m2 = SHA256_MSG_EMPTY[2];
+  m3 = SHA256_MSG_EMPTY[3];
+  abcd, efgh = sha256_block(abcd, efgh, m0, m1, m2, m3);
+  return abcd, efgh;
+}
+
+export
+fn sha256_abc() -> reg u128, reg u128 {
+  reg u128 abcd efgh m0 m1 m2 m3;
+  abcd = SHA256_IV[0];
+  efgh = SHA256_IV[1];
+  m0 = SHA256_MSG_ABC[0];
+  m1 = SHA256_MSG_ABC[1];
+  m2 = SHA256_MSG_ABC[2];
+  m3 = SHA256_MSG_ABC[3];
+  abcd, efgh = sha256_block(abcd, efgh, m0, m1, m2, m3);
+  return abcd, efgh;
+}
+
+export
+fn sha256_two_block256() -> reg u128, reg u128 {
+  reg u128 abcd efgh m0 m1 m2 m3;
