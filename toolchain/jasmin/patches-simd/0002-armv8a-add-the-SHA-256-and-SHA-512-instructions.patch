--- /dev/null
+++ b/compiler/tests/exec/exec_armv8a.ml
@@ -0,0 +1,50 @@
+(* Evaluation of armv8a programs with the semantics of the compiler, as in
+   exec.ml for x86-64. *)
+open Jasmin
+
+module Arch : Arch_full.Arch =
+  (val CoreArchFactory.get_arch_module Utils.ARMv8A Glob_options.Linux)
+
+let load_file name =
+  let prog =
+    let open Pretyping in
+    try
+      name
+      |> tt_file Arch.arch_info Env.empty None None
+      |> fst |> Env.decls
+      |> Compile.preprocess Arch.pointer_data Arch.msf_size Arch.asmOp
+    with TyError (loc, e) ->
+      Format.eprintf "%a: %a@." Location.pp_loc loc pp_tyerror e;
+      assert false
+  in
+  let fs = Hashtbl.create 17 in
+  List.iter
+    (fun { Prog.f_name; _ } -> Hashtbl.add fs f_name.fn_name f_name)
+    (snd prog);
+  (fs, Conv.cuprog_of_prog prog)
+
+let exec (fs, prog) f =
+  let f = Hashtbl.find fs f in
+  let m =
+    match Evaluator.initial_memory Arch.reg_size (Z.of_int 1024) [] with
+    | Utils0.Error _ -> assert false
+    | Utils0.Ok m -> m
+  in
+  let pp_vals = Utils.pp_list "; " Evaluator.pp_val in
+  match
+    Evaluator.run (module Arch) (Expr.to_uprog Arch.asmOp prog)
+      IInfo.dummy f [] m
+  with
+  | _, res -> Format.printf "%s() = %a@." f.fn_name pp_vals res
+  | exception Evaluator.Eval_error (_, err) ->
+      Format.printf "%s() failed with %a@." f.fn_name Evaluator.pp_error err
+
+(* SHA-256 and SHA-512 digests of FIPS 180-4 example messages, computed with
+   the SHA-2 instructions; the expected values are the published digests,
+   as (H0..H3), (H4..H7) for SHA-256 and (H0, H1)..(H6, H7) for SHA-512,
+   first word in the low bits. *)
+let () =
+  let prog = load_file "../success/armv8a/simd_sha2_kat.jazz" in
+  List.iter (exec prog)
+    [ "sha256_empty"; "sha256_abc"; "sha256_two_block256";
+      "sha512_empty"; "sha512_abc"; "sha512_two_block512" ]
