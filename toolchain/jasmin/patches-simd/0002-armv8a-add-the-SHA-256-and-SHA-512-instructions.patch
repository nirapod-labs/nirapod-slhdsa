+  0x00000000000000000000000000000000,
+  0x00000000000000000000000000000000,
+  0x00000000000000000000000000000000,
+  0x00000000000000000000000000000000,
+  0x00000000000000000000000000000000,
+  0x18000000000000000000000000000000
+};
+
+/* SHA512, padded: "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu" */
+u128[16] SHA512_MSG_TWO_BLOCK512 = {
+  0x69686766656463626867666564636261,
+  0x6b6a6968676665646a69686766656463,
+  0x6d6c6b6a696867666c6b6a6968676665,
+  0x6f6e6d6c6b6a69686e6d6c6b6a696867,
+  0x71706f6e6d6c6b6a706f6e6d6c6b6a69,
+  0x737271706f6e6d6c7271706f6e6d6c6b,
+  0x7574737271706f6e74737271706f6e6d,
+  0x00000000000000000000000000000080,
+  0x00000000000000000000000000000000,
+  0x00000000000000000000000000000000,
+  0x00000000000000000000000000000000,
+  0x00000000000000000000000000000000,
+  0x00000000000000000000000000000000,
+  0x00000000000000000000000000000000,
+  0x00000000000000000000000000000000,
+  0x80030000000000000000000000000000
+};
