+  | SHA256SU1 => armv8a_SHA256SU1_instr
+  | SHA512H => armv8a_SHA512H_instr
+  | SHA512H2 => armv8a_SHA512H2_instr
+  | SHA512SU0 => armv8a_SHA512SU0_instr
+  | SHA512SU1 => armv8a_SHA512SU1_instr
   end.
 
 End ARMV8A_INSTR.
