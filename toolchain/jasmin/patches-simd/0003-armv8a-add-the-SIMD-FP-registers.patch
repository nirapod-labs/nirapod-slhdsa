diff --git a/compiler/tests/fail/register_allocation/armv8a/syscall_live_u128.jazz b/compiler/tests/fail/register_allocation/armv8a/syscall_live_u128.jazz
new file mode 100644
index 00000000..66e32ccd
--- /dev/null
+++ b/compiler/tests/fail/register_allocation/armv8a/syscall_live_u128.jazz
@@ -0,0 +1,13 @@
+/* A syscall is not assumed to preserve the vector registers: [a] cannot stay
+   in v8-v15 across it (AAPCS64 preserves only their low 64 bits), and there
+   is no other register for it. */
+export fn syscall_live_u128(reg ptr u8[48] io) -> reg ptr u8[48] {
+  stack u8[16] r;
+  reg u128 a b;
+  a = io[:u128 0];
+  r = #randombytes(r);
+  b = r[:u128 0];
+  io[:u128 1] = a;
+  io[:u128 2] = b;
+  return io;
+}
diff --git a/compiler/tests/fail/register_allocation/armv8a/u256_reg.jazz b/compiler/tests/fail/register_allocation/armv8a/u256_reg.jazz
