diff --git a/changes/01-feature/armv8a-advanced-simd.md b/changes/01-feature/armv8a-advanced-simd.md
index 812b708c2..85bc5aeb4 100644
--- a/changes/01-feature/armv8a-advanced-simd.md
+++ b/changes/01-feature/armv8a-advanced-simd.md
@@ -6,3 +6,5 @@
 - armv8a: add the SHA-256 and SHA-512 instructions SHA256H, SHA256H2,
   SHA256SU0, SHA256SU1, SHA512H, SHA512H2, SHA512SU0 and SHA512SU1.
 - armv8a: add the SHA-3 instructions EOR3, BCAX, RAX1 and XAR.
+- armv8a: add the Advanced SIMD permutations and element moves EXT, REV32,
+  REV64, TRN1, TRN2, ZIP1, ZIP2, UZP1, UZP2, DUP, INS and UMOV.
diff --git a/compiler/src/pp_arm_v8a.ml b/compiler/src/pp_arm_v8a.ml
index 400dd1505..84a1af6c6 100644
--- a/compiler/src/pp_arm_v8a.ml
+++ b/compiler/src/pp_arm_v8a.ml
@@ -81,6 +81,20 @@ let pp_vregister (sz : Wsize.wsize) (r : vregister) =
       hierror ~loc:Lnone ~kind:"assembly printing" ~internal:true
         "no 256-bit view of a SIMD&FP register"
 
+(* A vector element operand [Vn.Ts[index]], for the element size [sz]. *)
+let pp_velement (sz : Wsize.wsize) (r : vregister) index =
+  let ts =
+    match sz with
+    | Wsize.U8 -> "b"
+    | Wsize.U16 -> "h"
+    | Wsize.U32 -> "s"
+    | Wsize.U64 -> "d"
+    | _ ->
+        hierror ~loc:Lnone ~kind:"assembly printing" ~internal:true
+          "no vector element of this size"
+  in
+  Format.asprintf "%s.%s[%s]" (pp_vregister_name r) ts (Z.to_string index)
+
 (* A64 has no conditional execution: a condition is always a proper operand
    (CSEL, CSET, ...), declared last in the argument list, so it is printed
    in place like any other operand. *)
@@ -262,6 +276,33 @@ module Armv8aTarget : AsmTargetBuilder.AsmTarget with
               | MOVZ | MOVN | MOVK -> pp_mov_wide_shift pargs
               | _ -> pp_shift op pargs
             in
+            (* The element operands of DUP (element), INS and UMOV: the
+               description gives the register, paired with the element
+               size, followed by the index (see armv8a_instr_decl.v). *)
+            let index = function
+              | (_, Imm (ws, w)) -> Conv.z_unsigned_of_word ws w
+              | _ ->
+                  hierror ~loc:Lnone ~kind:"assembly printing" ~internal:true
+                    "vector element index is not an immediate"
+            in
+            let element (sz, a) i =
+              match a with
+              | XReg r -> pp_velement sz r (index i)
+              | _ ->
+                  hierror ~loc:Lnone ~kind:"assembly printing" ~internal:true
+                    "vector element of a non-vector register"
+            in
+            let pargs =
+              match mn, pp.pp_aop_args, pargs with
+              | VDUPE, [ _; n; i ], [ d; _; _ ] -> [ d; element n i ]
+              | VINS, [ d; _; i ], [ _; r; _ ] -> [ element d i; r ]
+              | VINSE, [ d; n; i; j ], _ -> [ element d i; element n j ]
+              | VUMOV, [ _; n; i ], [ r; _; _ ] -> [ r; element n i ]
+              | (VDUPE | VINS | VINSE | VUMOV), _, _ ->
+                  hierror ~loc:Lnone ~kind:"assembly printing" ~internal:true
+                    "unexpected operands of a vector element instruction"
+              | _, _, _ -> pargs
+            in
             [ Instr (name, pargs) ]
 
 end
diff --git a/compiler/tests/fail/asmgen/armv8a/vext_index_range.jazz b/compiler/tests/fail/asmgen/armv8a/vext_index_range.jazz
new file mode 100644
index 000000000..6027dd655
--- /dev/null
+++ b/compiler/tests/fail/asmgen/armv8a/vext_index_range.jazz
@@ -0,0 +1,9 @@
+/* EXT of 16B vectors takes a byte position in [0, 15]. */
+export
+fn vext_index_range(reg u64 p) {
+    reg u128 a b;
+    a = [:u128 p];
+    b = [:u128 p + 16];
+    a = #VEXT(a, b, 16);
+    [:u128 p] = a;
+}
diff --git a/compiler/tests/fail/asmgen/armv8a/vins_index_range.jazz b/compiler/tests/fail/asmgen/armv8a/vins_index_range.jazz
new file mode 100644
index 000000000..f30bb9ebc
--- /dev/null
+++ b/compiler/tests/fail/asmgen/armv8a/vins_index_range.jazz
@@ -0,0 +1,10 @@
+/* A 4S vector has elements 0 to 3. */
+export
+fn vins_index_range(reg u64 p) {
+    reg u128 a;
+    reg u32 w;
+    a = [:u128 p];
+    w = [:u32 p + 16];
+    a = #VINS_4u32(a, w, 4);
+    [:u128 p] = a;
+}
