+   ; syscall_preserved := saved_regs
+   ; syscall_preserved_subset := erefl true
    ; call_reg_args  := [:: RCX; RDX; R8; R9 ]
    ; call_xreg_args := [:: XMM0; XMM1; XMM2; XMM3 ]
