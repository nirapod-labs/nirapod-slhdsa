diff --git a/compiler/src/arch_full.ml b/compiler/src/arch_full.ml
index 868e848a..7af22aab 100644
--- a/compiler/src/arch_full.ml
+++ b/compiler/src/arch_full.ml
@@ -201,19 +201,21 @@ module Arch_from_Core_arch (A : Core_arch) :
   let xmm_allocatable_vars =
     List.map var_of_xreg xmm_allocatable
 
-  let callee_save_vars =
-    let var_of_typed = function
-      | ARReg r -> var_of_reg  r
-      | ARegX r -> var_of_regx r
-      | AXReg r -> var_of_xreg r
-      | ABReg r -> var_of_flag r in
-    List.map var_of_typed callee_save
+  let var_of_typed = function
+    | ARReg r -> var_of_reg  r
+    | ARegX r -> var_of_regx r
+    | AXReg r -> var_of_xreg r
+    | ABReg r -> var_of_flag r
+
+  let callee_save_vars = List.map var_of_typed callee_save
 
   let rsp_var = var_of_reg rsp
 
   let all_registers = reg_vars @ regx_vars @ xreg_vars @ flag_vars
 
-  let syscall_kill = Sv.diff (Sv.of_list all_registers) (Sv.of_list callee_save_vars)
+  let syscall_kill =
+    let preserved = Arch_decl.syscall_preserved arch_decl call_conv in
+    Sv.diff (Sv.of_list all_registers) (Sv.of_list (List.map var_of_typed preserved))
 
   let callstyle =
     match A.callstyle with
diff --git a/compiler/tests/fail/windows/x86-64/syscall_live_u256.jazz b/compiler/tests/fail/windows/x86-64/syscall_live_u256.jazz
new file mode 100644
index 00000000..7c805b5a
--- /dev/null
+++ b/compiler/tests/fail/windows/x86-64/syscall_live_u256.jazz
@@ -0,0 +1,11 @@
+/* A syscall is not assumed to preserve the vector registers: [a] cannot stay
+   in ymm6-ymm15 across it, and there is no other register for it. */
+export fn f(reg ptr u8[64] io) -> reg ptr u8[64] {
+  stack u8[32] r;
+  reg u256 a;
+  a = io[:u256 0];
+  r = #randombytes(r);
+  a ^= r[:u256 0];
+  io[:u256 1] = a;
+  return io;
+}
