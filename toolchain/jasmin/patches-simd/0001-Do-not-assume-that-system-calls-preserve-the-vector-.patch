diff --git a/compiler/tests/success/windows/x86-64/syscall.jazz b/compiler/tests/success/windows/x86-64/syscall.jazz
new file mode 100644
index 00000000..894c055f
--- /dev/null
+++ b/compiler/tests/success/windows/x86-64/syscall.jazz
@@ -0,0 +1,11 @@
+/* A syscall is not assumed to preserve the vector registers (with the Windows
+   calling convention, only the low 128 bits of xmm6-xmm15 are callee-saved),
+   so an export function that issues a syscall saves and restores them. */
+export fn rand64() -> reg u64 {
+  reg u64 res;
+  stack u64[4] r;
+  r = #randombytes(r);
+  res = r[0];
+  res += r[3];
+  return res;
+}
diff --git a/proofs/arch/arch_decl.v b/proofs/arch/arch_decl.v
index 7d037339..2811d7c6 100644
--- a/proofs/arch/arch_decl.v
+++ b/proofs/arch/arch_decl.v
@@ -767,6 +767,12 @@ Definition is_ABReg r :=
   | _ => false
   end.
 
+Definition is_AXReg r :=
+  match r with
+  | AXReg _ => true
+  | _ => false
+  end.
+
 Class calling_convention :=
   { callee_saved   : seq asm_typed_reg
   ; callee_saved_not_bool : all (fun r => ~~is_ABReg r) callee_saved
@@ -778,6 +784,16 @@ Class calling_convention :=
   ; call_reg_ret_uniq : uniq (T:= @ceqT_eqType _ _) call_reg_ret
   }.
 
+(* The registers that a system call (a call to an external function, e.g.
+   randombytes) is assumed to preserve: the callee-saved registers, except
+   the vector ones.  The ABIs may preserve only part of a vector register
+   (Microsoft x64: the upper portions of YMM0-YMM15 are volatile; AAPCS64:
+   only the bottom 64 bits of v8-v15 need to be preserved), and a register is
+   either preserved in full or not at all here, so they are not assumed to be
+   preserved. *)
+Definition syscall_preserved {call_conv : calling_convention} :=
+  [seq r <- callee_saved | ~~ is_AXReg r].
+
 Definition get_ARReg (a:asm_typed_reg) :=
   match a with
   | ARReg r => Some r
diff --git a/proofs/arch/arch_sem.v b/proofs/arch/arch_sem.v
index 78e02e5a..7f826928 100644
--- a/proofs/arch/arch_sem.v
+++ b/proofs/arch/arch_sem.v
@@ -139,7 +139,7 @@ Class asm_syscall_sem := {
   eval_syscall_preserves :
     forall o s1 s2,
       eval_syscall o s1 = ok s2 ->
-      [/\ forall r, r \in callee_saved -> preserved_register r s1 s2
+      [/\ forall r, r \in syscall_preserved -> preserved_register r s1 s2
         , s1.(asm_rip) = s2.(asm_rip)
         & stack_stable s1.(asm_mem) s2.(asm_mem)
       ];
diff --git a/proofs/arch/asm_gen.v b/proofs/arch/asm_gen.v
index aad7726b..9e6a881f 100644
--- a/proofs/arch/asm_gen.v
+++ b/proofs/arch/asm_gen.v
@@ -759,6 +759,7 @@ Definition all_vars :=
          scs_vout := map to_var (take (size sig.(scs_tout)) call_reg_ret) |};
   all_vars     := all_vars;
   callee_saved := sv_of_list var_of_asm_typed_reg callee_saved;
+  syscall_preserved := sv_of_list var_of_asm_typed_reg syscall_preserved;
   vflags       := vflags;
   vflagsP      := vflagsP;
 }.
diff --git a/proofs/arch/asm_gen_proof.v b/proofs/arch/asm_gen_proof.v
index ad524992..c1697397 100644
--- a/proofs/arch/asm_gen_proof.v
+++ b/proofs/arch/asm_gen_proof.v
@@ -1615,6 +1615,10 @@ Proof.
   by rewrite cats0 flatten_cat /= cats0 size_cat size_map.
 Qed.
 
+Lemma syscall_preserved_callee_saved :
+  {subset arch_decl.syscall_preserved <= arch_decl.callee_saved}.
+Proof. by move=> r; rewrite mem_filter => /andP []. Qed.
+
 Lemma match_state_SysCall_eval fd ls ls' ii sc ac0 ac1 xs :
   let: li := MkLI ii (Lsyscall sc) in
   lom_eqv rip (to_estate ls) (asm_m xs) ->
@@ -1715,9 +1719,9 @@ Proof using hagparams ok_p'.
     case: (Sv_memP (to_var r) syscall_kill) => hinK.
     + by rewrite (hkill _ hinK hinR) /=.
     move: (hinK); rewrite /syscall_kill => hnin.
-    have : Sv.In (to_var r) one_varmap.callee_saved.
+    have : Sv.In (to_var r) one_varmap.syscall_preserved.
     + by have := reg_in_all r; SvD.fsetdec.
-    rewrite /one_varmap.callee_saved /= => /sv_of_listP /mapP [x] /hpr.
+    rewrite /one_varmap.syscall_preserved /= => /sv_of_listP /mapP [x] /hpr.
     move=> h /to_var_typed_reg ?; subst x.
     rewrite -h heqx // /X.
     SvD.fsetdec.
@@ -1730,9 +1734,9 @@ Proof using hagparams ok_p'.
     case: (Sv_memP (to_var r) syscall_kill) => hinK.
     + by have /(_ erefl) -> /= := hkill _ hinK hinR.
     move: (hinK); rewrite /syscall_kill => hnin.
-    have : Sv.In (to_var r) one_varmap.callee_saved.
+    have : Sv.In (to_var r) one_varmap.syscall_preserved.
     + have := regx_in_all r; SvD.fsetdec.
-    rewrite /one_varmap.callee_saved /= => /sv_of_listP /mapP [x] /hpr.
+    rewrite /one_varmap.syscall_preserved /= => /sv_of_listP /mapP [x] /hpr.
     move=> h /to_var_typed_regx ?; subst x.
     rewrite -h heqx // /X.
     SvD.fsetdec.
@@ -1745,9 +1749,9 @@ Proof using hagparams ok_p'.
     case: (Sv_memP (to_var r) syscall_kill) => hinK.
     + by have /(_ erefl) -> /= := hkill _ hinK hinR.
     move: (hinK); rewrite /syscall_kill => hnin.
-    have : Sv.In (to_var r) one_varmap.callee_saved.
+    have : Sv.In (to_var r) one_varmap.syscall_preserved.
     + have := xreg_in_all r. SvD.fsetdec.
-    rewrite /one_varmap.callee_saved /= => /sv_of_listP /mapP [x] /hpr.
+    rewrite /one_varmap.syscall_preserved /= => /sv_of_listP /mapP [x] /hpr.
     move=> h /to_var_typed_xreg ?; subst x.
     rewrite -h heqx // /X.
     SvD.fsetdec.
@@ -1756,9 +1760,10 @@ Proof using hagparams ok_p'.
   have hinR : ~Sv.In (to_var r) R.
   + rewrite /R /= vrvs_to_lvals => /sv_of_listP.
     by move=> /(mapP (T1 := @ceqT_eqType _ _)) [x _].
-  have hnc: ~ Sv.In (to_var r) one_varmap.callee_saved.
+  have hnc: ~ Sv.In (to_var r) one_varmap.syscall_preserved.
   + move=>
-      /= /sv_of_listP /mapP [] f /(allP callee_saved_not_bool) h
+      /= /sv_of_listP /mapP [] f
+      /syscall_preserved_callee_saved /(allP callee_saved_not_bool) h
       /to_var_typed_flag ?.
     by subst f.
   have hinK : Sv.In (to_var r) syscall_kill.
