diff --git a/compiler/tests/success/windows/x86-64/syscall.jazz b/compiler/tests/success/windows/x86-64/syscall.jazz
new file mode 100644
index 00000000..894c055f
--- /dev/null
+++ b/compiler/tests/success/windows/x86-64/syscall.jazz
@@ -0,0 +1,11 @@
+/* A syscall is not assumed to preserve the vector registers (with the Windows
+   calling convention, only the low 128 bits of xmm6-xmm15 are callee-saved),
+   so an export function that issues a syscall saves and restores them. */
+export fn rand64() -> reg u64 {
+  reg u64 res;
+  stack u64[4] r;
+  r = #randombytes(r);
+  res = r[0];
+  res += r[3];
+  return res;
+}
diff --git a/proofs/arch/arch_decl.v b/proofs/arch/arch_decl.v
index 7d037339..7669134d 100644
--- a/proofs/arch/arch_decl.v
+++ b/proofs/arch/arch_decl.v
@@ -771,6 +771,13 @@ Class calling_convention :=
   { callee_saved   : seq asm_typed_reg
   ; callee_saved_not_bool : all (fun r => ~~is_ABReg r) callee_saved
   ; callee_saved_has_rsp  : ARReg ad_rsp \in callee_saved
+    (* The registers that a system call (a call to an external function, e.g.
+       randombytes) is assumed to preserve. A register is either preserved in
+       full or not at all here, so a register that the ABI preserves only in
+       part must be left out. *)
+  ; syscall_preserved : seq asm_typed_reg
+  ; syscall_preserved_subset :
+      all (fun r => r \in callee_saved) syscall_preserved
   ; call_reg_args  : seq reg_t
   ; call_xreg_args : seq xreg_t
   ; call_reg_ret   : seq reg_t
diff --git a/proofs/arch/arch_sem.v b/proofs/arch/arch_sem.v
index 78e02e5a..7f826928 100644
--- a/proofs/arch/arch_sem.v
+++ b/proofs/arch/arch_sem.v
@@ -139,7 +139,7 @@ Class asm_syscall_sem := {
   eval_syscall_preserves :
     forall o s1 s2,
       eval_syscall o s1 = ok s2 ->
-      [/\ forall r, r \in callee_saved -> preserved_register r s1 s2
+      [/\ forall r, r \in syscall_preserved -> preserved_register r s1 s2
         , s1.(asm_rip) = s2.(asm_rip)
         & stack_stable s1.(asm_mem) s2.(asm_mem)
       ];
