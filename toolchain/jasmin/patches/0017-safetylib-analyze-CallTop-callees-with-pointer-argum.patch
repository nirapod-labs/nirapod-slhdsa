From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: athexweb3 <athexweb3@nirapod.org>
Date: Thu, 8 Oct 2026 19:09:38 +0600
Subject: [PATCH] safetylib: analyze CallTop callees with pointer arguments in
 context

From top, a callee loses the points-to information of its arguments, so
a pointer passed through it was reported at every later access.

(cherry picked from commit f2b06f24d681725b0005c607b5ad10a29e4d8680)
---
 compiler/safetylib/safetyInterpreter.ml       | 19 ++++++++++++++-----
 compiler/tests/safety/calltop.t/pointer.jazz  | 12 ++++++++++++
 .../safety/calltop.t/pointer_offset.jazz      | 13 +++++++++++++
 compiler/tests/safety/calltop.t/run.t         | 11 +++++++++++
 4 files changed, 50 insertions(+), 5 deletions(-)
 create mode 100644 compiler/tests/safety/calltop.t/pointer.jazz
 create mode 100644 compiler/tests/safety/calltop.t/pointer_offset.jazz

diff --git a/compiler/safetylib/safetyInterpreter.ml b/compiler/safetylib/safetyInterpreter.ml
index 9b477c71b..f6c51cfe1 100644
--- a/compiler/safetylib/safetyInterpreter.ml
+++ b/compiler/safetylib/safetyInterpreter.ml
@@ -1352,8 +1352,9 @@ end = struct
 
 
   (* The function must not use memory loads/stores, array accesses must be
-     fixed, and arrays in arguments must be fully initialized
-     (i.e. cells must be initialized). *)
+     fixed, arrays in arguments must be fully initialized
+     (i.e. cells must be initialized), and arguments must not point to
+     memory (the points-to information is lost when evaluating from top). *)
   let check_valid_call_top st f_decl =
     let cells_init =
       List.for_all (fun v -> match mvar_of_scoped_var Expr.Slocal v with
@@ -1368,7 +1369,14 @@ end = struct
           | _ -> true
         ) f_decl.f_args in
 
-    cells_init && check_memory_access f_decl
+    let no_pointer =
+      List.for_all (fun v ->
+          match AbsDom.var_points_to st.abs (mvar_of_scoped_var Expr.Slocal v) with
+          | Ptrs (_ :: _) -> false
+          | Ptrs [] | TopPtr -> true
+        ) f_decl.f_args in
+
+    cells_init && no_pointer && check_memory_access f_decl
 
 
   (* -------------------------------------------------------------------- *)
@@ -1808,8 +1816,9 @@ end = struct
 
     (* Precond: [check_valid_call_top st_in] must hold:
        the function must not use memory loads/stores, array accesses must be
-       fixed, and arrays in arguments must be fully initialized
-       (i.e. cells must be initialized). *)
+       fixed, arrays in arguments must be fully initialized
+       (i.e. cells must be initialized), and arguments must not point to
+       memory. *)
     | Config.Call_TopByCallSite ->
       (* f has been abstractly evaluated at this callsite before *)
       if ItMap.mem itk st_in.it then
diff --git a/compiler/tests/safety/calltop.t/pointer.jazz b/compiler/tests/safety/calltop.t/pointer.jazz
new file mode 100644
index 000000000..dda7c935b
--- /dev/null
+++ b/compiler/tests/safety/calltop.t/pointer.jazz
@@ -0,0 +1,12 @@
+// The callee has no memory access and returns its pointer argument.
+inline fn next(reg u64 p) -> reg u64 {
+  p += 8;
+  return p;
+}
+
+export fn g(reg u64 p) -> reg u64 {
+  reg u64 a;
+  p = next(p);
+  a = [p + 0];
+  return a;
+}
diff --git a/compiler/tests/safety/calltop.t/pointer_offset.jazz b/compiler/tests/safety/calltop.t/pointer_offset.jazz
new file mode 100644
index 000000000..363e76e1a
--- /dev/null
+++ b/compiler/tests/safety/calltop.t/pointer_offset.jazz
@@ -0,0 +1,13 @@
+// The callee adds an unknown value to its pointer argument.
+inline fn next(reg u64 p, reg u64 x) -> reg u64 {
+  p += x;
+  return p;
+}
+
+export fn g(reg u64 p) -> reg u64 {
+  reg u64 a x;
+  x = [p + 0];
+  p = next(p, x);
+  a = [p + 0];
+  return a;
+}
diff --git a/compiler/tests/safety/calltop.t/run.t b/compiler/tests/safety/calltop.t/run.t
index 71a45ce9d..67726117b 100644
--- a/compiler/tests/safety/calltop.t/run.t
+++ b/compiler/tests/safety/calltop.t/run.t
@@ -28,3 +28,14 @@ The safety conditions of the callee and of the caller are still checked.
   *** Possible Safety Violation(s):
     "index.jazz", line 15 (2-11): in_bound: t[a] (length 32 U8)
   Program is not safe!
+
+A callee with a pointer argument is analyzed in its calling context.
+
+  $ ../../../jasmin-checksafety --config calltop.json pointer.jazz 2>&1 | grep -e Violation -e line -e safe -e "mem_p:"
+  *** No Safety Violation
+    mem_p: [0; 16]
+
+  $ ../../../jasmin-checksafety --config calltop.json pointer_offset.jazz 2>&1 | grep -e Violation -e line -e safe
+  *** Possible Safety Violation(s):
+    "pointer_offset.jazz", line 11 (2-14): is_valid p +64u (64u) 0 u64
+  Program is not safe!
