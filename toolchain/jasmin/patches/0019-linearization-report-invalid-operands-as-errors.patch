index 000000000..fa8d44ed9
--- /dev/null
+++ b/compiler/tests/fail/common/bug_1126_store.jazz
@@ -0,0 +1,4 @@
+export fn entry(reg ptr u32[2] p, reg u32 x) -> reg ptr u32[2] {
+  p[(uint) p[0]] = x;
+  return p;
+}
