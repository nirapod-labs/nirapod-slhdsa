new file mode 100644
index 000000000..e7e7035b6
--- /dev/null
+++ b/compiler/tests/fail/common/bug_1126.jazz
@@ -0,0 +1,5 @@
+export fn entry(reg ptr u8[2] p) -> reg u32 {
+  reg u32 v;
+  v = (32u) p[0] + (32u) p[1];
+  return v;
+}
diff --git a/compiler/tests/fail/common/bug_1126_condition.jazz b/compiler/tests/fail/common/bug_1126_condition.jazz
new file mode 100644
index 000000000..1120193c4
--- /dev/null
+++ b/compiler/tests/fail/common/bug_1126_condition.jazz
@@ -0,0 +1,5 @@
+export fn entry(reg ptr u32[2] p, reg u32 x) -> reg u32 {
+  reg u32 r;
+  if ((p[0] == x) || (p[1] <s x)) { r = 1; } else { r = 2; }
+  return r;
+}
diff --git a/compiler/tests/fail/common/bug_1126_store.jazz b/compiler/tests/fail/common/bug_1126_store.jazz
