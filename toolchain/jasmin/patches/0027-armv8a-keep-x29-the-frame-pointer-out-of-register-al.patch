diff --git a/proofs/compiler/armv8a_decl.v b/proofs/compiler/armv8a_decl.v
index 8cc20775e..467059987 100644
--- a/proofs/compiler/armv8a_decl.v
+++ b/proofs/compiler/armv8a_decl.v
@@ -384,13 +384,15 @@ Definition armv8a_call_conv : calling_convention :=
    ; call_reg_ret_uniq := erefl true
    |}.
 
+(* R29 (x29), the frame pointer, is never allocated (see reserved_regs in
+   compiler/src/armv8a_arch_full.ml), so it carries no argument either. *)
