From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: athexweb3 <athexweb3@nirapod.org>
Date: Mon, 12 Oct 2026 19:51:28 +0600
Subject: [PATCH] armv8a: keep x29, the frame pointer, out of register
 allocation

AAPCS64 lets each platform decide whether the frame pointer must address a
valid frame record at all times. Apple platforms require it, allowing a
function not to create a record of its own. Register allocation could assign
x29 to a variable, which breaks stack traces taken while the function runs.
Reserve x29 on every platform: a function that never writes it leaves its
caller's frame record in place. x29 is also removed from the registers of
the internal calling convention.

Signed-off-by: athexweb3 <athexweb3@nirapod.org>
---
 compiler/src/arch_full.ml               |  8 +++-
 compiler/src/arch_full.mli              |  4 ++
 compiler/src/arm_arch_full.ml           |  3 ++
 compiler/src/armv8a_arch_full.ml        |  9 ++++
 compiler/src/riscv_arch_full.ml         |  3 ++
 compiler/src/x86_arch_full.ml           |  3 ++
 compiler/tests/armv8a_x29.t/fits.jazz   | 61 ++++++++++++++++++++++++
 compiler/tests/armv8a_x29.t/run.t       | 14 ++++++
 compiler/tests/armv8a_x29.t/spills.jazz | 63 +++++++++++++++++++++++++
 proofs/compiler/armv8a_decl.v           |  4 +-
 10 files changed, 169 insertions(+), 3 deletions(-)
 create mode 100644 compiler/tests/armv8a_x29.t/fits.jazz
 create mode 100644 compiler/tests/armv8a_x29.t/run.t
 create mode 100644 compiler/tests/armv8a_x29.t/spills.jazz

diff --git a/compiler/src/arch_full.ml b/compiler/src/arch_full.ml
index d90488a18..868e848a0 100644
--- a/compiler/src/arch_full.ml
+++ b/compiler/src/arch_full.ml
@@ -54,6 +54,10 @@ module type Core_arch = sig
   val is_ct_asm_extra : extra_op -> bool
 
   val internal_call_conv : (reg, regx, xreg, rflag, cond) internal_calling_convention
+
+  (* Registers the register allocator never assigns, besides the stack
+     pointer: registers the platform ABI reserves for its own use. *)
+  val reserved_regs : reg list
 end
 
 module type Arch = sig
@@ -158,8 +162,8 @@ module Arch_from_Core_arch (A : Core_arch) :
 
   let allocatable =
     let good_order = mk_allocatable (Arch_decl.registers arch_decl) callee_save_reg in
-    (* be sure that rsp is not used *)
-    List.filter (fun r -> r <> rsp) good_order
+    (* be sure that rsp and the reserved registers are not used *)
+    List.filter (fun r -> r <> rsp && not (List.mem r reserved_regs)) good_order
 
   let extra_allocatable =
     mk_allocatable (Arch_decl.registerxs arch_decl) callee_save_regx
diff --git a/compiler/src/arch_full.mli b/compiler/src/arch_full.mli
index 7ce1119b7..020aeedb6 100644
--- a/compiler/src/arch_full.mli
+++ b/compiler/src/arch_full.mli
@@ -50,6 +50,10 @@ module type Core_arch = sig
   val is_ct_asm_extra : extra_op -> bool
 
   val internal_call_conv : (reg, regx, xreg, rflag, cond) internal_calling_convention
+
+  (* Registers the register allocator never assigns, besides the stack
+     pointer: registers the platform ABI reserves for its own use. *)
+  val reserved_regs : reg list
 end
 
 module type Arch = sig
diff --git a/compiler/src/arm_arch_full.ml b/compiler/src/arm_arch_full.ml
index 174c0ca6a..85e1e4869 100644
--- a/compiler/src/arm_arch_full.ml
+++ b/compiler/src/arm_arch_full.ml
@@ -66,4 +66,7 @@ module Arm (Lowering_params : Arm_input) : Arch_full.Core_arch
   let max_store_size = Wsize.U32
 
   let internal_call_conv = Arm_decl.arm_internal_call_conv
+
+
+  let reserved_regs = []
 end
diff --git a/compiler/src/armv8a_arch_full.ml b/compiler/src/armv8a_arch_full.ml
index 8d49ca5fc..a5b1b089b 100644
--- a/compiler/src/armv8a_arch_full.ml
+++ b/compiler/src/armv8a_arch_full.ml
@@ -60,5 +60,14 @@ module Armv8a (Lowering_params : Armv8a_input) = struct
 
   let internal_call_conv = Armv8a_decl.armv8a_internal_call_conv
 
+  (* x29 is the frame pointer. AAPCS64 ("The Frame Pointer") lets each
+     platform decide whether it must always address a valid frame record;
+     Apple platforms require it, allowing a function not to create a record
+     of its own ("Writing ARM64 code for Apple platforms"). A function that
+     never writes x29 leaves its caller's frame record there, which meets
+     that rule, so x29 is kept out of register allocation on every
+     platform. *)
+  let reserved_regs = [ Armv8a_decl.R29 ]
+
   include Lowering_params
 end
diff --git a/compiler/src/riscv_arch_full.ml b/compiler/src/riscv_arch_full.ml
index 8f10aea30..2435ee48c 100644
--- a/compiler/src/riscv_arch_full.ml
+++ b/compiler/src/riscv_arch_full.ml
@@ -63,4 +63,7 @@ module Riscv (Lowering_params : Riscv_input) : Arch_full.Core_arch
   let max_store_size = Wsize.U32
 
   let internal_call_conv = Riscv_decl.riscv_internal_call_conv
+
+
+  let reserved_regs = []
 end
diff --git a/compiler/src/x86_arch_full.ml b/compiler/src/x86_arch_full.ml
index 06e10c1c3..af3d495b2 100644
--- a/compiler/src/x86_arch_full.ml
+++ b/compiler/src/x86_arch_full.ml
@@ -73,4 +73,7 @@ module X86 (Lowering_params : X86_input) :
   include Lowering_params
 
   let internal_call_conv = X86_decl.x86_internal_call_conv
+
+
+  let reserved_regs = []
 end
