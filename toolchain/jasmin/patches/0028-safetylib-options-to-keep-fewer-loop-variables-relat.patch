diff --git a/compiler/tests/safety/loopvars.t/run.t b/compiler/tests/safety/loopvars.t/run.t
new file mode 100644
index 000000000..3f7bb1a90
--- /dev/null
+++ b/compiler/tests/safety/loopvars.t/run.t
@@ -0,0 +1,16 @@
+The loop in sum reads p[0 .. n-1] with n <= 8. Kept relational, its counter
+bounds the memory range to 64 bytes. With "relational_loop_vars" false, the
+counter loses its relation to n and the range is much wider; naming sum in
+"relational_loop_vars_in" restores the bound for that function only.
+
+  $ ../../../jasmin-checksafety scan.jazz 2>&1 | grep -e Violation -e "mem_p:"
+  *** No Safety Violation
+    mem_p: [0; 64]
+
+  $ ../../../jasmin-checksafety --config none.json scan.jazz 2>&1 | grep -e Violation -e "mem_p:"
+  *** No Safety Violation
+    mem_p: [0; 65535]
+
+  $ ../../../jasmin-checksafety --config sum.json scan.jazz 2>&1 | grep -e Violation -e "mem_p:"
+  *** No Safety Violation
+    mem_p: [0; 64]
diff --git a/compiler/tests/safety/loopvars.t/scan.jazz b/compiler/tests/safety/loopvars.t/scan.jazz
new file mode 100644
index 000000000..9e2db9975
--- /dev/null
+++ b/compiler/tests/safety/loopvars.t/scan.jazz
@@ -0,0 +1,20 @@
+// The loop reads p[0 .. n-1] for n <= 8: bounding the accesses needs the
+// relation between the counter and the loop bound.
+inline fn sum(reg u64 p n) -> reg u64 {
+  reg u64 i s t;
+  s = 0;
+  i = 0;
+  while (i < n) {
+    t = [:u64 p + 8 * i];
+    s += t;
+    i += 1;
+  }
+  return s;
+}
+
+export fn scan(reg u64 p n) -> reg u64 {
+  reg u64 s;
+  s = 0;
+  if (n <= 8) { s = sum(p, n); }
+  return s;
+}
