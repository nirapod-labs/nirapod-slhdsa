diff --git a/compiler/tests/fail/asmgen/armv8a/ldp_stack_offset.jazz b/compiler/tests/fail/asmgen/armv8a/ldp_stack_offset.jazz
new file mode 100644
index 000000000..b1dc3a702
--- /dev/null
+++ b/compiler/tests/fail/asmgen/armv8a/ldp_stack_offset.jazz
@@ -0,0 +1,11 @@
+/* The stack slot lands outside the LDP offset range. */
+export
+fn ldp_stack_offset(reg u64 x) -> reg u64 {
+    stack u64[70] s;
+    reg u64 a b;
+    inline int i;
+    for i = 0 to 70 { s[i] = x; }
+    a, b = #LDP(s.[:u128 8 * 68]);
+    a += b;
+    return a;
+}
