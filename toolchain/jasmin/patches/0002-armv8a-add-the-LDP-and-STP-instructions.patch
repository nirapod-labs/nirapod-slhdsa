+    id_pp_asm := pp_armv8a_op_szs LDP [:: osz; osz; osz ];
+    id_valid := osz_valid;
+    id_safe_wf := refl_equal;
+    id_wf := refl_equal;
+  |}.
+
+(* [C6.2.414 STP] ARM DDI 0487 M.d
+   Store pair of registers. Signed offset form:
+   Syntax: STP <Wt1>, <Wt2>, [<Xn|SP>{, #<imm>}]
+   Syntax: STP <Xt1>, <Xt2>, [<Xn|SP>{, #<imm>}]
