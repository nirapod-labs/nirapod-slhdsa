diff --git a/compiler/tests/safety/subarray.t/string_value.jazz b/compiler/tests/safety/subarray.t/string_value.jazz
new file mode 100644
index 000000000..1d5ddb5b6
--- /dev/null
+++ b/compiler/tests/safety/subarray.t/string_value.jazz
@@ -0,0 +1,14 @@
+// t[0] is 5, then 90 ("Z"): a[t[0]] is out of bounds.
+export fn g(reg u64 p) -> reg u64 {
+  stack u8[4] t;
+  stack u64[8] a;
+  reg u64 x;
+  inline int i;
+  for i = 0 to 8 { a[i] = i; }
+  t[0] = 5;
+  t[0 : 1] = "Z";
+  x = (64u) t[0];
+  x = a[x];
+  [p + 0] = x;
+  return x;
+}
diff --git a/compiler/tests/safety/subarray.t/write.jazz b/compiler/tests/safety/subarray.t/write.jazz
new file mode 100644
index 000000000..cb4e942d5
--- /dev/null
+++ b/compiler/tests/safety/subarray.t/write.jazz
@@ -0,0 +1,17 @@
+// A partially initialized u is written at an unknown offset into an
+// initialized t: t[1] may be undefined.
+export fn g(reg u64 p) -> reg u64 {
+  stack u64[8] t;
+  stack u64[2] u;
+  reg u64 off x;
+  inline int i;
+  for i = 0 to 8 { t[i] = i; }
+  u[0] = 1;
+  off = [p + 0];
+  off &= 3;
+  off <<= 1;
+  t[off : 2] = u;
+  x = t[1];
+  [p + 0] = x;
+  return x;
+}
diff --git a/compiler/tests/safety/subarray.t/write_init.jazz b/compiler/tests/safety/subarray.t/write_init.jazz
new file mode 100644
index 000000000..3ee7937da
--- /dev/null
+++ b/compiler/tests/safety/subarray.t/write_init.jazz
@@ -0,0 +1,17 @@
+// The same with an initialized u.
+export fn g(reg u64 p) -> reg u64 {
+  stack u64[8] t;
+  stack u64[2] u;
+  reg u64 off x;
+  inline int i;
+  for i = 0 to 8 { t[i] = i; }
+  u[0] = 1;
+  u[1] = 2;
+  off = [p + 0];
+  off &= 3;
+  off <<= 1;
+  t[off : 2] = u;
+  x = t[1];
+  [p + 0] = x;
+  return x;
+}
