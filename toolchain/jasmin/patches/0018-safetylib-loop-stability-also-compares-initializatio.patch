From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: athexweb3 <athexweb3@nirapod.org>
Date: Thu, 8 Oct 2026 19:09:38 +0600
Subject: [PATCH] safetylib: loop stability also compares initialization

Otherwise a loop could be found stable before a variable that becomes
uninitialized in its body is read.

(cherry picked from commit 4bd66a7da7afaef6e815292082ab4d35c74f845f)
---
 compiler/safetylib/domains/safetyBoolean.ml  |  6 +++++-
 compiler/tests/safety/loopinit.t/init.jazz   | 19 +++++++++++++++++
 compiler/tests/safety/loopinit.t/run.t       |  9 ++++++++
 compiler/tests/safety/loopinit.t/uninit.jazz | 22 ++++++++++++++++++++
 4 files changed, 55 insertions(+), 1 deletion(-)
 create mode 100644 compiler/tests/safety/loopinit.t/init.jazz
 create mode 100644 compiler/tests/safety/loopinit.t/run.t
 create mode 100644 compiler/tests/safety/loopinit.t/uninit.jazz

diff --git a/compiler/safetylib/domains/safetyBoolean.ml b/compiler/safetylib/domains/safetyBoolean.ml
index e14d9b9b5..2c4967849 100644
--- a/compiler/safetylib/domains/safetyBoolean.ml
+++ b/compiler/safetylib/domains/safetyBoolean.ml
@@ -302,6 +302,7 @@ module type InitT = sig
   val copy_init      : t -> mvar -> mvar -> t
   val is_init        : t -> mvar list -> t
   val check_init     : t -> mvar -> bool
+  val is_included    : t -> t -> bool
     
   val size           : t -> int
   val print          : Format.formatter -> t -> unit
@@ -332,6 +333,9 @@ module Init : InitT = struct
   
   let check_init t v = Mm.find_default false v t
   let copy_init t l e = Mm.add l (check_init t e) t
+
+  (* Every variable initialized in [t'] is initialized in [t]. *)
+  let is_included t t' = Mm.for_all (fun k b' -> not b' || check_init t k) t'
                             
   let size t = Mm.cardinal t
 
@@ -500,7 +504,6 @@ module AbsBoolNoRel (AbsNum : AbsNumT) (Pt : PointsTo) (Sym : SymExpr)
                |> Mbv.add f_bv dnum in
     { t with bool = bool }
 
-  (* No need to check anything on t.init and t'.init. *)
   let is_included : t -> t -> bool = fun t t' ->
     let check_b b b_opt' = 
       let b' = match b_opt' with
@@ -511,6 +514,7 @@ module AbsBoolNoRel (AbsNum : AbsNumT) (Pt : PointsTo) (Sym : SymExpr)
     (AbsNum.R.is_included t.num t'.num)
     && (for_all2 check_b t.bool t'.bool)
     && (Pt.is_included t.points_to t'.points_to)
+    && (Init.is_included t.init t'.init)
 
   let is_bottom : t -> bool = fun t -> AbsNum.R.is_bottom t.num
 
diff --git a/compiler/tests/safety/loopinit.t/init.jazz b/compiler/tests/safety/loopinit.t/init.jazz
new file mode 100644
index 000000000..a667425bd
--- /dev/null
+++ b/compiler/tests/safety/loopinit.t/init.jazz
@@ -0,0 +1,19 @@
+// The same loop without ArrayInit: d stays defined.
+export fn g(reg u64 p) -> reg u64 {
+  stack u64[1] a b d;
+  stack u8[1] c;
+  reg u64 x;
+  a = #randombytes(a);
+  b = #randombytes(b);
+  d = #randombytes(d);
+  x = 0;
+  while {
+    c = #randombytes(c);
+  } (c[0] != 0) {
+    x = d[0];
+    d = b;
+    b = a;
+  }
+  [p + 0] = x;
+  return x;
+}
diff --git a/compiler/tests/safety/loopinit.t/run.t b/compiler/tests/safety/loopinit.t/run.t
new file mode 100644
index 000000000..12a5d7c78
--- /dev/null
+++ b/compiler/tests/safety/loopinit.t/run.t
@@ -0,0 +1,9 @@
+A loop is analysed until the initialization of the variables is stable too.
+
+  $ ../../../jasmin-checksafety uninit.jazz 2>&1 | grep -e Violation -e line -e safe
+  *** Possible Safety Violation(s):
+    "uninit.jazz", line 15 (4-13): is_init d[0]
+  Program is not safe!
+
+  $ ../../../jasmin-checksafety init.jazz 2>&1 | grep -e Violation -e line -e safe
+  *** No Safety Violation
diff --git a/compiler/tests/safety/loopinit.t/uninit.jazz b/compiler/tests/safety/loopinit.t/uninit.jazz
new file mode 100644
index 000000000..089e277bb
--- /dev/null
+++ b/compiler/tests/safety/loopinit.t/uninit.jazz
@@ -0,0 +1,22 @@
+// d is read at each iteration. a becomes undefined at the first iteration,
+// b at the second, d at the third: the fourth iteration reads an undefined
+// value.
+export fn g(reg u64 p) -> reg u64 {
+  stack u64[1] a b d;
+  stack u8[1] c;
+  reg u64 x;
+  a = #randombytes(a);
+  b = #randombytes(b);
+  d = #randombytes(d);
+  x = 0;
+  while {
+    c = #randombytes(c);
+  } (c[0] != 0) {
+    x = d[0];
+    d = b;
+    b = a;
+    ArrayInit(a);
+  }
+  [p + 0] = x;
+  return x;
+}
