From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: athexweb3 <athexweb3@nirapod.org>
Date: Mon, 12 Oct 2026 14:55:13 +0600
Subject: [PATCH] linearization: report invalid instruction operands as user
 errors

An instruction argument that is not an operand of the target, such as
the zero-extension of a byte read through a pointer in

    x += (64u) d[0];

reached linearization and failed there with the internal error
"linearization: check_rexpr". The program is not compilable as written:
neither x86-64 nor ARMv8-A has an addition whose operand zero-extends a
memory byte, so the byte must first be loaded into a register. Report it
as an error of the program, located at the instruction, that prints the
argument and says what to change.

Only the error changes; the check and its proofs are the same.

See issue #1126.
---
 .../armv8a/zext_load_operand.jazz             |  6 ++++
 .../x86-64/zext_load_operand.jazz             |  6 ++++
 compiler/tests/negative.expected              | 28 ++++++++++++++++---
 proofs/compiler/linearization.v               | 14 +++++++++-
 4 files changed, 49 insertions(+), 5 deletions(-)
 create mode 100644 compiler/tests/fail/linearization/armv8a/zext_load_operand.jazz
 create mode 100644 compiler/tests/fail/linearization/x86-64/zext_load_operand.jazz

diff --git a/compiler/tests/fail/linearization/armv8a/zext_load_operand.jazz b/compiler/tests/fail/linearization/armv8a/zext_load_operand.jazz
new file mode 100644
index 000000000..6065530d5
--- /dev/null
+++ b/compiler/tests/fail/linearization/armv8a/zext_load_operand.jazz
@@ -0,0 +1,6 @@
+/* The zero-extension of a byte read through a pointer is not an operand of
+   an addition: the byte must be loaded into a register first. */
+export fn f(reg ptr u8[4] d, reg u64 x) -> reg u64 {
+  x += (64u) d[0];
+  return x;
+}
diff --git a/compiler/tests/fail/linearization/x86-64/zext_load_operand.jazz b/compiler/tests/fail/linearization/x86-64/zext_load_operand.jazz
new file mode 100644
index 000000000..6065530d5
--- /dev/null
+++ b/compiler/tests/fail/linearization/x86-64/zext_load_operand.jazz
@@ -0,0 +1,6 @@
+/* The zero-extension of a byte read through a pointer is not an operand of
+   an addition: the byte must be loaded into a register first. */
+export fn f(reg ptr u8[4] d, reg u64 x) -> reg u64 {
+  x += (64u) d[0];
+  return x;
+}
diff --git a/compiler/tests/negative.expected b/compiler/tests/negative.expected
index 4b97c3fd4..5a2b1ea91 100644
--- a/compiler/tests/negative.expected
+++ b/compiler/tests/negative.expected
@@ -916,6 +916,24 @@ internal compilation error in function main:
   dead code: loop iterator too small
 Please report at https://github.com/jasmin-lang/jasmin/issues
 
+fail/linearization/armv8a/zext_load_operand.jazz:
+
+"fail/linearization/armv8a/zext_load_operand.jazz", line 4 (2-18):
+compilation error in function f:
+linearization: The argument
+(64u) [:u8 x0 +64u (64u) 0]
+of this instruction is not an operand of the target architecture.
+A memory access must be a whole argument: assign the expression to a register variable first.
+
+fail/linearization/x86-64/zext_load_operand.jazz:
+
+"fail/linearization/x86-64/zext_load_operand.jazz", line 4 (2-18):
+compilation error in function f:
+linearization: The argument
+(64u) [:u8 RDI +64u (64u) 0]
+of this instruction is not an operand of the target architecture.
+A memory access must be a whole argument: assign the expression to a register variable first.
+
 fail/namespaces/common/duplicate.jazz:
 
 "fail/namespaces/common/duplicate.jazz", line 2 (13-23): The function A::f is already declared at "fail/namespaces/common/duplicate.jazz", line 1 (13-23)
@@ -1535,9 +1553,11 @@ stack allocation: cannot access the subarray [16; 32[ of a[0; 24[, the access ov
 fail/stack_allocation/x86-64/reg_var_expected.jazz:
 
 "fail/stack_allocation/x86-64/reg_var_expected.jazz", line 6 (2-12):
-internal compilation error in function main:
-  linearization: check_rexpr
-Please report at https://github.com/jasmin-lang/jasmin/issues
+compilation error in function main:
+linearization: The argument
+[:u64 [#aligned :u64 RSP +64u (64u) 0]]
+of this instruction is not an operand of the target architecture.
+A memory access must be a whole argument: assign the expression to a register variable first.
 
 fail/stack_allocation/x86-64/regions_not_equal_array.jazz:
 
@@ -1966,4 +1986,4 @@ Statistics:
 	Pretyping:  65
 	Parsing:     5
 	Typing:      5
-	Compile:   235
+	Compile:   237
diff --git a/proofs/compiler/linearization.v b/proofs/compiler/linearization.v
index 6b1305758..195eff1a9 100644
--- a/proofs/compiler/linearization.v
+++ b/proofs/compiler/linearization.v
@@ -54,6 +54,17 @@ Definition assign_remains (ii : instr_info) (lv: lval) (e: pexpr) :=
       pp_s "More information may be found online: https://jasmin-lang.readthedocs.io/en/stable/misc/faq.html#linearization"
   ]).
 
+(* An argument of an instruction that is not an operand of the target: after
+   stack allocation, an array element or a memory access nested in a larger
+   expression, such as the zero-extension of a byte load. *)
+Definition invalid_operand (ii : instr_info) (e: pexpr) :=
+  gen_error false (Some ii)
+    (pp_nobox [:: pp_s "The argument"; PPEbreak;
+      pp_e e; PPEbreak;
+      pp_s "of this instruction is not an operand of the target architecture."; PPEbreak;
+      pp_s "A memory access must be a whole argument: assign the expression to a register variable first."
+  ]).
+
 End E.
 
 
@@ -353,7 +364,8 @@ Section EXPR.
 
   Definition check_fexpr := check_Some error fexpr_of_pexpr "check_fexpr".
 
-  Definition check_rexpr := check_Some error rexpr_of_pexpr "check_rexpr".
+  Definition check_rexpr (e: pexpr) :=
+    check_Some (fun _ => E.invalid_operand ii e) rexpr_of_pexpr "check_rexpr" e.
 
   Definition check_lexpr := check_Some error lexpr_of_lval "check_lexpr".
 
