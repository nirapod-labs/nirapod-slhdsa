diff --git a/compiler/tests/safety/arraytrack.t/lookup.jazz b/compiler/tests/safety/arraytrack.t/lookup.jazz
new file mode 100644
index 000000000..98483aa58
--- /dev/null
+++ b/compiler/tests/safety/arraytrack.t/lookup.jazz
@@ -0,0 +1,11 @@
+// The cells of t hold 0..15, so the value read from t[3] is a valid index
+// into t when the checker knows the values of the cells.
+export fn lookup() -> reg u64 {
+  stack u64[16] t;
+  inline int k;
+  reg u64 v r;
+  for k = 0 to 16 { t[k] = k; }
+  v = t[3];
+  r = t[v];
+  return r;
+}
diff --git a/compiler/tests/safety/arraytrack.t/masked.jazz b/compiler/tests/safety/arraytrack.t/masked.jazz
new file mode 100644
index 000000000..684958678
--- /dev/null
+++ b/compiler/tests/safety/arraytrack.t/masked.jazz
@@ -0,0 +1,11 @@
+// The value read from t is masked before it is used as an index.
+export fn masked() -> reg u64 {
+  stack u64[16] t;
+  inline int k;
+  reg u64 v r;
+  for k = 0 to 16 { t[k] = k; }
+  v = t[3];
+  v &= 15;
+  r = t[v];
+  return r;
+}
diff --git a/compiler/tests/safety/arraytrack.t/run.t b/compiler/tests/safety/arraytrack.t/run.t
new file mode 100644
index 000000000..a6e4c7469
--- /dev/null
+++ b/compiler/tests/safety/arraytrack.t/run.t
@@ -0,0 +1,27 @@
+With "array_track_max_bytes", the values of the cells of larger arrays are
+unknown: a value read from such an array is no longer known to be a valid
+index. Initialization and index bounds are still checked.
+
+  $ ../../../jasmin-checksafety lookup.jazz 2>&1 | grep -e Violation -e line -e safe
+  *** No Safety Violation
+
+  $ ../../../jasmin-checksafety --config small.json lookup.jazz 2>&1 | grep -e Violation -e line -e safe
+  *** Possible Safety Violation(s):
+    "lookup.jazz", line 9 (2-11): in_bound: t[v] (length 128 U8)
+  Program is not safe!
+
+  $ ../../../jasmin-checksafety masked.jazz 2>&1 | grep -e Violation -e line -e safe
+  *** No Safety Violation
+
+  $ ../../../jasmin-checksafety --config small.json masked.jazz 2>&1 | grep -e Violation -e line -e safe
+  *** No Safety Violation
+
+  $ ../../../jasmin-checksafety uninit.jazz 2>&1 | grep -e Violation -e line -e safe
+  *** Possible Safety Violation(s):
+    "uninit.jazz", line 8 (2-11): is_init t[i]
+  Program is not safe!
+
+  $ ../../../jasmin-checksafety --config small.json uninit.jazz 2>&1 | grep -e Violation -e line -e safe
+  *** Possible Safety Violation(s):
+    "uninit.jazz", line 8 (2-11): is_init t[i]
+  Program is not safe!
