From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: athexweb3 <athexweb3@nirapod.org>
Date: Mon, 12 Oct 2026 16:50:09 +0600
Subject: [PATCH] armv8a: load a 32-bit word zero-extended to 64 bits

`x = (64u)[:u32 p];` was rejected: the lowering of zero-extending loads
covered bytes (LDRB) and halfwords (LDRH) but not words, although
`LDR <Wt>` zero-extends the word into the whole X register. Add LDRW,
written `LDR <Wt>, ...` and valid at the 64-bit operand size only (the
counterpart of LDRSW), lower the zero-extending word load to it, and
model it in the EasyCrypt library as the 64-bit zero extension of the
word read.
---
 compiler/src/pp_arm_v8a.ml              |  1 +
 compiler/tests/success/armv8a/ldrw.jazz |  9 +++++++++
 eclib/JModel_armv8a.ec                  |  2 ++
 proofs/compiler/armv8a_instr_decl.v     | 16 ++++++++++++----
 proofs/compiler/armv8a_lowering.v       |  1 +
 5 files changed, 25 insertions(+), 4 deletions(-)
 create mode 100644 compiler/tests/success/armv8a/ldrw.jazz

diff --git a/compiler/src/pp_arm_v8a.ml b/compiler/src/pp_arm_v8a.ml
index acff22cdb..0c8fcbf0a 100644
--- a/compiler/src/pp_arm_v8a.ml
+++ b/compiler/src/pp_arm_v8a.ml
@@ -109,6 +109,7 @@ let pp_mnemonic (ARMv8A_op (mn, _) as op) =
   let pp = id.id_pp_asm [] in
   match mn with
   | UXTW -> "mov" (* [UXTW] is written [MOV <Wd>, <Wn>]. *)
+  | LDRW -> "ldr" (* [LDRW] is written [LDR <Wt>, ...]. *)
   | _ -> String.lowercase_ascii pp.pp_aop_name
 
 (* Split an [ADR] instruction to a global symbol into an [ADRP]/[ADD]
diff --git a/compiler/tests/success/armv8a/ldrw.jazz b/compiler/tests/success/armv8a/ldrw.jazz
new file mode 100644
index 000000000..a4f46c5f1
--- /dev/null
+++ b/compiler/tests/success/armv8a/ldrw.jazz
@@ -0,0 +1,9 @@
+/* A 32-bit load zero-extended to 64 bits is a single LDR to a W register. */
+export fn ldrw(reg u64 p i) -> reg u64 {
+  reg u64 x y;
+  x = (64u)[:u32 p];
+  i &= 7;
+  y = (64u)[:u32 p + 4 * i];
+  x += y;
+  return x;
+}
diff --git a/eclib/JModel_armv8a.ec b/eclib/JModel_armv8a.ec
index aa33242dc..37656be9c 100644
--- a/eclib/JModel_armv8a.ec
+++ b/eclib/JModel_armv8a.ec
@@ -281,6 +281,8 @@ op LDRSH_64 (x: W16.t) : W64.t = W64.of_int (W16.to_sint x).
 
 op LDRSW (x: W32.t) : W64.t = W64.of_int (W32.to_sint x).
 
+op LDRW (x: W32.t) : W64.t = W64.of_int (W32.to_uint x).
+
 op STR_64 (x: W64.t) : W64.t = x.
 
 op STRB_64 (x: W8.t) : W8.t = x.
diff --git a/proofs/compiler/armv8a_instr_decl.v b/proofs/compiler/armv8a_instr_decl.v
index 918c9750d..e8e414a13 100644
--- a/proofs/compiler/armv8a_instr_decl.v
+++ b/proofs/compiler/armv8a_instr_decl.v
@@ -154,6 +154,7 @@ Variant armv8a_mnemonic : Type :=
 | LDRSB                          (* Load a sign extended byte *)
 | LDRSH                          (* Load a sign extended halfword *)
 | LDRSW                          (* Load a sign extended word *)
+| LDRW                           (* Load a zero extended word *)
 | LDP                            (* Load a pair of words or doublewords *)
 
 (* Stores *)
@@ -184,7 +185,7 @@ Definition armv8a_mnemonics : seq armv8a_mnemonic :=
     ; SXTB; SXTH; SXTW; UXTB; UXTH; UXTW
     ; CMP; CMN; TST
     ; CSEL; CSINC; CSINV; CSNEG; CSET; CSETM
-    ; LDR; LDRB; LDRH; LDRSB; LDRSH; LDRSW; LDP
+    ; LDR; LDRB; LDRH; LDRSB; LDRSH; LDRSW; LDRW; LDP
     ; STR; STRB; STRH; STP
     ; CSDB; DSB; ISB
   ].
@@ -257,7 +258,7 @@ Definition wsize_of_narrow_load_mn (mn : armv8a_mnemonic) : option wsize :=
   match mn with
   | LDRB | LDRSB => Some U8
   | LDRH | LDRSH => Some U16
-  | LDRSW => Some U32
+  | LDRSW | LDRW => Some U32
   | _ => None
   end.
 
@@ -341,6 +342,7 @@ Definition string_of_armv8a_mnemonic (mn : armv8a_mnemonic) : string :=
   | LDRSB => "LDRSB"
   | LDRSH => "LDRSH"
   | LDRSW => "LDRSW"
+  | LDRW => "LDRW"
   | LDP => "LDP"
   | STR => "STR"
   | STRB => "STRB"
@@ -2538,6 +2540,11 @@ Definition armv8a_CSETM_instr := mk_cset_instr CSETM (armv8a_CSETM_semi (ws := o
      constant bits(datasize) data = Mem[address, datasize DIV 8, accdesc];
      X[t, regsize] = ZeroExtend(data, regsize);
 *)
+(* LDRW is LDR with a W destination register used for a 64-bit result: the
+   load writes [X[t, 32] = ZeroExtend(data, 32)], and a write to the W form of
+   a register clears its upper 32 bits, so the word is zero-extended to 64
+   bits. It is written [LDR <Wt>, ...] and valid at the 64-bit operand size
+   only, like LDRSW. *)
 Definition armv8a_load_instr mn : instr_desc_t :=
   let wacc :=
     if wsize_of_narrow_load_mn mn is Some ws'
@@ -2565,8 +2572,8 @@ Definition armv8a_load_instr mn : instr_desc_t :=
        name it at the operand size ([LDRSB <Wt>|<Xt>, ...]). *)
     id_pp_asm :=
       pp_armv8a_op_szs mn
-        [:: (match mn with LDRB | LDRH => U32 | _ => osz end); osz ];
-    id_valid := osz_valid && (if mn is LDRSW then osz == U64 else true);
+        [:: (match mn with LDRB | LDRH | LDRW => U32 | _ => osz end); osz ];
+    id_valid := osz_valid && (if mn \in [:: LDRSW; LDRW ] then osz == U64 else true);
     id_safe_wf := refl_equal;
     id_semi_errty := fun _ => sem_lprod_ok_error tin semi;
     id_semi_safe := fun _ => sem_lprod_ok_safe tin semi;
@@ -3035,6 +3042,7 @@ Definition mn_desc (mn : armv8a_mnemonic) : instr_desc_t :=
   | LDRSB => armv8a_load_instr LDRSB
   | LDRSH => armv8a_load_instr LDRSH
   | LDRSW => armv8a_load_instr LDRSW
+  | LDRW => armv8a_load_instr LDRW
   | LDP => armv8a_LDP_instr
   | STR => armv8a_store_instr STR
   | STRB => armv8a_store_instr STRB
diff --git a/proofs/compiler/armv8a_lowering.v b/proofs/compiler/armv8a_lowering.v
index fb6376d76..68e29e6b3 100644
--- a/proofs/compiler/armv8a_lowering.v
+++ b/proofs/compiler/armv8a_lowering.v
@@ -196,6 +196,7 @@ Definition uload_mn (ws ws' : wsize) : option armv8a_mnemonic :=
   match ws' with
   | U8 => Some LDRB
   | U16 => Some LDRH
+  | U32 => if ws == U64 then Some LDRW else None
   | _ => None
   end.
 
