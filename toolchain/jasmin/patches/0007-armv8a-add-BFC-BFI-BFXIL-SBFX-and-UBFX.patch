diff --git a/compiler/tests/success/armv8a/bitfield.jazz b/compiler/tests/success/armv8a/bitfield.jazz
new file mode 100644
index 000000000..273689a25
--- /dev/null
+++ b/compiler/tests/success/armv8a/bitfield.jazz
@@ -0,0 +1,34 @@
+/* Bit-field insertions and extractions. Every form exists in both the W and
+   X forms; the immediates are a bit position and a width. */
+
+export
+fn bitfield(reg u64 arg0, reg u64 arg1) -> reg u64 {
+    reg u64 x y;
+
+    y = arg1;
+    x = #UBFX(y, 3, 8);
+    x = #SBFX(x, 2, 16);
+    x = #BFI(x, y, 8, 8);
+    x = #BFC(x, 0, 4);
+    x = #BFXIL(x, y, 16, 8);
+    x = #UBFX(x, 60, 4);
+    x = #SBFX(x, 0, 64);
+    x = #BFI(x, y, 63, 1);
+    x = x + arg0;
+    return x;
+}
+
+export
+fn bitfield32(reg u32 arg0, reg u32 arg1) -> reg u32 {
+    reg u32 x;
+
+    x = #UBFX_32(arg1, 3, 8);
+    x = #SBFX_32(x, 2, 16);
+    x = #BFI_32(x, arg0, 8, 8);
+    x = #BFC_32(x, 0, 4);
+    x = #BFXIL_32(x, arg0, 16, 8);
+    x = #UBFX_32(x, 0, 32);
+    x = #BFC_32(x, 31, 1);
+    x = #BFXIL_32(x, arg1, 28, 4);
+    return x;
+}
