diff --git a/compiler/tests/success/armv8a/bic_lowering.jazz b/compiler/tests/success/armv8a/bic_lowering.jazz
new file mode 100644
index 000000000..a29c867de
--- /dev/null
+++ b/compiler/tests/success/armv8a/bic_lowering.jazz
@@ -0,0 +1,35 @@
+/* An AND with a complemented operand is lowered to BIC, whichever side the
+   complement is on; a shift of the complemented operand is folded in. */
+export fn bic_right(reg u64 a b) -> reg u64 {
+  reg u64 r;
+  r = a & !b;
+  return r;
+}
+
+export fn bic_left(reg u64 a b) -> reg u64 {
+  reg u64 r;
+  r = !b & a;
+  return r;
+}
+
+export fn bic_shift(reg u64 a b) -> reg u64 {
+  reg u64 r;
+  r = a & !(b >>r 7);
+  return r;
+}
+
+export fn bic_32(reg u32 a b) -> reg u32 {
+  reg u32 r;
+  r = !b & a;
+  return r;
+}
+
+/* A complemented constant is folded first: this is an AND with an immediate,
+   not a BIC. */
+param int C = 0xff;
+
+export fn and_not_const(reg u64 a) -> reg u64 {
+  reg u64 r;
+  r = a & !(64u) C;
+  return r;
+}
diff --git a/proofs/compiler/armv8a_lowering.v b/proofs/compiler/armv8a_lowering.v
index ba824c538..6fd1862a7 100644
--- a/proofs/compiler/armv8a_lowering.v
+++ b/proofs/compiler/armv8a_lowering.v
@@ -283,6 +283,13 @@ Definition check_shift_expr (ws : wsize) (e : pexpr) : option pexpr :=
     | _ => None
     end.
 
+(* Recognize a complemented operand [!b] at width [ws]. BIC computes
+   [Xn AND NOT Xm], so [a & !b] and [!b & a] are both BIC with [b] as its
+   second operand. *)
+Definition is_lnot (ws : wsize) (e : pexpr) : option pexpr :=
+  if e is Papp1 (Olnot ws') b then if ws' == ws then Some b else None
+  else None.
+
 Definition lower_Papp2_op
   (ws : wsize) (op : sop2) (e0 e1 : pexpr) :
   option (armv8a_mnemonic * pexpr * pexprs) :=
@@ -308,8 +315,13 @@ Definition lower_Papp2_op
   | Odiv Unsigned (Op_w ws') =>
       let%opt _ := oassert (ws' == ws) in
       Some (UDIV, e0, [:: e1 ])
-  | Oland _ =>
-      Some (AND, e0, [:: e1 ])
+  | Oland ws' =>
+      if ws' == ws
+      then
+        if is_lnot ws e1 is Some b then Some (BIC, e0, [:: b ])
+        else if is_lnot ws e0 is Some a then Some (BIC, e1, [:: a ])
+        else Some (AND, e0, [:: e1 ])
+      else Some (AND, e0, [:: e1 ])
   | Olor _ =>
       Some (ORR, e0, [:: e1 ])
   | Olxor _ =>
diff --git a/proofs/compiler/armv8a_lowering_proof.v b/proofs/compiler/armv8a_lowering_proof.v
index 31b9026d5..7b4b81c0f 100644
--- a/proofs/compiler/armv8a_lowering_proof.v
+++ b/proofs/compiler/armv8a_lowering_proof.v
@@ -782,6 +782,25 @@ Qed.
 
 End IS_MUL.
 
+Section IS_LNOT.
+
+Variant is_lnot_spec (ws : wsize) (e : pexpr) : option pexpr -> Type :=
+  | IsLnotSome b : e = Papp1 (Olnot ws) b -> is_lnot_spec (Some b)
+  | IsLnotNone : is_lnot_spec None.
+
+Lemma is_lnotP ws e : is_lnot_spec ws e (is_lnot ws e).
+Proof.
+  rewrite /is_lnot.
+  case: e; try (move=> *; exact: IsLnotNone).
+  move=> op b.
+  case: op; try (move=> *; exact: IsLnotNone).
+  move=> ws'.
+  case: eqP => [-> | _]; last exact: IsLnotNone.
+  exact: IsLnotSome.
+Qed.
+
+End IS_LNOT.
+
