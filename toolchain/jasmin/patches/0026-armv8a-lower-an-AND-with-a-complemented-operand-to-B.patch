+        move: hop; rewrite /sem_sop2_typed /mk_sem_op /= => -[?]; subst w2;
+        move: hw => /Vword_inj [?]; subst ws'; move=> /= ?; subst w;
+        (split;
+          last (split; [ exact: (disj_fvars_read_es2 hfve1 hfve0) | by [] ]));
