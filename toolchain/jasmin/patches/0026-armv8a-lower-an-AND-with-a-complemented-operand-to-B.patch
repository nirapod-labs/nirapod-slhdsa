+        move: hseme0 => /=; t_xrbindP => vb hsemb /sem_sop1I /= [wb [wn [hwb hwn ?]]];
+        subst v0;
+        move: hwn; rewrite /sem_sop1_typed /= => -[?]; subst wn;
+        move: hsemop => /sem_sop2I /= [w0' [w1' [w2 [hw0 hw1 hop hw]]]];
+        move: hw0; rewrite /= truncate_word_u => -[?]; subst w0';
