diff --git a/compiler/tests/fail/asmgen/armv8a/bic_two_complements.jazz b/compiler/tests/fail/asmgen/armv8a/bic_two_complements.jazz
new file mode 100644
index 000000000..9d57c45a9
--- /dev/null
+++ b/compiler/tests/fail/asmgen/armv8a/bic_two_complements.jazz
@@ -0,0 +1,8 @@
+/* With both operands complemented, BIC takes one complement and the other
+   remains an expression that is not a register: the program is rejected,
+   not compiled to a different operation. */
+export fn bic_two_complements(reg u64 a b) -> reg u64 {
+  reg u64 r;
+  r = !a & !b;
+  return r;
+}
