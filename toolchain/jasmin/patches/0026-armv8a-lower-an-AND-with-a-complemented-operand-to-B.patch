+        rewrite /semi_to_atype !computational_eq_refl /=;
+        by rewrite /armv8a_bitwise_semi zero_extend_u wandC
       | (* Division: SDIV, UDIV (operate at [ws''= ws]). *)
         lazymatch goal with
         | [ |- context[ARMv8A_op SDIV _] ] => idtac
@@ -1278,6 +1358,9 @@ Proof.
