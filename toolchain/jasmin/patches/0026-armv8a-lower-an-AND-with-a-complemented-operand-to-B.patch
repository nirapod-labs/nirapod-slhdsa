         end
@@ -1075,6 +1097,64 @@ Proof.
                 -?(wor_zero_extend _ _ hws) -?(wxor_zero_extend _ _ hws);
         rewrite ?(wopp_zero_extend _ hws) ?(zero_extend_idem _ hws);
