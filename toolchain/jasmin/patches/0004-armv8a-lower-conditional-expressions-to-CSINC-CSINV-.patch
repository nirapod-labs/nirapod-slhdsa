-  Some (pre, Oarmv8a (ARMv8A_op CSEL (opts_at ws)), [:: e0; e1; c' ]).
+  let%opt (mn, es) := lower_Pif_args ws c' e0 e1 in
+  Some (pre, Oarmv8a (ARMv8A_op mn (opts_at ws)), es).
 
