-    exists s1'; last exact: eeq_excR.
-    rewrite esem1.
-    exact: (sem_i_lower_store ii tag h hs00 hws hfve hseme hwrite01').
+  - case h: lower_store => [[op' es']|].
+    + move=> [? ? ? ?]; subst pre lvs op es.
+      exists s1'; last exact: eeq_excR.
