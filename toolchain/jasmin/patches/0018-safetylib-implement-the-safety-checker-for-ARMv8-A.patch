diff --git a/compiler/tests/safety/success/armv8a/array-direct.jazz b/compiler/tests/safety/success/armv8a/array-direct.jazz
new file mode 100644
index 000000000..67881d80a
--- /dev/null
+++ b/compiler/tests/safety/success/armv8a/array-direct.jazz
@@ -0,0 +1,18 @@
+export
+fn array_direct() -> reg u64 {
+
+  stack u8[64] a;
+  reg u64 q;
+  inline int i;
+  i = 0;
+  q = 0;
+  a.[:u64 0] = q;
+  a.[:u64 i] = q;
+  a.[:u64 i + 8] = q;
+  a.[:u64 8 * (i + 1)] = q;
+  a.[:u64 (i + 1) * 8] = q;
+  a.[:u64 i * 8 + 8] = q;
+
+  q = a.[:u64 0];
+  return q;
+}
diff --git a/compiler/tests/safety/success/armv8a/intrinsic-masked.jazz b/compiler/tests/safety/success/armv8a/intrinsic-masked.jazz
new file mode 100644
index 000000000..00b10da4a
--- /dev/null
+++ b/compiler/tests/safety/success/armv8a/intrinsic-masked.jazz
@@ -0,0 +1,13 @@
+/* The result of an architecture-specific operator is unknown to the
+   analysis; masking it bounds the index. */
+export
+fn masked(reg u64 x) -> reg u64 {
+  stack u64[4] t;
+  reg u64 i r;
+  inline int j;
+  for j = 0 to 4 { t[j] = j; }
+  i = #UBFX(x, 3, 8);
+  i &= 3;
+  r = t[i];
+  return r;
+}
diff --git a/compiler/tests/safety/success/armv8a/ldp.jazz b/compiler/tests/safety/success/armv8a/ldp.jazz
new file mode 100644
index 000000000..1a100f133
--- /dev/null
+++ b/compiler/tests/safety/success/armv8a/ldp.jazz
@@ -0,0 +1,10 @@
+export
+fn ldp() -> reg u64 {
+  stack u64[4] s;
+  reg u64 a b;
+  inline int j;
+  for j = 0 to 4 { s[j] = j; }
+  a, b = #LDP(s.[:u128 16]);
+  a += b;
+  return a;
+}
diff --git a/compiler/tests/safety/success/armv8a/loop1.jazz b/compiler/tests/safety/success/armv8a/loop1.jazz
new file mode 100644
index 000000000..9d5dc5161
--- /dev/null
+++ b/compiler/tests/safety/success/armv8a/loop1.jazz
@@ -0,0 +1,15 @@
+export
+fn poly1305(reg u64 in, reg u64 inlen) -> reg u64 {
+  reg u8 tmp;
+  reg u64 r;
+
+  r = 0;
+
+  while (inlen > 0 ) {
+    tmp = [:u8 in + 0];
+    in += 1;
+    inlen -= 1;
+  }
+
+  return r;
+}
