diff --git a/compiler/tests/safety/fail/armv8a/intrinsic-unbounded.jazz b/compiler/tests/safety/fail/armv8a/intrinsic-unbounded.jazz
new file mode 100644
index 000000000..491e7306f
--- /dev/null
+++ b/compiler/tests/safety/fail/armv8a/intrinsic-unbounded.jazz
@@ -0,0 +1,12 @@
+/* The result of an architecture-specific operator is unknown to the
+   analysis: without a mask, the index may be out of bounds. */
+export
+fn unbounded(reg u64 x) -> reg u64 {
+  stack u64[4] t;
+  reg u64 i r;
+  inline int j;
+  for j = 0 to 4 { t[j] = j; }
+  i = #UBFX(x, 3, 8);
+  r = t[i];
+  return r;
+}
diff --git a/compiler/tests/safety/fail/armv8a/ldp-uninit.jazz b/compiler/tests/safety/fail/armv8a/ldp-uninit.jazz
new file mode 100644
index 000000000..0381607e4
--- /dev/null
+++ b/compiler/tests/safety/fail/armv8a/ldp-uninit.jazz
@@ -0,0 +1,10 @@
+export
+fn ldp_uninit() -> reg u64 {
+  stack u64[4] s;
+  reg u64 a b;
+  inline int j;
+  for j = 0 to 3 { s[j] = j; }
+  a, b = #LDP(s.[:u128 16]);
+  a += b;
+  return a;
+}
