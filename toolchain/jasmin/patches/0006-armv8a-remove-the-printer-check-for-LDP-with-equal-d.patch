From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: athexweb3 <athexweb3@nirapod.org>
Date: Mon, 12 Oct 2026 23:06:38 +0600
Subject: [PATCH] armv8a: remove the printer check for LDP with equal
 destinations

---
 compiler/src/pp_arm_v8a.ml          | 5 -----
 proofs/compiler/armv8a_instr_decl.v | 3 +--
 2 files changed, 1 insertion(+), 7 deletions(-)

diff --git a/compiler/src/pp_arm_v8a.ml b/compiler/src/pp_arm_v8a.ml
index 5e61719f8..3c93c38e8 100644
--- a/compiler/src/pp_arm_v8a.ml
+++ b/compiler/src/pp_arm_v8a.ml
@@ -210,11 +210,6 @@ module Armv8aTarget : AsmTargetBuilder.AsmTarget with
         match op, args with
         | ARMv8A_op (ADR, _), [ dst; Addr (Arip r) ] ->
             pp_ADR (pp_asm_arg dst) (pp_rip_address r)
-        | ARMv8A_op (LDP, _), Reg r1 :: Reg r2 :: _ when r1 = r2 ->
-            (* CONSTRAINED UNPREDICTABLE (Arm ARM K1.2.17.7); register
-               allocation never produces it. *)
-            hierror ~loc:Lnone ~kind:"assembly printing" ~internal:true
-              "LDP with two equal destination registers"
         | _, _ ->
             let name = pp_mnemonic op in
             (* Registers are printed in the W form when the instruction
diff --git a/proofs/compiler/armv8a_instr_decl.v b/proofs/compiler/armv8a_instr_decl.v
index 704756e76..e2a39c4a4 100644
--- a/proofs/compiler/armv8a_instr_decl.v
+++ b/proofs/compiler/armv8a_instr_decl.v
@@ -2471,8 +2471,7 @@ Let ak_reg_reg_pair :=
      X{datasize}(t2) = data2;
    If t == t2, the behavior is CONSTRAINED UNPREDICTABLE (K1.2.17.7). The
    two destinations are written by the same instruction, so register
-   allocation gives them distinct registers; the assembly printer rejects
-   an LDP whose destinations are equal.
+   allocation gives them distinct registers.
 *)
 Definition armv8a_LDP_semi {ws : wsize} (w : word (wsize_pair ws))
   : sem_ltuple [:: lword ws; lword ws ] :=
