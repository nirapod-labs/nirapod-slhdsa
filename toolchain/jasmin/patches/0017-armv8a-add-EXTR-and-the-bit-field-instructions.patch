     ; SXTB; SXTH; UXTB; UXTH
     ; CMP; CMN; TST
@@ -302,6 +310,12 @@ Definition string_of_armv8a_mnemonic (mn : armv8a_mnemonic) : string :=
   | REV32 => "REV32"
   | CLZ => "CLZ"
   | CLS => "CLS"
+  | BFC => "BFC"
