(*
 * SPDX-FileCopyrightText: nirapod-slhdsa contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * SPHINCS_Refinement.eca
 * ======================
 *
 * The SPHINCS+ procedures of the imported security proof, instantiated
 * with the FIPS 205 functions (SPHINCS_Instance), compute the FIPS 205
 * algorithms on encoded values.
 *
 * The imported model works on n-byte digests held as 8n-bit strings, on
 * addresses held as lists of six indices, and on signatures held as nested
 * lists. The encodings used here:
 *
 *     enc / dec           a digest and its n bytes (bits2b / b2bits)
 *     ab                  a model address and its 32-byte ADRS
 *     enc_ap              an authentication path, root side first in the
 *                         model and leaf side first in FIPS 205
 *     enc_fors, enc_ht    FORS and hypertree signatures and their byte
 *                         strings (Figures 13 and 14)
 *
 * Every procedure is characterised by a statement of probability one, so
 * the statements hold for every run:
 *
 *     WOTS_sign_ph, pkWOTS_from_*_ph   the WOTS+ procedures compute the
 *                                      chains of Algorithms 5 to 8
 *     leaves_ph, xmss_root_enc         the leaves of an XMSS tree are WOTS+
 *                                      public keys and its root is the node
 *                                      of Algorithm 9 at height h'
 *     gen_root_ph                      key generation computes PK.root
 *                                      (Algorithm 18, line 3)
 *     xmss_layer_enc                   a WOTS+ signature with the
 *                                      authentication path built from the
 *                                      tree encodes Algorithm 10
 *     ht_sign_ph                       hypertree signing encodes
 *                                      Algorithm 12
 *     ht_root_ph                       the root recomputed from any
 *                                      hypertree signature is the node
 *                                      Algorithm 13 compares with PK.root
 *     fors_index                       the FORS indices the model reads from
 *                                      the message bits are the base_2b
 *                                      digits of Algorithm 16, line 2
 *     fors_sign_ph, fors_pk_ph         FORS signing and public-key recovery
 *                                      encode Algorithms 16 and 17
 *     mco_props                        message compression yields md,
 *                                      idx_tree and idx_leaf of Algorithm
 *                                      19, lines 6 to 10
 *     sign_refine                      SPHINCS+ signing of (PK || r, M)
 *                                      under (SK.prf, SK.seed, PK.seed), for
 *                                      any n-byte r, yields the bytes of
 *                                      slh_sign_internal(M, SK, r)
 *     verify_refine                    SPHINCS+ verification of the decoding
 *                                      of any byte string of the signature
 *                                      length, on (PK || r, M) for any r,
 *                                      returns slh_verify_internal
 *     keygen_bytes                     the key pair built from the computed
 *                                      root is that of Algorithm 18
 *
 * Both signing modes: the model derives the randomizer from the message
 * seed and the message, whose opt_rand part is PK.seed for deterministic
 * signing and fresh randomness for hedged signing (Algorithm 19, line 2).
 *
 * The parameter set is the abstract P of SPHINCS_Instance.
 *)

require import AllCore List IntDiv Distr StdOrder BitEncoding.
import IntOrder BS2Int.
from Jasmin require import JWord.
require import Bytes FIPS205_Encoding FIPS205_Params FIPS205_Address FIPS205_Hash.
require import FIPS205_WOTS FIPS205_XMSS FIPS205_Hypertree FIPS205_FORS FIPS205_Internal.
require import FIPS205_Encoding_Props FIPS205_Address_Props FIPS205_Hash_Props Validate_Params Bytes.
require import BinaryTrees MerkleTrees MerkleTrees_FIPS205 FIPS205_TreeForms.
require SPHINCS_Instance.

clone include SPHINCS_Instance.

lemma P_facts :
     n_ok P /\ P.`lgw = 4 /\ w P = 16 /\ len1 P = 2 * P.`n /\ len2 P = 3
  /\ len P = 2 * P.`n + 3 /\ P.`h = P.`d * P.`hp
  /\ 1 <= P.`hp <= 9 /\ 1 <= P.`a <= 14 /\ 1 <= P.`k <= 35 /\ 1 <= P.`d <= 22.
proof. exact (ps_facts P P_in). qed.

lemma n_okP : n_ok P by have [#] := P_facts.

lemma n_bounds : 16 <= P.`n <= 32.
proof. by have := n_okP; rewrite /n_ok /#. qed.

(* ------------------------------------------------------------------ *)
(* Digests and their bytes                                            *)

op enc (x : SP.dgstblock) : bytes = bits2b (SP.DigestBlock.val x).
op dec (b : bytes) : SP.dgstblock = SP.DigestBlock.insubd (b2bits b).

lemma size_b2bits (b : bytes) : size (b2bits b) = 8 * size b.
proof.
rewrite /b2bits (List.size_flatten_ctt 8) ?size_map //.
by move=> x /mapP [c [_ ->]]; rewrite W8.size_w2bits.
qed.

lemma b2bitsK (b : bytes) : bits2b (b2bits b) = b.
proof.
rewrite /b2bits /bits2b BitChunking.flattenK //.
+ by move=> x /mapP [c [_ ->]]; rewrite W8.size_w2bits.
by rewrite -map_comp; rewrite (eq_map _ idfun) ?map_id // => c; rewrite /(\o) W8.w2bitsK.
qed.

lemma b2bits_cat (x y : bytes) : b2bits (x ++ y) = b2bits x ++ b2bits y.
proof. by rewrite /b2bits map_cat flatten_cat. qed.

lemma bits2b_cat (x y : bool list) :
  8 %| size x => 8 %| size y => bits2b (x ++ y) = bits2b x ++ bits2b y.
proof.
by move=> hx hy; rewrite -(bits2bK x) // -(bits2bK y) // -b2bits_cat !b2bitsK.
qed.

lemma dvd8_val (x : SP.dgstblock) : 8 %| size (SP.DigestBlock.val x).
proof. by rewrite SP.DigestBlock.valP dvdz_mulr. qed.

lemma size_enc (x : SP.dgstblock) : size (enc x) = P.`n.
proof. by rewrite /enc size_bits2b SP.DigestBlock.valP mulKz. qed.

lemma enc_dec (b : bytes) : size b = P.`n => enc (dec b) = b.
proof.
by move=> hb; rewrite /enc /dec SP.DigestBlock.insubdK 1:size_b2bits 1:hb // b2bitsK.
qed.

lemma dec_enc (x : SP.dgstblock) : dec (enc x) = x.
proof. by rewrite /enc /dec bits2bK 1:dvd8_val SP.DigestBlock.valKd. qed.

lemma enc_inj (x y : SP.dgstblock) : enc x = enc y => x = y.
proof. by move=> h; rewrite -(dec_enc x) h dec_enc. qed.

lemma enc_cat (x y : SP.dgstblock) :
  bits2b (SP.DigestBlock.val x ++ SP.DigestBlock.val y) = enc x ++ enc y.
proof. by rewrite bits2b_cat ?dvd8_val. qed.

lemma enc_flatten (xs : SP.dgstblock list) :
  bits2b (flatten (map SP.DigestBlock.val xs)) = flatten (map enc xs).
proof.
elim: xs => [|x xs ih] /=; first by rewrite flatten_nil /bits2b BitChunking.chunk_nil.
rewrite !flatten_cons bits2b_cat ?dvd8_val ?ih //.
rewrite (List.size_flatten_ctt (8 * P.`n)).
+ by move=> b /mapP [z [_ ->]]; rewrite SP.DigestBlock.valP.
by apply/dvdz_mulr/dvdz_mulr/dvdzz.
qed.

(* ------------------------------------------------------------------ *)
(* The keyed functions and tweakable hashes                           *)

op ab (ad : SP.adrs) : adrs = adrs_bytes (SP.HA.Adrs.val ad).

lemma adrs_bytesE (l : int list) :
  adrs_bytes l = mk_adrs (nth 0 l 5) (nth 0 l 4) (nth 0 l 3) (nth 0 l 2) (nth 0 l 1) (nth 0 l 0).
proof. by rewrite /adrs_bytes /mk_adrs. qed.

lemma enc_insubd (b : bytes) : size b = P.`n => enc (SP.DigestBlock.insubd (b2bits b)) = b.
proof. exact enc_dec. qed.

lemma len_n : len P = 2 * P.`n + 3 by have [#] := P_facts.

lemma SP_len : SP.len = len P.
proof. by rewrite /SP.len /SP.len2 /SP.len1 /SP.w model_len1 model_len2 len_n. qed.

lemma enc_f ps ad x :
  enc (SP.f ps ad x) = F P (NBytes.val ps) (ab ad) (bits2b x).
proof. by rewrite /SP.f /SP.thfc /= enc_insubd // (FIPS205_Hash_Props.size_F _ _ _ _ n_okP). qed.

lemma enc_trh ps ad x :
  enc (SP.trh ps ad x) = H P (NBytes.val ps) (ab ad) (bits2b x).
proof.
rewrite /SP.trh /SP.thfc ifF; first by have := n_bounds; smt().
by rewrite /= enc_insubd // (FIPS205_Hash_Props.size_H _ _ _ _ n_okP).
qed.

lemma enc_pkco ps ad x :
  enc (SP.pkco ps ad x) = T_l P (NBytes.val ps) (ab ad) (bits2b x).
proof.
rewrite /SP.pkco /SP.thfc SP_len len_n ifF; first by have := n_bounds; smt().
rewrite ifF; first by have := n_bounds; smt().
by rewrite enc_insubd // (FIPS205_Hash_Props.size_T_l _ _ _ _ n_okP).
qed.

lemma P_k3 : 3 <= P.`k.
proof.
have := P_in; rewrite /parameter_sets /slh_dsa_sha2_128s /slh_dsa_shake_128s /slh_dsa_sha2_128f.
rewrite /slh_dsa_shake_128f /slh_dsa_sha2_192s /slh_dsa_shake_192s /slh_dsa_sha2_192f.
rewrite /slh_dsa_shake_192f /slh_dsa_sha2_256s /slh_dsa_shake_256s /slh_dsa_sha2_256f.
by rewrite /slh_dsa_shake_256f /=; smt().
qed.

lemma enc_trco ps ad x :
  enc (SP.trco ps ad x) = T_l P (NBytes.val ps) (ab ad) (bits2b x).
proof.
have hk := P_k3.
rewrite /SP.trco /SP.thfc ifF; first by have := n_bounds; smt().
rewrite ifF; first by have := n_bounds; smt().
by rewrite enc_insubd // (FIPS205_Hash_Props.size_T_l _ _ _ _ n_okP).
qed.

lemma enc_skg ss ps ad :
  enc (SP.skg ss (ps, ad))
  = PRF P (NBytes.val ps) (NBytes.val ss) (adrs_bytes (prf_retype (SP.HA.Adrs.val ad))).
proof. by rewrite /SP.skg /= enc_insubd // (FIPS205_Hash_Props.size_PRF _ _ _ _ n_okP). qed.

lemma val_mkg ms (m : bytes * bytes) :
  NBytes.val (SP.mkg ms m) = PRF_msg P (NBytes.val ms) (slice m.`1 (2 * P.`n) (3 * P.`n)) m.`2.
proof. by rewrite /SP.mkg /= NBytes.insubdK // (FIPS205_Hash_Props.size_PRF_msg _ _ _ _ n_okP). qed.

(* ------------------------------------------------------------------ *)
(* Model addresses                                                    *)

(* The index lists of the five address kinds the model uses, with the
   ranges of the honest computation (the validity predicate of the
   imported theory). *)
lemma w_16 : SP.w = 16.
proof. by have [#] _ h4 *:= P_facts; rewrite /SP.w h4. qed.

lemma valid_ch (h c kp t l : int) :
  0 <= h < 15 => 0 <= c < len P => 0 <= kp < 2 ^ P.`hp =>
  0 <= t < 2 ^ (P.`hp * (P.`d - l - 1)) => 0 <= l < P.`d =>
  SP.valid_adrsidxs [h; c; kp; 0; t; l].
proof.
move=> *; rewrite /SP.valid_adrsidxs /SP.adrs_len /SP.valid_idxvals /=; left.
rewrite /SP.valid_idxvalsch /SP.valid_hidx /SP.valid_chidx /SP.valid_kpidx /SP.valid_tidx.
by rewrite /SP.valid_lidx /SP.nr_trees /SP.l' w_16 SP_len /#.
qed.

lemma valid_pkco (kp t l : int) :
  0 <= kp < 2 ^ P.`hp => 0 <= t < 2 ^ (P.`hp * (P.`d - l - 1)) => 0 <= l < P.`d =>
  SP.valid_adrsidxs [0; 0; kp; 1; t; l].
proof.
move=> *; rewrite /SP.valid_adrsidxs /SP.adrs_len /SP.valid_idxvals /=; right; left.
rewrite /SP.valid_idxvalspkco /SP.valid_kpidx /SP.valid_tidx.
by rewrite /SP.valid_lidx /SP.nr_trees /SP.l' /#.
qed.

lemma valid_trhx (b h t l : int) :
  0 <= h <= P.`hp => 0 <= b < 2 ^ (P.`hp - h) =>
  0 <= t < 2 ^ (P.`hp * (P.`d - l - 1)) => 0 <= l < P.`d =>
  SP.valid_adrsidxs [b; h; 0; 2; t; l].
proof.
move=> *; rewrite /SP.valid_adrsidxs /SP.adrs_len /SP.valid_idxvals /=; right; right; left.
rewrite /SP.valid_idxvalstrhx /SP.valid_tbxidx /SP.valid_thxidx /SP.valid_tidx.
by rewrite /SP.valid_lidx /SP.nr_trees /SP.nr_nodesx /#.
qed.

lemma valid_trhf (b h kp t : int) :
  0 <= h <= P.`a => 0 <= b < P.`k * 2 ^ (P.`a - h) => 0 <= kp < 2 ^ P.`hp =>
  0 <= t < 2 ^ (P.`hp * (P.`d - 1)) =>
  SP.valid_adrsidxs [b; h; kp; 3; t; 0].
proof.
move=> *; rewrite /SP.valid_adrsidxs /SP.adrs_len /SP.valid_idxvals /=; right; right; right; left.
rewrite /SP.valid_idxvalstrhf /SP.valid_tbfidx /SP.valid_thfidx /SP.valid_kpidx /SP.valid_tidx.
by rewrite /SP.nr_trees /SP.nr_nodesf /SP.l' /#.
qed.

lemma valid_trco (kp t : int) :
  0 <= kp < 2 ^ P.`hp => 0 <= t < 2 ^ (P.`hp * (P.`d - 1)) =>
  SP.valid_adrsidxs [0; 0; kp; 4; t; 0].
proof.
move=> *; rewrite /SP.valid_adrsidxs /SP.adrs_len /SP.valid_idxvals /=; right; right; right; right.
rewrite /SP.valid_idxvalstrco /SP.valid_kpidx /SP.valid_tidx.
by rewrite /SP.nr_trees /SP.l' /#.
qed.

(* The setters on index lists of known shape. *)
lemma val_set_ltidx ad a0 a1 a2 a3 a4 a5 i j :
  SP.HA.Adrs.val ad = [a0; a1; a2; a3; a4; a5] =>
  SP.valid_adrsidxs [a0; a1; a2; a3; j; i] =>
  SP.HA.Adrs.val (SP.set_ltidx ad i j) = [a0; a1; a2; a3; j; i].
proof. by move=> hv hok; rewrite /SP.set_ltidx hv /= SP.HA.Adrs.insubdK. qed.

lemma val_set_typeidx ad a0 a1 a2 a3 a4 a5 ty :
  SP.HA.Adrs.val ad = [a0; a1; a2; a3; a4; a5] =>
  SP.valid_adrsidxs [0; 0; 0; ty; a4; a5] =>
  SP.HA.Adrs.val (SP.set_typeidx ad ty) = [0; 0; 0; ty; a4; a5].
proof. by move=> hv hok; rewrite /SP.set_typeidx hv /= SP.HA.Adrs.insubdK. qed.

lemma val_set_kpidx ad a0 a1 a2 a3 a4 a5 kp :
  SP.HA.Adrs.val ad = [a0; a1; a2; a3; a4; a5] =>
  SP.valid_adrsidxs [a0; a1; kp; a3; a4; a5] =>
  SP.HA.Adrs.val (SP.set_kpidx ad kp) = [a0; a1; kp; a3; a4; a5].
proof. by move=> hv hok; rewrite /SP.set_kpidx /SP.HA.set_idx hv /= SP.HA.Adrs.insubdK. qed.

lemma val_set_tidx ad a0 a1 a2 a3 a4 a5 t :
  SP.HA.Adrs.val ad = [a0; a1; a2; a3; a4; a5] =>
  SP.valid_adrsidxs [a0; a1; a2; a3; t; a5] =>
  SP.HA.Adrs.val (SP.set_tidx ad t) = [a0; a1; a2; a3; t; a5].
proof. by move=> hv hok; rewrite /SP.set_tidx /SP.HA.set_idx hv /= SP.HA.Adrs.insubdK. qed.

lemma val_set_chidx ad a0 a1 a2 a3 a4 a5 c :
  SP.HA.Adrs.val ad = [a0; a1; a2; a3; a4; a5] =>
  SP.valid_adrsidxs [a0; c; a2; a3; a4; a5] =>
  SP.HA.Adrs.val (SP.FSSLXMTWES.WTWES.set_chidx ad c) = [a0; c; a2; a3; a4; a5].
proof.
by move=> hv hok; rewrite /SP.FSSLXMTWES.WTWES.set_chidx /SP.HA.set_idx hv /= SP.HA.Adrs.insubdK.
qed.

lemma val_set_hidx ad a0 a1 a2 a3 a4 a5 h :
  SP.HA.Adrs.val ad = [a0; a1; a2; a3; a4; a5] =>
  SP.valid_adrsidxs [h; a1; a2; a3; a4; a5] =>
  SP.HA.Adrs.val (SP.FSSLXMTWES.WTWES.set_hidx ad h) = [h; a1; a2; a3; a4; a5].
proof.
by move=> hv hok; rewrite /SP.FSSLXMTWES.WTWES.set_hidx /SP.HA.set_idx hv /= SP.HA.Adrs.insubdK.
qed.

lemma val_set_thtbidx ad a0 a1 a2 a3 a4 a5 i j :
  SP.HA.Adrs.val ad = [a0; a1; a2; a3; a4; a5] =>
  SP.valid_adrsidxs [j; i; a2; a3; a4; a5] =>
  SP.HA.Adrs.val (SP.set_thtbidx ad i j) = [j; i; a2; a3; a4; a5].
proof. by move=> hv hok; rewrite /SP.set_thtbidx hv /= SP.HA.Adrs.insubdK. qed.

lemma val_adz : SP.HA.Adrs.val SP.adz = [0; 0; 0; 0; 0; 0].
proof.
rewrite /SP.adz SP.HA.Adrs.insubdK // valid_ch // 1:len_n; first by have := n_bounds; smt().
+ by rewrite expr_gt0.
+ by rewrite expr_gt0.
by have [#] := P_facts; smt().
qed.

lemma ab_list (l : int list) a0 a1 a2 a3 a4 a5 :
  l = [a0; a1; a2; a3; a4; a5] => adrs_bytes l = mk_adrs a5 a4 a3 a2 a1 a0.
proof. by move=> ->; rewrite adrs_bytesE. qed.

(* ------------------------------------------------------------------ *)
(* WOTS+                                                              *)

lemma em_get (x : SP.dgstblock) (i : int) : 0 <= i < len P =>
  SP.FSSLXMTWES.WTWES.BaseW.val
    (SP.FSSLXMTWES.WTWES.EmsgWOTS."_.[_]" (SP.FSSLXMTWES.WTWES.encode_msgWOTS x) i)
  = nth 0 (wots_digits P (enc x)) i.
proof.
move=> hi; have [hs ha] := wots_digits_range (enc x).
rewrite /SP.FSSLXMTWES.WTWES.encode_msgWOTS SP.FSSLXMTWES.WTWES.EmsgWOTS.getE SP_len hi /=.
rewrite SP.FSSLXMTWES.WTWES.EmsgWOTS.ofemsgWOTSK 1:size_map 1:hs 1:SP_len //.
rewrite (nth_map 0 witness) /=; first by rewrite hs.
rewrite SP.FSSLXMTWES.WTWES.BaseW.insubdK // w_16 -/(enc x).
have := List.allP (fun v => 0 <= v < 16) (wots_digits P (enc x)).
by rewrite ha /= => hall; apply hall; apply mem_nth; rewrite hs.
qed.

lemma digit_range (x : SP.dgstblock) (i : int) : 0 <= i < len P =>
  0 <= nth 0 (wots_digits P (enc x)) i < 16.
proof.
move=> hi; have [hs ha] := wots_digits_range (enc x).
have := List.allP (fun v => 0 <= v < 16) (wots_digits P (enc x)).
by rewrite ha /= => hall; apply hall; apply mem_nth; rewrite hs.
qed.

(* A hypertree position: layer j, tree t on that layer. *)
pred ht_pos (j t : int) = 0 <= j < P.`d /\ 0 <= t < 2 ^ (P.`hp * (P.`d - j - 1)).

lemma enc_cf ps ad (j t kp c s i : int) (x : SP.dgst) :
  SP.HA.Adrs.val ad = [0; c; kp; 0; t; j] => ht_pos j t =>
  0 <= kp < 2 ^ P.`hp => 0 <= c < len P => 0 <= s => 0 <= i => s + i <= 15 =>
  size x = 8 * P.`n =>
  enc (SP.FSSLXMTWES.WTWES.cf ps ad s i x)
  = chain_from P (NBytes.val ps) j t 0 kp c (bits2b x) (range s (s + i)).
proof.
move=> hv [hj ht] hkp hc hs hi hsi hx.
pose g := fun (c' : int) (y : bool list) =>
  SP.DigestBlock.val (SP.f ps (SP.FSSLXMTWES.WTWES.set_hidx ad (s + c')) y).
have inv : forall m, 0 <= m <= i =>
  size (iteri m g x) = 8 * P.`n
  /\ bits2b (iteri m g x) = chain_from P (NBytes.val ps) j t 0 kp c (bits2b x) (range s (s + m)).
+ move=> m [hm0 hmi]; elim: m hm0 hmi => [|m hm ih] hmi; first by rewrite iteri0 // range_geq.
  have [ih1 ih2] := ih _; first smt().
  rewrite iteriS //= /g SP.DigestBlock.valP /= -/(enc _) enc_f ih2.
  rewrite addrA rangeSr 1:/# /chain_from -cats1 foldl_cat /=.
  rewrite /ab (val_set_hidx _ 0 c kp 0 t j (s + m) hv); first by apply valid_ch => /#.
  by rewrite adrs_bytesE.
have [i1 i2] := inv i _; first smt().
by rewrite /SP.FSSLXMTWES.WTWES.cf /enc SP.DigestBlock.insubdK // -/g i2.
qed.

lemma dec_inj_enc (x : SP.dgstblock) (b : bytes) : enc x = b => x = dec b.
proof. by move=> <-; rewrite dec_enc. qed.

lemma prf_wots ad (h c kp t j : int) :
  SP.HA.Adrs.val ad = [h; c; kp; 0; t; j] =>
  adrs_bytes (prf_retype (SP.HA.Adrs.val ad)) = mk_adrs j t WOTS_PRF kp c h.
proof. by move=> hv; rewrite hv /prf_retype /= adrs_bytesE. qed.

op wsk (ss ps : nbytes) (j t kp : int) : SP.dgstblock list =
  mkseq (fun c => dec (wots_sk P (NBytes.val ss) (NBytes.val ps) j t kp c)) (len P).

lemma size_wots_sk ss ps j t kp c : size (wots_sk P ss ps j t kp c) = P.`n.
proof. by rewrite /wots_sk (FIPS205_Hash_Props.size_PRF _ _ _ _ n_okP). qed.

lemma gen_skWOTS_ph ss0 ps0 ad0 (j t kp : int) :
  SP.HA.Adrs.val ad0 = [0; 0; kp; 0; t; j] => ht_pos j t => 0 <= kp < 2 ^ P.`hp =>
  phoare [SP.FSSLXMTWES.WTWES.WOTS_TW_ES.gen_skWOTS :
            arg = (ss0, ps0, ad0) ==> SP.FSSLXMTWES.WTWES.DBLL.val res = wsk ss0 ps0 j t kp] = 1%r.
proof.
move=> hv hpos hkp; proc.
while (skWOTS = mkseq (fun c => dec (wots_sk P (NBytes.val ss0) (NBytes.val ps0) j t kp c)) (size skWOTS)
       /\ size skWOTS <= SP.len /\ ss = ss0 /\ ps = ps0 /\ ad = ad0) (SP.len - size skWOTS).
+ move=> z; auto => /> &hr h1 h2 h3.
  split; last by rewrite size_rcons /#.
  have hc := val_set_chidx ad0 0 0 kp 0 t j (size skWOTS{hr}) hv _.
  + by move: hpos => [? ?]; apply valid_ch => //; smt(SP_len size_ge0).
  have hh := val_set_hidx _ 0 (size skWOTS{hr}) kp 0 t j 0 hc _.
  + by move: hpos => [? ?]; apply valid_ch => //; smt(SP_len size_ge0).
  rewrite size_rcons (prf_wots _ _ _ _ _ _ hh) {1}h1 (mkseqS _ (size skWOTS{hr})) 1:size_ge0 /=.
  by rewrite /dec /wots_sk /= /#.
auto => />; split.
+ by rewrite mkseq0 /=; smt(SP_len len_n n_bounds).
move=> sk; split; first smt().
move=> hnot h1 h2; have hs : size sk = len P.
+ have h3 : SP.len <= size sk by rewrite lerNgt.
  by rewrite -SP_len; apply ler_anti; rewrite h2 h3.
rewrite SP.FSSLXMTWES.WTWES.DBLL.insubdK; first by rewrite SP_len.
by rewrite h1 hs.
qed.

lemma size_chain_fromP ps j t y kp c x js :
  size x = P.`n => size (chain_from P ps j t y kp c x js) = P.`n.
proof. by move=> hx; apply size_chain_from => //; exact n_okP. qed.

lemma enc_val_dec (b : bytes) : size b = P.`n => bits2b (SP.DigestBlock.val (dec b)) = b.
proof. exact enc_dec. qed.

lemma size_val (x : SP.dgstblock) : size (SP.DigestBlock.val x) = 8 * P.`n.
proof. exact SP.DigestBlock.valP. qed.

lemma chain_ok ad (j t kp c : int) :
  SP.HA.Adrs.val ad = [0; 0; kp; 0; t; j] => ht_pos j t => 0 <= kp < 2 ^ P.`hp =>
  0 <= c < len P =>
  SP.HA.Adrs.val (SP.FSSLXMTWES.WTWES.set_chidx ad c) = [0; c; kp; 0; t; j].
proof.
move=> hv [hj ht] hkp hc; apply (val_set_chidx _ 0 0 kp 0 t j c hv).
by apply valid_ch.
qed.

op wpk_elem (ss ps : bytes) (j t kp c : int) : bytes =
  chain_from P ps j t 0 kp c (wots_sk P ss ps j t kp c) (range 0 15).

lemma pkWOTS_from_skWOTS_ph ps0 ad0 ss (j t kp : int) :
  SP.HA.Adrs.val ad0 = [0; 0; kp; 0; t; j] => ht_pos j t => 0 <= kp < 2 ^ P.`hp =>
  phoare [SP.FSSLXMTWES.WTWES.WOTS_TW_ES.pkWOTS_from_skWOTS :
            ps = ps0 /\ ad = ad0 /\ SP.FSSLXMTWES.WTWES.DBLL.val skWOTS = wsk ss ps0 j t kp
            ==> SP.FSSLXMTWES.WTWES.DBLL.val res
                = mkseq (fun c => dec (wpk_elem (NBytes.val ss) (NBytes.val ps0) j t kp c)) (len P)] = 1%r.
proof.
move=> hv hpos hkp; proc.
while (pkWOTS = mkseq (fun c => dec (wpk_elem (NBytes.val ss) (NBytes.val ps0) j t kp c)) (size pkWOTS)
       /\ size pkWOTS <= SP.len /\ SP.FSSLXMTWES.WTWES.DBLL.val skWOTS = wsk ss ps0 j t kp
       /\ ps = ps0 /\ ad = ad0) (SP.len - size pkWOTS).
+ move=> z; auto => /> &hr h1 h2 hsk h3.
  rewrite size_rcons {1}h1 (mkseqS _ (size pkWOTS{hr})) 1:size_ge0 /=.
  have hc : 0 <= size pkWOTS{hr} < len P by smt(size_ge0 SP_len).
  have -> : SP.FSSLXMTWES.WTWES.cf ps0 (SP.FSSLXMTWES.WTWES.set_chidx ad0 (size pkWOTS{hr})) 0 (SP.w - 1)
              (SP.DigestBlock.val (nth witness (SP.FSSLXMTWES.WTWES.DBLL.val skWOTS{hr}) (size pkWOTS{hr})))
            = dec (wpk_elem (NBytes.val ss) (NBytes.val ps0) j t kp (size pkWOTS{hr})).
  + apply dec_inj_enc.
    have hca := chain_ok ad0 j t kp (size pkWOTS{hr}) hv hpos hkp hc.
    have hw : 0 <= SP.w - 1 /\ 0 + (SP.w - 1) <= 15 by rewrite w_16.
    rewrite (enc_cf _ _ j t kp (size pkWOTS{hr}) 0 (SP.w - 1) _ hca hpos hkp hc _ _ _ (size_val _)) //;
      1,2: smt().
    rewrite hsk /wsk nth_mkseq //= enc_val_dec ?size_wots_sk //.
    by rewrite w_16.
  smt().
auto => /> &hr hsk; split.
+ by rewrite mkseq0 /=; smt(SP_len len_n n_bounds).
move=> pk; split; first smt().
move=> hnot h1 h2; have hs : size pk = len P.
+ have h3 : SP.len <= size pk by rewrite lerNgt.
  by rewrite -SP_len; apply ler_anti; rewrite h2 h3.
rewrite SP.FSSLXMTWES.WTWES.DBLL.insubdK; first by rewrite SP_len.
by rewrite h1 hs.
qed.

op wsig_elem (ss ps : bytes) (j t kp : int) (m : bytes) (c : int) : bytes =
  chain_from P ps j t 0 kp c (wots_sk P ss ps j t kp c) (range 0 (nth 0 (wots_digits P m) c)).

lemma WOTS_sign_ph ss0 ps0 ad0 m0 (j t kp : int) :
  SP.HA.Adrs.val ad0 = [0; 0; kp; 0; t; j] => ht_pos j t => 0 <= kp < 2 ^ P.`hp =>
  phoare [SP.FSSLXMTWES.WTWES.WOTS_TW_ES.sign :
            arg = ((ss0, ps0, ad0), m0)
            ==> SP.FSSLXMTWES.WTWES.DBLL.val res
                = mkseq (fun c => dec (wsig_elem (NBytes.val ss0) (NBytes.val ps0) j t kp (enc m0) c))
                        (len P)] = 1%r.
proof.
move=> hv hpos hkp; proc.
while (sig = mkseq (fun c => dec (wsig_elem (NBytes.val ss0) (NBytes.val ps0) j t kp (enc m0) c)) (size sig)
       /\ size sig <= SP.len /\ ps = ps0 /\ ad = ad0 /\ em = SP.FSSLXMTWES.WTWES.encode_msgWOTS m0
       /\ SP.FSSLXMTWES.WTWES.DBLL.val skWOTS = wsk ss0 ps0 j t kp) (SP.len - size sig).
+ move=> z; auto => /> &hr h1 h2 hsk h3.
  rewrite size_rcons {1}h1 (mkseqS _ (size sig{hr})) 1:size_ge0 /=.
  have hc : 0 <= size sig{hr} < len P by split; [apply size_ge0 | move=> _; rewrite -SP_len].
  have hca := chain_ok ad0 j t kp (size sig{hr}) hv hpos hkp hc.
  rewrite em_get //.
  have hd := digit_range m0 (size sig{hr}) hc.
  have -> : SP.FSSLXMTWES.WTWES.cf ps0 (SP.FSSLXMTWES.WTWES.set_chidx ad0 (size sig{hr})) 0
              (nth 0 (wots_digits P (enc m0)) (size sig{hr}))
              (SP.DigestBlock.val (nth witness (SP.FSSLXMTWES.WTWES.DBLL.val skWOTS{hr}) (size sig{hr})))
            = dec (wsig_elem (NBytes.val ss0) (NBytes.val ps0) j t kp (enc m0) (size sig{hr})).
  + apply dec_inj_enc.
    rewrite (enc_cf _ _ j t kp (size sig{hr}) 0 (nth 0 (wots_digits P (enc m0)) (size sig{hr}))
               _ hca hpos hkp hc _ _ _ (size_val _)); 1..3: smt().
    by rewrite hsk /wsk nth_mkseq //= enc_val_dec ?size_wots_sk.
  smt().
wp; call (gen_skWOTS_ph ss0 ps0 ad0 j t kp hv hpos hkp); auto => /> sk hsk; split.
+ by rewrite mkseq0 /=; smt(SP_len len_n n_bounds).
move=> sg; split; first smt().
move=> hnot h1 h2 _; have hs : size sg = len P.
+ have h3 : SP.len <= size sg by rewrite lerNgt.
  by rewrite -SP_len; apply ler_anti; rewrite h2 h3.
rewrite SP.FSSLXMTWES.WTWES.DBLL.insubdK; first by rewrite SP_len.
by rewrite h1 hs.
qed.

op wpkv_elem (ps : bytes) (j t kp : int) (m : bytes) (sig : SP.dgstblock list) (c : int) : bytes =
  chain_from P ps j t 0 kp c (enc (nth witness sig c)) (range (nth 0 (wots_digits P m) c) 15).

lemma pkWOTS_from_sigWOTS_ph m0 sig0 ps0 ad0 (j t kp : int) :
  SP.HA.Adrs.val ad0 = [0; 0; kp; 0; t; j] => ht_pos j t => 0 <= kp < 2 ^ P.`hp =>
  phoare [SP.FSSLXMTWES.WTWES.WOTS_TW_ES.pkWOTS_from_sigWOTS :
            arg = (m0, sig0, ps0, ad0)
            ==> SP.FSSLXMTWES.WTWES.DBLL.val res
                = mkseq (fun c => dec (wpkv_elem (NBytes.val ps0) j t kp (enc m0)
                                                 (SP.FSSLXMTWES.WTWES.DBLL.val sig0) c))
                        (len P)] = 1%r.
proof.
move=> hv hpos hkp; proc.
while (pkWOTS = mkseq (fun c => dec (wpkv_elem (NBytes.val ps0) j t kp (enc m0)
                                               (SP.FSSLXMTWES.WTWES.DBLL.val sig0) c)) (size pkWOTS)
       /\ size pkWOTS <= SP.len /\ ps = ps0 /\ ad = ad0 /\ sig = sig0
       /\ em = SP.FSSLXMTWES.WTWES.encode_msgWOTS m0) (SP.len - size pkWOTS).
+ move=> z; auto => /> &hr h1 h2 h3.
  rewrite size_rcons {1}h1 (mkseqS _ (size pkWOTS{hr})) 1:size_ge0 /=.
  have hc : 0 <= size pkWOTS{hr} < len P by split; [apply size_ge0 | move=> _; rewrite -SP_len].
  have hca := chain_ok ad0 j t kp (size pkWOTS{hr}) hv hpos hkp hc.
  rewrite em_get //.
  have hd := digit_range m0 (size pkWOTS{hr}) hc.
  pose dc := nth 0 (wots_digits P (enc m0)) (size pkWOTS{hr}).
  have -> : SP.FSSLXMTWES.WTWES.cf ps0 (SP.FSSLXMTWES.WTWES.set_chidx ad0 (size pkWOTS{hr})) dc
              (SP.w - 1 - dc)
              (SP.DigestBlock.val (nth witness (SP.FSSLXMTWES.WTWES.DBLL.val sig0) (size pkWOTS{hr})))
            = dec (wpkv_elem (NBytes.val ps0) j t kp (enc m0) (SP.FSSLXMTWES.WTWES.DBLL.val sig0)
                             (size pkWOTS{hr})).
  + apply dec_inj_enc.
    have hw : SP.w - 1 - dc = 15 - dc by rewrite w_16.
    rewrite (enc_cf _ _ j t kp (size pkWOTS{hr}) dc (SP.w - 1 - dc)
               _ hca hpos hkp hc _ _ _ (size_val _)); 1..3: smt().
    have -> : dc + (SP.w - 1 - dc) = 15 by rewrite hw; ring.
    by rewrite /wpkv_elem -/dc.
  smt().
auto => />; split.
+ by rewrite mkseq0 /=; smt(SP_len len_n n_bounds).
move=> pk; split; first smt().
move=> hnot h1 h2; have hs : size pk = len P.
+ have h3 : SP.len <= size pk by rewrite lerNgt.
  by rewrite -SP_len; apply ler_anti; rewrite h2 h3.
rewrite SP.FSSLXMTWES.WTWES.DBLL.insubdK; first by rewrite SP_len.
by rewrite h1 hs.
qed.

(* The same statements with the shape of the address in the precondition,
   for use inside loops whose indices are program values. *)
pred wots_ok (ad : SP.adrs) (j t kp : int) =
  SP.HA.Adrs.val ad = [0; 0; kp; 0; t; j] /\ ht_pos j t /\ 0 <= kp < 2 ^ P.`hp.

lemma gen_skWOTS_pre ss0 ps0 ad0 (j t kp : int) :
  phoare [SP.FSSLXMTWES.WTWES.WOTS_TW_ES.gen_skWOTS :
            arg = (ss0, ps0, ad0) /\ wots_ok ad0 j t kp
            ==> SP.FSSLXMTWES.WTWES.DBLL.val res = wsk ss0 ps0 j t kp] = 1%r.
proof.
case: (wots_ok ad0 j t kp) => [[hv [hpos hkp]] | hn].
+ by conseq (gen_skWOTS_ph ss0 ps0 ad0 j t kp hv hpos hkp) => /#.
by exfalso; move=> &hr.
qed.

lemma pkWOTS_from_skWOTS_pre ps0 ad0 ss (j t kp : int) :
  phoare [SP.FSSLXMTWES.WTWES.WOTS_TW_ES.pkWOTS_from_skWOTS :
            ps = ps0 /\ ad = ad0 /\ wots_ok ad0 j t kp
            /\ SP.FSSLXMTWES.WTWES.DBLL.val skWOTS = wsk ss ps0 j t kp
            ==> SP.FSSLXMTWES.WTWES.DBLL.val res
                = mkseq (fun c => dec (wpk_elem (NBytes.val ss) (NBytes.val ps0) j t kp c)) (len P)] = 1%r.
proof.
case: (wots_ok ad0 j t kp) => [[hv [hpos hkp]] | hn].
+ by conseq (pkWOTS_from_skWOTS_ph ps0 ad0 ss j t kp hv hpos hkp) => /#.
by exfalso; move=> &hr.
qed.

lemma WOTS_sign_pre ss0 ps0 ad0 m0 (j t kp : int) :
  phoare [SP.FSSLXMTWES.WTWES.WOTS_TW_ES.sign :
            arg = ((ss0, ps0, ad0), m0) /\ wots_ok ad0 j t kp
            ==> SP.FSSLXMTWES.WTWES.DBLL.val res
                = mkseq (fun c => dec (wsig_elem (NBytes.val ss0) (NBytes.val ps0) j t kp (enc m0) c))
                        (len P)] = 1%r.
proof.
case: (wots_ok ad0 j t kp) => [[hv [hpos hkp]] | hn].
+ by conseq (WOTS_sign_ph ss0 ps0 ad0 m0 j t kp hv hpos hkp) => /#.
by exfalso; move=> &hr.
qed.

lemma pkWOTS_from_sigWOTS_pre m0 sig0 ps0 ad0 (j t kp : int) :
  phoare [SP.FSSLXMTWES.WTWES.WOTS_TW_ES.pkWOTS_from_sigWOTS :
            arg = (m0, sig0, ps0, ad0) /\ wots_ok ad0 j t kp
            ==> SP.FSSLXMTWES.WTWES.DBLL.val res
                = mkseq (fun c => dec (wpkv_elem (NBytes.val ps0) j t kp (enc m0)
                                                 (SP.FSSLXMTWES.WTWES.DBLL.val sig0) c))
                        (len P)] = 1%r.
proof.
case: (wots_ok ad0 j t kp) => [[hv [hpos hkp]] | hn].
+ by conseq (pkWOTS_from_sigWOTS_ph m0 sig0 ps0 ad0 j t kp hv hpos hkp) => /#.
by exfalso; move=> &hr.
qed.

(* ------------------------------------------------------------------ *)
(* XMSS trees                                                         *)

lemma hp_ge1 : 1 <= P.`hp by have [#] := P_facts.
lemma d_ge1 : 1 <= P.`d by have [#] := P_facts.

lemma lp_eq : SP.l' = 2 ^ P.`hp by done.

lemma wots_pkGen_leaf ss ps (j t i : int) (pk : SP.dgstblock list) :
  0 <= i < 2 ^ P.`hp =>
  pk = mkseq (fun c => dec (wpk_elem ss ps j t i c)) (len P) =>
  T_l P ps (mk_adrs j t WOTS_PK i 0 0) (flatten (map enc pk)) = xmss_leaf P ss ps j t i.
proof.
move=> hi ->; rewrite /xmss_leaf wots_pkGenE.
+ split; first smt(). move=> _; apply (ltr_le_trans (2 ^ P.`hp)); first smt().
  by apply ler_weexpn2l => //; smt(P_facts).
congr; congr; rewrite /mkseq -map_comp; apply eq_in_map => c hc /=.
rewrite /(\o) enc_dec; first by rewrite /wpk_elem; apply size_chain_fromP; apply size_wots_sk.
by rewrite /wpk_elem; have [#] _ _ -> := P_facts.
qed.


lemma wots_ok_kp ad (j t i : int) :
  SP.HA.Adrs.val ad = [0; 0; 0; 0; t; j] => ht_pos j t => 0 <= i < 2 ^ P.`hp =>
  wots_ok (SP.set_kpidx (SP.set_typeidx ad 0) i) j t i.
proof.
move=> hv hpos hi; have [hj ht] := hpos.
have h1 : SP.HA.Adrs.val (SP.set_typeidx ad 0) = [0; 0; 0; 0; t; j].
+ by apply (val_set_typeidx _ 0 0 0 0 t j) => //; apply valid_ch => //; smt(expr_gt0 len_n n_bounds).
have h2 : SP.HA.Adrs.val (SP.set_kpidx (SP.set_typeidx ad 0) i) = [0; 0; i; 0; t; j].
+ by apply (val_set_kpidx _ 0 0 0 0 t j) => //; apply valid_ch => //; smt(len_n n_bounds).
by split.
qed.

lemma pkco_ad ad (j t i : int) :
  SP.HA.Adrs.val ad = [0; 0; 0; 0; t; j] => ht_pos j t => 0 <= i < 2 ^ P.`hp =>
  ab (SP.set_kpidx (SP.set_typeidx ad 1) i) = mk_adrs j t WOTS_PK i 0 0.
proof.
move=> hv hpos hi; have [hj ht] := hpos.
have h1 : SP.HA.Adrs.val (SP.set_typeidx ad 1) = [0; 0; 0; 1; t; j].
+ by apply (val_set_typeidx _ 0 0 0 0 t j) => //; apply valid_pkco => //; smt(expr_gt0).
have h2 : SP.HA.Adrs.val (SP.set_kpidx (SP.set_typeidx ad 1) i) = [0; 0; i; 1; t; j].
+ by apply (val_set_kpidx _ 0 0 0 1 t j) => //; apply valid_pkco.
by rewrite /ab h2 adrs_bytesE.
qed.

lemma leaves_ph ss0 ps0 ad0 (j t : int) :
  SP.HA.Adrs.val ad0 = [0; 0; 0; 0; t; j] => ht_pos j t =>
  phoare [SP.FSSLXMTWES.FL_SL_XMSS_MT_ES.leaves_from_sspsad :
            arg = (ss0, ps0, ad0)
            ==> res = mkseq (fun i => dec (xmss_leaf P (NBytes.val ss0) (NBytes.val ps0) j t i))
                            (2 ^ P.`hp)] = 1%r.
proof.
move=> hv hpos; proc.
while (leaves = mkseq (fun i => dec (xmss_leaf P (NBytes.val ss0) (NBytes.val ps0) j t i)) (size leaves)
       /\ size leaves <= SP.l' /\ ss = ss0 /\ ps = ps0 /\ ad = ad0) (SP.l' - size leaves).
+ move=> z; exlim leaves => lv; wp.
  call (pkWOTS_from_skWOTS_pre ps0 (SP.set_kpidx (SP.set_typeidx ad0 0) (size lv)) ss0 j t (size lv)).
  call (gen_skWOTS_pre ss0 ps0 (SP.set_kpidx (SP.set_typeidx ad0 0) (size lv)) j t (size lv)).
  auto => /> h1 h2 h3.
  have hi : 0 <= size lv < 2 ^ P.`hp by move: h3; rewrite /SP.l'; smt(size_ge0).
  have [hva _] := wots_ok_kp ad0 j t (size lv) hv hpos hi.
  split; first by split => //; apply size_ge0.
  move=> _ _ _ _ _ _ _ sk hsk pk hpk.
  rewrite !size_rcons {1}h1 (mkseqS _ (size lv)) 1:size_ge0 /=.
  split; [split|].
  + congr; apply dec_inj_enc; rewrite enc_pkco (pkco_ad _ j t) // enc_flatten.
    by apply wots_pkGen_leaf.
  + by move: h3; rewrite /SP.l'; smt().
  by smt().
auto => />; split.
+ by rewrite mkseq0 /= /SP.l'; smt(expr_gt0).
move=> lv; split; first smt().
move=> hnot h1 h2; have hs : size lv = 2 ^ P.`hp.
+ have h3 : SP.l' <= size lv by rewrite lerNgt.
  by rewrite -lp_eq; apply ler_anti; rewrite h2 h3.
by rewrite h1 hs.
qed.

lemma updx_eq : SP.FSSLXMTWES.updhbidx = upd_hb.
proof. by apply fun_ext => hb; apply fun_ext => b; rewrite /SP.FSSLXMTWES.updhbidx /upd_hb. qed.

lemma updf_eq : SP.FTWES.updhbidx = upd_hb.
proof. by apply fun_ext => hb; apply fun_ext => b; rewrite /SP.FTWES.updhbidx /upd_hb. qed.

op tm (ps : nbytes) (ad : SP.adrs) (z i : int) (x y : SP.dgstblock) : SP.dgstblock =
  SP.trh ps (SP.set_thtbidx ad z i) (SP.DigestBlock.val x ++ SP.DigestBlock.val y).

lemma trhix_eq ps ad : SP.FSSLXMTWES.trhi ps ad = lift_trh (tm ps ad).
proof.
apply fun_ext => hb; apply fun_ext => x; apply fun_ext => y.
by rewrite /SP.FSSLXMTWES.trhi /lift_trh /tm.
qed.

lemma trhif_eq ps ad : SP.FTWES.trhi ps ad = lift_trh (tm ps ad).
proof.
apply fun_ext => hb; apply fun_ext => x; apply fun_ext => y.
by rewrite /SP.FTWES.trhi /lift_trh /tm.
qed.

lemma xmss_ad ad (j t : int) :
  SP.HA.Adrs.val ad = [0; 0; 0; 0; t; j] => ht_pos j t =>
  SP.HA.Adrs.val (SP.set_typeidx ad 2) = [0; 0; 0; 2; t; j].
proof.
move=> hv [hj ht]; apply (val_set_typeidx _ 0 0 0 0 t j) => //.
by apply valid_trhx => //; smt(expr_gt0 hp_ge1).
qed.

lemma enc_tm_x ps ad (j t z i : int) x y :
  SP.HA.Adrs.val ad = [0; 0; 0; 2; t; j] => ht_pos j t =>
  1 <= z <= P.`hp => 0 <= i < 2 ^ (P.`hp - z) =>
  enc (tm ps ad z i x y) = xmss_hash P (NBytes.val ps) j t z i (enc x) (enc y).
proof.
move=> hv [hj ht] hz hi; rewrite /tm enc_trh enc_cat /xmss_hash /ab.
have h := val_set_thtbidx ad 0 0 0 2 t j z i hv _; first by apply valid_trhx => /#.
by rewrite h adrs_bytesE.
qed.

lemma size_xmss_leafP ss ps j t i : size (xmss_leaf P ss ps j t i) = P.`n.
proof. exact (size_xmss_leaf _ _ _ _ _ _ n_okP). qed.

(* The root of the XMSS tree (j, t). *)
lemma xmss_root_enc ss ps ad (j t : int) :
  SP.HA.Adrs.val ad = [0; 0; 0; 0; t; j] => ht_pos j t =>
  enc (SP.FSSLXMTWES.val_bt_trh ps (SP.set_typeidx ad 2)
         (list2tree (mkseq (fun i => dec (xmss_leaf P (NBytes.val ss) (NBytes.val ps) j t i)) (2 ^ P.`hp))))
  = xmss_node P (NBytes.val ss) 0 P.`hp (NBytes.val ps) (mk_adrs j t 0 0 0 0).
proof.
move=> hv hpos; have hx := xmss_ad ad j t hv hpos.
rewrite /SP.FSSLXMTWES.val_bt_trh updx_eq trhix_eq.
rewrite (_: mkseq (fun i => dec (xmss_leaf P (NBytes.val ss) (NBytes.val ps) j t i)) (2 ^ P.`hp)
          = mkseq (fun i => dec (xmss_leaf P (NBytes.val ss) (NBytes.val ps) j t (0 * 2 ^ P.`hp + i)))
                  (2 ^ P.`hp)).
+ by apply eq_in_mkseq.
rewrite -(gnode_list2tree (fun i => dec (xmss_leaf P (NBytes.val ss) (NBytes.val ps) j t i))
                          (tm ps (SP.set_typeidx ad 2)) P.`hp 0); first smt(hp_ge1).
rewrite xmss_nodeE (gnode_hom enc _ _ (xmss_leaf P (NBytes.val ss) (NBytes.val ps) j t)
                       (xmss_hash P (NBytes.val ps) j t) 1 P.`hp P.`hp 0) //; first smt(hp_ge1).
+ by move=> i hi /=; rewrite enc_dec // size_xmss_leafP.
by move=> z' i' x y hz hi /=; rewrite (enc_tm_x _ _ j t) // /#.
qed.

lemma lt_ad (j t : int) : ht_pos j t =>
  SP.HA.Adrs.val (SP.set_ltidx SP.adz j t) = [0; 0; 0; 0; t; j].
proof.
move=> [hj ht]; apply (val_set_ltidx _ 0 0 0 0 0 0) => //; first by apply val_adz.
by apply valid_ch => //; smt(len_n n_bounds expr_gt0).
qed.

lemma top_pos : ht_pos (P.`d - 1) 0.
proof.
rewrite /ht_pos; have -> : P.`d - (P.`d - 1) - 1 = 0 by ring.
by rewrite /= ?mulr0 ?expr0; smt(d_ge1).
qed.

lemma gen_root_ph ss0 ps0 :
  phoare [SP.FSSLXMTWES.FL_SL_XMSS_MT_ES.gen_root :
            arg = (ss0, ps0, SP.adz)
            ==> enc res = xmss_node P (NBytes.val ss0) 0 P.`hp (NBytes.val ps0)
                                    (mk_adrs (P.`d - 1) 0 0 0 0 0)] = 1%r.
proof.
proc; wp.
call (leaves_ph ss0 ps0 (SP.set_ltidx SP.adz (P.`d - 1) 0) (P.`d - 1) 0 (lt_ad _ _ top_pos) top_pos).
auto => />.
by rewrite (xmss_root_enc _ _ _ (P.`d - 1) 0 (lt_ad _ _ top_pos) top_pos).
qed.

(* The byte string of one XMSS signature of the hypertree (Figure 11):
   the WOTS+ signature, then the authentication path from the leaf up. *)
op enc_layer (sa : SP.FSSLXMTWES.WTWES.sigWOTS * SP.FSSLXMTWES.apFLXMSSTW) : bytes =
  flatten (map enc (SP.FSSLXMTWES.WTWES.DBLL.val sa.`1))
  ++ flatten (map enc (rev (SP.FSSLXMTWES.DBHPL.val sa.`2))).

op enc_ht (sig : SP.FSSLXMTWES.sigFLSLXMSSMTTW) : bytes =
  flatten (map enc_layer (SP.FSSLXMTWES.SAPDL.val sig)).

lemma wots_sign_enc ss ps (j t kp : int) m :
  0 <= kp < 2 ^ 32 =>
  flatten (map enc (mkseq (fun c => dec (wsig_elem ss ps j t kp m c)) (len P)))
  = wots_sign P m ss ps (mk_adrs j t 0 kp 0 0).
proof.
move=> hkp; rewrite wots_signE // /mkseq -map_comp; congr; apply eq_in_map => c hc.
by rewrite /(\o) enc_dec // /wsig_elem size_chain_fromP // size_wots_sk.
qed.

lemma hp32 : 2 ^ P.`hp <= 2 ^ 32.
proof. by apply ler_weexpn2l => //; smt(P_facts). qed.

lemma lt_hp32 (x : int) : 0 <= x < 2 ^ P.`hp => 0 <= x < 2 ^ 32.
proof.
move=> [h0 h1]; split => // _.
by apply (ltr_le_trans (2 ^ P.`hp)) => //; exact hp32.
qed.

lemma xmss_layer_enc ss ps (m : SP.dgstblock) (j t kp : int) sw ap :
  ht_pos j t => 0 <= kp < 2 ^ P.`hp =>
  SP.FSSLXMTWES.WTWES.DBLL.val sw
    = mkseq (fun c => dec (wsig_elem (NBytes.val ss) (NBytes.val ps) j t kp (enc m) c)) (len P) =>
  ap = SP.FSSLXMTWES.cons_ap_trh ps (SP.set_typeidx (SP.set_ltidx SP.adz j t) 2)
         (list2tree (mkseq (fun i => dec (xmss_leaf P (NBytes.val ss) (NBytes.val ps) j t i)) (2 ^ P.`hp)))
         kp =>
  enc_layer (sw, ap) = xmss_sign P (enc m) (NBytes.val ss) kp (NBytes.val ps) (mk_adrs j t 0 0 0 0).
proof.
move=> hpos hkp hsw ->.
have hkp32 : 0 <= kp < 2 ^ 32 by apply lt_hp32.
have hA := xmss_ad _ j t (lt_ad j t hpos) hpos.
rewrite /enc_layer /= hsw wots_sign_enc // xmss_signE //; congr; first by rewrite /WOTS_HASH.
rewrite /SP.FSSLXMTWES.cons_ap_trh /SP.FSSLXMTWES.cons_ap_trh_gen updx_eq trhix_eq.
have h0 : kp %/ 2 ^ P.`hp = 0 by rewrite divz_small // ger0_norm 1:expr_ge0.
have hc := gnode_cons_ap (fun i => dec (xmss_leaf P (NBytes.val ss) (NBytes.val ps) j t i))
             (tm ps (SP.set_typeidx (SP.set_ltidx SP.adz j t) 2)) P.`hp kp _ _; 1,2: smt(hp_ge1).
move: hc; rewrite h0 /= => hc; rewrite hc.
rewrite SP.FSSLXMTWES.DBHPL.insubdK.
+ by rewrite size_rev size_map size_range; smt(hp_ge1).
rewrite revK -map_comp; congr; apply eq_in_map => j' /mem_range hj' /=.
rewrite /(\o) (gnode_hom enc _ _ (xmss_leaf P (NBytes.val ss) (NBytes.val ps) j t)
                 (xmss_hash P (NBytes.val ps) j t) 1 P.`hp j') //; 1: smt().
+ by rewrite /= (sibling_pow_lt kp P.`hp j').
+ by move=> i hi /=; rewrite enc_dec // size_xmss_leafP.
by move=> z' i' x y hz hi /=; rewrite (enc_tm_x _ _ j t) // /#.
qed.

lemma leaves_pre ss0 ps0 ad0 (j t : int) :
  phoare [SP.FSSLXMTWES.FL_SL_XMSS_MT_ES.leaves_from_sspsad :
            arg = (ss0, ps0, ad0) /\ SP.HA.Adrs.val ad0 = [0; 0; 0; 0; t; j] /\ ht_pos j t
            ==> res = mkseq (fun i => dec (xmss_leaf P (NBytes.val ss0) (NBytes.val ps0) j t i))
                            (2 ^ P.`hp)] = 1%r.
proof.
case: (SP.HA.Adrs.val ad0 = [0; 0; 0; 0; t; j] /\ ht_pos j t) => [[hv hpos] | hn].
+ by conseq (leaves_ph ss0 ps0 ad0 j t hv hpos) => /#.
by exfalso; move=> &hr.
qed.

(* ------------------------------------------------------------------ *)
(* The hypertree                                                      *)

lemma ht_pos_layer (it j : int) :
  0 <= it < 2 ^ (P.`hp * (P.`d - 1)) => 0 <= j < P.`d =>
  ht_pos j (ht_tree P it j).
proof.
move=> hit hj; rewrite /ht_pos; split => //; rewrite /ht_tree.
have -> : P.`hp * (P.`d - j - 1) = P.`hp * (P.`d - 1) - P.`hp * j by ring.
apply div_pow_lt => //; split; first smt(mulr_ge0 hp_ge1).
by move=> _; apply ler_wpmul2l; smt(hp_ge1).
qed.

lemma tidx_step (it il j : int) :
  0 <= il < 2 ^ P.`hp => 0 <= j =>
  (it * 2 ^ P.`hp + il) %/ 2 ^ (P.`hp * j) %/ 2 ^ P.`hp = ht_tree P it j
  /\ (it * 2 ^ P.`hp + il) %/ 2 ^ (P.`hp * j) %% 2 ^ P.`hp = ht_leaf P it il j
  /\ (it * 2 ^ P.`hp + il) %/ 2 ^ (P.`hp * (j + 1)) = ht_tree P it j.
proof.
move=> hil hj; have h1 := hp_ge1.
have hs : (it * 2 ^ P.`hp + il) %/ 2 ^ (P.`hp * (j + 1))
          = (it * 2 ^ P.`hp + il) %/ 2 ^ (P.`hp * j) %/ 2 ^ P.`hp.
+ have -> : P.`hp * (j + 1) = P.`hp * j + P.`hp by ring.
  rewrite exprD_nneg; [smt(mulr_ge0) | smt() |].
  by rewrite divzMr; 1,2: by apply expr_ge0.
rewrite hs.
have hdiv : (it * 2 ^ P.`hp + il) %/ 2 ^ P.`hp = it.
+ by rewrite divzMDl 1:gtr_eqF 1:expr_gt0 // divz_small // ger0_norm 1:expr_ge0.
case: (j = 0) => [-> /= | hj0].
+ rewrite /ht_tree /ht_leaf /= ?expr0 ?divz1 hdiv /=.
  by rewrite modzMDl modz_small // ger0_norm 1:expr_ge0.
have hsplit : (it * 2 ^ P.`hp + il) %/ 2 ^ (P.`hp * j) = ht_tree P it (j - 1).
+ have he : 2 ^ (P.`hp * j) = 2 ^ P.`hp * 2 ^ (P.`hp * (j - 1)).
  + rewrite -exprD_nneg; [smt() | smt(mulr_ge0) | congr; ring].
  rewrite /ht_tree he divzMr; 1,2: by apply expr_ge0.
  by rewrite hdiv.
rewrite hsplit /ht_leaf hj0 /= ht_treeS 1,2:/#.
by rewrite (_: j - 1 + 1 = j) 1:/#.
qed.

lemma ht_sign_ph ss0 ps0 m0 idx0 (it il : int) :
  SP.Index.val idx0 = it * 2 ^ P.`hp + il => 0 <= il < 2 ^ P.`hp =>
  0 <= it < 2 ^ (P.`hp * (P.`d - 1)) =>
  phoare [SP.FSSLXMTWES.FL_SL_XMSS_MT_ES.sign :
            arg = ((ss0, ps0, SP.adz), m0, idx0)
            ==> enc_ht res = ht_sign P (enc m0) (NBytes.val ss0) (NBytes.val ps0) it il] = 1%r.
proof.
move=> hidx hil hit; proc.
pose sigx := fun j => xmss_sign P (ht_msg P (enc m0) (NBytes.val ss0) (NBytes.val ps0) it j)
                        (NBytes.val ss0) (ht_leaf P it il j) (NBytes.val ps0)
                        (mk_adrs j (ht_tree P it j) 0 0 0 0).
wp; while (0 <= size sapl <= P.`d /\ ss = ss0 /\ ps = ps0 /\ ad = SP.adz
       /\ tidx = (it * 2 ^ P.`hp + il) %/ 2 ^ (P.`hp * size sapl)
       /\ enc root = ht_msg P (enc m0) (NBytes.val ss0) (NBytes.val ps0) it (size sapl)
       /\ map enc_layer sapl = map sigx (range 0 (size sapl))) (P.`d - size sapl).
+ move=> z; exlim sapl, tidx, root => sa ti r.
  wp.
  call (leaves_pre ss0 ps0 (SP.set_ltidx SP.adz (size sa) (ti %/ 2 ^ P.`hp)) (size sa) (ti %/ 2 ^ P.`hp)).
  call (WOTS_sign_pre ss0 ps0
          (SP.set_kpidx (SP.set_typeidx (SP.set_ltidx SP.adz (size sa) (ti %/ 2 ^ P.`hp)) 0) (ti %% 2 ^ P.`hp))
          r (size sa) (ti %/ 2 ^ P.`hp) (ti %% 2 ^ P.`hp)).
  auto => /> h0 hd hr hmap hlt; rewrite /SP.l'.
  have [ht [hl ht1]] := tidx_step it il (size sa) hil h0.
  rewrite ht hl.
  have hpos := ht_pos_layer it (size sa) hit _; first smt().
  have hkp := ht_leaf_range P it il (size sa) hil.
  have hlt' := lt_ad (size sa) (ht_tree P it (size sa)) hpos.
  have hw := wots_ok_kp _ _ _ _ hlt' hpos hkp.
  split; first by move: hw; rewrite /wots_ok /ht_pos.
  move=> _ _ _ _ _ _ _ _ sw hsw; split; first by move: hpos; rewrite /ht_pos.
  move=> _ _; rewrite !size_rcons.
  split; last smt().
  split; first smt().
  split; first by rewrite ht1.
  split.
  + by rewrite (xmss_root_enc _ _ _ (size sa) (ht_tree P it (size sa)) hlt' hpos) /ht_msg /#.
  rewrite map_rcons rangeSr // map_rcons hmap; congr.
  by rewrite /sigx -hr; apply (xmss_layer_enc ss0 ps0 r (size sa) (ht_tree P it (size sa)) (ht_leaf P it il (size sa))).
auto => />; split.
+ by split; [smt(d_ge1) | rewrite range_geq].
move=> r sa; split; first smt().
move=> hnot h0 hd _ hmap.
have hs : size sa = P.`d by smt().
rewrite /enc_ht SP.FSSLXMTWES.SAPDL.insubdK 1:hs //.
by rewrite (ht_signE P _ _ _ _ _ P_in hil) -hs -hmap.
qed.

(* ------------------------------------------------------------------ *)
(* Hypertree verification                                             *)

lemma size_flatten_enc (xs : SP.dgstblock list) : size (flatten (map enc xs)) = P.`n * size xs.
proof.
rewrite (size_flatten_n _ P.`n) ?size_map //.
by move=> b /mapP [x [_ ->]]; rewrite size_enc.
qed.

lemma slice_flatten_enc (xs : SP.dgstblock list) (k : int) :
  0 <= k < size xs =>
  slice (flatten (map enc xs)) (k * P.`n) ((k + 1) * P.`n) = enc (nth witness xs k).
proof.
move=> hk; rewrite (slice_flatten _ P.`n); 1: smt(n_bounds).
+ by move=> b /mapP [x [_ ->]]; rewrite size_enc.
+ by rewrite size_map.
by rewrite (nth_map witness).
qed.

lemma size_enc_layer (sa : SP.FSSLXMTWES.WTWES.sigWOTS * SP.FSSLXMTWES.apFLXMSSTW) :
  size (enc_layer sa) = xmss_sig_length P.
proof.
rewrite /enc_layer size_cat !size_flatten_enc size_rev SP.FSSLXMTWES.WTWES.DBLL.valP.
by rewrite SP.FSSLXMTWES.DBHPL.valP SP_len /xmss_sig_length; ring.
qed.

lemma wots_pkFromSig_enc ps (j t kp : int) (m : SP.dgstblock) (sw : SP.FSSLXMTWES.WTWES.sigWOTS) :
  0 <= kp < 2 ^ 32 =>
  T_l P ps (mk_adrs j t WOTS_PK kp 0 0)
    (flatten (map enc (mkseq (fun c => dec (wpkv_elem ps j t kp (enc m)
                                              (SP.FSSLXMTWES.WTWES.DBLL.val sw) c)) (len P))))
  = wots_pkFromSig P (flatten (map enc (SP.FSSLXMTWES.WTWES.DBLL.val sw))) (enc m) ps
                   (mk_adrs j t WOTS_HASH kp 0 0).
proof.
move=> hkp; rewrite wots_pkFromSigE //; congr; congr.
rewrite /mkseq -map_comp; apply eq_in_map => c /mem_iota hc.
rewrite /(\o) /= enc_dec.
+ by rewrite /wpkv_elem size_chain_fromP // size_enc.
rewrite /wpkv_elem slice_flatten_enc.
+ by rewrite SP.FSSLXMTWES.WTWES.DBLL.valP SP_len /#.
by have [#] _ _ -> := P_facts.
qed.

lemma auth_rev (ap : SP.FSSLXMTWES.apFLXMSSTW) :
  SP.FSSLXMTWES.DBHPL.val ap
  = rev (map (fun k => nth witness (rev (SP.FSSLXMTWES.DBHPL.val ap)) k) (range 0 P.`hp)).
proof.
rewrite -{1}(revK (SP.FSSLXMTWES.DBHPL.val ap)); congr.
have hs : size (rev (SP.FSSLXMTWES.DBHPL.val ap)) = P.`hp by rewrite size_rev SP.FSSLXMTWES.DBHPL.valP.
apply (eq_from_nth witness); first by rewrite size_map size_range hs; smt(hp_ge1).
move=> k; rewrite hs => hk; rewrite (nth_map 0) 1:size_range 1:/#.
by rewrite nth_range.
qed.

lemma xmss_verify_layer ps (j t kp : int) (r : SP.dgstblock) sw ap pk :
  ht_pos j t => 0 <= kp < 2 ^ P.`hp =>
  SP.FSSLXMTWES.WTWES.DBLL.val pk
    = mkseq (fun c => dec (wpkv_elem (NBytes.val ps) j t kp (enc r) (SP.FSSLXMTWES.WTWES.DBLL.val sw) c))
            (len P) =>
  enc (SP.FSSLXMTWES.val_ap_trh ps (SP.set_typeidx (SP.set_ltidx SP.adz j t) 2) ap kp
         (SP.pkco ps (SP.set_kpidx (SP.set_typeidx (SP.set_ltidx SP.adz j t) 1) kp)
            (flatten (map SP.DigestBlock.val (SP.FSSLXMTWES.WTWES.DBLL.val pk)))))
  = xmss_pkFromSig P kp (enc_layer (sw, ap)) (enc r) (NBytes.val ps) (mk_adrs j t 0 0 0 0).
proof.
move=> hpos hkp hpk.
have hkp32 := lt_hp32 kp hkp.
have hlt := lt_ad j t hpos.
have hA := xmss_ad _ j t hlt hpos.
rewrite xmss_pkFromSigE //; first smt(hp_ge1).
rewrite /SP.FSSLXMTWES.val_ap_trh /SP.FSSLXMTWES.val_ap_trh_gen updx_eq trhix_eq.
rewrite {1}auth_rev.
have h0 : kp %/ 2 ^ P.`hp = 0 by rewrite divz_small // ger0_norm 1:expr_ge0.
pose lf := SP.pkco ps (SP.set_kpidx (SP.set_typeidx (SP.set_ltidx SP.adz j t) 1) kp)
             (flatten (map SP.DigestBlock.val (SP.FSSLXMTWES.WTWES.DBLL.val pk))).
have hv := gfold_val_ap (tm ps (SP.set_typeidx (SP.set_ltidx SP.adz j t) 2))
             (fun k => nth witness (rev (SP.FSSLXMTWES.DBHPL.val ap)) k) kp lf P.`hp _.
+ smt(hp_ge1).
move: hv; rewrite h0 => hv; rewrite -hv.
rewrite (gfold_hom enc _ (xmss_hash P (NBytes.val ps) j t)); first smt(hp_ge1).
+ move=> k x y hk; rewrite (enc_tm_x _ _ j t) //; first smt().
  by apply div_pow_lt; smt().
have hsw : size (flatten (map enc (SP.FSSLXMTWES.WTWES.DBLL.val sw))) = len P * P.`n.
+ by rewrite size_flatten_enc SP.FSSLXMTWES.WTWES.DBLL.valP SP_len; ring.
have hsa : size (flatten (map enc (rev (SP.FSSLXMTWES.DBHPL.val ap)))) = P.`hp * P.`n.
+ by rewrite size_flatten_enc size_rev SP.FSSLXMTWES.DBHPL.valP; ring.
have hW : slice (enc_layer (sw, ap)) 0 (len P * P.`n)
          = flatten (map enc (SP.FSSLXMTWES.WTWES.DBLL.val sw)).
+ have hln : 0 <= len P * P.`n by apply mulr_ge0; smt(len_n n_bounds).
  rewrite /enc_layer /= slice_cat_l; first by rewrite hsw; smt().
  by rewrite -hsw slice_whole.
have hAu : slice (enc_layer (sw, ap)) (len P * P.`n) ((len P + P.`hp) * P.`n)
           = flatten (map enc (rev (SP.FSSLXMTWES.DBHPL.val ap))).
+ rewrite /enc_layer /= slice_cat_r; first by rewrite hsw.
  have -> : (len P + P.`hp) * P.`n - size (flatten (map enc (SP.FSSLXMTWES.WTWES.DBLL.val sw)))
            = size (flatten (map enc (rev (SP.FSSLXMTWES.DBHPL.val ap)))) by rewrite hsw hsa; ring.
  by rewrite hsw /= slice_whole.
rewrite hW hAu.
rewrite (gfold_eq_auth _ _ (fun k => slice (flatten (map enc (rev (SP.FSSLXMTWES.DBHPL.val ap))))
                                           (k * P.`n) ((k + 1) * P.`n))); first smt(hp_ge1).
+ move=> k hk /=; rewrite slice_flatten_enc //.
  by rewrite size_rev SP.FSSLXMTWES.DBHPL.valP.
congr.
rewrite /lf enc_pkco (pkco_ad _ j t) // enc_flatten hpk.
by apply wots_pkFromSig_enc.
qed.

op ht_fold (ps : bytes) (it il : int) (sig : SP.FSSLXMTWES.sigFLSLXMSSMTTW) (m : bytes) (i : int) : bytes =
  foldl (fun (node : bytes) (j : int) =>
           xmss_pkFromSig P (ht_leaf P it il j) (enc_layer (nth witness (SP.FSSLXMTWES.SAPDL.val sig) j))
             node ps (mk_adrs j (ht_tree P it j) 0 0 0 0))
        m (range 0 i).

lemma ht_root_ph m0 sig0 idx0 ps0 (it il : int) :
  SP.Index.val idx0 = it * 2 ^ P.`hp + il => 0 <= il < 2 ^ P.`hp =>
  0 <= it < 2 ^ (P.`hp * (P.`d - 1)) =>
  phoare [SP.FSSLXMTWES.FL_SL_XMSS_MT_ES.root_from_sigFLSLXMSSMTTW :
            arg = (m0, sig0, idx0, ps0, SP.adz)
            ==> enc res = ht_fold (NBytes.val ps0) it il sig0 (enc m0) P.`d] = 1%r.
proof.
move=> hidx hil hit; proc.
while (0 <= i <= P.`d /\ ps = ps0 /\ ad = SP.adz /\ sig = sig0
       /\ tidx = (it * 2 ^ P.`hp + il) %/ 2 ^ (P.`hp * i)
       /\ enc root = ht_fold (NBytes.val ps0) it il sig0 (enc m0) i) (P.`d - i).
+ move=> z; exlim i, tidx, root => i0 ti r.
  wp.
  call (pkWOTS_from_sigWOTS_pre r (nth witness (SP.FSSLXMTWES.SAPDL.val sig0) i0).`1 ps0
          (SP.set_kpidx (SP.set_typeidx (SP.set_ltidx SP.adz i0 (ti %/ 2 ^ P.`hp)) 0) (ti %% 2 ^ P.`hp))
          i0 (ti %/ 2 ^ P.`hp) (ti %% 2 ^ P.`hp)).
  auto => /> h0 hd hr hlt; rewrite /SP.l'.
  have [ht [hl ht1]] := tidx_step it il i0 hil h0.
  rewrite ht hl.
  have hpos := ht_pos_layer it i0 hit _; first smt().
  have hkp := ht_leaf_range P it il i0 hil.
  have hlt' := lt_ad i0 (ht_tree P it i0) hpos.
  have hw := wots_ok_kp _ _ _ _ hlt' hpos hkp.
  split; first by move: hw; rewrite /wots_ok /ht_pos.
  move=> _ _ _ _ _ _ _ _ pk hpk.
  split; last smt().
  split; first smt().
  split; first by rewrite ht1.
  rewrite (xmss_verify_layer _ _ _ _ r _ _ pk hpos hkp hpk).
  rewrite /ht_fold (rangeSr 0 i0) 1:/# -cats1 foldl_cat /=.
  rewrite -/(ht_fold (NBytes.val ps0) it il sig0 (enc m0) i0) -hr.
  by case: (nth witness (SP.FSSLXMTWES.SAPDL.val sig0) i0).
auto => />; split.
+ by split; [smt(d_ge1) | rewrite /ht_fold range_geq].
move=> i r; split; first smt().
move=> hnot h0 hd hr.
by rewrite hr (_: i = P.`d) 1:/#.
qed.


(* ------------------------------------------------------------------ *)
(* The FORS indices of the message digest                             *)

lemma size_msb (y : bytes) : size (msb_bits y) = 8 * size y.
proof.
rewrite /msb_bits (List.size_flatten_ctt 8) ?size_map //.
by move=> x /mapP [c [_ ->]]; rewrite size_rev W8.size_w2bits.
qed.

lemma msb_rcons (y : bytes) (c : W8.t) : msb_bits (rcons y c) = msb_bits y ++ rev (W8.w2bits c).
proof. by rewrite /msb_bits -cats1 map_cat flatten_cat /= flatten_seq1. qed.

lemma msb_be (y : bytes) : bs2int (rev (msb_bits y)) = be_int y.
proof.
elim/last_ind: y => [|y c ih]; first by rewrite /msb_bits /be_int /= flatten_nil rev_nil bs2int_nil.
rewrite msb_rcons rev_cat revK bs2int_cat ih W8.size_w2bits.
have -> : max 0 8 = 8 by done.
by rewrite be_int_rcons W8.to_uintE /=; ring.
qed.

lemma take_msb (y : bytes) (c : int) :
  0 <= c <= size y => take (8 * c) (msb_bits y) = msb_bits (take c y).
proof.
move=> hc; rewrite -{1}(cat_take_drop c y) /msb_bits map_cat flatten_cat.
rewrite take_size_cat //.
rewrite -/(msb_bits (take c y)) size_msb size_take; smt().
qed.

lemma bs2int_rev_take (s : bool list) (e : int) :
  0 <= e <= size s => bs2int (rev (take e s)) = bs2int (rev s) %/ 2 ^ (size s - e).
proof.
move=> he; rewrite -{2}(cat_take_drop e s) rev_cat bs2int_cat size_rev size_drop 1:/#.
rewrite (_: max 0 (size s - e) = size s - e) 1:/#.
rewrite (mulzC (2 ^ (size s - e))) divzMDr 1:gtr_eqF 1:expr_gt0 // divz_small //.
rewrite bs2int_ge0 /= ger0_norm 1:expr_ge0 //.
by have := bs2int_le2Xs (rev (drop e s)); rewrite size_rev size_drop 1:/# /#.
qed.

lemma bs2int_rev_window (s : bool list) (o b : int) :
  0 <= o => 0 <= b => o + b <= size s =>
  bs2int (rev (take b (drop o s))) = bs2int (rev (take (o + b) s)) %% 2 ^ b.
proof.
move=> ho hb hob; rewrite takeD // rev_cat bs2int_cat size_rev size_take //.
have hw : b <= size (drop o s) by rewrite size_drop // /#.
rewrite (_: (if b < size (drop o s) then b else size (drop o s)) = b) 1:/#.
rewrite (mulzC (2 ^ b)) modzMDr modz_small //.
rewrite bs2int_ge0 /= ger0_norm 1:expr_ge0 //.
by have := bs2int_le2Xs (rev (take b (drop o s))); rewrite size_rev size_take // /#.
qed.

lemma fors_index (md : bytes) (a k i : int) :
  0 < a => 0 <= i < k => cdiv (k * a) 8 <= size md =>
  bs2int (rev (take a (drop (a * i) (take (k * a) (msb_bits md))))) = nth 0 (base_2b md a k) i.
proof.
move=> ha hi hsz.
have hka : 0 <= k * a by smt().
rewrite drop_take; 1,2: smt().
rewrite take_take ifT 1:/#.
rewrite bs2int_rev_window; 1..2: smt().
+ rewrite size_msb; smt(divz_eq).
rewrite nth_base_2b // /digit /=.
pose ci := cdiv ((i + 1) * a) 8.
have hci : (i + 1) * a <= 8 * ci /\ 0 <= ci <= size md.
+ have hia : 0 <= (i + 1) * a <= k * a by smt().
  split; first by rewrite /ci /cdiv; smt(divz_eq modz_ge0 ltz_pmod).
  split; first by rewrite /ci /cdiv; apply divz_ge0 => /#.
  move=> _; apply (ler_trans (cdiv (k * a) 8)) => //.
  by rewrite /ci /cdiv; apply leq_div2r => /#.
have -> : a * i + a = (i + 1) * a by ring.
have -> : take ((i + 1) * a) (msb_bits md) = take ((i + 1) * a) (take (8 * ci) (msb_bits md)).
+ by rewrite take_take ifT //; case: hci.
rewrite take_msb 1:/# bs2int_rev_take.
+ rewrite size_msb size_take; smt().
by rewrite msb_be size_msb size_take; smt().
qed.

(* ------------------------------------------------------------------ *)
(* FORS                                                               *)



lemma a_ge1 : 1 <= P.`a by have [#] := P_facts.
lemma k_ge1 : 1 <= P.`k by have [#] := P_facts.

pred fors_ok (ad : SP.adrs) (t kp : int) =
  SP.HA.Adrs.val ad = [0; 0; kp; 3; t; 0] /\ 0 <= t < 2 ^ (P.`hp * (P.`d - 1)) /\ 0 <= kp < 2 ^ P.`hp.

lemma thtb_f ad (t kp h b : int) :
  fors_ok ad t kp => 0 <= h <= P.`a => 0 <= b < P.`k * 2 ^ (P.`a - h) =>
  SP.HA.Adrs.val (SP.set_thtbidx ad h b) = [b; h; kp; 3; t; 0].
proof.
move=> [hv [ht hkp]] hh hb; apply (val_set_thtbidx _ 0 0 kp 3 t 0) => //.
by apply valid_trhf.
qed.

lemma size_fors_leaf ss ps l t y kp i : size (fors_leaf P ss ps l t y kp i) = P.`n.
proof. by rewrite /fors_leaf (FIPS205_Hash_Props.size_F _ _ _ _ n_okP). qed.

lemma leaf_range (i j : int) :
  0 <= i < P.`k => 0 <= j < 2 ^ P.`a => 0 <= i * 2 ^ P.`a + j < P.`k * 2 ^ P.`a.
proof.
move=> hi hj; have h2 : 0 <= 2 ^ P.`a by apply expr_ge0.
split; first by smt(mulr_ge0).
move=> _; have -> : P.`k * 2 ^ P.`a = i * 2 ^ P.`a + (P.`k - i - 1) * 2 ^ P.`a + 2 ^ P.`a by ring.
have : 0 <= (P.`k - i - 1) * 2 ^ P.`a by apply mulr_ge0 => /#.
smt().
qed.

lemma gen_leaves_ph idxt0 ss0 ps0 ad0 (t kp : int) :
  fors_ok ad0 t kp => 0 <= idxt0 < P.`k =>
  phoare [SP.FTWES.FL_FORS_ES.gen_leaves_single_tree :
            arg = (idxt0, ss0, ps0, ad0)
            ==> res = mkseq (fun j => dec (fors_leaf P (NBytes.val ss0) (NBytes.val ps0) 0 t 3 kp
                                                     (idxt0 * 2 ^ P.`a + j)))
                            (2 ^ P.`a)] = 1%r.
proof.
move=> hf hidxt; proc.
while (leaves = mkseq (fun j => dec (fors_leaf P (NBytes.val ss0) (NBytes.val ps0) 0 t 3 kp
                                              (idxt0 * 2 ^ P.`a + j))) (size leaves)
       /\ size leaves <= SP.t /\ idxt = idxt0 /\ ss = ss0 /\ ps = ps0 /\ ad = ad0) (SP.t - size leaves).
+ move=> z; auto => /> &hr h1 h2 h3; move: h2 h3; rewrite /SP.t => h2 h3.
  have hb := leaf_range idxt0 (size leaves{hr}) hidxt _; first smt(size_ge0).
  have hv := thtb_f ad0 t kp 0 (idxt0 * 2 ^ P.`a + size leaves{hr}) hf _ _; 1: smt(a_ge1).
  + by rewrite /=; exact hb.
  rewrite hv /prf_retype /WOTS_HASH /FORS_TREE /FORS_PRF /= !size_rcons {1}h1 (mkseqS _ (size leaves{hr})) 1:size_ge0 /=.
  split; last smt().
  split; last smt().
  congr; apply dec_inj_enc; rewrite enc_f /ab hv adrs_bytesE /= enc_val_dec.
  + by rewrite (FIPS205_Hash_Props.size_PRF _ _ _ _ n_okP).
  by rewrite /fors_leaf /fors_sk adrs_bytesE.
auto => />; split; first by rewrite mkseq0 /= /SP.t; smt(expr_gt0).
move=> lv; split; first smt().
move=> hnot h1 h2; have hs : size lv = 2 ^ P.`a.
+ have h3 : SP.t <= size lv by rewrite lerNgt.
  by apply ler_anti; rewrite -{1}/SP.t h2 /= -/SP.t h3.
by rewrite h1 hs.
qed.

lemma gen_leaves_pre idxt0 ss0 ps0 ad0 (t kp : int) :
  phoare [SP.FTWES.FL_FORS_ES.gen_leaves_single_tree :
            arg = (idxt0, ss0, ps0, ad0) /\ fors_ok ad0 t kp /\ 0 <= idxt0 < P.`k
            ==> res = mkseq (fun j => dec (fors_leaf P (NBytes.val ss0) (NBytes.val ps0) 0 t 3 kp
                                                     (idxt0 * 2 ^ P.`a + j)))
                            (2 ^ P.`a)] = 1%r.
proof.
case: (fors_ok ad0 t kp /\ 0 <= idxt0 < P.`k) => [[hf hi] | hn].
+ by conseq (gen_leaves_ph idxt0 ss0 ps0 ad0 t kp hf hi) => /#.
by exfalso; move=> &hr.
qed.

lemma enc_tm_f ps ad (t kp z i : int) x y :
  fors_ok ad t kp => 1 <= z <= P.`a => 0 <= i < P.`k * 2 ^ (P.`a - z) =>
  enc (tm ps ad z i x y) = fors_hash P (NBytes.val ps) 0 t 3 kp z i (enc x) (enc y).
proof.
move=> hf hz hi; rewrite /tm enc_trh enc_cat /fors_hash /ab.
by rewrite (thtb_f ad t kp z i hf) 1,2:/# adrs_bytesE.
qed.

lemma forest_lt (g j : int) :
  0 <= j <= P.`a => 0 <= g < P.`k * 2 ^ P.`a => 0 <= g %/ 2 ^ j < P.`k * 2 ^ (P.`a - j).
proof.
move=> hj hg; split; first by apply divz_ge0; [apply expr_gt0 | smt()].
move=> _; rewrite ltz_divLR 1:expr_gt0 // -mulrA -exprD_nneg 1,2:/#.
have -> : P.`a - j + j = P.`a by ring.
by case: hg.
qed.

lemma forest_sibling_lt (g j : int) :
  0 <= j < P.`a => 0 <= g < P.`k * 2 ^ P.`a => 0 <= gsibling (g %/ 2 ^ j) < P.`k * 2 ^ (P.`a - j).
proof.
move=> hj hg.
have he : 2 ^ (P.`a - j) = 2 * 2 ^ (P.`a - j - 1).
+ by rewrite -exprS; [smt() | congr; ring].
have -> : P.`k * 2 ^ (P.`a - j) = 2 * (P.`k * 2 ^ (P.`a - j - 1)) by rewrite he; ring.
apply gsibling_range.
have <- : P.`k * 2 ^ (P.`a - j) = 2 * (P.`k * 2 ^ (P.`a - j - 1)) by rewrite he; ring.
by apply forest_lt => /#.
qed.

lemma fors_ap_enc ss ps ad (t kp i idx : int) :
  fors_ok ad t kp => 0 <= i < P.`k => 0 <= idx < 2 ^ P.`a =>
  flatten (map enc (rev (SP.FTWES.DBAL.val
    (SP.FTWES.cons_ap_trh ps ad
       (list2tree (mkseq (fun j => dec (fors_leaf P (NBytes.val ss) (NBytes.val ps) 0 t 3 kp
                                                  (i * 2 ^ P.`a + j))) (2 ^ P.`a)))
       idx i))))
  = flatten (map (fun j => gnode (fors_leaf P (NBytes.val ss) (NBytes.val ps) 0 t 3 kp)
                                 (fors_hash P (NBytes.val ps) 0 t 3 kp)
                                 (hts j) (gsibling ((i * 2 ^ P.`a + idx) %/ 2 ^ j)))
                 (range 0 P.`a)).
proof.
move=> hf hi hidx.
pose g := i * 2 ^ P.`a + idx.
have hg : 0 <= g < P.`k * 2 ^ P.`a by apply leaf_range.
have hga : g %/ 2 ^ P.`a = i.
+ by rewrite /g divzMDl 1:gtr_eqF 1:expr_gt0 // divz_small // ger0_norm 1:expr_ge0.
have hgm : g %% 2 ^ P.`a = idx.
+ by rewrite /g modzMDl modz_small // ger0_norm 1:expr_ge0.
rewrite /SP.FTWES.cons_ap_trh /SP.FTWES.cons_ap_trh_gen updf_eq trhif_eq.
have hc := gnode_cons_ap (fun j => dec (fors_leaf P (NBytes.val ss) (NBytes.val ps) 0 t 3 kp j))
             (tm ps ad) P.`a g _ _; 1,2: smt(a_ge1).
move: hc; rewrite hga /= -int2bs_mod hgm => hc; rewrite hc.
rewrite SP.FTWES.DBAL.insubdK.
+ by rewrite size_rev size_map size_range; smt(a_ge1).
rewrite revK -map_comp; congr; apply eq_in_map => j /mem_range hj /=.
rewrite /(\o) (gnode_hom enc _ _ (fors_leaf P (NBytes.val ss) (NBytes.val ps) 0 t 3 kp)
                 (fors_hash P (NBytes.val ps) 0 t 3 kp) P.`k P.`a j) //; 1: smt().
+ by apply forest_sibling_lt.
+ by move=> i' hi' /=; rewrite enc_dec // size_fors_leaf.
by move=> z' i' x y hz hi' /=; rewrite (enc_tm_f _ _ t kp) // /#.
qed.

op enc_fpair (x : SP.dgstblock * SP.FTWES.apFORSTW) : bytes =
  enc x.`1 ++ flatten (map enc (rev (SP.FTWES.DBAL.val x.`2))).

op enc_fors (s : SP.FTWES.sigFORSTW) : bytes = flatten (map enc_fpair (SP.FTWES.DBAPKL.val s)).

op fblk (md ss ps : bytes) (t kp i : int) : bytes =
  let g = i * 2 ^ P.`a + nth 0 (base_2b md P.`a P.`k) i in
  fors_sk P ss ps 0 t kp g
  ++ flatten (map (fun j => gnode (fors_leaf P ss ps 0 t 3 kp) (fors_hash P ps 0 t 3 kp)
                                  (hts j) (gsibling (g %/ 2 ^ j)))
                  (range 0 P.`a)).

lemma idx_range (md : bytes) (i : int) : 0 <= i < P.`k =>
  0 <= nth 0 (base_2b md P.`a P.`k) i < 2 ^ P.`a.
proof.
move=> hi; have := List.allP (fun v => 0 <= v < 2 ^ P.`a) (base_2b md P.`a P.`k).
rewrite Validate_Encoding.base_2b_range /= => h; apply h; apply mem_nth.
by rewrite Validate_Encoding.size_base_2b; smt(k_ge1).
qed.

lemma fors_sign_ph ss0 ps0 ad0 cm0 (md : bytes) (t kp : int) :
  fors_ok ad0 t kp =>
  SP.FTWES.BLKAL.val cm0 = take (P.`k * P.`a) (msb_bits md) =>
  cdiv (P.`k * P.`a) 8 <= size md =>
  phoare [SP.FTWES.FL_FORS_ES.sign :
            arg = ((ss0, ps0, ad0), cm0)
            ==> enc_fors res = fors_sign P md (NBytes.val ss0) (NBytes.val ps0) (mk_adrs 0 t 3 kp 0 0)] = 1%r.
proof.
move=> hf hcm hmd; proc.
have [_ [_ hkp]] := hf.
wp; while (ss = ss0 /\ ps = ps0 /\ ad = ad0 /\ m = cm0 /\ size sig <= P.`k
           /\ map enc_fpair sig = map (fblk md (NBytes.val ss0) (NBytes.val ps0) t kp) (range 0 (size sig)))
          (P.`k - size sig).
+ move=> z; exlim sig => sg; wp.
  call (gen_leaves_pre (size sg) ss0 ps0 ad0 t kp).
  auto => /> hsg hmap hlt; split; first smt(size_ge0).
  have hi : 0 <= size sg < P.`k by smt(size_ge0).
  rewrite hcm (fors_index md P.`a P.`k (size sg)) //; first smt(a_ge1).
  have hidx := idx_range md (size sg) hi.
  pose idx := nth 0 (base_2b md P.`a P.`k) (size sg).
  have hb := leaf_range (size sg) idx hi hidx.
  have hv := thtb_f ad0 t kp 0 (size sg * 2 ^ P.`a + idx) hf _ _; 1: smt(a_ge1).
  + by rewrite /=; exact hb.
  rewrite /SP.t hv /prf_retype /WOTS_HASH /FORS_TREE /FORS_PRF /= !size_rcons.
  move=> _ _ _ _ _ _.
  have hput : forall (a0 a1 a2 a3 a4 a5 v : int),
    put [a0; a1; a2; a3; a4; a5] 3 v = [a0; a1; a2; v; a4; a5] by done.
  rewrite hput.
  split; last smt().
  split; first smt().
  rewrite map_rcons hmap rangeSr 1:size_ge0 map_rcons; congr.
  rewrite /enc_fpair /fblk /= -/idx enc_insubd.
  + by rewrite (FIPS205_Hash_Props.size_PRF _ _ _ _ n_okP).
  rewrite (fors_ap_enc _ _ _ t kp (size sg) idx hf hi hidx).
  by rewrite /fors_sk adrs_bytesE.
auto => />; split.
+ by split; [smt(k_ge1) | rewrite range_geq].
move=> sg; split; first smt().
move=> hnot hk hmap; have hs : size sg = P.`k by smt().
rewrite /enc_fors SP.FTWES.DBAPKL.insubdK 1:hs //.
rewrite (fors_signE P md (NBytes.val ss0) (NBytes.val ps0) 0 t 3 kp 0 0) 1:lt_hp32 //; first smt(a_ge1).
by rewrite hmap hs.
qed.

lemma slice_slice (x : bytes) (b e u v : int) :
  0 <= b => 0 <= u <= v <= e - b =>
  slice (slice x b e) u v = slice x (b + u) (b + v).
proof.
move=> hb huv; rewrite /slice drop_take 1,2:/# drop_drop 1,2:/# take_take ifT 1:/#.
by congr; [ring | rewrite addrC].
qed.

lemma size_enc_fpair (x : SP.dgstblock * SP.FTWES.apFORSTW) :
  size (enc_fpair x) = (P.`a + 1) * P.`n.
proof.
rewrite /enc_fpair size_cat size_enc (size_flatten_n _ P.`n).
+ by move=> b /mapP [y [_ ->]]; rewrite size_enc.
by rewrite size_map size_rev SP.FTWES.DBAL.valP; ring.
qed.

lemma size_enc_fors (s : SP.FTWES.sigFORSTW) :
  size (enc_fors s) = P.`k * ((P.`a + 1) * P.`n).
proof.
rewrite /enc_fors (size_flatten_n _ ((P.`a + 1) * P.`n)).
+ by move=> b /mapP [y [_ ->]]; rewrite size_enc_fpair.
by rewrite size_map SP.FTWES.DBAPKL.valP; ring.
qed.

lemma fors_blk (s : SP.FTWES.sigFORSTW) (i : int) : 0 <= i < P.`k =>
  slice (enc_fors s) (i * ((P.`a + 1) * P.`n)) ((i + 1) * ((P.`a + 1) * P.`n))
  = enc_fpair (nth witness (SP.FTWES.DBAPKL.val s) i).
proof.
move=> hi; rewrite /enc_fors (slice_flatten _ ((P.`a + 1) * P.`n)); 1: smt(n_bounds a_ge1).
+ by move=> b /mapP [y [_ ->]]; rewrite size_enc_fpair.
+ by rewrite size_map SP.FTWES.DBAPKL.valP.
by rewrite (nth_map witness) // SP.FTWES.DBAPKL.valP.
qed.

lemma fors_sk_slice (s : SP.FTWES.sigFORSTW) (i : int) : 0 <= i < P.`k =>
  slice (enc_fors s) (i * (P.`a + 1) * P.`n) ((i * (P.`a + 1) + 1) * P.`n)
  = enc (nth witness (SP.FTWES.DBAPKL.val s) i).`1.
proof.
move=> hi; have hN : 0 <= P.`n by smt(n_bounds).
have h1 := fors_blk s i hi.
have -> : i * (P.`a + 1) * P.`n = i * ((P.`a + 1) * P.`n) + 0 by ring.
have -> : (i * (P.`a + 1) + 1) * P.`n = i * ((P.`a + 1) * P.`n) + P.`n by ring.
rewrite -(slice_slice _ (i * ((P.`a + 1) * P.`n)) ((i + 1) * ((P.`a + 1) * P.`n)) 0 P.`n).
+ smt(mulr_ge0 a_ge1).
+ have -> : (i + 1) * ((P.`a + 1) * P.`n) - i * ((P.`a + 1) * P.`n) = (P.`a + 1) * P.`n by ring.
  smt(mulr_ge0 a_ge1).
rewrite h1 /enc_fpair slice_cat_l; first by rewrite size_enc.
by rewrite -(size_enc (nth witness (SP.FTWES.DBAPKL.val s) i).`1) slice_whole.
qed.

lemma fors_auth_slice (s : SP.FTWES.sigFORSTW) (i j : int) : 0 <= i < P.`k => 0 <= j < P.`a =>
  slice (slice (enc_fors s) ((i * (P.`a + 1) + 1) * P.`n) ((i + 1) * (P.`a + 1) * P.`n))
        (j * P.`n) ((j + 1) * P.`n)
  = enc (nth witness (rev (SP.FTWES.DBAL.val (nth witness (SP.FTWES.DBAPKL.val s) i).`2)) j).
proof.
move=> hi hj; have hN : 0 <= P.`n by smt(n_bounds).
have hiN : 0 <= i * ((P.`a + 1) * P.`n) by smt(mulr_ge0 a_ge1).
have hb := fors_blk s i hi.
have -> : (i * (P.`a + 1) + 1) * P.`n = i * ((P.`a + 1) * P.`n) + P.`n by ring.
have -> : (i + 1) * (P.`a + 1) * P.`n = i * ((P.`a + 1) * P.`n) + (P.`a + 1) * P.`n by ring.
rewrite -(slice_slice _ (i * ((P.`a + 1) * P.`n)) ((i + 1) * ((P.`a + 1) * P.`n)) P.`n ((P.`a + 1) * P.`n)) //.
+ have -> : (i + 1) * ((P.`a + 1) * P.`n) - i * ((P.`a + 1) * P.`n) = (P.`a + 1) * P.`n by ring.
  smt(mulr_ge0 a_ge1).
rewrite hb /enc_fpair slice_cat_r; first by rewrite size_enc.
rewrite size_enc (_: (P.`a + 1) * P.`n - P.`n = size (flatten (map enc (rev (SP.FTWES.DBAL.val
           (nth witness (SP.FTWES.DBAPKL.val s) i).`2))))).
+ by rewrite size_flatten_enc size_rev SP.FTWES.DBAL.valP; ring.
rewrite (_: P.`n - P.`n = 0) 1:// slice_whole slice_flatten_enc //.
by rewrite size_rev SP.FTWES.DBAL.valP.
qed.

lemma ka32 : P.`k * 2 ^ P.`a <= 2 ^ 32.
proof.
have hk : P.`k <= 2 ^ 6 by smt(P_facts expr_gt0).
have ha : 2 ^ P.`a <= 2 ^ 14 by apply ler_weexpn2l => //; smt(P_facts).
apply (ler_trans (2 ^ 6 * 2 ^ 14)); first by apply ler_pmul => //; smt(expr_ge0 k_ge1).
by rewrite -exprD_nneg.
qed.

lemma fors_auth_rev (ap : SP.FTWES.apFORSTW) :
  SP.FTWES.DBAL.val ap
  = rev (map (fun k => nth witness (rev (SP.FTWES.DBAL.val ap)) k) (range 0 P.`a)).
proof.
rewrite -{1}(revK (SP.FTWES.DBAL.val ap)); congr.
have hs : size (rev (SP.FTWES.DBAL.val ap)) = P.`a by rewrite size_rev SP.FTWES.DBAL.valP.
apply (eq_from_nth witness); first by rewrite size_map size_range hs; smt(a_ge1).
move=> k; rewrite hs => hk; rewrite (nth_map 0) 1:size_range 1:/#.
by rewrite nth_range.
qed.

lemma fors_root_model ps ad (t kp i idx : int) sk ap :
  fors_ok ad t kp => 0 <= i < P.`k => 0 <= idx < 2 ^ P.`a =>
  enc (SP.FTWES.val_ap_trh ps ad ap idx (SP.f ps (SP.set_thtbidx ad 0 (i * SP.t + idx)) (SP.DigestBlock.val sk)) i)
  = gfold (fors_hash P (NBytes.val ps) 0 t 3 kp)
          (fun j => enc (nth witness (rev (SP.FTWES.DBAL.val ap)) j))
          (i * 2 ^ P.`a + idx)
          (F P (NBytes.val ps) (mk_adrs 0 t 3 kp 0 (i * 2 ^ P.`a + idx)) (enc sk)) P.`a.
proof.
move=> hf hi hidx.
pose g := i * 2 ^ P.`a + idx.
have hg : 0 <= g < P.`k * 2 ^ P.`a by apply leaf_range.
have hga : g %/ 2 ^ P.`a = i.
+ by rewrite /g divzMDl 1:gtr_eqF 1:expr_gt0 // divz_small // ger0_norm 1:expr_ge0.
have hgm : g %% 2 ^ P.`a = idx.
+ by rewrite /g modzMDl modz_small // ger0_norm 1:expr_ge0.
pose lf := SP.f ps (SP.set_thtbidx ad 0 (i * SP.t + idx)) (SP.DigestBlock.val sk).
rewrite /SP.FTWES.val_ap_trh /SP.FTWES.val_ap_trh_gen updf_eq trhif_eq.
rewrite {1}fors_auth_rev -hgm int2bs_mod.
have hv := gfold_val_ap (tm ps ad) (fun k => nth witness (rev (SP.FTWES.DBAL.val ap)) k) g lf P.`a _.
+ smt(a_ge1).
move: hv; rewrite hga => hv; rewrite -hv.
rewrite (gfold_hom enc _ (fors_hash P (NBytes.val ps) 0 t 3 kp)); first smt(a_ge1).
+ move=> k x y hk; rewrite (enc_tm_f _ _ t kp) //; first smt().
  by apply forest_lt => /#.
congr; first done.
rewrite /lf enc_f /ab (thtb_f ad t kp 0 (i * SP.t + idx) hf) /=; 1: smt(a_ge1).
+ by rewrite /SP.t; exact hg.
by rewrite adrs_bytesE /= /SP.t.
qed.

lemma fors_pk_ph (sf0 : bytes) cm0 ps0 ad0 (md : bytes) (t kp : int) :
  fors_ok ad0 t kp =>
  SP.FTWES.BLKAL.val cm0 = take (P.`k * P.`a) (msb_bits md) =>
  cdiv (P.`k * P.`a) 8 <= size md =>
  phoare [SP.FTWES.FL_FORS_ES.pkFORS_from_sigFORSTW :
            enc_fors sig = sf0 /\ m = cm0 /\ ps = ps0 /\ ad = ad0
            ==> enc res = fors_pkFromSig P sf0 md (NBytes.val ps0) (mk_adrs 0 t 3 kp 0 0)] = 1%r.
proof.
move=> hf hcm hmd; proc.
have [hv [ht hkp]] := hf.
pose R := fun i => fors_root P (NBytes.val ps0) 0 t 3 kp sf0 i (nth 0 (base_2b md P.`a P.`k) i).
wp; while (enc_fors sig = sf0 /\ m = cm0 /\ ps = ps0 /\ ad = ad0 /\ size roots <= P.`k
           /\ map enc roots = map R (range 0 (size roots))) (P.`k - size roots).
+ move=> z; auto => /> &hr hsf hsz hmap hlt.
  have hi : 0 <= size roots{hr} < P.`k by smt(size_ge0).
  rewrite hcm (fors_index md P.`a P.`k (size roots{hr})) //; first smt(a_ge1).
  have hidx := idx_range md (size roots{hr}) hi.
  rewrite !size_rcons; split; last smt().
  split; first smt().
  rewrite map_rcons hmap rangeSr 1:size_ge0 map_rcons; congr.
  pose pr := nth witness (SP.FTWES.DBAPKL.val sig{hr}) (size roots{hr}).
  rewrite (fors_root_model _ _ t kp (size roots{hr}) _ _ _ hf hi hidx).
  rewrite /R /fors_root /= -/pr -hsf.
  rewrite (gfold_eq_auth _
             (fun j => slice (slice (enc_fors sig{hr}) ((size roots{hr} * (P.`a + 1) + 1) * P.`n)
                                    ((size roots{hr} + 1) * (P.`a + 1) * P.`n))
                             (j * P.`n) ((j + 1) * P.`n))
             (fun j => enc (nth witness (rev (SP.FTWES.DBAL.val pr.`2)) j))); 1: smt(a_ge1).
  + by move=> j hj /=; rewrite fors_auth_slice.
  by rewrite fors_sk_slice.
auto => /> &hr hsf; split.
+ by split; [smt(k_ge1) | rewrite range_geq].
move=> rs; split; first smt().
move=> hnot hk hmap; have hs : size rs = P.`k by smt().
rewrite enc_trco enc_flatten hmap hs.
rewrite (fors_pkFromSigE P (enc_fors sig{hr}) md (NBytes.val ps0) 0 t 3 kp 0 0) 1:lt_hp32 //.
+ smt(a_ge1).
+ smt(k_ge1).
+ exact ka32.
congr.
have hk1 : SP.HA.Adrs.val (SP.set_typeidx ad0 4) = [0; 0; 0; 4; t; 0].
+ by apply (val_set_typeidx _ 0 0 kp 3 t 0) => //; apply valid_trco => //; smt(expr_gt0).
have hk2 : SP.HA.Adrs.val (SP.set_kpidx (SP.set_typeidx ad0 4) (SP.FTWES.get_kpidx ad0)) = [0; 0; kp; 4; t; 0].
+ rewrite /SP.FTWES.get_kpidx /SP.HA.get_idx hv /=.
  by apply (val_set_kpidx _ 0 0 0 4 t 0) => //; apply valid_trco.
+ by rewrite /ab hk2 adrs_bytesE.
by rewrite /R hsf.
qed.

(* ------------------------------------------------------------------ *)
(* Message compression                                                *)

op dig (mk : nbytes) (m : bytes * bytes) : bytes * int * int =
  split_digest P (H_msg P (NBytes.val mk) (slice m.`1 0 P.`n) (slice m.`1 P.`n (2 * P.`n)) m.`2).

lemma P_m : P.`m = cdiv (P.`h - P.`hp) 8 + cdiv P.`hp 8 + cdiv (P.`k * P.`a) 8
          /\ P.`hp = P.`h %/ P.`d /\ P.`h = P.`d * P.`hp.
proof. by have := P_table2; rewrite /table2_consistent => [#] *. qed.

lemma cdiv_ge0 (x y : int) : 0 <= x => 0 < y => 0 <= cdiv x y.
proof. by move=> hx hy; rewrite /cdiv; apply divz_ge0 => /#. qed.

lemma dig_props mk (m : bytes * bytes) :
  let (md, it, il) = dig mk m in
     size md = cdiv (P.`k * P.`a) 8
  /\ 0 <= it < 2 ^ (P.`hp * (P.`d - 1)) /\ 0 <= il < 2 ^ P.`hp.
proof.
have [hm [hhp hh]] := P_m.
have hka : 0 <= P.`k * P.`a by smt(mulr_ge0 a_ge1 k_ge1).
have hc1 := cdiv_ge0 (P.`h - P.`hp) 8 _ _; 1,2: smt(hp_ge1 d_ge1 mulr_ge0).
have hc2 := cdiv_ge0 P.`hp 8 _ _; 1,2: smt(hp_ge1).
have hc3 := cdiv_ge0 (P.`k * P.`a) 8 _ _; 1,2: smt().
rewrite /dig /split_digest /=.
have hsz := FIPS205_Hash_Props.size_H_msg P (NBytes.val mk) (slice m.`1 0 P.`n)
              (slice m.`1 P.`n (2 * P.`n)) m.`2 n_okP _; first smt().
split; first by rewrite size_slice /md_bytes //; smt().
rewrite -hhp.
have -> : P.`h - P.`hp = P.`hp * (P.`d - 1) by rewrite hh; ring.
split; [split; [apply modz_ge0 | move=> _; apply ltz_pmod] | split; [apply modz_ge0 | move=> _; apply ltz_pmod]].
+ by apply gtr_eqF; apply expr_gt0.
+ by apply expr_gt0.
+ by apply gtr_eqF; apply expr_gt0.
by apply expr_gt0.
qed.

lemma mco_props mk (m : bytes * bytes) :
  let (md, it, il) = dig mk m in
     SP.FTWES.BLKAL.val (SP.FTWES.mco mk m).`1 = take (P.`k * P.`a) (msb_bits md)
  /\ SP.Index.val (SP.FTWES.mco mk m).`2 = it * 2 ^ P.`hp + il.
proof.
have := dig_props mk m.
rewrite /SP.FTWES.mco /= -/(dig mk m).
case: (dig mk m) => md it il /= [hmd [hit hil]].
split.
+ rewrite SP.FTWES.BLKAL.insubdK // size_take; first smt(mulr_ge0 a_ge1 k_ge1).
  rewrite size_msb hmd /cdiv; smt(divz_eq modz_ge0 ltz_pmod).
rewrite SP.Index.insubdK //; split.
+ smt(mulr_ge0 expr_ge0).
move=> _; rewrite /SP.l /SP.h.
have -> : P.`hp * P.`d = P.`hp + P.`hp * (P.`d - 1) by ring.
rewrite exprD_nneg; [smt(hp_ge1) | smt(mulr_ge0 hp_ge1 d_ge1) |].
have : (it + 1) * 2 ^ P.`hp <= 2 ^ P.`hp * 2 ^ (P.`hp * (P.`d - 1)).
+ by rewrite mulrC; apply ler_wpmul2l; [apply expr_ge0 | smt()].
smt().
qed.

(* ------------------------------------------------------------------ *)
(* SPHINCS+ signing                                                   *)

op enc_sig (s : SP.sigSPHINCSPLUSTW) : bytes = NBytes.val s.`1 ++ enc_fors s.`2 ++ enc_ht s.`3.

lemma fors_ad (t kp : int) :
  0 <= t < 2 ^ (P.`hp * (P.`d - 1)) => 0 <= kp < 2 ^ P.`hp =>
  fors_ok (SP.set_kpidx (SP.set_tidx (SP.set_typeidx SP.adz 3) t) kp) t kp.
proof.
move=> ht hkp; split => //.
have h1 : SP.HA.Adrs.val (SP.set_typeidx SP.adz 3) = [0; 0; 0; 3; 0; 0].
+ apply (val_set_typeidx _ 0 0 0 0 0 0) => //; first exact val_adz.
  by apply valid_trhf => //; smt(expr_gt0 a_ge1 k_ge1 mulr_gt0 hp_ge1 d_ge1).
have h2 : SP.HA.Adrs.val (SP.set_tidx (SP.set_typeidx SP.adz 3) t) = [0; 0; 0; 3; t; 0].
+ apply (val_set_tidx _ 0 0 0 3 0 0) => //.
  by apply valid_trhf => //; smt(expr_gt0 a_ge1 k_ge1 mulr_gt0).
by apply (val_set_kpidx _ 0 0 0 3 t 0) => //; apply valid_trhf => //; smt(expr_gt0 a_ge1 k_ge1 mulr_gt0).
qed.

lemma nval_size (x : nbytes) : size (NBytes.val x) = P.`n.
proof. exact NBytes.valP. qed.

lemma key_fields (x y z w : bytes) :
  size x = P.`n => size y = P.`n => size z = P.`n => size w = P.`n =>
     sk_seed_of P (x ++ y ++ z ++ w) = x /\ sk_prf_of P (x ++ y ++ z ++ w) = y
  /\ pk_seed_of P (x ++ y ++ z ++ w) = z /\ pk_root_of P (x ++ y ++ z ++ w) = w.
proof.
move=> hx hy hz hw; have hn := n_bounds; rewrite -!catA.
rewrite /sk_seed_of /sk_prf_of /pk_seed_of /pk_root_of.
rewrite slice_cat_l 1:/# -{1}hx slice_whole /=.
rewrite slice_cat_r 1:/# hx /= slice_cat_l 1:/# (_: 2 * P.`n - P.`n = size y) 1:/# slice_whole /=.
rewrite slice_cat_r 1:/# hx (_: 2 * P.`n - P.`n = P.`n) 1:/# slice_cat_r 1:/# hy /=.
rewrite (_: 3 * P.`n - P.`n - P.`n = size z) 1:/# slice_cat_l 1:/# slice_whole /=.
rewrite slice_cat_r 1:/# hx slice_cat_r 1:/# hy slice_cat_r 1:/# hz.
by rewrite (_: 4 * P.`n - P.`n - P.`n - P.`n = size w) 1:/# (_: 3 * P.`n - P.`n - P.`n - P.`n = 0) 1:/# slice_whole.
qed.

lemma sign_refine msA ssA psA (rootA : SP.dgstblock) (rA M : bytes) :
  size rA = P.`n =>
  phoare [SP.SPHINCS_PLUS.sign :
            arg = ((msA, ssA, psA), (NBytes.val psA ++ enc rootA ++ rA, M))
            ==> enc_sig res = slh_sign_internal P M (NBytes.val ssA ++ NBytes.val msA ++ NBytes.val psA ++ enc rootA) (Some rA)] = 1%r.
proof.
move=> hrA.
pose m := (NBytes.val psA ++ enc rootA ++ rA, M).
have hpre : size (NBytes.val psA ++ enc rootA) = 2 * P.`n.
+ by rewrite size_cat nval_size size_enc; ring.
pose mk := SP.mkg msA m.
have hmc := mco_props mk m; have hdp := dig_props mk m.
have [md it il hd] : exists md it il, dig mk m = (md, it, il).
+ by exists (dig mk m).`1 (dig mk m).`2 (dig mk m).`3; case: (dig mk m).
move: hmc hdp; rewrite hd /= => [[hcm hidx] [hmd [hit hil]]].
have hmd' : cdiv (P.`k * P.`a) 8 <= size md by rewrite hmd.
pose adF := SP.set_kpidx (SP.set_tidx (SP.set_typeidx SP.adz 3) it) il.
have hf := fors_ad it il hit hil.
pose sf := fors_sign P md (NBytes.val ssA) (NBytes.val psA) (mk_adrs 0 it 3 il 0 0).
pose pkf := fors_pkFromSig P sf md (NBytes.val psA) (mk_adrs 0 it 3 il 0 0).
have hs0 : slice m.`1 0 P.`n = NBytes.val psA.
+ rewrite /m /= slice_cat_l; first by rewrite hpre; smt(n_bounds).
  rewrite slice_cat_l; first by rewrite nval_size; smt(n_bounds).
  by rewrite -(nval_size psA) slice_whole.
have hs1 : slice m.`1 P.`n (2 * P.`n) = enc rootA.
+ rewrite /m /= slice_cat_l; first by rewrite hpre; smt(n_bounds).
  rewrite slice_cat_r nval_size // (_: 2 * P.`n - P.`n = size (enc rootA)).
  + by rewrite size_enc; ring.
  by rewrite /= slice_whole.
have hs2 : slice m.`1 (2 * P.`n) (3 * P.`n) = rA.
+ rewrite /m /= slice_cat_r hpre // (_: 3 * P.`n - 2 * P.`n = size rA).
  + by rewrite hrA; ring.
  by rewrite /= slice_whole.
have hr : NBytes.val (NBytes.insubd (PRF_msg P (NBytes.val msA) rA M))
          = PRF_msg P (NBytes.val msA) rA M.
+ by rewrite NBytes.insubdK // (FIPS205_Hash_Props.size_PRF_msg _ _ _ _ n_okP).
have hdd : split_digest P (H_msg P (PRF_msg P (NBytes.val msA) rA M) (NBytes.val psA) (enc rootA) M)
           = (md, it, il).
+ by move: hd; rewrite /dig /mk /SP.mkg hs0 hs1 hs2 /= hr.
proc; inline SP.FTWES.M_FORS_ES.sign; wp.
call (ht_sign_ph ssA psA (dec pkf) (SP.FTWES.mco mk m).`2 it il hidx hil hit).
wp.
call (fors_pk_ph sf (SP.FTWES.mco mk m).`1 psA adF md it il hf hcm hmd').
wp.
call (fors_sign_ph ssA psA adF (SP.FTWES.mco mk m).`1 md it il hf hcm hmd').
have hmco : SP.FTWES.mco mk m
            = (SP.FTWES.BLKAL.insubd (take (P.`k * P.`a) (msb_bits md)),
               SP.Index.insubd (it * 2 ^ P.`hp + il)).
+ by rewrite /SP.FTWES.mco /mk /SP.mkg hs0 hs1 hs2 /= hr hdd.
have hiv : SP.Index.val (SP.Index.insubd (it * 2 ^ P.`hp + il)) = it * 2 ^ P.`hp + il.
+ by move: hidx; rewrite hmco.
have hq : (it * 2 ^ P.`hp + il) %/ 2 ^ P.`hp = it.
+ by rewrite divzMDl 1:gtr_eqF 1:expr_gt0 // divz_small // ger0_norm 1:expr_ge0.
have hrm : (it * 2 ^ P.`hp + il) %% 2 ^ P.`hp = il.
+ by rewrite modzMDl modz_small // ger0_norm 1:expr_ge0.
auto => />.
rewrite hs0 hs1 hs2 /= hr hdd /= hiv /SP.l' hq hrm hmco /=.
move=> _ sg hsg1 hsg2 pk hpk.
have hpkf : size pkf = P.`n by rewrite /pkf -hpk size_enc.
split; first by apply dec_inj_enc; rewrite hpk.
move=> _ ht hht.
rewrite /enc_sig /= hr hsg2 hht enc_dec //.
have [h1 [h2 [h3 h4]]] := key_fields (NBytes.val ssA) (NBytes.val msA) (NBytes.val psA) (enc rootA)
                             (nval_size _) (nval_size _) (nval_size _) (size_enc _).
rewrite /slh_sign_internal /= h1 h2 h3 h4 hdd /=.
by rewrite mk_adrs0 setTreeAddressE setTypeAndClearE setKeyPairAddressE /FORS_TREE.
qed.

(* ------------------------------------------------------------------ *)
(* Decoding signatures                                                *)

lemma flatten_slices (s : bytes) (N B : int) :
  0 < N => size s = B * N =>
  flatten (mkseq (fun i => slice s (i * N) ((i + 1) * N)) B) = s.
proof.
move=> hN hs; have hB : 0 <= B by smt(size_ge0).
have hc := BitEncoding.BitChunking.chunkK N s hN _; first by rewrite hs dvdz_mull dvdzz.
rewrite -{2}hc /BitEncoding.BitChunking.chunk hs mulzK 1:/#; congr; apply eq_in_mkseq => i hi /=.
by rewrite /slice; congr; [ring | rewrite mulrC].
qed.

op dec_fors (sf : bytes) : SP.FTWES.sigFORSTW =
  SP.FTWES.DBAPKL.insubd (mkseq (fun i =>
    (dec (slice sf (i * ((P.`a + 1) * P.`n)) (i * ((P.`a + 1) * P.`n) + P.`n)),
     SP.FTWES.DBAL.insubd (rev (mkseq (fun j =>
       dec (slice sf (i * ((P.`a + 1) * P.`n) + P.`n + j * P.`n)
                     (i * ((P.`a + 1) * P.`n) + P.`n + (j + 1) * P.`n))) P.`a))))
    P.`k).

op dec_ht (sh : bytes) : SP.FSSLXMTWES.sigFLSLXMSSMTTW =
  SP.FSSLXMTWES.SAPDL.insubd (mkseq (fun j =>
    (SP.FSSLXMTWES.WTWES.DBLL.insubd (mkseq (fun c =>
       dec (slice sh (j * xmss_sig_length P + c * P.`n) (j * xmss_sig_length P + (c + 1) * P.`n)))
       (len P)),
     SP.FSSLXMTWES.DBHPL.insubd (rev (mkseq (fun k =>
       dec (slice sh (j * xmss_sig_length P + len P * P.`n + k * P.`n)
                     (j * xmss_sig_length P + len P * P.`n + (k + 1) * P.`n))) P.`hp))))
    P.`d).

lemma enc_dec_slices (s : bytes) (o B : int) :
  0 <= o => 0 <= B => o + B * P.`n <= size s =>
  flatten (map enc (mkseq (fun c => dec (slice s (o + c * P.`n) (o + (c + 1) * P.`n))) B))
  = slice s o (o + B * P.`n).
proof.
move=> ho hB hs; have hn := n_bounds.
rewrite -(flatten_slices (slice s o (o + B * P.`n)) P.`n B) 1:/#.
+ by rewrite size_slice; smt(mulr_ge0).
rewrite /mkseq -map_comp; congr; apply eq_in_map => c /mem_iota hc /=.
rewrite /(\o) enc_dec; first by rewrite size_slice; smt(mulr_ge0).
rewrite slice_slice //; smt(mulr_ge0).
qed.

lemma slice_adj (s : bytes) (x y z : int) :
  0 <= x <= y => y <= z => slice s x y ++ slice s y z = slice s x z.
proof.
move=> hxy hyz; rewrite /slice (_: z - x = (y - x) + (z - y)) 1:/# (takeD (drop x s) (y - x) (z - y)) 1,2:/#.
by rewrite drop_drop 1,2:/# (_: y - x + x = y) 1:/#.
qed.

lemma enc_dec_fors (sf : bytes) : size sf = P.`k * ((P.`a + 1) * P.`n) => enc_fors (dec_fors sf) = sf.
proof.
move=> hs; have hn := n_bounds; have ha := a_ge1; have hk := k_ge1.
pose N := (P.`a + 1) * P.`n.
have hN : 0 < N by rewrite /N; smt().
rewrite /enc_fors /dec_fors SP.FTWES.DBAPKL.insubdK; first by rewrite size_mkseq; smt().
rewrite -{3}(flatten_slices sf N P.`k) //.
rewrite /mkseq -!map_comp; congr; apply eq_in_map => i /mem_iota hi /=.
rewrite /(\o) /enc_fpair /= enc_dec.
+ have hiN : 0 <= i * N by smt(mulr_ge0).
  have hup : (i + 1) * N <= size sf by rewrite hs; smt(ler_wpmul2r).
  rewrite size_slice; last by ring.
  by rewrite -/N; smt().
rewrite SP.FTWES.DBAL.insubdK; first by rewrite size_rev size_mkseq; smt().
rewrite revK enc_dec_slices; 1,2: smt(mulr_ge0).
+ rewrite hs -/N; have -> : i * N + P.`n + P.`a * P.`n = (i + 1) * N by rewrite /N; ring.
  smt(ler_wpmul2r).
rewrite slice_adj; 1,2: smt(mulr_ge0).
by congr; rewrite /N; ring.
qed.

lemma enc_dec_ht (sh : bytes) : size sh = P.`d * xmss_sig_length P => enc_ht (dec_ht sh) = sh.
proof.
move=> hs; have hn := n_bounds; have hh := hp_ge1; have hd := d_ge1.
have hl : 0 < len P by smt(len_n).
pose X := xmss_sig_length P.
have hX : X = (len P + P.`hp) * P.`n by rewrite /X /xmss_sig_length; ring.
have hX0 : 0 < X by rewrite hX; smt().
rewrite /enc_ht /dec_ht SP.FSSLXMTWES.SAPDL.insubdK; first by rewrite size_mkseq; smt().
rewrite -{3}(flatten_slices sh X P.`d) //.
rewrite map_mkseq; congr; apply eq_in_mkseq => j hj /=.
rewrite /(\o) /enc_layer /= -/X.
rewrite SP.FSSLXMTWES.WTWES.DBLL.insubdK; first by rewrite size_mkseq SP_len; smt().
rewrite SP.FSSLXMTWES.DBHPL.insubdK; first by rewrite size_rev size_mkseq; smt().
have hjX : 0 <= j * X by smt(mulr_ge0).
have hup : (j + 1) * X <= size sh by rewrite hs; smt(ler_wpmul2r).
have hlnX : 0 <= len P * P.`n <= X.
+ rewrite hX; split; first smt(mulr_ge0).
  by move=> _; apply ler_wpmul2r; smt().
have hhX : j * X + len P * P.`n + P.`hp * P.`n = (j + 1) * X by rewrite hX; ring.
have hjX1 : (j + 1) * X = j * X + X by ring.
have hl0 : 0 <= len P by smt().
have hh0 : 0 <= P.`hp by smt().
have hs1 : j * X + len P * P.`n <= size sh by smt().
have ho2 : 0 <= j * X + len P * P.`n by smt().
have hs2 : j * X + len P * P.`n + P.`hp * P.`n <= size sh by smt().
rewrite (enc_dec_slices sh (j * X) (len P) hjX hl0 hs1).
rewrite revK (enc_dec_slices sh (j * X + len P * P.`n) P.`hp ho2 hh0 hs2).
rewrite slice_adj; first smt().
+ smt().
by rewrite hhX.
qed.

op fors_end : int = (1 + P.`k * (1 + P.`a)) * P.`n.

op dec_sig (b : bytes) : SP.sigSPHINCSPLUSTW =
  (NBytes.insubd (slice b 0 P.`n), dec_fors (slice b P.`n fors_end), dec_ht (slice b fors_end (sig_length P))).

lemma foldl_eq_in ['a 'b] (f g : 'a -> 'b -> 'a) (x : 'a) (l : 'b list) :
  (forall acc y, y \in l => f acc y = g acc y) => foldl f x l = foldl g x l.
proof.
elim: l x => [|y l ih] x h //=.
by rewrite h // ih // => acc z hz; apply h; right.
qed.

lemma sig_sizes :
     0 <= P.`n <= fors_end <= sig_length P
  /\ fors_end - P.`n = P.`k * ((P.`a + 1) * P.`n)
  /\ sig_length P - fors_end = P.`d * xmss_sig_length P.
proof.
have hn := n_bounds; have ha := a_ge1; have hk := k_ge1; have hd := d_ge1; have hh := hp_ge1.
have [_ [_ hh']] := P_m.
have hl := len_n.
rewrite /fors_end /sig_length /xmss_sig_length hh'.
split; first smt(mulr_ge0).
split; first ring.
by ring.
qed.

lemma verify_refine (rootA : SP.dgstblock) psA (rA M b : bytes) :
  size b = sig_length P =>
  phoare [SP.SPHINCS_PLUS.verify :
            arg = ((rootA, psA), (NBytes.val psA ++ enc rootA ++ rA, M), dec_sig b)
            ==> res = slh_verify_internal P M b (NBytes.val psA ++ enc rootA)] = 1%r.
proof.
move=> hb.
have [#] h0n hnf hfs hfsz hhsz := sig_sizes.
pose m := (NBytes.val psA ++ enc rootA ++ rA, M).
pose mk := NBytes.insubd (slice b 0 P.`n).
have hmk : NBytes.val mk = slice b 0 P.`n.
+ by rewrite /mk NBytes.insubdK // size_slice //; smt().
have hmc := mco_props mk m; have hdp := dig_props mk m.
have [md it il hd] : exists md it il, dig mk m = (md, it, il).
+ by exists (dig mk m).`1 (dig mk m).`2 (dig mk m).`3; case: (dig mk m).
move: hmc hdp; rewrite hd /= => [[hcm hidx] [hmd [hit hil]]].
have hmd' : cdiv (P.`k * P.`a) 8 <= size md by rewrite hmd.
pose adF := SP.set_kpidx (SP.set_tidx (SP.set_typeidx SP.adz 3) it) il.
have hf := fors_ad it il hit hil.
pose sfb := slice b P.`n fors_end.
pose shb := slice b fors_end (sig_length P).
have hsfb : size sfb = P.`k * ((P.`a + 1) * P.`n) by rewrite /sfb size_slice; smt().
have hshb : size shb = P.`d * xmss_sig_length P.
+ have h0f : 0 <= fors_end by apply (ler_trans P.`n).
  have h := size_slice b fors_end (sig_length P) _; first by rewrite hb h0f hfs.
  by rewrite /shb h hhsz.
pose pkf := fors_pkFromSig P sfb md (NBytes.val psA) (mk_adrs 0 it 3 il 0 0).
proc; wp.
call (ht_root_ph (dec pkf) (dec_ht shb) (SP.FTWES.mco mk m).`2 psA it il hidx hil hit).
wp.
call (fors_pk_ph sfb (SP.FTWES.mco mk m).`1 psA adF md it il hf hcm hmd').
have hpk0 : slice (NBytes.val psA ++ enc rootA) 0 P.`n = NBytes.val psA.
+ rewrite slice_cat_l; first by rewrite nval_size; smt(n_bounds).
  by rewrite -(nval_size psA) slice_whole.
have hpk1 : slice (NBytes.val psA ++ enc rootA) P.`n (2 * P.`n) = enc rootA.
+ rewrite slice_cat_r nval_size // (_: 2 * P.`n - P.`n = size (enc rootA)).
  + by rewrite size_enc; ring.
  by rewrite /= slice_whole.
have hpre : size (NBytes.val psA ++ enc rootA) = 2 * P.`n.
+ by rewrite size_cat nval_size size_enc; ring.
have hr0 : slice (NBytes.val psA ++ enc rootA ++ rA) 0 P.`n = NBytes.val psA.
+ by rewrite slice_cat_l 2:hpk0 // hpre; smt(n_bounds).
have hr1 : slice (NBytes.val psA ++ enc rootA ++ rA) P.`n (2 * P.`n) = enc rootA.
+ by rewrite slice_cat_l 2:hpk1 // hpre; smt(n_bounds).
have hdd : split_digest P (H_msg P (slice b 0 P.`n) (NBytes.val psA) (enc rootA) M) = (md, it, il).
+ by move: hd; rewrite /dig hmk /m /= hr0 hr1.
have hmco : SP.FTWES.mco mk m
            = (SP.FTWES.BLKAL.insubd (take (P.`k * P.`a) (msb_bits md)),
               SP.Index.insubd (it * 2 ^ P.`hp + il)).
+ by rewrite /SP.FTWES.mco hmk /m /= hr0 hr1 hdd.
have hiv : SP.Index.val (SP.Index.insubd (it * 2 ^ P.`hp + il)) = it * 2 ^ P.`hp + il.
+ by move: hidx; rewrite hmco.
have hq : (it * 2 ^ P.`hp + il) %/ 2 ^ P.`hp = it.
+ by rewrite divzMDl 1:gtr_eqF 1:expr_gt0 // divz_small // ger0_norm 1:expr_ge0.
have hrm : (it * 2 ^ P.`hp + il) %% 2 ^ P.`hp = il.
+ by rewrite modzMDl modz_small // ger0_norm 1:expr_ge0.
have hds : dec_sig b = (mk, dec_fors sfb, dec_ht shb) by rewrite /dec_sig.
auto => />.
rewrite hds /= hmk /m /= hr0 hr1 hdd /= hiv /SP.l' hq hrm hmco /=.
split; first by split => //; apply enc_dec_fors.
move=> _ _ pk hpk.
have hpkf : size pkf = P.`n by rewrite /pkf -hpk size_enc.
split; first by apply dec_inj_enc; rewrite hpk.
move=> _ r; rewrite enc_dec // => hr.
have -> : (r = rootA) = (enc r = enc rootA).
+ by apply/eq_iff; split => [-> // | /enc_inj].
rewrite hr /slh_verify_internal hb /= hpk0 hpk1.
rewrite -/fors_end -/sfb -/shb hdd /=.
rewrite mk_adrs0 setTreeAddressE setTypeAndClearE setKeyPairAddressE /FORS_TREE -/pkf.
rewrite (ht_verifyE P pkf shb (NBytes.val psA) it il (enc rootA) P_in) /ht_fold.
congr; apply foldl_eq_in => acc j /mem_range hj /=; congr.
have he := enc_dec_ht shb hshb.
rewrite -{2}he /enc_ht (slice_flatten _ (xmss_sig_length P)).
+ by rewrite /xmss_sig_length; apply mulr_ge0; smt(len_n n_bounds hp_ge1).
+ by move=> x /mapP [y [_ ->]]; rewrite size_enc_layer.
+ by rewrite size_map SP.FSSLXMTWES.SAPDL.valP.
by rewrite (nth_map witness) // SP.FSSLXMTWES.SAPDL.valP.
qed.

lemma keygen_bytes (ss ms ps : nbytes) (root : SP.dgstblock) :
  enc root = xmss_node P (NBytes.val ss) 0 P.`hp (NBytes.val ps) (mk_adrs (P.`d - 1) 0 0 0 0 0) =>
  slh_keygen_internal P (NBytes.val ss) (NBytes.val ms) (NBytes.val ps)
  = (NBytes.val ss ++ NBytes.val ms ++ NBytes.val ps ++ enc root, NBytes.val ps ++ enc root).
proof. by move=> h; rewrite /slh_keygen_internal /= mk_adrs0 setLayerAddressE h. qed.
