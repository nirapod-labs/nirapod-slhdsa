(* The external interface with hedged signing                         *)

section HedgedComposition.

declare module A <: DSE.Stateless.Adv_EUFCMA {
   -SP.SKG_PRF.O_PRF_Default, -SP.MKG_PRF.O_PRF_Default,
   -SP.FTWES.MCO_ITSR.O_ITSR_Default, -SP.FTWES.F_OpenPRE.O_SMDTOpenPRE_Default,
   -SP.FTWES.FP_OPRETCRDSPR.FP_OpenPRE.O_SMDTOpenPRE_Default, -SP.FTWES.FP_OPRETCRDSPR.FP_TCR.O_SMDTTCR_Default,
   -SP.FTWES.FP_OPRETCRDSPR.FP_DSPR.O_SMDTDSPR_Default, -SP.FTWES.FP_OPRETCRDSPR.R_TCR_OpenPRE,
   -SP.FTWES.FP_OPRETCRDSPR.R_DSPR_OpenPRE, -SP.FTWES.TRHC.O_THFC_Default,
   -SP.FTWES.TRHC_TCR.O_SMDTTCR_Default, -SP.FTWES.TRCOC.O_THFC_Default,
   -SP.FTWES.TRCOC_TCR.O_SMDTTCR_Default, -SP.FTWES.O_CMA_MFORSTWESNPRF,
   -SP.FTWES.O_CMA_MFORSTWESNPRF_AV, -SP.FTWES.R_ITSR_EUFCMA,
   -SP.FTWES.R_FSMDTOpenPRE_EUFCMA, -SP.FTWES.R_TRHSMDTTCRC_EUFCMA,
   -SP.FTWES.R_TRCOSMDTTCRC_EUFCMA, -SP.FSSLXMTWES.PKCOC.O_THFC_Default,
   -SP.FSSLXMTWES.PKCOC_TCR.O_SMDTTCR_Default, -SP.FSSLXMTWES.TRHC.O_THFC_Default,
   -SP.FSSLXMTWES.TRHC_TCR.O_SMDTTCR_Default, -SP.FSSLXMTWES.WTWES.FC.O_THFC_Default,
   -SP.FSSLXMTWES.WTWES.FC_UD.O_SMDTUD_Default, -SP.FSSLXMTWES.WTWES.FC_TCR.O_SMDTTCR_Default,
   -SP.FSSLXMTWES.WTWES.FC_PRE.O_SMDTPRE_Default, -SP.FSSLXMTWES.WTWES.O_MEUFGCMA_WOTSTWESNPRF,
   -SP.FSSLXMTWES.WTWES.R_SMDTPREC_Game4WOTSTWES, -SP.FSSLXMTWES.WTWES.R_SMDTUDC_Game23WOTSTWES,
   -SP.FSSLXMTWES.WTWES.R_SMDTTCRC_Game34WOTSTWES, -SP.FSSLXMTWES.R_MEUFGCMAWOTSTWESNPRF_EUFNAGCMA,
   -SP.FSSLXMTWES.R_SMDTTCRCPKCO_EUFNAGCMA, -SP.FSSLXMTWES.R_SMDTTCRCTRH_EUFNAGCMA,
   -SP.DSS.Stateless.O_CMA_Default, -SP.R_SKGPRF_EUFCMA,
   -SP.R_MKGPRF_EUFCMA, -SP.R_MFORSTWESNPRFEUFCMA_EUFCMA,
   -SP.R_FLSLXMSSMTTWESNPRFEUFNAGCMA_EUFCMA, -R,
   -DSI.Stateless.O_CMA_Default, -DSE.Stateless.O_CMA_Default,
   -Rec, -W, -PRFMsg_PRF.O_PRF_Default, -HMsg_ITSR.O_ITSR_Default
}.

declare axiom A_forge_ll (O <: DSE.Stateless.SOracle_CMA{-A}) :
  islossless O.sign => islossless A(O).forge.

lemma WB_ll (O <: SP.DSS.Stateless.SOracle_CMA{-W, -A}) :
  islossless O.sign => islossless W(B(A), O).forge.
proof.
move=> hO; proc; inline B(A, W(B(A), O).O').forge; wp; call (: true); last by auto.
+ by apply A_forge_ll.
proc; inline *; sp; if; auto; call hO; auto; smt(dnbytes_ll).
qed.

lemma slhdsa_euf_cma_hedged &m :
  Pr[DSE.Stateless.EUF_CMA(External(SLH_Hedged), A,
      DSE.Stateless.O_CMA_Default).main() @ &m : res]
  <= `|Pr[SP.SKG_PRF.PRF(SP.R_SKGPRF_EUFCMA(W(B(A))),
      SP.SKG_PRF.O_PRF_Default).main (false) @ &m : res] -
      Pr[SP.SKG_PRF.PRF(SP.R_SKGPRF_EUFCMA(W(B(A))),
      SP.SKG_PRF.O_PRF_Default).main (true) @ &m : res]|
   + `|Pr[PRFMsg_PRF.PRF(PP(SP.R_MKGPRF_EUFCMA(W(B(A)))),
       PRFMsg_PRF.O_PRF_Default).main (false) @ &m : res] -
       Pr[PRFMsg_PRF.PRF(PP(SP.R_MKGPRF_EUFCMA(W(B(A)))),
       PRFMsg_PRF.O_PRF_Default).main (true) @ &m : res]|
   + Pr[HMsg_ITSR.ITSR(PI(SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(B(A))))),
       HMsg_ITSR.O_ITSR_Default).main() @ &m : res]
   + StdOrder.RealOrder.maxr 0%r (Pr[SP.FTWES.FP_OPRETCRDSPR.FP_DSPR.SM_DT_DSPR(SP.FTWES.FP_OPRETCRDSPR.R_DSPR_OpenPRE(SP.FTWES.R_FPOpenPRE_FOpenPRE(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(B(A))))),
       SP.FTWES.FP_OPRETCRDSPR.FP_DSPR.O_SMDTDSPR_Default).main () @ &m : res] -
       Pr[SP.FTWES.FP_OPRETCRDSPR.FP_DSPR.SM_DT_SPprob(SP.FTWES.FP_OPRETCRDSPR.R_DSPR_OpenPRE(SP.FTWES.R_FPOpenPRE_FOpenPRE(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(B(A))))),
       SP.FTWES.FP_OPRETCRDSPR.FP_DSPR.O_SMDTDSPR_Default).main () @ &m : res])
   + 3%r * Pr[SP.FTWES.FP_OPRETCRDSPR.FP_TCR.SM_DT_TCR(SP.FTWES.FP_OPRETCRDSPR.R_TCR_OpenPRE(SP.FTWES.R_FPOpenPRE_FOpenPRE(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(B(A))))),
       SP.FTWES.FP_OPRETCRDSPR.FP_TCR.O_SMDTTCR_Default).main () @ &m : res]
   + Pr[SP.FTWES.TRHC_TCR.SM_DT_TCR_C(SP.FTWES.R_TRHSMDTTCRC_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(B(A)))),
       SP.FTWES.TRHC_TCR.O_SMDTTCR_Default, SP.FTWES.TRHC.O_THFC_Default).main() @ &m : res]
   + Pr[SP.FTWES.TRCOC_TCR.SM_DT_TCR_C(SP.FTWES.R_TRCOSMDTTCRC_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(B(A)))),
       SP.FTWES.TRCOC_TCR.O_SMDTTCR_Default, SP.FTWES.TRCOC.O_THFC_Default).main() @ &m : res]
   + (SP.w -
       2)%r * `|Pr[SP.FSSLXMTWES.WTWES.FC_UD.SM_DT_UD_C(SP.FSSLXMTWES.WTWES.R_SMDTUDC_Game23WOTSTWES(SP.FSSLXMTWES.R_MEUFGCMAWOTSTWESNPRF_EUFNAGCMA(SP.R_FLSLXMSSMTTWESNPRFEUFNAGCMA_EUFCMA(W(B(A))))),
       SP.FSSLXMTWES.WTWES.FC_UD.O_SMDTUD_Default,
       SP.FSSLXMTWES.WTWES.FC.O_THFC_Default).main (false) @ &m : res] -
       Pr[SP.FSSLXMTWES.WTWES.FC_UD.SM_DT_UD_C(SP.FSSLXMTWES.WTWES.R_SMDTUDC_Game23WOTSTWES(SP.FSSLXMTWES.R_MEUFGCMAWOTSTWESNPRF_EUFNAGCMA(SP.R_FLSLXMSSMTTWESNPRFEUFNAGCMA_EUFCMA(W(B(A))))),
       SP.FSSLXMTWES.WTWES.FC_UD.O_SMDTUD_Default,
