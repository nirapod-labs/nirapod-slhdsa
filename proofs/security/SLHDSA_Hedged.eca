   + Pr[EUF_CMA_Rec(SLH_Hedged, A).main() @ &m :
          exists y, y \in DSE.Stateless.O_CMA_Default.qs /\ ph_collision Rec.forged y].
proof.
have h1 := euf_cma_external SLH_Hedged A SLH_Hedged_verify_ll &m.
have h2 := internal_le_sp_h (B(A)) &m.
have h3 := SP.EUFCMA_SPHINCS_PLUS (W(B(A))) _ &m.
+ by move=> O hO; apply (WB_ll O hO).
have h4 := prf_proj (B(A)) false &m.
have h5 := prf_proj (B(A)) true &m.
have h6 := itsr_proj (B(A)) &m.
smt().
qed.

end section HedgedComposition.
