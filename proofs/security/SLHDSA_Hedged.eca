   + Pr[SP.FSSLXMTWES.WTWES.FC_TCR.SM_DT_TCR_C(SP.FSSLXMTWES.WTWES.R_SMDTTCRC_Game34WOTSTWES(SP.FSSLXMTWES.R_MEUFGCMAWOTSTWESNPRF_EUFNAGCMA(SP.R_FLSLXMSSMTTWESNPRFEUFNAGCMA_EUFCMA(W(B(A))))),
