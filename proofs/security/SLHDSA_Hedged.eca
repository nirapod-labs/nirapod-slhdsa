(*
 * SPDX-FileCopyrightText: nirapod-slhdsa contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * SLHDSA_Hedged.eca
 * =================
 *
 * EUF-CMA of the FIPS 205 external interface with hedged signing, for the
 * parameter set P.
 *
 * Scheme. SLH_Hedged is the internal scheme of FIPS 205 section 9 with
 * addrnd present: every signature draws a fresh, uniform n-byte opt_rand
 * (the addrnd of Algorithms 22 and 23) and returns slh_sign_internal(M, SK,
 * opt_rand). Key generation and verification are those of SLH_Internal.
 *
 * Results.
 *
 *     internal_le_sp_h         a forger against SLH_Hedged yields, through
 *                              the reduction W, a forger against the
 *                              SPHINCS+ instance with at least the same
 *                              success probability
 *     prf_proj                 for W, the PRF advantage against mkg equals
 *                              the PRF advantage against PRF_msg on
 *                              (opt_rand, M') under the key SK.prf
 *     itsr_proj                for W, the ITSR advantage against mco is at
 *                              most the ITSR advantage against H_msg, with
 *                              the FIPS 205 index function, on
 *                              (PK.seed, PK.root, M')
 *     slhdsa_euf_cma_hedged    the external interface with hedged signing:
 *                              the success probability of any forger A is
 *                              at most the SPHINCS+ bound of the imported
 *                              proof for the adversary W(B(A)), with its
 *                              mkg and mco terms replaced by the PRF_msg
 *                              and H_msg terms above, plus the pre-hash
 *                              collision term of ExternalFraming.ec
 *
 * Route. The SPHINCS+ instance signs (PK.seed || PK.root || opt_rand, M')
 * (SPHINCS_Instance.eca), so hedged signing is SPHINCS+ signing of a
 * message whose opt_rand part the reduction W draws. W answers A's
 * queries this way and records (opt_rand, M', R) for each; for the forgery
 * it picks the opt_rand of a recorded query with the same M' and R, if
 * there is one. The imported SPHINCS+ bound then applies to W, but two of
 * its terms are stated for the instance message type, where they are not
 * meaningful assumptions on their own:
 *
 *  - mkg ignores PK.seed and PK.root, so it is not a PRF on that type;
 *  - mco ignores opt_rand, so it is not ITSR on that type (two messages
 *    that differ only in opt_rand share their FORS indices).
 *
 * prf_proj and itsr_proj restate both for PRF_msg and H_msg on their own
 * inputs, through the explicit adversaries PP and PI. The first holds
 * because all of W's queries carry one public key, so the two random
 * functions see the same queries. The second holds because W's choice of
 * opt_rand makes its forgery a recorded query whenever its H_msg inputs
 * and randomizer match one, and a recorded query is never an ITSR win.
 *
 * No term for opt_rand collisions appears: the PRF hop of the imported
 * proof replaces mkg by a random function of the whole message, and a
 * repeated opt_rand only repeats an input of that function.
 *
 * Hypotheses: A terminates whenever its signing oracle does, and A does not
 * read or write the state of the games and reductions involved (the module
 * restrictions of the statement). Nothing is assumed about the hash
 * functions; the PRF_msg term is the standard PRF advantage, keyed by
 * SK.prf drawn uniformly.
 *
 * The randomness of key generation and of opt_rand is modelled as uniform
 * n-byte strings.
 *)

require import AllCore List Distr DList FMap.
from Jasmin require import JWord.
require import Bytes FIPS205_Params FIPS205_Hash FIPS205_Internal FIPS205_External FIPS205_XMSS FIPS205_Address_Props.
require import ExternalFraming.
require SLHDSA_EUFCMA.

clone include SLHDSA_EUFCMA.

(* ------------------------------------------------------------------ *)
(* Hedged signing                                                     *)

module SLH_Hedged : DSI.Stateless.Scheme = {
  proc keygen() : bytes * bytes = {
    var ss, sprf, ps, k;
    ss <$ dnbytes;
    sprf <$ dnbytes;
    ps <$ dnbytes;
    k <- slh_keygen_internal P (NBytes.val ss) (NBytes.val sprf) (NBytes.val ps);
    return (k.`2, k.`1);
  }

  proc sign(sk : bytes, m : bytes) : bytes = {
    var r;
    r <$ dnbytes;
    return slh_sign_internal P m sk (Some (NBytes.val r));
  }

  proc verify(pk : bytes, m : bytes, s : bytes) : bool = {
    return slh_verify_internal P m s pk;
  }
}.

lemma SLH_Hedged_verify_ll : islossless SLH_Hedged.verify.
proof. by proc. qed.

(* The opt_rand of the first recorded query on message m whose randomizer
   is k, or d when there is none. *)
op pick (rec : (bytes * bytes * nbytes) list) (m : bytes) (k : nbytes) (d : bytes) : bytes =
  let i = find (fun (e : bytes * bytes * nbytes) => e.`2 = m /\ e.`3 = k) rec in
  if i < size rec then (nth witness rec i).`1 else d.

lemma pickP (rec : (bytes * bytes * nbytes) list) (m : bytes) (k : nbytes) (d : bytes) :
  (exists e, e \in rec /\ e.`2 = m /\ e.`3 = k) =>
  (pick rec m k d, m, k) \in rec.
proof.
move=> [e [he [h2 h3]]].
pose p := fun (e : bytes * bytes * nbytes) => e.`2 = m /\ e.`3 = k.
have hh : has p rec by apply/List.hasP; exists e => /#.
have hi : find p rec < size rec by rewrite -has_find.
rewrite /pick /= -/p hi /=.
have [h2' h3'] := nth_find witness p rec hh.
have -> : ((nth witness rec (find p rec)).`1, m, k) = nth witness rec (find p rec).
+ by rewrite -h2' -h3'; case: (nth witness rec (find p rec)).
by apply mem_nth; smt(find_ge0).
qed.

(* The reduction: run A on the byte encoding of the SPHINCS+ public key,
   answer each query M' by drawing opt_rand and signing
   (PK || opt_rand, M'), and sign the forgery with the opt_rand of a
   recorded query of the same message and randomizer. *)
module W (A : DSI.Stateless.Adv_EUFCMA) (O : SP.DSS.Stateless.SOracle_CMA) = {
  var pkb : bytes
  var rec : (bytes * bytes * nbytes) list

  module O' = {
    proc sign(m : bytes) : bytes = {
      var r, s;
      r <$ dnbytes;
      s <@ O.sign((pkb ++ NBytes.val r, m));
      rec <- rcons rec (NBytes.val r, m, s.`1);
      return enc_sig s;
    }
  }

  proc forge(pk : SP.pkSPHINCSPLUSTW) : (bytes * bytes) * SP.sigSPHINCSPLUSTW = {
    var m, s, sg;
    pkb <- NBytes.val pk.`2 ++ enc pk.`1;
    rec <- [];
    (m, s) <@ A(O').forge(pkb);
    sg <- dec_sig s;
    return ((pkb ++ pick rec m sg.`1 (NBytes.val pk.`2), m), sg);
  }
}.

section HedgedReduction.

declare module A <: DSI.Stateless.Adv_EUFCMA
  {-W, -DSI.Stateless.O_CMA_Default, -SP.DSS.Stateless.O_CMA_Default}.

lemma oracle_eq_h :
  equiv [DSI.Stateless.O_CMA_Default(SLH_Hedged).sign
         ~ W(A, SP.DSS.Stateless.O_CMA_Default(SP.SPHINCS_PLUS)).O'.sign :
         ={m} /\ keys_rel DSI.Stateless.O_CMA_Default.sk{1} SP.DSS.Stateless.O_CMA_Default.sk{2} W.pkb{2}
         /\ DSI.Stateless.O_CMA_Default.qs{1} = map (fun (e : bytes * bytes * nbytes) => e.`2) W.rec{2}
         /\ SP.DSS.Stateless.O_CMA_Default.qs{2}
            = map (fun (e : bytes * bytes * nbytes) => (W.pkb{2} ++ e.`1, e.`2)) W.rec{2}
         ==> ={res} /\ keys_rel DSI.Stateless.O_CMA_Default.sk{1} SP.DSS.Stateless.O_CMA_Default.sk{2} W.pkb{2}
         /\ DSI.Stateless.O_CMA_Default.qs{1} = map (fun (e : bytes * bytes * nbytes) => e.`2) W.rec{2}
         /\ SP.DSS.Stateless.O_CMA_Default.qs{2}
            = map (fun (e : bytes * bytes * nbytes) => (W.pkb{2} ++ e.`1, e.`2)) W.rec{2}].
proof.
proc; inline SP.DSS.Stateless.O_CMA_Default(SP.SPHINCS_PLUS).sign SLH_Hedged.sign.
conseq (_: m{1} = m{2}
           /\ (exists r, W.pkb{2} = NBytes.val SP.DSS.Stateless.O_CMA_Default.sk{2}.`3 ++ enc r
                /\ DSI.Stateless.O_CMA_Default.sk{1}
                    = NBytes.val SP.DSS.Stateless.O_CMA_Default.sk{2}.`2
                      ++ NBytes.val SP.DSS.Stateless.O_CMA_Default.sk{2}.`1
                      ++ NBytes.val SP.DSS.Stateless.O_CMA_Default.sk{2}.`3 ++ enc r)
           /\ DSI.Stateless.O_CMA_Default.qs{1} = map (fun (e : bytes * bytes * nbytes) => e.`2) W.rec{2}
           /\ SP.DSS.Stateless.O_CMA_Default.qs{2}
              = map (fun (e : bytes * bytes * nbytes) => (W.pkb{2} ++ e.`1, e.`2)) W.rec{2}
           ==> _) => //.
elim* => rt.
exlim (SP.DSS.Stateless.O_CMA_Default.sk{2}).`1, (SP.DSS.Stateless.O_CMA_Default.sk{2}).`2,
      (SP.DSS.Stateless.O_CMA_Default.sk{2}).`3, m{2} => ms ss ps M.
swap{1} 3 -2; seq 1 1 : (#pre /\ r{1} = r{2}); first by auto.
exlim r{2} => rr.
wp; call{2} (sign_refine ms ss ps rt (NBytes.val rr) M (nval_size rr)).
auto => /> &2; split; first by case: (SP.DSS.Stateless.O_CMA_Default.sk{2}).
move=> _ sg hsg; split; first by rewrite hsg.
split; first by exists rt.
by rewrite !map_rcons.
qed.

lemma internal_le_sp_h &m :
  Pr[DSI.Stateless.EUF_CMA(SLH_Hedged, A, DSI.Stateless.O_CMA_Default).main() @ &m : res]
  <= Pr[SP.DSS.Stateless.EUF_CMA(SP.SPHINCS_PLUS, W(A), SP.DSS.Stateless.O_CMA_Default).main() @ &m : res].
proof.
byequiv => //; proc.
inline SLH_Hedged.keygen SP.SPHINCS_PLUS.keygen.
inline DSI.Stateless.O_CMA_Default(SLH_Hedged).init SP.DSS.Stateless.O_CMA_Default(SP.SPHINCS_PLUS).init.
inline W(A, SP.DSS.Stateless.O_CMA_Default(SP.SPHINCS_PLUS)).forge.
inline DSI.Stateless.O_CMA_Default(SLH_Hedged).fresh SP.DSS.Stateless.O_CMA_Default(SP.SPHINCS_PLUS).fresh.
inline SLH_Hedged.verify.
swap{1} 1 1.
seq 3 4 : (={glob A} /\ sprf{1} = ms{2} /\ ss{1} = ss{2} /\ ps{1} = ps{2} /\ ad{2} = SP.adz).
+ by wp; rnd; rnd; rnd; wp; skip.
exlim ss{2}, ps{2} => s0 p0.
seq 0 1 : (={glob A} /\ sprf{1} = ms{2} /\ ss{1} = s0 /\ ss{2} = s0 /\ ps{1} = p0 /\ ps{2} = p0
           /\ enc root{2} = xmss_node P (NBytes.val s0) 0 P.`hp (NBytes.val p0) (mk_adrs (P.`d - 1) 0 0 0 0 0)).
+ by call{2} (gen_root_ph s0 p0); skip => /> /#.
seq 6 12 : (keys_rel DSI.Stateless.O_CMA_Default.sk{1} SP.DSS.Stateless.O_CMA_Default.sk{2} W.pkb{2}
           /\ DSI.Stateless.O_CMA_Default.qs{1} = map (fun (e : bytes * bytes * nbytes) => e.`2) W.rec{2}
           /\ SP.DSS.Stateless.O_CMA_Default.qs{2}
              = map (fun (e : bytes * bytes * nbytes) => (W.pkb{2} ++ e.`1, e.`2)) W.rec{2}
           /\ m{1} = m0{2} /\ sig{1} = s{2} /\ pk{1} = W.pkb{2}
           /\ pk{2} = (root{2}, ps{2}) /\ W.pkb{2} = NBytes.val ps{2} ++ enc root{2}
           /\ m{2} = (W.pkb{2} ++ pick W.rec{2} m0{2} (dec_sig s{2}).`1 (NBytes.val ps{2}), m0{2})
           /\ sig{2} = dec_sig s{2}).
+ wp; call (_: keys_rel DSI.Stateless.O_CMA_Default.sk{1} SP.DSS.Stateless.O_CMA_Default.sk{2} W.pkb{2}
           /\ DSI.Stateless.O_CMA_Default.qs{1} = map (fun (e : bytes * bytes * nbytes) => e.`2) W.rec{2}
           /\ SP.DSS.Stateless.O_CMA_Default.qs{2}
              = map (fun (e : bytes * bytes * nbytes) => (W.pkb{2} ++ e.`1, e.`2)) W.rec{2}).
  + by conseq oracle_eq_h.
  wp; skip => /> &2 hr.
  rewrite (keygen_bytes s0 ms{2} p0 root{2} hr) /=.
  by exists root{2}.
exlim sig{1}, root{2}, ps{2}, m{1}, W.rec{2} => b r p M rc.
case (size b = sig_length P).
+ wp; call{2} (verify_pre r p (pick rc M (dec_sig b).`1 (NBytes.val p)) M b).
  wp; skip => &1 &2 [#] 5!-> hk hq1 hq2 hm hsig hpk1 hpk2 hpkb hm2 hsig2 hsz.
  rewrite hpk2 hm2 hsig2 hpkb -hm -hsig /=; split; first by [].
  move=> _ v -> [hval hfresh]; split; first by rewrite -hpkb -hpk1.
  move: hfresh; rewrite hq1 hq2; apply contra => /mapP [e [he /= [_ ->]]].
  by apply/mapP; exists e.
wp; call{2} SP_verify_ll.
by auto => />.
qed.

end section HedgedReduction.

(* ------------------------------------------------------------------ *)
(* PRF_msg on its own inputs                                          *)

require (*--*) KeyedHashFunctions.

(* PRF_msg(SK.prf, opt_rand, M') as a keyed function of (opt_rand, M'). *)
op prf_msg (k : nbytes) (x : bytes * bytes) : nbytes = NBytes.insubd (PRF_msg P (NBytes.val k) x.`1 x.`2).

clone KeyedHashFunctions as PRFMsg with
  type key_t <- nbytes,
  type in_t <- bytes * bytes,
  type out_t <- nbytes,
  op f <- prf_msg
proof *.

clone PRFMsg.PRF as PRFMsg_PRF with
  op dkey <- dnbytes,
  op doutm x <- dnbytes
proof *.
realize dkey_ll by exact dnbytes_ll.
realize doutm_ll by move=> _; exact dnbytes_ll.

(* A distinguisher against mkg made into one against PRF_msg: each query
   (PK || opt_rand, M') is asked as (opt_rand, M'). *)
module PP (C : SP.MKG_PRF.Adv_PRF) (O : PRFMsg_PRF.Oracle_PRF) = {
  module O' : SP.MKG_PRF.Oracle_PRF = {
    proc init(b : bool) : unit = { }

    proc query(x : bytes * bytes) : nbytes = {
      var y;
      y <@ O.query((slice x.`1 (2 * P.`n) (3 * P.`n), x.`2));
      return y;
    }
  }

  proc distinguish() : bool = {
    var b;
    b <@ C(O').distinguish();
    return b;
  }
}.

lemma slice_rand (pkb r : bytes) :
  size pkb = 2 * P.`n => size r = P.`n =>
  slice (pkb ++ r) (2 * P.`n) (3 * P.`n) = r.
proof.
move=> hp hr; rewrite slice_cat_r hp // (_: 3 * P.`n - 2 * P.`n = size r) 1:hr 1:/#.
by rewrite /= slice_whole.
qed.

section PRFProjection.

declare module A <: DSI.Stateless.Adv_EUFCMA
  {-W, -SP.R_MKGPRF_EUFCMA, -SP.MKG_PRF.O_PRF_Default, -PRFMsg_PRF.O_PRF_Default}.

(* All of W's queries carry the same public key, so the queries of the
   two games correspond one to one. *)
pred prf_rel (pkb : bytes) (mS : (bytes * bytes, nbytes) fmap) (mF : (bytes * bytes, nbytes) fmap) =
  size pkb = 2 * P.`n
  /\ forall r M, mF.[(r, M)] = if size r = P.`n then mS.[(pkb ++ r, M)] else None.

lemma prf_rel_get pkb mS mF (r M : bytes) :
  size r = P.`n => prf_rel pkb mS mF => mF.[(r, M)] = mS.[(pkb ++ r, M)].
proof. by move=> hr [_ h]; rewrite h hr. qed.

lemma prf_rel_set pkb mS mF (r M : bytes) (y : nbytes) :
  size r = P.`n => prf_rel pkb mS mF =>
  prf_rel pkb mS.[(pkb ++ r, M) <- y] mF.[(r, M) <- y].
proof.
move=> hr [hp h]; split => // r' M'; rewrite !get_setE h.
case: (size r' = P.`n) => hr' //=.
+ by have -> : (pkb ++ r' = pkb ++ r) = (r' = r) by smt(catsI).
by case: (r' = r) => [->> //|].
qed.

local lemma prf_oracle :
  equiv [W(A, SP.R_MKGPRF_EUFCMA(W(A), SP.MKG_PRF.O_PRF_Default).O_CMA).O'.sign
         ~ W(A, SP.R_MKGPRF_EUFCMA(W(A), PP(SP.R_MKGPRF_EUFCMA(W(A)), PRFMsg_PRF.O_PRF_Default).O').O_CMA).O'.sign :
         ={m, W.pkb, W.rec, glob SP.R_MKGPRF_EUFCMA}
         /\ ={b, k}(SP.MKG_PRF.O_PRF_Default, PRFMsg_PRF.O_PRF_Default)
         /\ prf_rel W.pkb{1} SP.MKG_PRF.O_PRF_Default.m{1} PRFMsg_PRF.O_PRF_Default.m{2}
         ==> ={res, W.pkb, W.rec, glob SP.R_MKGPRF_EUFCMA}
         /\ ={b, k}(SP.MKG_PRF.O_PRF_Default, PRFMsg_PRF.O_PRF_Default)
         /\ prf_rel W.pkb{1} SP.MKG_PRF.O_PRF_Default.m{1} PRFMsg_PRF.O_PRF_Default.m{2}].
proof.
proc.
inline SP.R_MKGPRF_EUFCMA(W(A), SP.MKG_PRF.O_PRF_Default).O_CMA.sign
       SP.R_MKGPRF_EUFCMA(W(A), PP(SP.R_MKGPRF_EUFCMA(W(A)), PRFMsg_PRF.O_PRF_Default).O').O_CMA.sign.
inline SP.MKG_PRF.O_PRF_Default.query PP(SP.R_MKGPRF_EUFCMA(W(A)), PRFMsg_PRF.O_PRF_Default).O'.query
       PRFMsg_PRF.O_PRF_Default.query.
seq 3 3 : (={r, m0, ad, m, W.pkb, W.rec, glob SP.R_MKGPRF_EUFCMA}
           /\ ={b, k}(SP.MKG_PRF.O_PRF_Default, PRFMsg_PRF.O_PRF_Default)
           /\ prf_rel W.pkb{1} SP.MKG_PRF.O_PRF_Default.m{1} PRFMsg_PRF.O_PRF_Default.m{2}
           /\ m0{1} = (W.pkb{1} ++ NBytes.val r{1}, m{1})).
+ by auto.
seq 3 5 : (={r, m0, ad, m, mk, W.pkb, W.rec, glob SP.R_MKGPRF_EUFCMA}
           /\ ={b, k}(SP.MKG_PRF.O_PRF_Default, PRFMsg_PRF.O_PRF_Default)
           /\ prf_rel W.pkb{1} SP.MKG_PRF.O_PRF_Default.m{1} PRFMsg_PRF.O_PRF_Default.m{2}).
+ sp.
  conseq (_: ={r, m0, ad, m, W.pkb, W.rec, glob SP.R_MKGPRF_EUFCMA}
             /\ ={b, k}(SP.MKG_PRF.O_PRF_Default, PRFMsg_PRF.O_PRF_Default)
             /\ prf_rel W.pkb{1} SP.MKG_PRF.O_PRF_Default.m{1} PRFMsg_PRF.O_PRF_Default.m{2}
             /\ size (NBytes.val r{1}) = P.`n
             /\ x{1} = (W.pkb{1} ++ NBytes.val r{1}, m{1})
             /\ x0{2} = (NBytes.val r{1}, m{1}) ==> _).
  + move=> &1 &2 [#] -> -> -> 11!-> hb hk hrel hm0.
    rewrite hm0 /= slice_rand; [by case: hrel | by apply nval_size | smt(nval_size)].
  if => //.
  + if.
    + by move=> /> &1 &2 *; rewrite !domE; smt(prf_rel_get).
    + auto => /> &1 &2 hp hrel hsz _ _ y _; rewrite !get_set_sameE /=.
      by have [_ h] := prf_rel_set W.pkb{2} SP.MKG_PRF.O_PRF_Default.m{1} PRFMsg_PRF.O_PRF_Default.m{2}
                         (NBytes.val r{2}) m{2} y hsz _; first by split.
    by auto => /> &1 &2 *; smt(prf_rel_get).
  by auto => /> &1 &2 hp hrel hsz *; rewrite /prf_msg /= (slice_rand _ _ hp hsz).
sim / (={b, k}(SP.MKG_PRF.O_PRF_Default, PRFMsg_PRF.O_PRF_Default)
       /\ prf_rel W.pkb{1} SP.MKG_PRF.O_PRF_Default.m{1} PRFMsg_PRF.O_PRF_Default.m{2})
    : (={s, W.pkb, W.rec, glob SP.R_MKGPRF_EUFCMA}).
qed.

local lemma prf_dist :
  equiv [SP.R_MKGPRF_EUFCMA(W(A), SP.MKG_PRF.O_PRF_Default).distinguish
         ~ SP.R_MKGPRF_EUFCMA(W(A), PP(SP.R_MKGPRF_EUFCMA(W(A)), PRFMsg_PRF.O_PRF_Default).O').distinguish :
         ={glob A}
         /\ ={b, k}(SP.MKG_PRF.O_PRF_Default, PRFMsg_PRF.O_PRF_Default)
         /\ SP.MKG_PRF.O_PRF_Default.m{1} = empty /\ PRFMsg_PRF.O_PRF_Default.m{2} = empty
         ==> ={res}].
proof.
proc.
inline W(A, SP.R_MKGPRF_EUFCMA(W(A), SP.MKG_PRF.O_PRF_Default).O_CMA).forge
       W(A, SP.R_MKGPRF_EUFCMA(W(A), PP(SP.R_MKGPRF_EUFCMA(W(A)), PRFMsg_PRF.O_PRF_Default).O').O_CMA).forge.
seq 12 12 : (={glob A, glob SP.R_MKGPRF_EUFCMA, pk}
             /\ ={b, k}(SP.MKG_PRF.O_PRF_Default, PRFMsg_PRF.O_PRF_Default)
             /\ SP.MKG_PRF.O_PRF_Default.m{1} = empty /\ PRFMsg_PRF.O_PRF_Default.m{2} = empty).
+ sim / (={b, k}(SP.MKG_PRF.O_PRF_Default, PRFMsg_PRF.O_PRF_Default)
         /\ SP.MKG_PRF.O_PRF_Default.m{1} = empty /\ PRFMsg_PRF.O_PRF_Default.m{2} = empty)
      : (={glob A, glob SP.R_MKGPRF_EUFCMA, pk}).
seq 3 3 : (={glob A, glob SP.R_MKGPRF_EUFCMA, pk, pk0, W.pkb, W.rec}
           /\ ={b, k}(SP.MKG_PRF.O_PRF_Default, PRFMsg_PRF.O_PRF_Default)
           /\ prf_rel W.pkb{1} SP.MKG_PRF.O_PRF_Default.m{1} PRFMsg_PRF.O_PRF_Default.m{2}).
+ auto => /> *; split; first by rewrite size_cat nval_size size_enc; ring.
  by move=> r M; rewrite !emptyE.
seq 1 1 : (={glob A, glob SP.R_MKGPRF_EUFCMA, pk, pk0, W.pkb, W.rec, m, s}).
+ call (: ={W.pkb, W.rec, glob SP.R_MKGPRF_EUFCMA}
          /\ ={b, k}(SP.MKG_PRF.O_PRF_Default, PRFMsg_PRF.O_PRF_Default)
          /\ prf_rel W.pkb{1} SP.MKG_PRF.O_PRF_Default.m{1} PRFMsg_PRF.O_PRF_Default.m{2}).
  + by conseq prf_oracle.
  by auto.
sim.
qed.

lemma prf_proj b &m :
  Pr[SP.MKG_PRF.PRF(SP.R_MKGPRF_EUFCMA(W(A)), SP.MKG_PRF.O_PRF_Default).main(b) @ &m : res]
  = Pr[PRFMsg_PRF.PRF(PP(SP.R_MKGPRF_EUFCMA(W(A))), PRFMsg_PRF.O_PRF_Default).main(b) @ &m : res].
proof.
byequiv => //; proc.
inline SP.MKG_PRF.O_PRF_Default.init PRFMsg_PRF.O_PRF_Default.init
       PP(SP.R_MKGPRF_EUFCMA(W(A)), PRFMsg_PRF.O_PRF_Default).distinguish.
wp; call prf_dist; auto.
qed.

end section PRFProjection.

(* ------------------------------------------------------------------ *)
(* H_msg on its own inputs                                            *)

(* H_msg(R, PK.seed, PK.root, M') followed by the digest split of
   Algorithm 19, lines 6 to 10, in the model's representation: the FORS
   message bits and the index of the FORS instance. *)
op hmsg (k : nbytes) (x : bytes * bytes * bytes) : SP.FTWES.msgFORSTW * SP.index =
  let digest = H_msg P (NBytes.val k) x.`1 x.`2 x.`3 in
  let (md, it, il) = split_digest P digest in
  (SP.FTWES.BLKAL.insubd (take (P.`k * P.`a) (msb_bits md)), SP.Index.insubd (it * 2 ^ P.`hp + il)).

(* The inputs of H_msg in a message of the instance. *)
op pmsg (m : bytes * bytes) : bytes * bytes * bytes =
  (slice m.`1 0 P.`n, slice m.`1 P.`n (2 * P.`n), m.`2).

lemma mco_hmsg k m : SP.FTWES.mco k m = hmsg k (pmsg m).
proof. by []. qed.

clone KeyedHashFunctions as HMsg with
  type key_t <- nbytes,
  type in_t <- bytes * bytes * bytes,
  type out_t <- SP.FTWES.msgFORSTW * SP.index,
  op f <- hmsg
proof *.

clone HMsg.ITSR as HMsg_ITSR with
  op g <- SP.FTWES.g,
  op dkey <- dnbytes
proof *.
realize dkey_ll by exact dnbytes_ll.

(* An ITSR adversary against mco made into one against H_msg: each query
   and the final pair are mapped to the inputs of H_msg. *)
module PI (C : SP.FTWES.MCO_ITSR.Adv_ITSR) (O : HMsg_ITSR.Oracle_ITSR) = {
  module O' : SP.FTWES.MCO_ITSR.Oracle_ITSR = {
    proc init() : unit = { }

    proc query(x : bytes * bytes) : nbytes = {
      var k;
      k <@ O.query(pmsg x);
      return k;
    }

    proc get_targets() : (nbytes * (bytes * bytes)) list = {
      return [];
    }
  }

  proc find() : nbytes * (bytes * bytes * bytes) = {
    var k, x;
    (k, x) <@ C(O').find();
    return (k, pmsg x);
  }
}.

op pi (kx : nbytes * (bytes * bytes)) : nbytes * (bytes * bytes * bytes) = (kx.`1, pmsg kx.`2).

(* What W's records say about the ITSR targets: every target is a recorded
   query (PK || r, M') with randomizer k, every recorded query is a
   target, and every cached randomizer is that of a target. *)
pred itsr_rel (pkb : bytes) (rec : (bytes * bytes * nbytes) list)
              (mmap : (bytes * bytes, nbytes) fmap) (ts : (nbytes * (bytes * bytes)) list) =
     size pkb = 2 * P.`n
  /\ (forall k x, (k, x) \in ts => exists r, x.`1 = pkb ++ r /\ (r, x.`2, k) \in rec)
  /\ (forall e, e \in rec => (e.`3, (pkb ++ e.`1, e.`2)) \in ts)
  /\ (forall m, m \in mmap => (oget mmap.[m], m) \in ts).

lemma pmsg_cat (pkb r M : bytes) :
  size pkb = 2 * P.`n => pmsg (pkb ++ r, M) = (slice pkb 0 P.`n, slice pkb P.`n (2 * P.`n), M).
proof.
move=> hp; have hn := n_bounds.
by rewrite /pmsg /= !slice_cat_l // hp; smt().
qed.

(* The ITSR win of the instance game, for W's forgery, is an ITSR win for
   H_msg: the same index tuples, and a pair that is new on the inputs of
   H_msg, because W reuses the opt_rand of a recorded query whenever the
   message and randomizer match one. *)
lemma itsr_final (pkb : bytes) rec mmap ts (k : nbytes) (M d : bytes) :
  itsr_rel pkb rec mmap ts =>
  let x = (pkb ++ pick rec M k d, M) in
     (forall t, t \in SP.FTWES.MCO_ITSR.h k x =>
         t \in flatten (map (fun (kx : nbytes * (bytes * bytes)) => SP.FTWES.MCO_ITSR.h kx.`1 kx.`2) ts))
  /\ ! (k, x) \in ts
  => (forall t, t \in HMsg_ITSR.h k (pmsg x) =>
         t \in flatten (map (fun (kx : nbytes * (bytes * bytes * bytes)) => HMsg_ITSR.h kx.`1 kx.`2) (map pi ts)))
  /\ ! (k, pmsg x) \in map pi ts.
proof.
move=> [hp [hts [hrec hmm]]] /= [hcov hnew].
have hh : forall k' x', SP.FTWES.MCO_ITSR.h k' x' = HMsg_ITSR.h k' (pmsg x').
+ by move=> k' x'; rewrite /SP.FTWES.MCO_ITSR.h /HMsg_ITSR.h.
split.
+ move=> t; rewrite -hh => /hcov; rewrite -map_comp.
  have -> : (fun (kx : nbytes * (bytes * bytes * bytes)) => HMsg_ITSR.h kx.`1 kx.`2) \o pi
            = (fun (kx : nbytes * (bytes * bytes)) => SP.FTWES.MCO_ITSR.h kx.`1 kx.`2).
  + by apply fun_ext => kx; rewrite /(\o) /pi /= hh.
  by [].
move: hnew; apply contra => /mapP [[k' x'] [hin /= [hk hx]]].
have [r' [hx1 hrin]] := hts _ _ hin.
have hM : x'.`2 = M.
+ by move: hx; rewrite /pmsg /=; smt().
have := pickP rec M k' d _; first by exists (r', x'.`2, k'); rewrite -hM.
by move/hrec; rewrite hk.
qed.

section ITSRProjection.

declare module A <: DSI.Stateless.Adv_EUFCMA
  {-W, -SP.FTWES.R_ITSR_EUFCMA, -SP.R_MFORSTWESNPRFEUFCMA_EUFCMA,
   -SP.FTWES.MCO_ITSR.O_ITSR_Default, -HMsg_ITSR.O_ITSR_Default}.

local lemma itsr_oracle :
  equiv [W(A, SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A), SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A)), SP.FTWES.MCO_ITSR.O_ITSR_Default).O_CMA).O_CMA).O'.sign
         ~ W(A, SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A), SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A)), PI(SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A))), HMsg_ITSR.O_ITSR_Default).O').O_CMA).O_CMA).O'.sign :
         ={m, W.pkb, W.rec, glob SP.FTWES.R_ITSR_EUFCMA, glob SP.R_MFORSTWESNPRFEUFCMA_EUFCMA}
         /\ HMsg_ITSR.O_ITSR_Default.ts{2} = map pi SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1}
         /\ itsr_rel W.pkb{1} W.rec{1} SP.FTWES.R_ITSR_EUFCMA.mmap{1} SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1}
         ==> ={res, W.pkb, W.rec, glob SP.FTWES.R_ITSR_EUFCMA, glob SP.R_MFORSTWESNPRFEUFCMA_EUFCMA}
         /\ HMsg_ITSR.O_ITSR_Default.ts{2} = map pi SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1}
         /\ itsr_rel W.pkb{1} W.rec{1} SP.FTWES.R_ITSR_EUFCMA.mmap{1} SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1}].
proof.
proc.
inline SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A), SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A)), SP.FTWES.MCO_ITSR.O_ITSR_Default).O_CMA).O_CMA.sign
       SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A), SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A)), PI(SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A))), HMsg_ITSR.O_ITSR_Default).O').O_CMA).O_CMA.sign.
inline SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A)), SP.FTWES.MCO_ITSR.O_ITSR_Default).O_CMA.sign
       SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A)), PI(SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A))), HMsg_ITSR.O_ITSR_Default).O').O_CMA.sign.
inline SP.FTWES.MCO_ITSR.O_ITSR_Default.query
       PI(SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A))), HMsg_ITSR.O_ITSR_Default).O'.query
       HMsg_ITSR.O_ITSR_Default.query.
seq 3 3 : (={r, m0, m1, m, W.pkb, W.rec, glob SP.FTWES.R_ITSR_EUFCMA, glob SP.R_MFORSTWESNPRFEUFCMA_EUFCMA}
           /\ HMsg_ITSR.O_ITSR_Default.ts{2} = map pi SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1}
           /\ itsr_rel W.pkb{1} W.rec{1} SP.FTWES.R_ITSR_EUFCMA.mmap{1} SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1}
           /\ m1{1} = (W.pkb{1} ++ NBytes.val r{1}, m{1})).
+ by auto.
seq 2 2 : (={r, m0, m1, m, mk0, W.pkb, W.rec, glob SP.FTWES.R_ITSR_EUFCMA, glob SP.R_MFORSTWESNPRFEUFCMA_EUFCMA}
           /\ HMsg_ITSR.O_ITSR_Default.ts{2} = map pi SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1}
           /\ m1{1} = (W.pkb{1} ++ NBytes.val r{1}, m{1})
           /\ size W.pkb{1} = 2 * P.`n
           /\ (forall k x, (k, x) \in SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1} =>
                 (k, x) = (mk0{1}, m1{1}) \/ exists r, x.`1 = W.pkb{1} ++ r /\ (r, x.`2, k) \in W.rec{1})
           /\ (forall e, e \in W.rec{1} => (e.`3, (W.pkb{1} ++ e.`1, e.`2)) \in SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1})
           /\ (forall mm, mm \in SP.FTWES.R_ITSR_EUFCMA.mmap{1} =>
                 (oget SP.FTWES.R_ITSR_EUFCMA.mmap{1}.[mm], mm) \in SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1})
           /\ (mk0{1}, m1{1}) \in SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1}).
+ if => //.
  + auto => /> &1 &2 hp hts hrec hmm _ k _.
    rewrite get_set_sameE /= map_rcons /=.
    split; first by rewrite /pi.
    split.
    + move=> k1 x1; rewrite mem_rcons /= => -[[-> ->] // | h].
      by right; apply hts.
    split; first by move=> e he; rewrite mem_rcons; right; apply hrec.
    split; last by rewrite mem_rcons.
    move=> mm; rewrite mem_set get_setE mem_rcons.
    case: (mm = (W.pkb{2} ++ NBytes.val r{2}, m{2})) => [-> // | hne /= hin].
    by right; apply hmm.
  auto => /> &1 &2 hp hts hrec hmm hin; smt().
wp; call (: true); first by sim.
wp; call (: true); first by sim.
auto => /> &1 &2 hp hts hrec hmm hin; split.
+ move=> k1 x1 /hts [[-> ->] /= | [r0 [h1 h2]]].
  + by exists (NBytes.val r{2}); rewrite mem_rcons.
  by exists r0; rewrite mem_rcons; smt().
by move=> e; rewrite mem_rcons => -[-> // | /hrec].
qed.

lemma itsr_proj &m :
  Pr[SP.FTWES.MCO_ITSR.ITSR(SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A))), SP.FTWES.MCO_ITSR.O_ITSR_Default).main() @ &m : res]
  <= Pr[HMsg_ITSR.ITSR(PI(SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A)))), HMsg_ITSR.O_ITSR_Default).main() @ &m : res].
proof.
byequiv => //; proc.
inline SP.FTWES.MCO_ITSR.O_ITSR_Default.init HMsg_ITSR.O_ITSR_Default.init SP.FTWES.MCO_ITSR.O_ITSR_Default.get_targets HMsg_ITSR.O_ITSR_Default.get_targets PI(SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A))), HMsg_ITSR.O_ITSR_Default).find.
inline SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A)), SP.FTWES.MCO_ITSR.O_ITSR_Default).find
       SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A)), PI(SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A))), HMsg_ITSR.O_ITSR_Default).O').find.
inline SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A), SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A)), SP.FTWES.MCO_ITSR.O_ITSR_Default).O_CMA).forge
       SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A), SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A)), PI(SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A))), HMsg_ITSR.O_ITSR_Default).O').O_CMA).forge.
inline W(A, SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A), SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A)), SP.FTWES.MCO_ITSR.O_ITSR_Default).O_CMA).O_CMA).forge
       W(A, SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A), SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A)), PI(SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(W(A))), HMsg_ITSR.O_ITSR_Default).O').O_CMA).O_CMA).forge.
seq 1 1 : (={glob A} /\ SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1} = [] /\ HMsg_ITSR.O_ITSR_Default.ts{2} = []); first by auto.
seq 4 4 : (={glob A, SP.FTWES.R_ITSR_EUFCMA.ad, SP.FTWES.R_ITSR_EUFCMA.ps, SP.FTWES.R_ITSR_EUFCMA.skFORSs, pk, sk} /\ SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1} = [] /\ HMsg_ITSR.O_ITSR_Default.ts{2} = []).
+ sim / (SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1} = [] /\ HMsg_ITSR.O_ITSR_Default.ts{2} = []) : (={glob A, SP.FTWES.R_ITSR_EUFCMA.ad, SP.FTWES.R_ITSR_EUFCMA.ps, SP.FTWES.R_ITSR_EUFCMA.skFORSs, pk, sk}).
seq 1 1 : (={glob A, SP.FTWES.R_ITSR_EUFCMA.ad, SP.FTWES.R_ITSR_EUFCMA.ps, SP.FTWES.R_ITSR_EUFCMA.skFORSs, SP.FTWES.R_ITSR_EUFCMA.mmap, pk, sk} /\ SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1} = [] /\ HMsg_ITSR.O_ITSR_Default.ts{2} = []
           /\ SP.FTWES.R_ITSR_EUFCMA.mmap{1} = empty).
+ by auto.
seq 7 7 : (={glob A, glob SP.FTWES.R_ITSR_EUFCMA, glob SP.R_MFORSTWESNPRFEUFCMA_EUFCMA, root, pk0} /\ SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1} = [] /\ HMsg_ITSR.O_ITSR_Default.ts{2} = []
           /\ SP.FTWES.R_ITSR_EUFCMA.mmap{1} = empty).
+ sim / (SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1} = [] /\ HMsg_ITSR.O_ITSR_Default.ts{2} = [] /\ SP.FTWES.R_ITSR_EUFCMA.mmap{1} = empty)
      : (={glob A, glob SP.FTWES.R_ITSR_EUFCMA, glob SP.R_MFORSTWESNPRFEUFCMA_EUFCMA, root, pk0}).
seq 3 3 : (={glob A, glob SP.FTWES.R_ITSR_EUFCMA, glob SP.R_MFORSTWESNPRFEUFCMA_EUFCMA, pk1, W.pkb, W.rec} /\ HMsg_ITSR.O_ITSR_Default.ts{2} = map pi SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1}
           /\ itsr_rel W.pkb{1} W.rec{1} SP.FTWES.R_ITSR_EUFCMA.mmap{1} SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1}).
+ auto => /> *; split; first by rewrite size_cat nval_size size_enc; ring.
  by move=> m; rewrite mem_empty.
wp; call (: ={W.pkb, W.rec, glob SP.FTWES.R_ITSR_EUFCMA, glob SP.R_MFORSTWESNPRFEUFCMA_EUFCMA}
            /\ HMsg_ITSR.O_ITSR_Default.ts{2} = map pi SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1}
            /\ itsr_rel W.pkb{1} W.rec{1} SP.FTWES.R_ITSR_EUFCMA.mmap{1} SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1}).
+ by conseq itsr_oracle.
skip => /> &1 &2 _ _ _ _ mr tsl recr mmr hp ht hr hm hcov hnew.
have hrel : itsr_rel W.pkb{2} recr mmr tsl by done.
by apply (itsr_final _ _ _ _ _ _ _ hrel).

qed.

end section ITSRProjection.

