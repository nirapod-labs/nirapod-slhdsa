   + Pr[SP.FSSLXMTWES.WTWES.FC_PRE.SM_DT_PRE_C(SP.FSSLXMTWES.WTWES.R_SMDTPREC_Game4WOTSTWES(SP.FSSLXMTWES.R_MEUFGCMAWOTSTWESNPRF_EUFNAGCMA(SP.R_FLSLXMSSMTTWESNPRFEUFNAGCMA_EUFCMA(W(B(A))))),
