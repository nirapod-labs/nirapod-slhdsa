inline SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(R(A)), SP.FTWES.MCO_ITSR.O_ITSR_Default).O_CMA.sign
       SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(R(A)), PI(SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(R(A))), HMsg_ITSR.O_ITSR_Default).O').O_CMA.sign.
