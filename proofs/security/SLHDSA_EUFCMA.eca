           /\ (forall k x, (k, x) \in SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1} => x.`1 = R.pkm{1}) /\ 2 * P.`n <= size R.pkm{1}).
+ auto => /> *; rewrite size_cat size_cat nval_size size_enc; smt(n_bounds).
wp; call (: ={R.pkb, R.pkm, glob SP.FTWES.R_ITSR_EUFCMA, glob SP.R_MFORSTWESNPRFEUFCMA_EUFCMA}
            /\ HMsg_ITSR.O_ITSR_Default.ts{2} = map pi SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1}
            /\ (forall k x, (k, x) \in SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1} => x.`1 = R.pkm{1}) /\ 2 * P.`n <= size R.pkm{1}).
+ by conseq itsr_oracle.
