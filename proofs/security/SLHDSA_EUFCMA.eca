proc.
inline SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(R(A), SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(R(A)), SP.FTWES.MCO_ITSR.O_ITSR_Default).O_CMA).O_CMA.sign
