       PI(SP.FTWES.R_ITSR_EUFCMA(SP.R_MFORSTWESNPRFEUFCMA_EUFCMA(R(A))), HMsg_ITSR.O_ITSR_Default).O'.query
       HMsg_ITSR.O_ITSR_Default.query.
seq 2 2 : (={m0, m1, m, R.pkb, R.pkm, glob SP.FTWES.R_ITSR_EUFCMA, glob SP.R_MFORSTWESNPRFEUFCMA_EUFCMA}
           /\ HMsg_ITSR.O_ITSR_Default.ts{2} = map pi SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1}
           /\ (forall k x, (k, x) \in SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1} => x.`1 = R.pkm{1}) /\ 2 * P.`n <= size R.pkm{1}
           /\ m1{1} = (R.pkm{1}, m{1})).
+ by auto.
seq 2 2 : (={m0, m1, m, mk0, R.pkb, R.pkm, glob SP.FTWES.R_ITSR_EUFCMA, glob SP.R_MFORSTWESNPRFEUFCMA_EUFCMA}
           /\ HMsg_ITSR.O_ITSR_Default.ts{2} = map pi SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1}
           /\ (forall k x, (k, x) \in SP.FTWES.MCO_ITSR.O_ITSR_Default.ts{1} => x.`1 = R.pkm{1}) /\ 2 * P.`n <= size R.pkm{1}).
+ if => //.
  + auto => /> &1 &2 hts hsz _ k _; rewrite map_rcons /=.
    split; first by rewrite /pi.
    by move=> k1 x1; rewrite mem_rcons /= => -[[_ ->] // | /hts].
  by auto.
wp; call (: true); first by sim.
wp; call (: true); first by sim.
by auto.
qed.

