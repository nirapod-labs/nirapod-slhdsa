inline fn __x4_state_load(reg mut ptr u64[100] st, reg u64 p) -> reg ptr u64[100]
{
  reg u64 t;
  inline int i;

  for i = 0 to 100 {
    t = [:u64 p + 8 * i];
    st[i] = t;
  }
  return st;
}

inline fn __x4_state_store(reg u64 p, reg const ptr u64[100] st)
{
  reg u64 t;
  inline int i;

  for i = 0 to 100 {
    t = st[i];
    [:u64 p + 8 * i] = t;
  }
}

/* The state is loaded first, so a lane the init leaves keeps a known value. */
#[ct = "public -> ()"]
export fn nirapod_slhdsa_hashtest_keccak_x4_init(reg u64 p)
{
  stack u64[100] st;
  reg u64 ms;

  ms = #init_msf();
