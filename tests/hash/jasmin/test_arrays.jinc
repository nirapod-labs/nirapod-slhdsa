namespace M256_64_30 {
  param int MGF1_SEED_LEN = 64;
  param int MGF1_OUT_LEN = 30;
  from Hash require "sha2/mgf1.jinc"
}

namespace S256_64_30 {
  param int HASH_ARRAY_LEN = 64;
  require "array_io.jinc"
}

namespace O256_64_30 {
  param int HASH_ARRAY_LEN = 30;
  require "array_io.jinc"
}

#[ct = "public × public -> ()"]
export fn nirapod_slhdsa_hashtest_mgf1_sha256_64_30(reg u64 out seed)
{
  stack u8[64] s;
  stack u8[30] o;
  reg u64 ms;

  ms = #init_msf();
  out = #protect(out, ms);
  seed = #protect(seed, ms);
  s = S256_64_30::__array_load(s, seed);
  () = #spill(out);
  o, ms = M256_64_30::_mgf1_sha256(o, s, ms);
  () = #unspill(out);
  out = #protect(out, ms);
  O256_64_30::__array_store(out, o);
}

