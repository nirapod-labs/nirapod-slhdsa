#[ct = "public × public × public × public × public -> public"]
export fn nirapod_slhdsa_hashtest_sha256_absorb(reg u64 hp bp total in inlen) -> reg u64
{
  stack u32[8] h;
  stack u8[64] buf;
  reg u64 ms;

  ms = #init_msf();
  hp = #protect(hp, ms);
  bp = #protect(bp, ms);
  total = #protect(total, ms);
  in = #protect(in, ms);
  inlen = #protect(inlen, ms);
  h = __h256_load(h, hp);
  buf = __bytes_load64(buf, bp);
  () = #spill(hp, bp);
  h, buf, total, ms = _sha256_absorb_mem(h, buf, total, in, inlen, ms);
  () = #unspill(hp, bp);
  hp = #protect(hp, ms);
  bp = #protect(bp, ms);
  __h256_store(hp, h);
  __bytes_store64(bp, buf);

  return total;
}

#[ct = "public × public × public × public -> ()"]
export fn nirapod_slhdsa_hashtest_sha256_finalize(reg u64 out hp bp total)
{
  stack u32[8] h;
  stack u8[64] buf;
  stack u8[32] d;
  reg u64 ms t;
  inline int i;

  ms = #init_msf();
  out = #protect(out, ms);
  hp = #protect(hp, ms);
  bp = #protect(bp, ms);
  total = #protect(total, ms);
  h = __h256_load(h, hp);
  buf = __bytes_load64(buf, bp);
  () = #spill(out, hp, bp);
  d, h, buf, ms = _sha256_finalize(d, h, buf, total, ms);
  () = #unspill(out, hp, bp);
  out = #protect(out, ms);
  hp = #protect(hp, ms);
  bp = #protect(bp, ms);
  __h256_store(hp, h);
  __bytes_store64(bp, buf);

  for i = 0 to 4 {
    t = d[:u64 i];
    [:u64 out + 8 * i] = t;
  }
}

#[ct = "public × public -> ()"]
export fn nirapod_slhdsa_hashtest_sha256_compress(reg u64 hp block)
{
  stack u32[8] h;
  stack u8[64] b;
  reg u64 ms;

  ms = #init_msf();
  hp = #protect(hp, ms);
  block = #protect(block, ms);
  h = __h256_load(h, hp);
  b = __bytes_load64(b, block);
  () = #spill(hp);
  h, ms = _sha256_compress(h, b, ms);
  () = #unspill(hp);
  hp = #protect(hp, ms);
  __h256_store(hp, h);
}

#[ct = "public × public × public -> ()"]
export fn nirapod_slhdsa_hashtest_sha256_compress_blocks(reg u64 hp block n)
{
  stack u32[8] h;
  reg u64 ms;

  ms = #init_msf();
  hp = #protect(hp, ms);
  block = #protect(block, ms);
  n = #protect(n, ms);
  h = __h256_load(h, hp);
  () = #spill(hp);
  h, ms = _sha256_compress_blocks(h, block, n, ms);
  () = #unspill(hp);
  hp = #protect(hp, ms);
  __h256_store(hp, h);
}

#[ct = "public × public × public × public × public -> public"]
export fn nirapod_slhdsa_hashtest_sha512_absorb(reg u64 hp bp total in inlen) -> reg u64
{
  stack u64[8] h;
  stack u8[128] buf;
  reg u64 ms;

  ms = #init_msf();
  hp = #protect(hp, ms);
  bp = #protect(bp, ms);
  total = #protect(total, ms);
  in = #protect(in, ms);
  inlen = #protect(inlen, ms);
  h = __h512_load(h, hp);
  buf = __bytes_load128(buf, bp);
  () = #spill(hp, bp);
  h, buf, total, ms = _sha512_absorb_mem(h, buf, total, in, inlen, ms);
  () = #unspill(hp, bp);
  hp = #protect(hp, ms);
  bp = #protect(bp, ms);
  __h512_store(hp, h);
  __bytes_store128(bp, buf);

  return total;
}

#[ct = "public × public × public × public -> ()"]
export fn nirapod_slhdsa_hashtest_sha512_finalize(reg u64 out hp bp total)
{
  stack u64[8] h;
  stack u8[128] buf;
  stack u8[64] d;
  reg u64 ms t;
  inline int i;

  ms = #init_msf();
  out = #protect(out, ms);
  hp = #protect(hp, ms);
  bp = #protect(bp, ms);
  total = #protect(total, ms);
  h = __h512_load(h, hp);
  buf = __bytes_load128(buf, bp);
  () = #spill(out, hp, bp);
  d, h, buf, ms = _sha512_finalize(d, h, buf, total, ms);
  () = #unspill(out, hp, bp);
  out = #protect(out, ms);
  hp = #protect(hp, ms);
  bp = #protect(bp, ms);
  __h512_store(hp, h);
  __bytes_store128(bp, buf);

  for i = 0 to 8 {
    t = d[:u64 i];
    [:u64 out + 8 * i] = t;
  }
}

