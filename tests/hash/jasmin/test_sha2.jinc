 * SPDX-License-Identifier: Apache-2.0
 *
 * Test exports for SHA-2, HMAC and MGF1. Not part of the library: each
 * export copies between C memory and the Jasmin calling form of one
 * primitive so the C harness drives the production code directly.
 *
 * Every export protects its arguments before use, because export arguments
 * are only transient under the speculative constant-time model.
 */
from Hash require "sha2/sha256.jinc"
from Hash require "sha2/sha512.jinc"
from Hash require "sha2/hmac.jinc"

inline fn __h256_load(reg mut ptr u32[8] h, reg u64 p) -> reg ptr u32[8]
{
  reg u32 t;
  inline int i;

  for i = 0 to 8 {
    t = [:u32 p + 4 * i];
    h[i] = t;
  }
  return h;
}

inline fn __h256_store(reg u64 p, reg const ptr u32[8] h)
{
  reg u32 t;
  inline int i;

  for i = 0 to 8 {
    t = h[i];
    [:u32 p + 4 * i] = t;
  }
}

inline fn __h512_load(reg mut ptr u64[8] h, reg u64 p) -> reg ptr u64[8]
{
  reg u64 t;
  inline int i;

  for i = 0 to 8 {
    t = [:u64 p + 8 * i];
    h[i] = t;
  }
  return h;
}

inline fn __h512_store(reg u64 p, reg const ptr u64[8] h)
{
  reg u64 t;
  inline int i;

  for i = 0 to 8 {
    t = h[i];
    [:u64 p + 8 * i] = t;
  }
}

inline fn __bytes_load64(reg mut ptr u8[64] b, reg u64 p) -> reg ptr u8[64]
{
  reg u64 t;
  inline int i;

  for i = 0 to 8 {
    t = [:u64 p + 8 * i];
    b[:u64 i] = t;
  }
  return b;
}

inline fn __bytes_store64(reg u64 p, reg const ptr u8[64] b)
{
  reg u64 t;
  inline int i;

  for i = 0 to 8 {
    t = b[:u64 i];
    [:u64 p + 8 * i] = t;
  }
}

inline fn __bytes_load128(reg mut ptr u8[128] b, reg u64 p) -> reg ptr u8[128]
{
  reg u64 t;
  inline int i;

  for i = 0 to 16 {
    t = [:u64 p + 8 * i];
    b[:u64 i] = t;
  }
  return b;
}

inline fn __bytes_store128(reg u64 p, reg const ptr u8[128] b)
{
  reg u64 t;
  inline int i;

  for i = 0 to 16 {
    t = b[:u64 i];
    [:u64 p + 8 * i] = t;
  }
}

#[ct = "public × public × public -> ()"]
export fn nirapod_slhdsa_hashtest_sha224(reg u64 out in inlen)
{
  stack u8[32] d;
  reg u64 ms t;
  inline int i;

  ms = #init_msf();
  out = #protect(out, ms);
  in = #protect(in, ms);
  inlen = #protect(inlen, ms);
  () = #spill(out);
  d, ms = _sha224_mem(d, in, inlen, ms);
  () = #unspill(out);
  out = #protect(out, ms);

  for i = 0 to 28 {
    t = (64u)d[i];
    [:u8 out + i] = (8u)t;
  }
}

