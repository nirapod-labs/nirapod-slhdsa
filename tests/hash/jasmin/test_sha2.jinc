#[ct = "public -> ()"]
export fn nirapod_slhdsa_hashtest_sha256_init(reg u64 hp)
{
  stack u32[8] h;
  reg u64 ms;

  ms = #init_msf();
  hp = #protect(hp, ms);
  h = __sha256_init(h);
  __h256_store(hp, h);
}

