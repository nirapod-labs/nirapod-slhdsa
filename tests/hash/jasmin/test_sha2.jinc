#[ct = "public × public × public × public × public -> ()"]
export fn nirapod_slhdsa_hashtest_hmac_sha256(reg u64 out key keylen msg msglen)
{
  stack u8[64] k0 buf;
  stack u32[8] inner outer;
  stack u8[32] tag;
  reg u64 ms total t;
  inline int i;

  ms = #init_msf();
  out = #protect(out, ms);
  key = #protect(key, ms);
  keylen = #protect(keylen, ms);
  msg = #protect(msg, ms);
  msglen = #protect(msglen, ms);
  () = #spill(out, msg, msglen);
  k0, ms = _hmac_sha256_keyblock_mem(k0, key, keylen, ms);
  inner, outer, ms = __hmac_sha256_init(inner, outer, k0, ms);
  () = #unspill(msg, msglen);
  msg = #protect(msg, ms);
  msglen = #protect(msglen, ms);
  total = 64;
  inner, buf, total, ms = _sha256_absorb_mem(inner, buf, total, msg, msglen, ms);
  tag, inner, buf, ms = __hmac_sha256_finalize(tag, inner, buf, total, outer, ms);
  () = #unspill(out);
  out = #protect(out, ms);

  for i = 0 to 4 {
    t = tag[:u64 i];
    [:u64 out + 8 * i] = t;
  }
}

#[ct = "public × public × public × public × public -> ()"]
export fn nirapod_slhdsa_hashtest_hmac_sha512(reg u64 out key keylen msg msglen)
{
  stack u8[128] k0 buf;
  stack u64[8] inner outer;
  stack u8[64] tag;
  reg u64 ms total t;
  inline int i;

  ms = #init_msf();
  out = #protect(out, ms);
  key = #protect(key, ms);
  keylen = #protect(keylen, ms);
  msg = #protect(msg, ms);
  msglen = #protect(msglen, ms);
  () = #spill(out, msg, msglen);
  k0, ms = _hmac_sha512_keyblock_mem(k0, key, keylen, ms);
  inner, outer, ms = __hmac_sha512_init(inner, outer, k0, ms);
  () = #unspill(msg, msglen);
  msg = #protect(msg, ms);
  msglen = #protect(msglen, ms);
  total = 128;
  inner, buf, total, ms = _sha512_absorb_mem(inner, buf, total, msg, msglen, ms);
  tag, inner, buf, ms = __hmac_sha512_finalize(tag, inner, buf, total, outer, ms);
  () = #unspill(out);
  out = #protect(out, ms);

  for i = 0 to 8 {
    t = tag[:u64 i];
    [:u64 out + 8 * i] = t;
  }
}
