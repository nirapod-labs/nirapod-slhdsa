/*
 * SPDX-FileCopyrightText: nirapod-slhdsa contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * tests/core/checker/workarounds.jazz
 * ===================================
 *
 * Reproducers of code shapes in src/slhdsa that exist only for
 * jasmin-checksafety, each as a pair of exports: the shape the algorithm
 * would use, which the pinned checker reports, and the shape the source
 * uses, which it accepts. check.py runs both and fails if either verdict
 * changes, so a checker that no longer needs a workaround, or a workaround
 * that no longer suffices, is noticed.
 *
 *   fill_plain  / fill_first    a buffer written at run-time offsets, then
 *                               read whole: is_init, unless the buffer is
 *                               first written at constant indices
 *                               (_wots_leaf_x4 pk, _wots_pk_from_sig tmp,
 *                               _xmss_treehash nodes, auth and wsig,
 *                               _fors_tree nodes, auth and selected,
 *                               _fors_sign and _fors_pk_from_sig roots,
 *                               _slh_frame prefix)
 *   slot_plain  / slot_clamp    a slot offset from a counter of trailing one
 *                               bits: in_bound, unless the counter is clamped
 *                               to the last slot (treehash.jinc __fold_slot)
 *   msg_array   / msg_scalar    a message pointer kept in a stack array cell:
 *                               is_valid on every read through it, unless it
 *                               stays in a variable (M' in internal.jinc)
 *   copy_beside / copy_fixed    stores at an offset advanced beside the loop
 *                               counter: in_bound, unless the offset is the
 *                               fixed base plus the counter (_fors_sign
 *                               signature copy, _slh_frame pre-hash copy,
 *                               the SHA-2 T_l / T_k message layout)
 *   reset_eq    / reset_clamp   a position reset when it equals the rate:
 *                               in_bound, unless it is clamped below the
 *                               rate before use (the SHAKE T_l, T_k and
 *                               T_l x4 absorb loops, _shake_absorb_prefix)
 *   tail_padded / tail_whole    blocks read at an offset that only the loop
 *                               test bounds, from a buffer longer than the
 *                               blocks: is_init, unless the whole buffer is
 *                               cleared, not only the blocks (the SHA-2
 *                               T_l / T_k message buffer, __t_layout)
 *
 * Two clamps in _slh_frame (external.jinc) have no pair, so make
 * checker-repro does not re-check them: of the pre-hash length len, a
 * bound that holds on every branch of _prehash, and of prefix_len, a bound
 * that holds by construction in the framing arithmetic. Each restates its
 * bound where the code that relies on it can see it.
 *
 * The constants are those of SLH-DSA-SHA2-128f (n = 16, a = 6, len = 35,
 * k = 33); the shapes do not depend on them.
 */

param int N = 16;
param int A = 6;
param int LEN = 35;
param int K = 33;

/*
 * The T_k message of thash_sha2_t.jinc: ADRS^c (22 bytes) and M (k n),
 * padded to SHA-256 blocks (576 bytes) in a buffer sized for SHA-512
 * blocks (640 bytes).
 */
param int T_BYTES = 22 + K * N;
param int T_PADDED = (T_BYTES + 9 + 63) / 64 * 64;
param int T_BUF = (T_BYTES + 17 + 127) / 128 * 128;

/* Chain ends stored at i n for i < len, as in the WOTS+ loops. */
inline fn __ends(reg mut ptr u8[LEN * N] b, reg u64 x) -> reg ptr u8[LEN * N]
{
  reg u64 i off;
  reg bool more;
  inline int w;

  i = 0;
  while { more = i < LEN; } (more) {
    off = i;
    off *= N;
    for w = 0 to N / 8 {
      b.[:u64 off] = x;
      off += 8;
    }
    i += 1;
  }
  return b;
}

/* Every byte of b, read at constant indices, as the hash of T_l reads it. */
inline fn __sum(reg const ptr u8[LEN * N] b) -> reg u64
{
  reg u64 s t;
  inline int k;

  s = 0;
  for k = 0 to LEN * N / 8 {
    t = b[:u64 k];
    s ^= t;
  }
  return s;
}

export fn fill_plain(reg u64 x) -> reg u64
{
  stack u8[LEN * N] b;
  reg ptr u8[LEN * N] p;
  reg u64 s;

  p = b;
  p = __ends(p, x);
  s = __sum(p);
  return s;
}

export fn fill_first(reg u64 x) -> reg u64
{
  stack u8[LEN * N] b;
  reg ptr u8[LEN * N] p;
  reg u64 s fill;
  inline int k;

  fill = 0;
  for k = 0 to LEN * N / 8 {
    b[:u64 k] = fill;
  }
  p = b;
  p = __ends(p, x);
  s = __sum(p);
  return s;
}

/* z = the trailing one bits of idx, then the slot at z n, as in the fold. */
export fn slot_plain(reg u64 idx) -> reg u64
{
  stack u8[(A + 1) * N] nodes;
  reg u64 z off r bit;
  reg bool odd;
  inline int i;

  for i = 0 to (A + 1) * N / 8 { nodes[:u64 i] = 0; }
  z = 0;
  while { bit = idx; bit &= 1; odd = bit == 1; } (odd) { z += 1; idx >>= 1; }
  off = z;
  off *= N;
  r = nodes.[:u64 off];
  return r;
}

export fn slot_clamp(reg u64 idx) -> reg u64
{
  stack u8[(A + 1) * N] nodes;
  reg u64 z off r bit cap;
  reg bool odd;
  inline int i;

  for i = 0 to (A + 1) * N / 8 { nodes[:u64 i] = 0; }
  z = 0;
  while { bit = idx; bit &= 1; odd = bit == 1; } (odd) { z += 1; idx >>= 1; }
  cap = A;
  z = z < A ? z : cap;
  off = z;
  off *= N;
  r = nodes.[:u64 off];
  return r;
}

/* msg_len bytes read at msg, through an array cell or a variable. */
inline fn __read(reg u64 m l) -> reg u64
{
  reg u64 i s t;
  reg bool more;

  s = 0;
  i = 0;
  while { more = i < l; } (more) {
    t = (64u) [:u8 m + i];
    s ^= t;
    i += 1;
  }
  return s;
}

export fn msg_array(reg u64 msg msg_len) -> reg u64
{
  stack u64[2] ref;
  reg u64 m l s;

  ref[0] = msg;
  ref[1] = msg_len;
  m = ref[0];
  l = ref[1];
  s = __read(m, l);
  return s;
}

export fn msg_scalar(reg u64 msg msg_len) -> reg u64
{
  reg u64 s;

  s = __read(msg, msg_len);
  return s;
}

/*
 * Eight words stored at a base below 64 plus 8 j, j < 8: with an offset
 * advanced beside the counter, or derived from the counter at each store.
 */
export fn copy_beside(reg u64 base) -> reg u64
{
  stack u8[16 * 8] b;
  reg u64 o k r;
  reg bool more;
  inline int i;

  for i = 0 to 16 { b[:u64 i] = 0; }
  base &= 7;
  base <<= 3;
  o = base;
  k = 0;
  while { more = k < 64; } (more) {
    b.[:u64 o] = k;
    o += 8;
    k += 8;
  }
  r = b[:u64 0];
  return r;
}

export fn copy_fixed(reg u64 base) -> reg u64
{
  stack u8[16 * 8] b;
  reg u64 o k r;
  reg bool more;
  inline int i;

  for i = 0 to 16 { b[:u64 i] = 0; }
  base &= 7;
  base <<= 3;
  k = 0;
  while { more = k < 64; } (more) {
    o = base;
    o += k;
    b.[:u64 o] = k;
    k += 8;
  }
  r = b[:u64 0];
  return r;
}

/*
 * A sponge position over n lanes, reset when it reaches the rate, used as
 * it is or clamped below the rate first, as in the tweakable hashes T_l
 * and T_k.
 */
export fn reset_eq(reg u64 n) -> reg u64
{
  stack u64[25] st;
  reg u64 pos i t;
  reg bool more full;
  inline int k;

  for k = 0 to 25 { st[k] = 0; }
  pos = 3;
  i = 0;
  while { more = i < n; } (more) {
    t = st[pos];
    t ^= i;
    st[pos] = t;
    pos += 1;
    full = pos == 17;
    if (full) { pos = 0; }
    i += 1;
  }
  t = st[pos];
  return t;
}

export fn reset_clamp(reg u64 n) -> reg u64
{
  stack u64[25] st;
  reg u64 pos i t cap;
  reg bool more full;
  inline int k;

  for k = 0 to 25 { st[k] = 0; }
  pos = 3;
  i = 0;
  while { more = i < n; } (more) {
    cap = 16;
    pos = pos >= 17 ? cap : pos;
    t = st[pos];
    t ^= i;
    st[pos] = t;
    pos += 1;
    full = pos == 17;
    if (full) { pos = 0; }
    i += 1;
  }
  t = st[pos];
  return t;
}

/*
 * The blocks of T_PADDED bytes read 64 at a time at off, advanced by 64
 * while off < T_PADDED, as _thash_t compresses them; the buffer is first
 * cleared up to T_PADDED or whole.
 */
fn _block(reg const ptr u8[64] blk) -> reg u64
{
  reg u64 s t;
  inline int k;

  s = 0;
  for k = 0 to 8 {
    t = blk[:u64 k];
    s ^= t;
  }
  return s;
}

export fn tail_padded(reg u64 x) -> reg u64
{
  stack u8[T_BUF] b;
  reg ptr u8[T_BUF] p;
  reg u64 s t off z;
  reg bool more;
  inline int i;

  z = 0;
  for i = 0 to T_PADDED / 8 { b[:u64 i] = z; }
  b[:u64 0] = x;
  s = 0;
  off = 0;
  while { more = off < T_PADDED; } (more) {
    p = b;
    t = _block(p[off : 64]);
    s ^= t;
    off += 64;
  }
  return s;
}

export fn tail_whole(reg u64 x) -> reg u64
{
  stack u8[T_BUF] b;
  reg ptr u8[T_BUF] p;
  reg u64 s t off z;
  reg bool more;
  inline int i;

  z = 0;
  for i = 0 to T_BUF / 8 { b[:u64 i] = z; }
  b[:u64 0] = x;
  s = 0;
  off = 0;
  while { more = off < T_PADDED; } (more) {
    p = b;
    t = _block(p[off : 64]);
    s ^= t;
    off += 64;
  }
  return s;
}
