/*
 * SPDX-FileCopyrightText: nirapod-slhdsa contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * sha512_x4_compress.jinc (x86-64, avx2)
 * ======================================
 *
 * Four independent SHA-512 compressions in AVX2, with the entry point and
 * contract of the scalar 4-way kernel (sha2/sha512_x4_compress.jinc):
 *
 *     _sha512_x4_compress(h4, blocks, ms)
 *
 * The structure of sha256_x8_compress.jinc in this directory with 64-bit
 * lanes: one 256-bit register holds the same word of the four instances,
 * qword k for instance k, so state register j is h4[:u256 j]. Each quarter
 * block (four words) of the four instances is a 4 x 4 matrix of qwords,
 * transposed by VPUNPCK{L,H}_4u64 and VPERM2I128 and made big-endian by
 * VPSHUFB. Rotations are two shifts and an OR; K_t is broadcast.
 *
 * Required CPU feature: AVX2.
 *
 * Security: as the 8-way SHA-256 kernel. Residue: the local schedule window
 * holds 16 schedule words of every instance on return (W_63 .. W_78 as
 * compiled); clearing is the export's obligation.
 */

from Hash require "sha2/sha512_k.jinc"

/* VPSHUFB mask reversing the bytes of each qword, in both 128-bit halves. */
u64[4] SHA512_X4_BSWAP = {
  0x0001020304050607, 0x08090a0b0c0d0e0f,
  0x0001020304050607, 0x08090a0b0c0d0e0f
};

inline fn __rotr_4u64(reg u256 x, inline int r) -> reg u256
{
  reg u256 t;

  t = x >>4u64 r;
  x = x <<4u64 (64 - r);
  x |= t;
  return x;
}

inline fn __Sigma0_4x(reg u256 x) -> reg u256
{
  reg u256 r t;

  r = __rotr_4u64(x, 28);
  t = __rotr_4u64(x, 34);
  r ^= t;
  t = __rotr_4u64(x, 39);
  r ^= t;
  return r;
}

inline fn __Sigma1_4x(reg u256 x) -> reg u256
{
  reg u256 r t;

  r = __rotr_4u64(x, 14);
  t = __rotr_4u64(x, 18);
  r ^= t;
  t = __rotr_4u64(x, 41);
  r ^= t;
  return r;
}

inline fn __sigma0_4x(reg u256 x) -> reg u256
{
  reg u256 r t;

  r = __rotr_4u64(x, 1);
  t = __rotr_4u64(x, 8);
  r ^= t;
  t = x >>4u64 7;
  r ^= t;
  return r;
}

inline fn __sigma1_4x(reg u256 x) -> reg u256
{
  reg u256 r t;

  r = __rotr_4u64(x, 19);
  t = __rotr_4u64(x, 61);
  r ^= t;
  t = x >>4u64 6;
  r ^= t;
  return r;
}

/*
 * Words 4q .. 4q + 3 of the four blocks into w[4q .. 4q + 3], transposed
 * and byte-swapped. Row k is instance k's 32 bytes at 128k + 32q.
 */
inline fn __sha512_x4_load_quarter(
  stack u256[16] w,
  reg const ptr u8[512] blocks,
  inline int q,
  reg u256 mask
) -> stack u256[16]
{
  reg u256[4] r t;
  reg u256 c;
  inline int k;

  for k = 0 to 4 {
    r[k] = blocks[:u256 4 * k + q];
  }

  /* row pairs: qwords 0 | 2 in t[0], t[2]; qwords 1 | 3 in t[1], t[3] */
  t[0] = #VPUNPCKL_4u64(r[0], r[1]);
  t[1] = #VPUNPCKH_4u64(r[0], r[1]);
  t[2] = #VPUNPCKL_4u64(r[2], r[3]);
  t[3] = #VPUNPCKH_4u64(r[2], r[3]);

  /* halves: instances 0-1 from t[m], 2-3 from t[m + 2] */
  for k = 0 to 2 {
    c = #VPERM2I128(t[k], t[k + 2], 0x20);
    c = #VPSHUFB_256(c, mask);
    w[4 * q + k] = c;
    c = #VPERM2I128(t[k], t[k + 2], 0x31);
    c = #VPSHUFB_256(c, mask);
    w[4 * q + k + 2] = c;
  }

  return w;
}

#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × msf"]
fn _sha512_x4_compress(
  reg mut ptr u64[32] h4,
  reg const ptr u8[512] blocks,
  reg u64 ms
) -> reg ptr u64[32], reg u64
{
  stack u256[16] w;
  reg ptr u64[4] mask_p;
  reg ptr u64[80] k;
  reg u256[8] v;
  reg u256 mask t1 x y;
  inline int t i;

  mask_p = SHA512_X4_BSWAP;
  mask = mask_p[:u256 0];
  for i = 0 to 4 {
    w = __sha512_x4_load_quarter(w, blocks, i, mask);
  }

  for i = 0 to 8 {
    v[i] = h4[:u256 i];
  }
  k = SHA512_K;

  /*
   * Rounds of section 6.4.2 step 3; variable k (a = 0 .. h = 7) of round t
   * is v[(k - t) mod 8].
   */

  for t = 0 to 80 {
    #[inline]
    if (t >= 16) {
      t1 = __sigma1_4x(w[(t - 2) % 16]);
      x = __sigma0_4x(w[(t - 15) % 16]);
      t1 = t1 +4u64 x;
      t1 = t1 +4u64 w[(t - 7) % 16];
      t1 = t1 +4u64 w[t % 16];
      w[t % 16] = t1;
    } else {
      t1 = w[t];
    }

    /* T1 = h + Σ1(e) + Ch(e, f, g) + K_t + W_t */

    t1 = t1 +4u64 v[(7 + 80 - t) % 8];
    x = __Sigma1_4x(v[(4 + 80 - t) % 8]);
    t1 = t1 +4u64 x;
    x = v[(5 + 80 - t) % 8] ^ v[(6 + 80 - t) % 8];
    x &= v[(4 + 80 - t) % 8];
    x ^= v[(6 + 80 - t) % 8];
    t1 = t1 +4u64 x;
    x = #VPBROADCAST_4u64(k[t]);
    t1 = t1 +4u64 x;

    /* e' = d + T1 */

    v[(3 + 80 - t) % 8] = v[(3 + 80 - t) % 8] +4u64 t1;

    /* a' = T1 + Σ0(a) + Maj(a, b, c) */

    x = __Sigma0_4x(v[(0 + 80 - t) % 8]);
    t1 = t1 +4u64 x;
    x = v[(0 + 80 - t) % 8] ^ v[(1 + 80 - t) % 8];
    x &= v[(2 + 80 - t) % 8];
    y = v[(0 + 80 - t) % 8] & v[(1 + 80 - t) % 8];
    x ^= y;
    t1 = t1 +4u64 x;
    v[(7 + 80 - t) % 8] = t1;
  }

  /* Step 4 */

  for i = 0 to 8 {
    x = h4[:u256 i];
    x = x +4u64 v[i];
    h4[:u256 i] = x;
  }

  return h4, ms;
}
