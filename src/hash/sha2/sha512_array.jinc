/*
 * SPDX-FileCopyrightText: nirapod-slhdsa contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * sha512_array.jinc
 * =================
 *
 * _sha512_absorb_array: append a byte array whose length is fixed by the
 * enclosing namespace (param int HASH_ARRAY_LEN), with the contract of
 * _sha512_absorb_mem. sha512.jinc must be required at top level first.
 *
 * The structure is that of sha256_array.jinc with 128-byte blocks.
 */

/* Copy n bytes of in from offset off into buf from position fill. */
inline fn __sha512_buf_copy_array(
  reg mut ptr u8[128] buf,
  reg u64 fill_,
  reg const ptr u8[HASH_ARRAY_LEN] in,
  reg u64 off_ n_,
  reg u64 ms
) -> reg ptr u8[128], reg u64
{
  reg u64 fill off n head end t;
  reg bool more;

  fill = fill_;
  off = off_;
  n = n_;

  head = fill;
  head = -head;
  head &= 7;
  head = n < head ? n : head;
  n -= head;

  end = fill;
  end += head;
  while { more = fill < end; } (more) {
    ms = #update_msf(more, ms);
    t = (64u)in[off];
    buf[fill] = (8u)t;
    fill += 1;
    off += 1;
  }
  ms = #update_msf(!more, ms);

  while { more = n >= 8; } (more) {
    ms = #update_msf(more, ms);
    t = in.[:u64 off];
    buf.[:u64 fill] = t;
    fill += 8;
    off += 8;
    n -= 8;
  }
  ms = #update_msf(!more, ms);

  end = fill;
  end += n;
  while { more = fill < end; } (more) {
    ms = #update_msf(more, ms);
    t = (64u)in[off];
    buf[fill] = (8u)t;
    fill += 1;
    off += 1;
  }
  ms = #update_msf(!more, ms);

  return buf, ms;
}

#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } × public ×
         { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × { ptr: public, val: secret } × public × msf"]
fn _sha512_absorb_array(
  reg mut ptr u64[8] h,
  reg mut ptr u8[128] buf,
  reg u64 total,
  reg const ptr u8[HASH_ARRAY_LEN] in,
  reg u64 ms
) -> reg ptr u64[8], reg ptr u8[128], reg u64, reg u64
{
  reg u64 fill off inlen n;
  reg bool more full;

  fill = total;
  fill &= 127;
  total += HASH_ARRAY_LEN;
  off = 0;
  inlen = HASH_ARRAY_LEN;

  /* Invariant: buf holds fill < 128 pending bytes at each iteration's top. */

  while { more = inlen != 0; } (more) {
    ms = #update_msf(more, ms);

    n = 128;
    n -= fill;
    n = inlen < n ? inlen : n;
    buf, ms = __sha512_buf_copy_array(buf, fill, in, off, n, ms);
    fill += n;
    off += n;
    inlen -= n;

    full = fill == 128;
    if (full) {
      ms = #update_msf(full, ms);
      () = #spill(total, in, off, inlen, buf);
      h, ms = _sha512_compress(h, buf, ms);
      () = #unspill(total, in, off, inlen, buf);
      total = #protect(total, ms);
      in = #protect_ptr(in, ms);
      off = #protect(off, ms);
      inlen = #protect(inlen, ms);
      buf = #protect_ptr(buf, ms);
      fill = 0;
    } else {
      ms = #update_msf(!full, ms);
    }
  }
  ms = #update_msf(!more, ms);

  return h, buf, total, ms;
}
