 *
 * word.jinc (x86-64)
 * ==================
 *
 * Word operations for the hash kernels. The contract of each function is
 * stated in aarch64/word.jinc; only the instruction differs.
 */

inline fn __bswap32(reg u32 x) -> reg u32
{
  x = #BSWAP_32(x);
  return x;
}

inline fn __bswap64(reg u64 x) -> reg u64
{
  x = #BSWAP_64(x);
  return x;
}
