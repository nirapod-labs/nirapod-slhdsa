/*
 * SPDX-FileCopyrightText: nirapod-slhdsa contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * hmac.jinc
 * =========
 *
 * HMAC (FIPS 198-1) over SHA-256 and SHA-512:
 *
 *     HMAC(K, text) = H((K0 ^ opad) || H((K0 ^ ipad) || text))
 *
 * with ipad = 0x36 and opad = 0x5c repeated over one block (section 3).
 * FIPS 205 section 11.2 uses it for PRF_msg with K = SK.prf.
 *
 * The computation is split so the message goes through the ordinary
 * absorb functions of sha256.jinc and sha512.jinc:
 *
 *     _hmac_sha<x>_keyblock_mem   K -> K0                       steps 1-3
 *     __hmac_sha<x>_init          K0 -> inner, outer states     steps 4-5, 7-8
 *     (caller absorbs text into inner with total = block size)  step 6
 *     __hmac_sha<x>_finalize      tag                           step 9
 *
 * inner and outer are chaining values after one compression each; they
 * depend only on the key, so a caller may keep outer for several messages.
 *
 * Security: key, K0, states, text and tag are secret. Key length and
 * pointers are public.
 */

require "sha256.jinc"
require "sha512.jinc"

/*
 * K0 from a key in memory (FIPS 198-1 section 4, steps 1 to 3): a key of
 * at most one block is padded with zeros; a longer key is replaced by its
 * digest, then padded. The key length is public and selects the case.
 *
 * Residue: for a long key the local digest holds H(K) on return, and
 * the one-shot hash of the key leaves its last padded block.
 */
#[sct = "{ ptr: public, val: secret } × public × public × msf →
         { ptr: public, val: secret } × msf"]
fn _hmac_sha256_keyblock_mem(
  reg mut ptr u8[64] k0,
  reg u64 key keylen,
  reg u64 ms
) -> reg ptr u8[64], reg u64
{
  stack u8[32] digest;
  reg u64 i z t;
  inline int j;
  reg bool long more;

  long = keylen > 64;
  if (long) {
    ms = #update_msf(long, ms);
    /*
     * The digest goes to local storage and is copied after the call; k0
     * crosses the call through the stack and is protected on reload.
     */
    () = #spill(k0);
    digest, ms = _sha256_mem(digest, key, keylen, ms);
    () = #unspill(k0);
    k0 = #protect_ptr(k0, ms);
    for j = 0 to 4 {
      t = digest[:u64 j];
      k0[:u64 j] = t;
    }
    i = 32;
  } else {
    ms = #update_msf(!long, ms);
    i = 0;
    while { more = i < keylen; } (more) {
      ms = #update_msf(more, ms);
      t = (64u)[:u8 key + i];
      k0[i] = (8u)t;
      i += 1;
    }
    ms = #update_msf(!more, ms);
  }

  z = 0;
  while { more = i < 64; } (more) {
    ms = #update_msf(more, ms);
    k0[i] = (8u)z;
    i += 1;
  }
  ms = #update_msf(!more, ms);

  return k0, ms;
}

#[sct = "{ ptr: public, val: secret } × public × public × msf →
         { ptr: public, val: secret } × msf"]
fn _hmac_sha512_keyblock_mem(
  reg mut ptr u8[128] k0,
  reg u64 key keylen,
  reg u64 ms
) -> reg ptr u8[128], reg u64
{
  stack u8[64] digest;
  reg u64 i z t;
  inline int j;
  reg bool long more;

  long = keylen > 128;
  if (long) {
    ms = #update_msf(long, ms);
    /*
     * The digest goes to local storage and is copied after the call; k0
     * crosses the call through the stack and is protected on reload.
     */
    () = #spill(k0);
    digest, ms = _sha512_mem(digest, key, keylen, ms);
    () = #unspill(k0);
    k0 = #protect_ptr(k0, ms);
    for j = 0 to 8 {
      t = digest[:u64 j];
      k0[:u64 j] = t;
    }
    i = 64;
  } else {
    ms = #update_msf(!long, ms);
    i = 0;
    while { more = i < keylen; } (more) {
      ms = #update_msf(more, ms);
      t = (64u)[:u8 key + i];
      k0[i] = (8u)t;
      i += 1;
    }
    ms = #update_msf(!more, ms);
  }

  z = 0;
  while { more = i < 128; } (more) {
    ms = #update_msf(more, ms);
    k0[i] = (8u)z;
    i += 1;
  }
  ms = #update_msf(!more, ms);

  return k0, ms;
}

/*
 * inner <- compress(IV, K0 ^ ipad), outer <- compress(IV, K0 ^ opad).
 *
 * inner and outer are the caller's stack arrays, passed by name.
 *
 * Residue: the local pad blocks hold K0 ^ ipad and K0 ^ opad on return.
 * Neither they nor the compression's schedule window are cleared here;
 * clearing is an obligation of the export that runs this code.
 */
inline fn __hmac_sha256_init(
  stack u32[8] inner outer,
  reg const ptr u8[64] k0,
  reg u64 ms
) -> stack u32[8], stack u32[8], reg u64
{
  stack u8[64] ipad opad;
  reg u64 t u mi mo;
  inline int i;

  /*
   * Both padded blocks are formed before either compression, so k0 is dead
   * by the first call and nothing but the call's own arguments is live
   * across it.
   */

  mi = 0x3636363636363636;
  mo = 0x5c5c5c5c5c5c5c5c;
  for i = 0 to 8 {
    t = k0[:u64 i];
    u = t;
    t ^= mi;
    u ^= mo;
    ipad[:u64 i] = t;
    opad[:u64 i] = u;
  }

  inner = __sha256_init(inner);
  inner, ms = _sha256_compress(inner, ipad, ms);

  outer = __sha256_init(outer);
  outer, ms = _sha256_compress(outer, opad, ms);

  return inner, outer, ms;
}

/* The SHA-512 form of __hmac_sha256_init, with 128-byte blocks. */
inline fn __hmac_sha512_init(
  stack u64[8] inner outer,
  reg const ptr u8[128] k0,
  reg u64 ms
) -> stack u64[8], stack u64[8], reg u64
{
  stack u8[128] ipad opad;
  reg u64 t u mi mo;
  inline int i;

  /*
   * Both padded blocks are formed before either compression, so k0 is dead
   * by the first call and nothing but the call's own arguments is live
   * across it.
   */

  mi = 0x3636363636363636;
  mo = 0x5c5c5c5c5c5c5c5c;
  for i = 0 to 16 {
    t = k0[:u64 i];
    u = t;
    t ^= mi;
    u ^= mo;
    ipad[:u64 i] = t;
    opad[:u64 i] = u;
  }

  inner = __sha512_init(inner);
  inner, ms = _sha512_compress(inner, ipad, ms);

  outer = __sha512_init(outer);
  outer, ms = _sha512_compress(outer, opad, ms);

  return inner, outer, ms;
}

/*
 * Step 9: tag = H((K0 ^ opad) || inner_digest).
 *
 * The inner digest is finished first, then the outer hash continues from a
 * copy of outer in the inner state's storage, so outer itself is only read.
 * The outer message is one block of key plus the digest: total starts at
 * the block size and grows by the digest length.
 *
 * out and outer are the caller's stack arrays, passed by name, as at
 * __hmac_sha256_init.
 */
inline fn __hmac_sha256_finalize(
  stack u8[32] out,
  reg mut ptr u32[8] inner,
  reg mut ptr u8[64] buf,
  reg u64 total,
  stack u32[8] outer,
  reg u64 ms
) -> stack u8[32], reg ptr u32[8], reg ptr u8[64], reg u64
{
  stack u8[32] digest;
  reg u64 t;
  reg u32 x;
  inline int i;

  digest, inner, buf, ms = _sha256_finalize(digest, inner, buf, total, ms);

  for i = 0 to 8 {
    x = outer[i];
    inner[i] = x;
  }
  for i = 0 to 4 {
    t = digest[:u64 i];
    buf[:u64 i] = t;
  }
  total = 64 + 32;
  out, inner, buf, ms = _sha256_finalize(out, inner, buf, total, ms);

  return out, inner, buf, ms;
}

/* The SHA-512 form of __hmac_sha256_finalize. */
inline fn __hmac_sha512_finalize(
  stack u8[64] out,
  reg mut ptr u64[8] inner,
  reg mut ptr u8[128] buf,
  reg u64 total,
  stack u64[8] outer,
  reg u64 ms
) -> stack u8[64], reg ptr u64[8], reg ptr u8[128], reg u64
{
  stack u8[64] digest;
  reg u64 t;
  inline int i;

  digest, inner, buf, ms = _sha512_finalize(digest, inner, buf, total, ms);

  for i = 0 to 8 {
    t = outer[i];
    inner[i] = t;
  }
  for i = 0 to 8 {
    t = digest[:u64 i];
    buf[:u64 i] = t;
  }
  total = 128 + 64;
  out, inner, buf, ms = _sha512_finalize(out, inner, buf, total, ms);

  return out, inner, buf, ms;
}
