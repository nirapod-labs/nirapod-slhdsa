param int SLH_N        = 32;
param int SLH_H        = 64;
param int SLH_D        = 8;
param int SLH_HP       = 8;
param int SLH_A        = 14;
param int SLH_K        = 22;
param int SLH_M        = 47;
param int SLH_CATEGORY = 5;
