/*
 * SPDX-FileCopyrightText: nirapod-slhdsa contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * constants.jinc
 * ==============
 *
 * Quantities derived from the parameter set. A set file under params/
 * supplies n, h, d, h', a, k and m; everything here follows from FIPS 205
 * and is shared by all twelve sets.
 *
 * WOTS+
 *
 *     lg_w = 4 and w = 16 in every FIPS 205 parameter set (Table 2).
 *
 *     len1 = 8n / lg_w = 2n                                  (equation 5.1)
 *     len2 = floor(log2(len1 (w - 1)) / lg_w) + 1 = 3        (equation 5.2)
 *     len  = len1 + len2
 *
 *     len2 is 3 for every n in {16, 24, 32}: len1 (w - 1) lies in
 *     [480, 960], whose base-2 logarithm floors to 8 or 9.
 *
 * Message digest split (FIPS 205 Algorithm 19, lines 7-12)
 *
 *     digest = md || tmp_idx_tree || tmp_idx_leaf, of m bytes, where
 *
 *         |md|           = ceil(k a / 8)
 *         |tmp_idx_tree| = ceil((h - h') / 8)
 *         |tmp_idx_leaf| = ceil(h' / 8)
 *
 *     and idx_tree < 2^(h - h'), idx_leaf < 2^h'. h - h' is at most 64
 *     (SLH-DSA-*-256f), so idx_tree fits one 64-bit word.
 *
 * Signature layout (FIPS 205 section 9.2, Figure 17)
 *
 *     R (n) || SIG_FORS (k (1 + a) n) || SIG_HT (d (len + h') n)
 */

param int SLH_LGW  = 4;
param int SLH_W    = 16;
param int SLH_LEN1 = 2 * SLH_N;
param int SLH_LEN2 = 3;
param int SLH_LEN  = SLH_LEN1 + SLH_LEN2;

param int SLH_PK_BYTES = 2 * SLH_N;
param int SLH_SK_BYTES = 4 * SLH_N;

param int SLH_WOTS_SIG_BYTES = SLH_LEN * SLH_N;
param int SLH_XMSS_SIG_BYTES = (SLH_LEN + SLH_HP) * SLH_N;
param int SLH_HT_SIG_BYTES   = SLH_D * SLH_XMSS_SIG_BYTES;
param int SLH_FORS_SIG_BYTES = SLH_K * (SLH_A + 1) * SLH_N;
param int SLH_SIG_BYTES      = SLH_N + SLH_FORS_SIG_BYTES + SLH_HT_SIG_BYTES;

param int SLH_SIG_FORS_OFFSET = SLH_N;
param int SLH_SIG_HT_OFFSET   = SLH_N + SLH_FORS_SIG_BYTES;

param int SLH_MD_BYTES       = (SLH_K * SLH_A + 7) / 8;
param int SLH_TREE_BITS      = SLH_H - SLH_HP;
param int SLH_IDX_TREE_BYTES = (SLH_TREE_BITS + 7) / 8;
param int SLH_IDX_LEAF_BYTES = (SLH_HP + 7) / 8;

/* Leaves per XMSS tree and per FORS tree. */
param int SLH_XMSS_LEAVES = 1 << SLH_HP;
param int SLH_FORS_LEAVES = 1 << SLH_A;

/*
 * Secret key = SK.seed || SK.prf || PK.seed || PK.root, public key =
 * PK.seed || PK.root (FIPS 205 Figures 15 and 16).
 */
param int SLH_SK_SEED_OFFSET = 0;
param int SLH_SK_PRF_OFFSET  = SLH_N;
param int SLH_SK_PK_OFFSET   = 2 * SLH_N;

/*
 * M' framing (FIPS 205 Algorithms 22 and 23). The longest prefix that
 * precedes the caller's message is the pre-hash form:
 *
 *     0x01 || |ctx| || ctx (<= 255) || OID (11) || PH(M) (<= 64)
 *
 * The domain block passed by the C layer is
 *
 *     pre-hash id (1) || |ctx| (1) || ctx, zero padded to 255 bytes.
 */
param int SLH_CTX_MAX       = 255;
param int SLH_OID_BYTES     = 11;
param int SLH_PH_MAX_BYTES  = 64;
param int SLH_PREFIX_MAX    = 2 + SLH_CTX_MAX + SLH_OID_BYTES + SLH_PH_MAX_BYTES;
param int SLH_DOMAIN_BYTES  = 2 + SLH_CTX_MAX;
