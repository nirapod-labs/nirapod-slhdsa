/*
 * SPDX-FileCopyrightText: nirapod-slhdsa contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * thash_sha2_x4.jinc (multi)
 * ==========================
 *
 * The four-way forms of the SHA2 tweakable hashes on the multi-way SHA-2
 * kernels of the hash layer (Sha2KernelX), with the functions, layouts and
 * contracts of thash_sha2.jinc, "Four-way forms":
 *
 *     _thash_prf_x4    PRF on instances 0 .. 3: one 8-way SHA-256 compression
 *     _thash_f_x4      F on instances 0 .. 3: one 8-way SHA-256 compression
 *     _thash_t_len_x4  T_len on instances 0 .. 3: per block, one 8-way
 *                      SHA-256 compression in category 1, one 4-way
 *                      SHA-512 compression in categories 3 and 5
 *
 * Each instance computes exactly the bytes its one-way function computes:
 * the same padded blocks (built by the same layout helpers) are compressed
 * from the same precomputed state, in the same order.
 *
 * Lanes
 *
 *     _sha256_x8_compress   h8 u32[64], H_j of lane k at 8j + k;
 *                           lane k's block at bytes 64k .. 64k + 63
 *     _sha512_x4_compress   h4 u64[32], H_j of lane k at 4j + k;
 *                           lane k's block at bytes 128k .. 128k + 127
 *
 *     Instance k is lane k. The tree code supplies four instances, so
 *     lanes 4 .. 7 of the 8-way SHA-256 kernel are idle: their chaining
 *     values and blocks are zero, set at constant indices before the
 *     compression, and their results are never read. They cost the
 *     kernel's work for them and carry no data.
 *
 * Security: as thash_sha2.jinc. Every block, chaining value and output is
 * secret; block counts, offsets and lane indices are compile-time
 * constants or loop counters bounded by them. The idle lanes hold zeros.
 * The staging buffers here and the kernels' frames (schedule words of
 * every lane) keep secret data on return; clearing is the export's
 * obligation (-stack-zero).
 */

from Sha2KernelX require "sha256_x8_compress.jinc"
from Sha2KernelX require "sha512_x4_compress.jinc"

/* Bytes of one instance's padded T_len message in the staging buffer. */
param int TX_LANE_BYTES = TLen::T_BLOCKS_512 * 128;

/*
 * h8 <- the precomputed SHA-256 state of ctx (words 0 .. 3, two state
 * words each) in lanes 0 .. 3; zero in the idle lanes 4 .. 7.
 */
inline fn __sha256_x8_seeded(reg mut ptr u32[64] h8, reg const ptr u64[THASH_CTX_WORDS] ctx)
  -> reg ptr u32[64]
{
  reg u32 w z;
  inline int j k;

  z = 0;
  for j = 0 to 8 {
    w = ctx[:u32 j];
    for k = 0 to 4 {
      h8[8 * j + k] = w;
    }
    for k = 4 to 8 {
      h8[8 * j + k] = z;
    }
  }

  return h8;
}

/* The blocks of the idle lanes 4 .. 7, bytes 256 .. 511, to zero. */
inline fn __sha256_x8_idle_blocks(reg mut ptr u8[512] blk) -> reg ptr u8[512]
{
  reg u64 z;
  inline int i;

  z = 0;
  for i = 32 to 64 {
    blk[:u64 i] = z;
  }

  return blk;
}

/* out[k] <- the first n bytes of lane k's big-endian state, k = 0 .. 3. */
inline fn __sha256_x8_trunc_n(reg mut ptr u8[4 * SLH_N] out, reg const ptr u32[64] h8)
  -> reg ptr u8[4 * SLH_N]
{
  reg u32 w;
  inline int i k;

  for k = 0 to 4 {
    for i = 0 to SLH_N / 4 {
      w = h8[8 * i + k];
      w = __bswap32(w);
      out[:u32 SLH_N / 4 * k + i] = w;
    }
  }

  return out;
}

/* h4 <- the precomputed SHA-512 state of ctx (words 4 .. 11) in lanes 0 .. 3. */
inline fn __sha512_x4_seeded(reg mut ptr u64[32] h4, reg const ptr u64[THASH_CTX_WORDS] ctx)
  -> reg ptr u64[32]
{
  reg u64 t;
  inline int j k;

  for j = 0 to 8 {
    t = ctx[4 + j];
    for k = 0 to 4 {
      h4[4 * j + k] = t;
    }
  }

  return h4;
}

/* out[k] <- the first n bytes of lane k's big-endian state, k = 0 .. 3. */
inline fn __sha512_x4_trunc_n(reg mut ptr u8[4 * SLH_N] out, reg const ptr u64[32] h4)
  -> reg ptr u8[4 * SLH_N]
{
  reg u64 t;
  inline int i k;

  for k = 0 to 4 {
    for i = 0 to SLH_N / 8 {
      t = h4[4 * i + k];
      t = __bswap64(t);
      out[:u64 SLH_N / 8 * k + i] = t;
    }
  }

  return out;
}

/*
 * out[k] <- PRF(PK.seed, SK.seed, adrs[k]), k = 0 .. 3
 *
 * Lane k's block is the one _thash_prf compresses: ADRS^c of adrs[k],
 * SK.seed, padding (__sha256_seeded_block).
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } ×
         { ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × msf"]
fn _thash_prf_x4(
  reg mut ptr u8[4 * SLH_N] out,
  reg const ptr u8[SLH_N] sk_seed,
  reg const ptr u64[THASH_CTX_WORDS] ctx,
  reg const ptr u64[16] adrs,
  reg u64 ms
) -> reg ptr u8[4 * SLH_N], reg u64
{
  stack u8[512] blk;
  stack u32[64] h8;
  reg u64 t;
  inline int i k;

  for k = 0 to 4 {
    blk[64 * k : 64] = __sha256_seeded_block(blk[64 * k : 64], adrs[4 * k : 4],
                                             SLH_N, SHA256_TAIL_BITS_N);
    for i = 0 to SLH_N / 8 {
      t = sk_seed[:u64 i];
      blk.[:u64 64 * k + SHA2_ADRSC_BYTES + 8 * i] = t;
    }
  }
  blk = __sha256_x8_idle_blocks(blk);
  h8 = __sha256_x8_seeded(h8, ctx);

  #spill(out);
  h8, ms = _sha256_x8_compress(h8, blk, ms);
  #unspill(out);
  out = #protect_ptr(out, ms);
  out = __sha256_x8_trunc_n(out, h8);

  return out, ms;
}

/*
 * x[k] <- F(PK.seed, adrs[k], x[k]), k = 0 .. 3, in place
 *
 * Every x[k] is read into its block before the compression and written
 * after it, so the in-place update has no ordering hazard.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } ×
         { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × msf"]
fn _thash_f_x4(
  reg mut ptr u8[4 * SLH_N] x,
  reg const ptr u64[THASH_CTX_WORDS] ctx,
  reg const ptr u64[16] adrs,
  reg u64 ms
) -> reg ptr u8[4 * SLH_N], reg u64
{
  stack u8[512] blk;
  stack u32[64] h8;
  reg u64 t;
  inline int i k;

  for k = 0 to 4 {
    blk[64 * k : 64] = __sha256_seeded_block(blk[64 * k : 64], adrs[4 * k : 4],
                                             SLH_N, SHA256_TAIL_BITS_N);
    for i = 0 to SLH_N / 8 {
      t = x[:u64 SLH_N / 8 * k + i];
      blk.[:u64 64 * k + SHA2_ADRSC_BYTES + 8 * i] = t;
    }
  }
  blk = __sha256_x8_idle_blocks(blk);
  h8 = __sha256_x8_seeded(h8, ctx);

  #spill(x);
  h8, ms = _sha256_x8_compress(h8, blk, ms);
  #unspill(x);
  x = #protect_ptr(x, ms);
  x = __sha256_x8_trunc_n(x, h8);

  return x, ms;
}

/*
 * out[k] <- T_len(PK.seed, adrs[k], in[k]), k = 0 .. 3
 *
 * Phase 1, layout. Instance k's padded message (ADRS^c || M_k || padding,
 * thash_sha2_t.jinc) is laid out by TLen::__t_layout, as TLen::_thash_t
 * lays it out, in msgs[TX_LANE_BYTES k ..]. The region is sized for the
 * SHA-512 layout; the SHA-256 one is never longer (64 T_BLOCKS_256 is the
 * least multiple of 64 >= l n + 31, and 128 T_BLOCKS_512, a multiple of
 * 64 that is >= l n + 39, cannot be smaller).
 *
 * Phase 2, compression. Block j of the four instances is gathered into
 * the kernel's lane layout and compressed:
 *
 *     blk[b k .. b k + b - 1] = msgs[TX_LANE_BYTES k + b j .. + b - 1]
 *
 *     with b = 64 for SHA-256 and 128 for SHA-512, the block size and the
 *     kernel's lane stride.
 *
 *     Invariant: before block j, lane k of the state is X's chaining value
 *     of instance k after its first j blocks (from the precomputed state).
 *
 * Phase 3: out[k] <- Trunc_n(lane k).
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } ×
         { ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × msf"]
fn _thash_t_len_x4(
  reg mut ptr u8[4 * SLH_N] out,
  reg const ptr u8[4 * SLH_LEN * SLH_N] in,
  reg const ptr u64[THASH_CTX_WORDS] ctx,
  reg const ptr u64[16] adrs,
  reg u64 ms
) -> reg ptr u8[4 * SLH_N], reg u64
{
  stack u8[4 * TX_LANE_BYTES] msgs;
  stack u8[512] blk;
  stack u32[64] h8;
  stack u64[32] h4;
  reg ptr u8[TX_LANE_BYTES] p;
  reg u64 t off o;
  reg bool more;
  inline int i k;

  /* Phase 1 */

  for k = 0 to 4 {
    p = msgs[TX_LANE_BYTES * k : TX_LANE_BYTES];
    #[inline]
    if (SHA2_WIDE == 0) {
      p, ms = TLen::__t_layout(p, in[SLH_LEN * SLH_N * k : SLH_LEN * SLH_N], adrs[4 * k : 4],
                               64 * TLen::T_BLOCKS_256, TLen::T_BITS_256, ms);
    } else {
      p, ms = TLen::__t_layout(p, in[SLH_LEN * SLH_N * k : SLH_LEN * SLH_N], adrs[4 * k : 4],
                               128 * TLen::T_BLOCKS_512, TLen::T_BITS_512, ms);
    }
    msgs[TX_LANE_BYTES * k : TX_LANE_BYTES] = p;
  }

  #spill(out);

  /* Phase 2; off is the byte offset of block j within each instance. */

  off = 0;

  #[inline]
  if (SHA2_WIDE == 0) {
    blk = __sha256_x8_idle_blocks(blk);
    h8 = __sha256_x8_seeded(h8, ctx);

    while { more = off < 64 * TLen::T_BLOCKS_256; } (more) {
      ms = #update_msf(more, ms);
      o = off;
      for k = 0 to 4 {
        for i = 0 to 8 {
          t = msgs.[:u64 o + 8 * i];
          blk[:u64 8 * k + i] = t;
        }
        o += TX_LANE_BYTES;
      }
      #spill(off);
      h8, ms = _sha256_x8_compress(h8, blk, ms);
      #unspill(off);
      off = #protect(off, ms);
      off += 64;
    }
    ms = #update_msf(!more, ms);

    #unspill(out);
    out = #protect_ptr(out, ms);
    out = __sha256_x8_trunc_n(out, h8);
  } else {
    h4 = __sha512_x4_seeded(h4, ctx);

    while { more = off < 128 * TLen::T_BLOCKS_512; } (more) {
      ms = #update_msf(more, ms);
      o = off;
      for k = 0 to 4 {
        for i = 0 to 16 {
          t = msgs.[:u64 o + 8 * i];
          blk[:u64 16 * k + i] = t;
        }
        o += TX_LANE_BYTES;
      }
      #spill(off);
      h4, ms = _sha512_x4_compress(h4, blk, ms);
      #unspill(off);
      off = #protect(off, ms);
      off += 128;
    }
    ms = #update_msf(!more, ms);

    #unspill(out);
    out = #protect_ptr(out, ms);
    out = __sha512_x4_trunc_n(out, h4);
  }

  return out, ms;
}
