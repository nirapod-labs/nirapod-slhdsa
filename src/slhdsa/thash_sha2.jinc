/*
 * SPDX-FileCopyrightText: nirapod-slhdsa contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * thash_sha2.jinc
 * ===============
 *
 * The SHA2 instantiation of FIPS 205 section 11.2. With ADRS^c the 22-byte
 * compressed address and pad_b = toByte(0, b - n) for a block of b bytes:
 *
 *     PRF(PK.seed, SK.seed, ADRS) = Trunc_n(SHA-256(PK.seed || pad_64 || ADRS^c || SK.seed))
 *     F(PK.seed, ADRS, M1)        = Trunc_n(SHA-256(PK.seed || pad_64 || ADRS^c || M1))
 *
 * and, with (X, b) = (SHA-256, 64) in security category 1 (section
 * 11.2.1) and (SHA-512, 128) in categories 3 and 5 (section 11.2.2):
 *
 *     H(PK.seed, ADRS, M2)  = Trunc_n(X(PK.seed || pad_b || ADRS^c || M2))
 *     T_l(PK.seed, ADRS, M) = Trunc_n(X(PK.seed || pad_b || ADRS^c || M))
 *     PRF_msg(SK.prf, opt_rand, M) = Trunc_n(HMAC-X(SK.prf, opt_rand || M))
 *     H_msg(R, PK.seed, PK.root, M)
 *         = MGF1-X(R || PK.seed || X(R || PK.seed || PK.root || M), m)
 *
 * Compressed address (section 11.2)
 *
 *     ADRS^c = ADRS[3] || ADRS[8:16] || ADRS[19] || ADRS[20:32]
 *
 *     the low byte of the layer address, the low 8 bytes of the tree
 *     address, the low byte of the type, and the three final words. The
 *     dropped bytes are zero for every ADRS this implementation builds
 *     (address.jinc, field ranges).
 *
 * Precomputed state
 *
 *     PK.seed || pad_b is exactly one block of X, the same for every call
 *     with one key. ctx holds the chaining value after that block: the
 *     SHA-256 state in words 0..3 and, in categories 3 and 5, the SHA-512
 *     state in words 4..11. Each hash copies the state and continues with
 *     total = b bytes absorbed.
 *
 * Single-block finish
 *
 *     After the precomputed block, PRF and F have 22 + n <= 54 bytes left,
 *     and H has 22 + 2n <= 54 (SHA-256, n = 16) or <= 86 (SHA-512): with
 *     the 0x80 byte and the length field (8 bytes for SHA-256, 16 for
 *     SHA-512, FIPS 180-4 section 5.1) each fits one more block. These
 *     blocks are laid out here with constant offsets and compressed
 *     directly. T_l and the message hashes stream through the hash layer.
 *
 * Security: as thash_shake.jinc. Secret values move as data only; offsets
 * and lengths are public.
 */

from Hash require "sha2/sha256.jinc"
from Hash require "sha2/sha512.jinc"
from Hash require "sha2/hmac.jinc"

param int THASH_CTX_WORDS = 12;

/*
 * X is SHA-512 in categories 3 and 5 (FIPS 205 section 11.2.2): SHA2_WIDE
 * is 0 for category 1 and 1 for categories 3 and 5. It is written as
 * arithmetic because it sizes an array.
 */
param int SHA2_WIDE        = (SLH_CATEGORY + 1) / 4;
param int SHA2_X_DIGEST    = 32 * (1 + SHA2_WIDE);
param int SHA2_ADRSC_BYTES = 22;

/* Bit length of PK.seed || pad_b || ADRS^c || x for an x of `bytes`. */
param int SHA256_TAIL_BITS_N  = 8 * (64 + SHA2_ADRSC_BYTES + SLH_N);
param int SHA256_TAIL_BITS_2N = 8 * (64 + SHA2_ADRSC_BYTES + 2 * SLH_N);
param int SHA512_TAIL_BITS_2N = 8 * (128 + SHA2_ADRSC_BYTES + 2 * SLH_N);

namespace Mgf {
  param int MGF1_SEED_LEN = 2 * SLH_N + SHA2_X_DIGEST;
  param int MGF1_OUT_LEN = SLH_M;
  from Hash require "sha2/mgf1.jinc"
}

/*
 * ADRS^c into dst[0 : 22], the layout above. The same bytes are written in
 * three places: here for a 64-byte block, in __adrs_compress_into128 for a
 * 128-byte one, and in __t_layout (thash_sha2_t.jinc). A change to one is
 * a change to all three.
 */
inline fn __adrs_compress_into64(reg mut ptr u8[64] dst, reg const ptr u64[4] adrs) -> reg ptr u8[64]
{
  reg u64 t;
  inline int i;

  t = (64u) adrs[:u8 3];
  dst[0] = (8u) t;
  for i = 0 to 8 {
    t = (64u) adrs[:u8 8 + i];
    dst[1 + i] = (8u) t;
  }
  t = (64u) adrs[:u8 19];
  dst[9] = (8u) t;
  for i = 0 to 12 {
    t = (64u) adrs[:u8 20 + i];
    dst[10 + i] = (8u) t;
  }

  return dst;
}

/* ADRS^c into dst[0 : 22]: as __adrs_compress_into64. */
inline fn __adrs_compress_into128(reg mut ptr u8[128] dst, reg const ptr u64[4] adrs) -> reg ptr u8[128]
{
  reg u64 t;
  inline int i;

  t = (64u) adrs[:u8 3];
  dst[0] = (8u) t;
  for i = 0 to 8 {
    t = (64u) adrs[:u8 8 + i];
    dst[1 + i] = (8u) t;
  }
  t = (64u) adrs[:u8 19];
  dst[9] = (8u) t;
  for i = 0 to 12 {
    t = (64u) adrs[:u8 20 + i];
    dst[10 + i] = (8u) t;
  }

  return dst;
}

/* out <- the first n bytes of the big-endian SHA-256 state h. */
inline fn __sha256_trunc_n(reg mut ptr u8[SLH_N] out, reg const ptr u32[8] h) -> reg ptr u8[SLH_N]
{
  reg u32 w;
  inline int i;

  for i = 0 to SLH_N / 4 {
    w = h[i];
    w = __bswap32(w);
    out[:u32 i] = w;
  }

  return out;
}

/* out <- the first n bytes of the big-endian SHA-512 state h. */
inline fn __sha512_trunc_n(reg mut ptr u8[SLH_N] out, reg const ptr u64[8] h) -> reg ptr u8[SLH_N]
{
  reg u64 w;
  inline int i;

  for i = 0 to SLH_N / 8 {
    w = h[i];
    w = __bswap64(w);
    out[:u64 i] = w;
  }

  return out;
}

/*
 * ctx <- compression states after PK.seed || pad_b, for b = 64 and, in
 * categories 3 and 5, b = 128.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × msf"]
fn _thash_ctx_init(reg mut ptr u64[THASH_CTX_WORDS] ctx, reg const ptr u8[SLH_N] pk_seed, reg u64 ms)
  -> reg ptr u64[THASH_CTX_WORDS], reg u64
{
  stack u8[128] block;
  stack u32[8] h256;
  stack u64[8] h512;
  reg u64 t z;
  inline int i;

  z = 0;
  for i = 0 to 16 {
    block[:u64 i] = z;
  }
  for i = 0 to SLH_N / 8 {
    t = pk_seed[:u64 i];
    block[:u64 i] = t;
  }

  #spill(ctx);

  h256 = __sha256_init(h256);
  h256, ms = _sha256_compress(h256, block[0 : 64], ms);

  #unspill(ctx);
  ctx = #protect_ptr(ctx, ms);
  #spill(ctx);
  for i = 0 to 4 {
    t = h256[:u64 i];
    ctx[i] = t;
  }

  #[inline]
  if (SHA2_WIDE == 1) {
    #spill(ctx);
    h512 = __sha512_init(h512);
    h512, ms = _sha512_compress(h512, block, ms);
    #unspill(ctx);
    ctx = #protect_ptr(ctx, ms);
    #spill(ctx);
    for i = 0 to 8 {
      t = h512[i];
      ctx[4 + i] = t;
    }
  } else {
    z = 0;
    for i = 0 to 8 {
      ctx[4 + i] = z;
    }
  }

  return ctx, ms;
}

/*
 * One SHA-256 block after the precomputed state:
 *
 *     block = ADRS^c || x || 0x80 || 0 ... || L,  L = bits big-endian
 *
 * then out <- Trunc_n(compress(ctx state, block)). x is x_len bytes,
 * 22 + x_len <= 55.
 */
inline fn __sha256_seeded_block(
  reg mut ptr u8[64] block,
  reg const ptr u64[4] adrs,
  inline int x_len bits
) -> reg ptr u8[64]
{
  reg u64 z t;
  inline int i;

  z = 0;
  for i = 0 to 8 {
    block[:u64 i] = z;
  }
  block = __adrs_compress_into64(block, adrs);

  t = 0x80;
  block[SHA2_ADRSC_BYTES + x_len] = (8u) t;

  /* L < 2^16: only the last two bytes of the 64-bit length are non-zero. */
  t = bits >> 8;
  block[62] = (8u) t;
  t = bits & 0xff;
  block[63] = (8u) t;

  return block;
}

/* out <- PRF(PK.seed, SK.seed, ADRS) */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } ×
         { ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × msf"]
fn _thash_prf(
  reg mut ptr u8[SLH_N] out,
  reg const ptr u8[SLH_N] sk_seed,
  reg const ptr u64[THASH_CTX_WORDS] ctx,
  reg const ptr u64[4] adrs,
  reg u64 ms
) -> reg ptr u8[SLH_N], reg u64
{
  stack u8[64] block;
  stack u32[8] h;
  reg u64 t;
  inline int i;

  block = __sha256_seeded_block(block, adrs, SLH_N, SHA256_TAIL_BITS_N);
  for i = 0 to SLH_N / 8 {
    t = sk_seed[:u64 i];
    block.[:u64 SHA2_ADRSC_BYTES + 8 * i] = t;
  }
  for i = 0 to 4 {
    t = ctx[i];
    h[:u64 i] = t;
  }

  #spill(out);
  h, ms = _sha256_compress(h, block, ms);
  #unspill(out);
  out = #protect_ptr(out, ms);
  out = __sha256_trunc_n(out, h);

  return out, ms;
}

/* x <- F(PK.seed, ADRS, x), in place. */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } ×
         { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × msf"]
fn _thash_f(
  reg mut ptr u8[SLH_N] x,
  reg const ptr u64[THASH_CTX_WORDS] ctx,
  reg const ptr u64[4] adrs,
  reg u64 ms
) -> reg ptr u8[SLH_N], reg u64
{
  stack u8[64] block;
  stack u32[8] h;
  reg u64 t;
  inline int i;

  block = __sha256_seeded_block(block, adrs, SLH_N, SHA256_TAIL_BITS_N);
  for i = 0 to SLH_N / 8 {
    t = x[:u64 i];
    block.[:u64 SHA2_ADRSC_BYTES + 8 * i] = t;
  }
  for i = 0 to 4 {
    t = ctx[i];
    h[:u64 i] = t;
  }

  #spill(x);
  h, ms = _sha256_compress(h, block, ms);
  #unspill(x);
  x = #protect_ptr(x, ms);
  x = __sha256_trunc_n(x, h);

  return x, ms;
}

/*
 * out <- H(PK.seed, ADRS, in), in = left || right.
 *
 * Category 1: one SHA-256 block, as F with 2n = 32 bytes of input.
 * Categories 3, 5: one SHA-512 block,
 *
 *     ADRS^c || in || 0x80 || 0 ... || L (128-bit, big-endian)
 *
 * with 22 + 2n <= 86 bytes of data, so L sits in bytes 112..127 and only
 * its last two bytes are non-zero.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } ×
         { ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × msf"]
fn _thash_h(
  reg mut ptr u8[SLH_N] out,
  reg const ptr u8[2 * SLH_N] in,
  reg const ptr u64[THASH_CTX_WORDS] ctx,
  reg const ptr u64[4] adrs,
  reg u64 ms
) -> reg ptr u8[SLH_N], reg u64
{
  stack u8[64] block;
  stack u8[128] wide;
  stack u32[8] h;
  stack u64[8] h512;
  reg u64 t z;
  inline int i;

  #[inline]
  if (SHA2_WIDE == 0) {
    block = __sha256_seeded_block(block, adrs, 2 * SLH_N, SHA256_TAIL_BITS_2N);
    for i = 0 to SLH_N / 4 {
      t = in[:u64 i];
      block.[:u64 SHA2_ADRSC_BYTES + 8 * i] = t;
    }
    for i = 0 to 4 {
      t = ctx[i];
      h[:u64 i] = t;
    }

    #spill(out);
    h, ms = _sha256_compress(h, block, ms);
    #unspill(out);
    out = #protect_ptr(out, ms);
    out = __sha256_trunc_n(out, h);
  } else {
    z = 0;
    for i = 0 to 16 {
      wide[:u64 i] = z;
    }
    wide = __adrs_compress_into128(wide, adrs);
    for i = 0 to SLH_N / 4 {
      t = in[:u64 i];
      wide.[:u64 SHA2_ADRSC_BYTES + 8 * i] = t;
    }
    t = 0x80;
    wide[SHA2_ADRSC_BYTES + 2 * SLH_N] = (8u) t;
    t = SHA512_TAIL_BITS_2N >> 8;
    wide[126] = (8u) t;
    t = SHA512_TAIL_BITS_2N & 0xff;
    wide[127] = (8u) t;

    for i = 0 to 8 {
      t = ctx[4 + i];
      h512[i] = t;
    }

    #spill(out);
    h512, ms = _sha512_compress(h512, wide, ms);
    #unspill(out);
    out = #protect_ptr(out, ms);
    out = __sha512_trunc_n(out, h512);
  }

  return out, ms;
}

/* T_l at l = len (WOTS+ public keys) and l = k (FORS roots). */

namespace TLen {
  param int T_INPUT_BYTES = SLH_LEN * SLH_N;
  from Slhdsa require "thash_sha2_t.jinc"
}

namespace TK {
  param int T_INPUT_BYTES = SLH_K * SLH_N;
  from Slhdsa require "thash_sha2_t.jinc"
}

/* out <- T_len(PK.seed, ADRS, in), the WOTS+ public-key compression. */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } ×
         { ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × msf"]
fn _thash_t_len(
  reg mut ptr u8[SLH_N] out,
  reg const ptr u8[SLH_LEN * SLH_N] in,
  reg const ptr u64[THASH_CTX_WORDS] ctx,
  reg const ptr u64[4] adrs,
  reg u64 ms
) -> reg ptr u8[SLH_N], reg u64
{
  out, ms = TLen::_thash_t(out, in, ctx, adrs, ms);
  return out, ms;
}

/* out <- T_k(PK.seed, ADRS, in), the FORS public-key compression. */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } ×
         { ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × msf"]
fn _thash_t_k(
  reg mut ptr u8[SLH_N] out,
  reg const ptr u8[SLH_K * SLH_N] in,
  reg const ptr u64[THASH_CTX_WORDS] ctx,
  reg const ptr u64[4] adrs,
  reg u64 ms
) -> reg ptr u8[SLH_N], reg u64
{
  out, ms = TK::_thash_t(out, in, ctx, adrs, ms);
  return out, ms;
}

/*
 * Message hashing
 * ---------------
 *
 * M' = prefix[0 : prefix_len] || msg[0 : msg_len], as for SHAKE. The
 * prefix has a run-time length, so it is appended byte by byte to the
 * block buffer here, compressing each full block; the message then goes
 * through the hash layer's memory absorb. (h, buf, total) is the
 * streaming state of the hash layer's README: buf holds total mod b
 * pending bytes.
 *
 * The prefix absorbers are inline: as local functions their state
 * pointer would join the register class of every SHA-2 state argument in
 * the program, which leaves the x86-64 allocation no register for it.
 */

inline fn __sha256_absorb_prefix(
  reg mut ptr u32[8] h,
  reg mut ptr u8[64] buf,
  reg u64 total,
  reg const ptr u8[SLH_PREFIX_MAX] prefix,
  reg u64 len,
  reg u64 ms
) -> reg ptr u32[8], reg ptr u8[64], reg u64, reg u64
{
  reg u64 i fill t;
  reg bool more full;

  i = 0;
  while { more = i < len; } (more) {
    ms = #update_msf(more, ms);

    fill = total;
    fill &= 63;
    t = (64u) prefix[i];
    buf[fill] = (8u) t;
    total += 1;
    i += 1;

    full = fill == 63;
    if (full) {
      ms = #update_msf(full, ms);
      #spill(buf, total, prefix, len, i);
      h, ms = _sha256_compress(h, buf, ms);
      #unspill(buf, total, prefix, len, i);
      buf = #protect_ptr(buf, ms);
      total = #protect(total, ms);
      prefix = #protect_ptr(prefix, ms);
      len = #protect(len, ms);
      i = #protect(i, ms);
      #spill(buf, total, prefix, len, i);
    } else {
      ms = #update_msf(!full, ms);
    }
  }
  ms = #update_msf(!more, ms);

  return h, buf, total, ms;
}

inline fn __sha512_absorb_prefix(
  reg mut ptr u64[8] h,
  reg mut ptr u8[128] buf,
  reg u64 total,
  reg const ptr u8[SLH_PREFIX_MAX] prefix,
  reg u64 len,
  reg u64 ms
) -> reg ptr u64[8], reg ptr u8[128], reg u64, reg u64
{
  reg u64 i fill t;
  reg bool more full;

  i = 0;
  while { more = i < len; } (more) {
    ms = #update_msf(more, ms);

    fill = total;
    fill &= 127;
    t = (64u) prefix[i];
    buf[fill] = (8u) t;
    total += 1;
    i += 1;

    full = fill == 127;
    if (full) {
      ms = #update_msf(full, ms);
      #spill(buf, total, prefix, len, i);
      h, ms = _sha512_compress(h, buf, ms);
      #unspill(buf, total, prefix, len, i);
      buf = #protect_ptr(buf, ms);
      total = #protect(total, ms);
      prefix = #protect_ptr(prefix, ms);
      len = #protect(len, ms);
      i = #protect(i, ms);
      #spill(buf, total, prefix, len, i);
    } else {
      ms = #update_msf(!full, ms);
    }
  }
  ms = #update_msf(!more, ms);

  return h, buf, total, ms;
}

/*
 * Append M' to a SHA-256 or SHA-512 stream: the prefix, then the
 * message. prefix_len, msg and msg_len are protected where they bound a
 * loop or address memory; msg and msg_len wait in spill slots across the
 * prefix.
 */
inline fn __sha256_absorb_message(
  reg mut ptr u32[8] h,
  reg mut ptr u8[64] buf,
  reg u64 total,
  reg const ptr u8[SLH_PREFIX_MAX] prefix,
  reg u64 prefix_len msg msg_len,
  reg u64 ms
) -> reg ptr u32[8], reg ptr u8[64], reg u64, reg u64
{
  prefix_len = #protect(prefix_len, ms);
  #spill(msg, msg_len);
  h, buf, total, ms = __sha256_absorb_prefix(h, buf, total, prefix, prefix_len, ms);
  #unspill(msg, msg_len);
  msg = #protect(msg, ms);
  msg_len = #protect(msg_len, ms);

  h, buf, total, ms = _sha256_absorb_mem(h, buf, total, msg, msg_len, ms);

  return h, buf, total, ms;
}

inline fn __sha512_absorb_message(
  reg mut ptr u64[8] h,
  reg mut ptr u8[128] buf,
  reg u64 total,
  reg const ptr u8[SLH_PREFIX_MAX] prefix,
  reg u64 prefix_len msg msg_len,
  reg u64 ms
) -> reg ptr u64[8], reg ptr u8[128], reg u64, reg u64
{
  prefix_len = #protect(prefix_len, ms);
  #spill(msg, msg_len);
  h, buf, total, ms = __sha512_absorb_prefix(h, buf, total, prefix, prefix_len, ms);
  #unspill(msg, msg_len);
  msg = #protect(msg, ms);
  msg_len = #protect(msg_len, ms);

  h, buf, total, ms = _sha512_absorb_mem(h, buf, total, msg, msg_len, ms);

  return h, buf, total, ms;
}

/*
 * R <- PRF_msg(SK.prf, opt_rand, M') = Trunc_n(HMAC-X(SK.prf, opt_rand || M'))
 *
 * K0 is SK.prf padded with zeros to one block (FIPS 198-1 section 4, step
 * 2: the key is shorter than the block).
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } ×
         { ptr: public, val: secret } × { ptr: public, val: secret } ×
         transient × transient × transient × msf →
         { ptr: public, val: secret } × msf"]
fn _prf_msg(
  reg mut ptr u8[SLH_N] r,
  reg const ptr u8[SLH_N] sk_prf,
  reg const ptr u8[SLH_N] opt_rand,
  reg const ptr u8[SLH_PREFIX_MAX] prefix,
  reg u64 prefix_len msg msg_len,
  reg u64 ms
) -> reg ptr u8[SLH_N], reg u64
{
  stack u8[128] k0;
  stack u8[64] buf;
  stack u8[128] buf512;
  stack u32[8] inner outer;
  stack u64[8] inner512 outer512;
  stack u8[32] tag;
  stack u8[64] tag512;
  reg u64 t z total;
  inline int i;

  z = 0;
  for i = 0 to 16 {
    k0[:u64 i] = z;
  }
  for i = 0 to SLH_N / 8 {
    t = sk_prf[:u64 i];
    k0[:u64 i] = t;
  }

  #spill(r, opt_rand, prefix, prefix_len, msg, msg_len);

  #[inline]
  if (SHA2_WIDE == 0) {
    inner, outer, ms = __hmac_sha256_init(inner, outer, k0[0 : 64], ms);

    /* opt_rand opens the inner message: n < 64 bytes, no block completes. */
    #unspill(opt_rand);
    opt_rand = #protect_ptr(opt_rand, ms);
    for i = 0 to SLH_N / 8 {
      t = opt_rand[:u64 i];
      buf[:u64 i] = t;
    }
    total = 64 + SLH_N;
    #unspill(prefix, prefix_len, msg, msg_len);
    prefix = #protect_ptr(prefix, ms);
    inner, buf, total, ms = __sha256_absorb_message(inner, buf, total, prefix, prefix_len, msg, msg_len, ms);
    tag, inner, buf, ms = __hmac_sha256_finalize(tag, inner, buf, total, outer, ms);
    #unspill(r);
    r = #protect_ptr(r, ms);
    for i = 0 to SLH_N / 8 {
      t = tag[:u64 i];
      r[:u64 i] = t;
    }
  } else {
    inner512, outer512, ms = __hmac_sha512_init(inner512, outer512, k0, ms);

    /* opt_rand opens the inner message: n < 128 bytes, no block completes. */
    #unspill(opt_rand);
    opt_rand = #protect_ptr(opt_rand, ms);
    for i = 0 to SLH_N / 8 {
      t = opt_rand[:u64 i];
      buf512[:u64 i] = t;
    }
    total = 128 + SLH_N;
    #unspill(prefix, prefix_len, msg, msg_len);
    prefix = #protect_ptr(prefix, ms);
    inner512, buf512, total, ms = __sha512_absorb_message(inner512, buf512, total, prefix,
                                                          prefix_len, msg, msg_len, ms);
    tag512, inner512, buf512, ms = __hmac_sha512_finalize(tag512, inner512, buf512, total, outer512, ms);
    #unspill(r);
    r = #protect_ptr(r, ms);
    for i = 0 to SLH_N / 8 {
      t = tag512[:u64 i];
      r[:u64 i] = t;
    }
  }

  return r, ms;
}

/*
 * digest <- H_msg(R, PK.seed, PK.root, M')
 *         = MGF1-X(R || PK.seed || X(R || PK.seed || PK.root || M'), m)
 *
 * pk = PK.seed || PK.root.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } ×
         { ptr: public, val: secret } × { ptr: public, val: secret } ×
         transient × transient × transient × msf →
         { ptr: public, val: secret } × msf"]
fn _h_msg(
  reg mut ptr u8[SLH_M] digest,
  reg const ptr u8[SLH_N] r,
  reg const ptr u8[2 * SLH_N] pk,
  reg const ptr u8[SLH_PREFIX_MAX] prefix,
  reg u64 prefix_len msg msg_len,
  reg u64 ms
) -> reg ptr u8[SLH_M], reg u64
{
  stack u8[3 * SLH_N] head;
  stack u8[2 * SLH_N + SHA2_X_DIGEST] seed;
  stack u8[64] buf;
  stack u8[128] buf512;
  stack u32[8] h;
  stack u64[8] h512;
  stack u8[32] d256;
  stack u8[64] d512;
  reg u64 t total;
  inline int i;

  /* head = R || PK.seed || PK.root; seed starts R || PK.seed. */

  for i = 0 to SLH_N / 8 {
    t = r[:u64 i];
    head[:u64 i] = t;
    seed[:u64 i] = t;
  }
  for i = 0 to 2 * SLH_N / 8 {
    t = pk[:u64 i];
    head[:u64 SLH_N / 8 + i] = t;
  }
  for i = 0 to SLH_N / 8 {
    t = pk[:u64 i];
    seed[:u64 SLH_N / 8 + i] = t;
  }

  #spill(digest, prefix, prefix_len, msg, msg_len);

  #[inline]
  if (SHA2_WIDE == 0) {
    h = __sha256_init(h);

    /* R || PK.seed || PK.root: 3n = 48 < 64 bytes, no block completes. */
    for i = 0 to 3 * SLH_N / 8 {
      t = head[:u64 i];
      buf[:u64 i] = t;
    }
    total = 3 * SLH_N;
    #unspill(prefix, prefix_len, msg, msg_len);
    prefix = #protect_ptr(prefix, ms);
    h, buf, total, ms = __sha256_absorb_message(h, buf, total, prefix, prefix_len, msg, msg_len, ms);
    d256, h, buf, ms = _sha256_finalize(d256, h, buf, total, ms);
    for i = 0 to 4 {
      t = d256[:u64 i];
      seed[:u64 2 * SLH_N / 8 + i] = t;
    }
  } else {
    h512 = __sha512_init(h512);

    /* R || PK.seed || PK.root: 3n <= 96 < 128 bytes, no block completes. */
    for i = 0 to 3 * SLH_N / 8 {
      t = head[:u64 i];
      buf512[:u64 i] = t;
    }
    total = 3 * SLH_N;
    #unspill(prefix, prefix_len, msg, msg_len);
    prefix = #protect_ptr(prefix, ms);
    h512, buf512, total, ms = __sha512_absorb_message(h512, buf512, total, prefix,
                                                      prefix_len, msg, msg_len, ms);
    d512, h512, buf512, ms = _sha512_finalize(d512, h512, buf512, total, ms);
    for i = 0 to 8 {
      t = d512[:u64 i];
      seed[:u64 2 * SLH_N / 8 + i] = t;
    }
  }

  #unspill(digest);
  digest = #protect_ptr(digest, ms);

  #[inline]
  if (SHA2_WIDE == 0) {
    digest, ms = Mgf::_mgf1_sha256(digest, seed, ms);
  } else {
    digest, ms = Mgf::_mgf1_sha512(digest, seed, ms);
  }

  return digest, ms;
}

/*
 * Four-way forms
 * --------------
 *
 * The tree code computes key pairs and FORS leaves four at a time through
 * _thash_prf_x4, _thash_f_x4 and _thash_t_len_x4, for four independent
 * instances k = 0 .. 3, each exactly as the one-way function would:
 *
 *     adrs  u64[16]          ADRS of instance k at words 4k .. 4k + 3
 *     x     u8[4n]           instance k at bytes kn .. kn + n - 1 (out too)
 *     in    u8[4 len n]      instance k at bytes k len n .. (k + 1) len n - 1
 *
 * They come from the include root Sha2ThashX, which the build points at
 * one of two versions with the same functions and contracts (Makefile,
 * TX_<variant>):
 *
 *     thash_sha2_x4/single/  four calls of the one-way functions above
 *     thash_sha2_x4/multi/   the multi-way SHA-2 kernels of the hash layer
 *                            (Sha2KernelX), one compression for the four
 */

param int THASH_WAYS = 4;

from Sha2ThashX require "thash_sha2_x4.jinc"
